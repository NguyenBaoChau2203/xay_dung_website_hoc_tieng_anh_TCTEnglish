{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "TCT: Set up shared agent tools",
      "type": "process",
      "command": "node",
      "args": [
        "${workspaceFolder}/scripts/agent-tools.cjs",
        "setup"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen",
        "instanceLimit": 1
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      }
    },
    {
      "label": "TCT: Check agent tooling",
      "type": "process",
      "command": "node",
      "args": [
        "${workspaceFolder}/scripts/agent-tools.cjs",
        "validate"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "TCT: Create CodeGraph index (explicit action)",
      "type": "process",
      "command": "node",
      "args": [
        "${workspaceFolder}/scripts/agent-tools.cjs",
        "index"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "TCT: Start local web",
      "type": "shell",
      "command": "pwsh -NoProfile -File \"${workspaceFolder}/scripts/start-local.ps1\" -NoBrowser",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "TCT: Speech configuration status",
      "type": "shell",
      "command": "pwsh -NoProfile -File \"${workspaceFolder}/scripts/speech-status.ps1\"",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "TCT: Setup local media (FFmpeg import)",
      "type": "shell",
      "command": "pwsh -NoProfile -File \"${workspaceFolder}/scripts/local-media.ps1\" -Action Setup",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
