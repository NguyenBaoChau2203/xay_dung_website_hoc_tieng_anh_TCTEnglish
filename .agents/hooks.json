{
  "tct-project-checks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node scripts/agent-tools.cjs hook antigravity SessionStart",
        "timeout": 30
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/agent-tools.cjs hook antigravity PreToolUse",
            "timeout": 30
          }
        ],
        "matcher": "^(invoke_subagent|define_subagent)$"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/agent-tools.cjs hook antigravity PostToolUse",
            "timeout": 30
          }
        ],
        "matcher": "^(run_command|write_to_file|replace_file_content|multi_replace_file_content)$"
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node scripts/agent-tools.cjs hook antigravity Stop",
        "timeout": 30
      }
    ]
  }
}
