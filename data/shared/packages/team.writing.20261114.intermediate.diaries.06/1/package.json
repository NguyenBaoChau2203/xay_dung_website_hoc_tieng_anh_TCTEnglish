  "version": 1,
  "dependsOn": [],
  "records": [
    {
      "key": "team.writing.20261114.intermediate.diaries.06",
      "kind": "WritingExercise",
      "values": {
        "Title": "B\u1EEFa t\u1ED1i n\u1ED1i l\u1EA1i cu\u1ED9c tr\u00F2 chuy\u1EC7n",
        "Level": "intermediate",
        "ContentType": "diaries",
        "Topic": "Gia \u0111\u00ECnh",
        "SourceType": "original-20261114",
        "PreviewText": "Nh\u1EADt k\u00FD tr\u00F2 chuy\u1EC7n v\u1EDBi \u00F4ng qua vi\u1EC7c c\u00F9ng chu\u1EA9n b\u1ECB m\u1ED9t m\u00F3n \u0103n c\u0169.",
        "IsPublished": true
      },
      "references": {}
    },
    {
      "key": "team.writing.20261114.intermediate.diaries.06.0fc828f2bec946a28da1b5b88a7af2db",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 7,
        "VietnameseText": "L\u1EA7n n\u00E0y t\u00F4i kh\u00F4ng nh\u00ECn \u0111i\u1EC7n tho\u1EA1i m\u1ED7i khi c\u00E2u chuy\u1EC7n t\u1EA1m ng\u1EEBng.",
        "EnglishMeaning": "This time I did not look at my phone whenever the conversation paused.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.diaries.06"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.diaries.06.48dec2adb1db47489e9157b1134b1242",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 3,
        "VietnameseText": "T\u00F4i ngh\u0129 vi\u1EC7c n\u1EA5u \u0103n s\u1EBD ch\u1EC9 m\u1EA5t n\u1EEDa gi\u1EDD, nh\u01B0ng \u00F4ng mu\u1ED1n t\u1EF1 l\u00E0m n\u01B0\u1EDBc d\u00F9ng.",
        "EnglishMeaning": "I expected cooking to take half an hour, but he wanted to make the broth himself.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.diaries.06"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.diaries.06.4af70b48f78940dead1d44012fa9702b",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 11,
        "VietnameseText": "T\u00F4i mu\u1ED1n d\u00E0nh m\u1ED9t bu\u1ED5i t\u1ED1i m\u1ED7i tu\u1EA7n \u0111\u1EC3 l\u00E0m vi\u1EC7c g\u00EC \u0111\u00F3 c\u00F9ng \u00F4ng.",
        "EnglishMeaning": "I want to spend one evening each week doing something with my grandfather.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.diaries.06"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.diaries.06.67e06ae54fbd43f9ac1680a305e7d949",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 6,
        "VietnameseText": "\u00D4ng k\u1EC3 c\u1EA3 nh\u1EEFng ng\u00E0y v\u1EAFng kh\u00E1ch, ch\u1EE9 kh\u00F4ng ch\u1EC9 nh\u1EEFng l\u00FAc l\u00E0m \u0103n thu\u1EADn l\u1EE3i.",
        "EnglishMeaning": "He described the quiet days as well as the times when business went well.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.diaries.06"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.diaries.06.75feb1261a5d4800b770423490724105",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 5,
        "VietnameseText": "T\u00F4i ch\u01B0a t\u1EEBng bi\u1EBFt r\u1EB1ng \u00F4ng \u0111\u00E3 b\u00E1n xe \u0111\u1EA1p \u0111\u1EC3 c\u00F3 ti\u1EC1n m\u1EDF c\u1EEDa h\u00E0ng.",
        "EnglishMeaning": "I had never known that he sold his bicycle to afford opening the shop.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.diaries.06"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.diaries.06.819adf572352474480da3d08f3067099",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 4,
        "VietnameseText": "Trong l\u00FAc ch\u1EDD, \u00F4ng nh\u1EDD t\u00F4i th\u00E1i rau v\u00E0 k\u1EC3 v\u1EC1 c\u1EEDa h\u00E0ng \u0111\u1EA7u ti\u00EAn c\u1EE7a m\u00ECnh.",
        "EnglishMeaning": "While we waited, he asked me to chop vegetables and described his first shop.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.diaries.06"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.diaries.06.866dd7c407d443f2b23c018ee2207286",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 10,
        "VietnameseText": "Sau b\u1EEFa t\u1ED1i, t\u00F4i ghi l\u1EA1i v\u00E0i \u0111i\u1EC1u \u0111\u1EC3 kh\u00F4ng qu\u00EAn c\u00E2u chuy\u1EC7n.",
        "EnglishMeaning": "After dinner, I wrote down a few things so I would remember the story.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.diaries.06"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.diaries.06.87f1ab9a90bc44909274bacf615b9957",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 9,
        "VietnameseText": "M\u00EC h\u01A1i m\u1EC1m v\u00EC ch\u00FAng t\u00F4i m\u1EA3i n\u00F3i chuy\u1EC7n, nh\u01B0ng c\u1EA3 hai \u0111\u1EC1u \u0103n h\u1EBFt.",
        "EnglishMeaning": "The noodles were slightly soft because we kept talking, but we both finished our bowls.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.diaries.06"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.diaries.06.9cb949fe18bb41b38e753c60de1729b4",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 12,
        "VietnameseText": "C\u00F3 l\u1EBD ch\u00FAng t\u00F4i kh\u00F4ng c\u1EA7n m\u1ED9t d\u1ECBp \u0111\u1EB7c bi\u1EC7t \u0111\u1EC3 hi\u1EC3u nhau h\u01A1n.",
        "EnglishMeaning": "Perhaps we do not need a special occasion to understand each other better.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.diaries.06"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.diaries.06.a85a2b2b1b514460a630a04e36572478",
      "kind": "WritingAcceptedAnswer",
      "values": {
        "AnswerText": "I would like to set aside an evening every week for an activity with my grandfather.",
        "NormalizedHash": "1ab5b8d33a6f121882f503dc0b54454855406395e65799cac7d0ea7731deef8d"
      },
      "references": {
        "WritingExerciseSentenceId": "team.writing.20261114.intermediate.diaries.06.4af70b48f78940dead1d44012fa9702b",
        "ApprovedByUserId": "owner:system"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.diaries.06.b0e754063de24480a0507aaf73705375",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 2,
        "VietnameseText": "G\u1EA7n \u0111\u00E2y ch\u00FAng t\u00F4i \u00EDt n\u00F3i chuy\u1EC7n v\u00EC t\u00F4i th\u01B0\u1EDDng v\u1EC1 mu\u1ED9n r\u1ED3i m\u1EDF m\u00E1y t\u00EDnh.",
        "EnglishMeaning": "Recently we have talked less because I usually arrive home late and open my laptop.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.diaries.06"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.diaries.06.c27365a3d9514296b691d640922ed3f0",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 8,
        "VietnameseText": "T\u00F4i h\u1ECFi th\u00EAm v\u00E0 th\u1EA5y \u00F4ng vui v\u00EC c\u00F3 ng\u01B0\u1EDDi mu\u1ED1n nghe chi ti\u1EBFt.",
        "EnglishMeaning": "I asked more questions and noticed his pleasure at someone\u0027s interest in the details.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.diaries.06"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.diaries.06.fcf06c208a3e417196525d438687c263",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 1,
        "VietnameseText": "T\u1ED1i nay t\u00F4i c\u00F9ng \u00F4ng chu\u1EA9n b\u1ECB m\u00F3n m\u00EC m\u00E0 \u00F4ng th\u01B0\u1EDDng n\u1EA5u khi t\u00F4i c\u00F2n nh\u1ECF.",
        "EnglishMeaning": "Tonight I helped my grandfather prepare the noodles he often cooked during my childhood.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.diaries.06"
      }
    }
  ],
