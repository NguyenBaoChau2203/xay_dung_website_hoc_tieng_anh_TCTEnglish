      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 4,
        "VietnameseText": "Em bu\u1ED3n v\u00EC chi\u1EBFc thuy\u1EC1n \u0111\u1ED3 ch\u01A1i c\u1EE7a m\u00ECnh \u0111\u00E3 b\u1ECB g\u00E3y.",
        "EnglishMeaning": "She was sad because her toy boat was broken.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.beginner.paper-boat"
      }
    },
    {
