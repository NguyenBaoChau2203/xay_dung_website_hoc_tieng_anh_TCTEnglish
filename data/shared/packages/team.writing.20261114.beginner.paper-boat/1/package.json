      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 1,
        "VietnameseText": "Trong gi\u1EDD ngh\u1EC9, B\u00ECnh t\u00ECm th\u1EA5y m\u1ED9t t\u1EDD gi\u1EA5y ch\u1EC9 vi\u1EBFt m\u1ED9t m\u1EB7t.",
        "EnglishMeaning": "During the break, Binh found a sheet of paper with writing on one side.",
        "BreakAfter": false
