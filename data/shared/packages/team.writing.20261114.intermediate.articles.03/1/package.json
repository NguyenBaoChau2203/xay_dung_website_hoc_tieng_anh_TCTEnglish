  "records": [
    {
      "key": "team.writing.20261114.intermediate.articles.03",
      "kind": "WritingExercise",
      "values": {
        "Title": "Kh\u00E1m ph\u00E1 khu ph\u1ED1 b\u1EB1ng m\u1ED9t tuy\u1EBFn \u0111i b\u1ED9",
        "Level": "intermediate",
        "ContentType": "articles",
        "Topic": "Kh\u00E1m ph\u00E1 \u0111\u1ECBa ph\u01B0\u01A1ng",
        "SourceType": "original-20261114",
        "PreviewText": "B\u00E0i vi\u1EBFt g\u1EE3i \u00FD l\u00EAn tuy\u1EBFn \u0111i b\u1ED9 ng\u1EAFn d\u1EF1a tr\u00EAn \u0111i\u1EC3m d\u1EEBng v\u00E0 \u0111i\u1EC1u ki\u1EC7n th\u1EF1c t\u1EBF.",
        "IsPublished": true
      },
      "references": {}
    },
    {
      "key": "team.writing.20261114.intermediate.articles.03.0b2140980be449fbae48dbed469056be",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 5,
        "VietnameseText": "M\u1ED9t t\u1EA5m b\u1EA3n \u0111\u1ED3 \u0111\u01A1n gi\u1EA3n c\u00F3 th\u1EC3 gi\u00FAp b\u1EA1n tr\u00E1nh ph\u1EA3i li\u00EAn t\u1EE5c nh\u00ECn \u0111i\u1EC7n tho\u1EA1i.",
        "EnglishMeaning": "A simple map can help you avoid looking at your phone constantly.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.articles.03"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.articles.03.0d06edab14e34fd8a18a307e336bec94",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 8,
        "VietnameseText": "N\u1EBFu mu\u1ED1n ch\u1EE5p \u1EA3nh ng\u01B0\u1EDDi b\u00E1n h\u00E0ng, h\u00E3y xin ph\u00E9p tr\u01B0\u1EDBc khi \u0111\u01B0a m\u00E1y l\u00EAn.",
        "EnglishMeaning": "If you want to photograph a shopkeeper, ask permission before raising your camera.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.articles.03"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.articles.03.23ee03df5b7b4747a4fe6cbb5eb4b7c0",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 3,
        "VietnameseText": "Ch\u1ECDn ba \u0111i\u1EC3m g\u1EA7n nhau s\u1EBD gi\u00FAp chuy\u1EBFn \u0111i c\u00F3 m\u1EE5c \u0111\u00EDch m\u00E0 kh\u00F4ng qu\u00E1 m\u1EC7t.",
        "EnglishMeaning": "Choosing three nearby stops gives the walk a purpose without making it too tiring.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.articles.03"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.articles.03.2403263b618d48a7be7cfb2a224f349c",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 10,
        "VietnameseText": "Ng\u01B0\u1EDDi tham gia c\u00F3 th\u1EC3 mang theo m\u1ED9t \u0111i\u1EC1u m\u1EDBi h\u1ECDc \u0111\u01B0\u1EE3c v\u1EC1 khu v\u1EF1c.",
        "EnglishMeaning": "Each participant can bring one new thing they have learned about the area.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.articles.03"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.articles.03.45ee18a89e82470f8adb2432bc47cdb1",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 2,
        "VietnameseText": "H\u00E3y b\u1EAFt \u0111\u1EA7u v\u1EDBi m\u1ED9t ch\u1EE7 \u0111\u1EC1 nh\u1ECF, ch\u1EB3ng h\u1EA1n nh\u1EEFng c\u1EEDa h\u00E0ng l\u00E2u n\u0103m.",
        "EnglishMeaning": "Start with a small theme, such as shops that have been there for years.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.articles.03"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.articles.03.6ab17784eec6441888373ccd6c4edf1e",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 4,
        "VietnameseText": "Tr\u01B0\u1EDBc khi \u0111i, h\u00E3y ki\u1EC3m tra l\u1ED1i \u0111i v\u00E0 gi\u1EDD m\u1EDF c\u1EEDa c\u1EE7a c\u00E1c \u0111i\u1EC3m \u0111\u1ECBnh gh\u00E9.",
        "EnglishMeaning": "Before leaving, check the paths and opening times of the places you plan to visit.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.articles.03"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.articles.03.6eaf2bc4fad34e7db86be3a0a2cdc916",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 12,
        "VietnameseText": "M\u1ED9t chuy\u1EBFn kh\u00E1m ph\u00E1 \u0111\u00E1ng nh\u1EDB kh\u00F4ng nh\u1EA5t thi\u1EBFt ph\u1EA3i b\u1EAFt \u0111\u1EA7u \u1EDF m\u1ED9t n\u01A1i xa l\u1EA1.",
        "EnglishMeaning": "A memorable exploration does not necessarily have to begin somewhere unfamiliar.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.articles.03"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.articles.03.92e31c81789b475f8557f3d5bc3bea46",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 7,
        "VietnameseText": "M\u1ED9t bi\u1EC3n hi\u1EC7u c\u0169 ho\u1EB7c kho\u1EA3ng s\u00E2n nh\u1ECF c\u00F3 th\u1EC3 m\u1EDF ra c\u00E2u chuy\u1EC7n th\u00FA v\u1ECB.",
        "EnglishMeaning": "An old sign or a small courtyard might lead to an interesting story.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.articles.03"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.articles.03.a84a6bdcf0f448aca9e1d411bac121e0",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 1,
        "VietnameseText": "B\u1EA1n c\u00F3 th\u1EC3 kh\u00E1m ph\u00E1 m\u1ED9t khu ph\u1ED1 quen thu\u1ED9c b\u1EB1ng c\u00E1ch l\u00EAn m\u1ED9t tuy\u1EBFn \u0111i b\u1ED9 m\u1EDBi.",
        "EnglishMeaning": "You can explore a familiar neighbourhood by planning a new walking route.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.articles.03"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.articles.03.c56f458f56694f1b982b8b1133627914",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 11,
        "VietnameseText": "Sau chuy\u1EBFn \u0111i, ghi l\u1EA1i \u0111o\u1EA1n \u0111\u01B0\u1EDDng thu\u1EADn ti\u1EC7n \u0111\u1EC3 l\u1EA7n sau \u0111i\u1EC1u ch\u1EC9nh.",
        "EnglishMeaning": "After the walk, note which sections were convenient so you can adjust the route next time.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.articles.03"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.articles.03.c8900669f9a140379dabaa6300d2a38e",
      "kind": "WritingAcceptedAnswer",
      "values": {
        "AnswerText": "Following the walk, record the convenient parts of the route to help plan the next visit.",
        "NormalizedHash": "3c3bb524c47b154791e7bb60b62259417517d027223d4ecf56a3f41dc2f8a177"
      },
      "references": {
        "WritingExerciseSentenceId": "team.writing.20261114.intermediate.articles.03.c56f458f56694f1b982b8b1133627914",
        "ApprovedByUserId": "owner:system"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.articles.03.e2a100cdb77c4f629a65f171b2baad9a",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 9,
        "VietnameseText": "H\u00E3y ch\u1ECDn \u0111i\u1EC3m d\u1EEBng cu\u1ED1i c\u00F3 ch\u1ED7 ng\u1ED3i \u0111\u1EC3 m\u1ECDi ng\u01B0\u1EDDi ngh\u1EC9 v\u00E0 trao \u0111\u1ED5i.",
        "EnglishMeaning": "Choose a final stop with seats where everyone can rest and share impressions.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.articles.03"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.articles.03.e321707e405144d3a100c6bb9599427a",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 6,
        "VietnameseText": "Tuy nhi\u00EAn, \u0111\u1EEBng l\u00EAn l\u1ECBch k\u00EDn \u0111\u1EBFn m\u1EE9c kh\u00F4ng c\u00F2n th\u1EDDi gian quan s\u00E1t.",
        "EnglishMeaning": "However, avoid packing the schedule so tightly that there is no time to look around.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.articles.03"
      }
    }
  ],
