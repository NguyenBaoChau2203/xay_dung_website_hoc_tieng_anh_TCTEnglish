  "records": [
    {
      "key": "team.writing.20261114.beginner.learn-with-friend",
      "kind": "WritingExercise",
      "values": {
        "Title": "H\u1ECDc c\u00F9ng m\u1ED9t ng\u01B0\u1EDDi b\u1EA1n",
        "Level": "beginner",
        "ContentType": "essays",
        "Topic": "H\u1ECDc t\u1EADp",
        "SourceType": "original-20261114",
        "PreviewText": "\u0110o\u1EA1n lu\u1EADn c\u00E2n nh\u1EAFc l\u1EE3i \u00EDch v\u00E0 \u0111i\u1EC1u ki\u1EC7n c\u1EE7a h\u1ECDc \u0111\u00F4i.",
        "IsPublished": true
      },
      "references": {}
    },
    {
      "key": "team.writing.20261114.beginner.learn-with-friend.2480cf29c27f4297aaf7c29d689c1b36",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 5,
        "VietnameseText": "Nh\u01B0ng ch\u00FAng ta c\u1EA7n ch\u1ECDn m\u1ED9t n\u01A1i \u0111\u1EE7 y\u00EAn t\u0129nh.",
        "EnglishMeaning": "But we need to choose a place that is quiet enough.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.beginner.learn-with-friend"
      }
    },
    {
      "key": "team.writing.20261114.beginner.learn-with-friend.5b3a41e57b2644fd9b1dc69710886131",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 4,
        "VietnameseText": "M\u1ED9t ng\u01B0\u1EDDi b\u1EA1n c\u00F3 th\u1EC3 nh\u1EAFc t\u00F4i ngh\u1EC9 khi t\u00F4i h\u1ECDc qu\u00E1 l\u00E2u.",
        "EnglishMeaning": "A friend can remind me to rest when I study too long.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.beginner.learn-with-friend"
      }
    },
    {
      "key": "team.writing.20261114.beginner.learn-with-friend.67c50d8d084f47cdb1fda2e42025a5f0",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 6,
        "VietnameseText": "N\u1EBFu ch\u1EC9 tr\u00F2 chuy\u1EC7n, ch\u00FAng ta s\u1EBD kh\u00F4ng ho\u00E0n th\u00E0nh c\u00F4ng vi\u1EC7c.",
        "EnglishMeaning": "If we only chat, we will not finish our work.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.beginner.learn-with-friend"
      }
    },
    {
      "key": "team.writing.20261114.beginner.learn-with-friend.6b063bccd1be44faa767dc2d402e5fc5",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 8,
        "VietnameseText": "Nh\u01B0 v\u1EADy, ch\u00FAng t\u00F4i v\u1EEBa h\u1ECDc \u0111\u01B0\u1EE3c \u0111i\u1EC1u m\u1EDBi v\u1EEBa gi\u00FAp \u0111\u1EE1 nhau.",
        "EnglishMeaning": "This way, we learn something new and help each other.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.beginner.learn-with-friend"
      }
    },
    {
      "key": "team.writing.20261114.beginner.learn-with-friend.a76d695f937646359996d1d10b394456",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 1,
        "VietnameseText": "H\u1ECDc c\u00F9ng m\u1ED9t ng\u01B0\u1EDDi b\u1EA1n c\u00F3 th\u1EC3 gi\u00FAp vi\u1EC7c h\u1ECDc th\u00FA v\u1ECB h\u01A1n.",
        "EnglishMeaning": "Studying with a friend can make learning more interesting.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.beginner.learn-with-friend"
      }
    },
    {
      "key": "team.writing.20261114.beginner.learn-with-friend.a8a4e74bcf0447b9af0a6a6b7690a70e",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 3,
        "VietnameseText": "Khi gi\u1EA3i th\u00EDch m\u1ED9t c\u00E2u tr\u1EA3 l\u1EDDi, t\u00F4i c\u0169ng nh\u1EDB b\u00E0i r\u00F5 h\u01A1n.",
        "EnglishMeaning": "When I explain an answer, I also remember the lesson better.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.beginner.learn-with-friend"
      }
    },
    {
      "key": "team.writing.20261114.beginner.learn-with-friend.b402de95623044c5b3abd53f0c829a12",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 7,
        "VietnameseText": "T\u00F4i th\u00EDch \u0111\u1EB7t m\u1ED9t m\u1EE5c ti\u00EAu nh\u1ECF tr\u01B0\u1EDBc m\u1ED7i bu\u1ED5i h\u1ECDc chung.",
        "EnglishMeaning": "I like setting a small goal before each study session together.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.beginner.learn-with-friend"
      }
    },
    {
      "key": "team.writing.20261114.beginner.learn-with-friend.bb7a922e9a1d4efcb167b433d20840e9",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 2,
        "VietnameseText": "Ch\u00FAng ta c\u00F3 th\u1EC3 h\u1ECFi nhau nh\u1EEFng \u0111i\u1EC1u ch\u01B0a hi\u1EC3u.",
        "EnglishMeaning": "We can ask each other about things we do not understand.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.beginner.learn-with-friend"
      }
    },
    {
      "key": "team.writing.20261114.beginner.learn-with-friend.e5addb05147f417dbe7dfcb08e3dcbe2",
      "kind": "WritingAcceptedAnswer",
      "values": {
        "AnswerText": "But we need to find a place that is quiet enough.",
