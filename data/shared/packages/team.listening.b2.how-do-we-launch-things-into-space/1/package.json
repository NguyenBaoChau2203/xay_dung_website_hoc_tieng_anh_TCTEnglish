    {
      "key": "team.listening.b2.how-do-we-launch-things-into-space.6f7caff058d046738ca391f138ab8913",
      "kind": "ListeningTranscriptLine",
      "values": {
        "OrderIndex": 11,
        "Speaker": "Narrator",
        "Text": "There, it keeps going around Earth in a circular path \u2013 an orbit.",
        "VietnameseMeaning": "\u1EDE \u0111\u00F3, n\u00F3 ti\u1EBFp t\u1EE5c bay v\u00F2ng quanh Tr\u00E1i \u0110\u1EA5t theo m\u1ED9t \u0111\u01B0\u1EDDng tr\u00F2n \u2013 m\u1ED9t qu\u1EF9 \u0111\u1EA1o.",
        "StartTime": 75.3,
        "EndTime": 81.5
      },
      "references": {
        "LessonId": "team.listening.b2.how-do-we-launch-things-into-space"
      }
    },
    {
