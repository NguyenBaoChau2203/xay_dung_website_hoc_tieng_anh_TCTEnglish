      "kind": "ListeningTranscriptLine",
      "values": {
        "OrderIndex": 21,
        "Speaker": "Narrator",
        "Text": "And if you want to explore even farther planets like Saturn, plan carefully!",
        "VietnameseMeaning": "V\u00E0 n\u1EBFu b\u1EA1n mu\u1ED1n kh\u00E1m ph\u00E1 nh\u1EEFng h\u00E0nh tinh xa h\u01A1n n\u1EEFa nh\u01B0 Sao Th\u1ED5, h\u00E3y l\u00EAn k\u1EBF ho\u1EA1ch c\u1EA9n th\u1EADn!",
        "StartTime": 131.4,
        "EndTime": 138
      },
      "references": {
