      }
    },
    {
      "key": "team.listening.b2.how-do-we-launch-things-into-space.0f66d21d4ac94efd91da35870a3c1745",
      "kind": "ListeningTranscriptLine",
      "values": {
        "OrderIndex": 23,
        "Speaker": "Narrator",
        "Text": "But don\u2019t worry, all the planning is worth it when you end up with a view like this one.",
        "VietnameseMeaning": "Nh\u01B0ng \u0111\u1EEBng lo, m\u1ECDi s\u1EF1 l\u00EAn k\u1EBF ho\u1EA1ch \u0111\u1EC1u x\u1EE9ng \u0111\u00E1ng khi b\u1EA1n c\u00F3 \u0111\u01B0\u1EE3c m\u1ED9t khung c\u1EA3nh nh\u01B0 th\u1EBF n\u00E0y.",
        "StartTime": 143.5,
        "EndTime": 150.7
      },
      "references": {
