    {
      "key": "team.listening.b2.how-do-we-launch-things-into-space.6aea16c1998f44569d443085e917ef88",
      "kind": "ListeningTranscriptLine",
      "values": {
        "OrderIndex": 14,
        "Speaker": "Narrator",
        "Text": "The balance of these two forces can keep a satellite in orbit for many years!",
        "VietnameseMeaning": "S\u1EF1 c\u00E2n b\u1EB1ng gi\u1EEFa hai l\u1EF1c n\u00E0y c\u00F3 th\u1EC3 gi\u1EEF m\u1ED9t v\u1EC7 tinh tr\u00EAn qu\u1EF9 \u0111\u1EA1o trong nhi\u1EC1u n\u0103m!",
        "StartTime": 88.9,
