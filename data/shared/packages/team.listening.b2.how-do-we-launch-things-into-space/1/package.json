      }
    },
    {
      "key": "team.listening.b2.how-do-we-launch-things-into-space.106100549caf43a393699122fc41b3a4",
      "kind": "ListeningQuizQuestion",
      "values": {
        "OrderIndex": 3,
        "QuestionText": "How fast must a rocket go to stay in orbit?",
        "OptionA": "At least 17,800 miles per hour",
        "OptionB": "100 miles per hour",
        "OptionC": "At least 1,000 miles per hour",
        "OptionD": "1 million miles per hour",
        "CorrectAnswer": "A",
        "Explanation": "\u0022A rocket needs enough fuel \u2013 and thrust \u2013 to speed up to at least 17,800 miles per hour.\u0022 \u2014 00:42"
      },
      "references": {
        "LessonId": "team.listening.b2.how-do-we-launch-things-into-space"
      }
    },
    {
