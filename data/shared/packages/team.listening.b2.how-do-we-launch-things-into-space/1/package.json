      "kind": "ListeningTranscriptLine",
      "values": {
        "OrderIndex": 20,
        "Speaker": "Narrator",
        "Text": "This is the best time to go to Mars, since it will require the least amount of fuel and time to get there.",
        "VietnameseMeaning": "\u0110\u00E2y l\u00E0 th\u1EDDi \u0111i\u1EC3m t\u1ED1t nh\u1EA5t \u0111\u1EC3 \u0111\u1EBFn Sao H\u1ECFa, v\u00EC khi \u0111\u00F3 c\u1EA7n \u00EDt nhi\u00EAn li\u1EC7u v\u00E0 th\u1EDDi gian nh\u1EA5t \u0111\u1EC3 t\u1EDBi n\u01A1i.",
        "StartTime": 124.6,
