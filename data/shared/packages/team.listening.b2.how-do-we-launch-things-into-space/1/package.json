      "kind": "ListeningQuizQuestion",
      "values": {
        "OrderIndex": 2,
        "QuestionText": "What is propellant?",
        "OptionA": "Fuel burned by a rocket",
        "OptionB": "A kind of metal",
        "OptionC": "A type of satellite",
        "OptionD": "A planet",
        "CorrectAnswer": "A",
        "Explanation": "\u0022However, a rocket burns fuel \u2013 called propellant \u2013 to push away from Earth and against gravity.\u0022 \u2014 00:33"
