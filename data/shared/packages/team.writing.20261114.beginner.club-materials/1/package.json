      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 2,
        "VietnameseText": "\u0110\u00E2y l\u00E0 bu\u1ED5i sinh ho\u1EA1t \u0111\u1EA7u ti\u00EAn c\u1EE7a em \u1EDF c\u00E2u l\u1EA1c b\u1ED9.",
