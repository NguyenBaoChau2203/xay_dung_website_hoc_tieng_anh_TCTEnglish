      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 6,
        "VietnameseText": "Bu\u1ED5i sinh ho\u1EA1t s\u1EBD di\u1EC5n ra \u1EDF ph\u00F2ng m\u1EF9 thu\u1EADt ph\u1EA3i kh\u00F4ng \u1EA1?",
