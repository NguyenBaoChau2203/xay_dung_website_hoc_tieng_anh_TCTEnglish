      }
    },
    {
      "key": "team.writing.20261114.beginner.cooking-soup.3dbaaa6345504386bb345acc313e34b3",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 5,
        "VietnameseText": "Ch\u00FAng t\u00F4i n\u1EA5u th\u00EAm m\u1ED9t l\u00FAc v\u00E0 cho v\u00E0o m\u1ED9t \u00EDt mu\u1ED1i.",
        "EnglishMeaning": "We cooked it a little longer and added some salt.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.beginner.cooking-soup"
      }
    },
    {
      "key": "team.writing.20261114.beginner.cooking-soup.5a52c34569bd433abee9159c6040907a",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 7,
        "VietnameseText": "T\u00F4i r\u1EA5t vui d\u00F9 m\u00F3n s\u00FAp ch\u01B0a th\u1EADt ho\u00E0n h\u1EA3o.",
        "EnglishMeaning": "I was very happy even though the soup was not perfect.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.beginner.cooking-soup"
      }
    },
    {
      "key": "team.writing.20261114.beginner.cooking-soup.71e92c8d31c34177b97b695dd2d30684",
      "kind": "WritingAcceptedAnswer",
      "values": {
