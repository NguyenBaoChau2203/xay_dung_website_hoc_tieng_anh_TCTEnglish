  "version": 1,
  "dependsOn": [],
  "records": [
    {
      "key": "team.writing.20261114.intermediate.essays.05",
      "kind": "WritingExercise",
      "values": {
        "Title": "C\u00F3 n\u00EAn d\u1EA1y k\u1EF9 n\u0103ng ph\u1EA3n h\u1ED3i trong l\u1EDBp?",
        "Level": "intermediate",
        "ContentType": "essays",
        "Topic": "Giao ti\u1EBFp",
        "SourceType": "original-20261114",
        "PreviewText": "B\u00E0i lu\u1EADn gi\u1EA3i th\u00EDch gi\u00E1 tr\u1ECB c\u1EE7a ph\u1EA3n h\u1ED3i c\u1EE5 th\u1EC3 v\u00E0 c\u00E1ch luy\u1EC7n t\u1EADp c\u00F3 h\u01B0\u1EDBng d\u1EABn.",
        "IsPublished": true
      },
      "references": {}
    },
    {
      "key": "team.writing.20261114.intermediate.essays.05.0c12693f9aeb4b0494b40895f73f85be",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 2,
        "VietnameseText": "C\u00E1c em th\u01B0\u1EDDng \u0111\u01B0\u1EE3c y\u00EAu c\u1EA7u l\u00E0m vi\u1EC7c nh\u00F3m nh\u01B0ng \u00EDt \u0111\u01B0\u1EE3c h\u01B0\u1EDBng d\u1EABn c\u00E1ch g\u00F3p \u00FD.",
        "EnglishMeaning": "They are often asked to work in groups but receive little guidance on giving comments.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.essays.05"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.essays.05.2deda38856874a968a36a3a0807b6508",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 7,
        "VietnameseText": "Ng\u01B0\u1EDDi nh\u1EADn c\u00F3 th\u1EC3 h\u1ECFi l\u1EA1i tr\u01B0\u1EDBc khi quy\u1EBFt \u0111\u1ECBnh c\u00F3 s\u1EEDa b\u00E0i hay kh\u00F4ng.",
        "EnglishMeaning": "The recipient can ask questions before deciding whether to revise their work.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.essays.05"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.essays.05.3da0f1f3dc9f4d3b9a507961a90209be",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 12,
        "VietnameseText": "K\u1EF9 n\u0103ng n\u00E0y s\u1EBD gi\u00FAp c\u00E1c em h\u1EE3p t\u00E1c t\u1ED1t h\u01A1n c\u1EA3 trong tr\u01B0\u1EDDng l\u1EABn sau n\u00E0y.",
        "EnglishMeaning": "This skill will help them cooperate more effectively both at school and later in life.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.essays.05"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.essays.05.4aabb334e3574ccca7d900a295155276",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 1,
        "VietnameseText": "T\u00F4i cho r\u1EB1ng h\u1ECDc sinh n\u00EAn \u0111\u01B0\u1EE3c h\u1ECDc c\u00E1ch \u0111\u01B0a v\u00E0 nh\u1EADn ph\u1EA3n h\u1ED3i trong l\u1EDBp.",
        "EnglishMeaning": "I believe students should learn how to give and receive feedback in class.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.essays.05"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.essays.05.6648c678759f421d8a614ec89ea8b7ec",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 10,
        "VietnameseText": "L\u1EDBp n\u00EAn b\u1EAFt \u0111\u1EA7u b\u1EB1ng v\u00ED d\u1EE5 \u0111\u01A1n gi\u1EA3n v\u00E0 nh\u1EEFng quy t\u1EAFc chung v\u1EC1 s\u1EF1 t\u00F4n tr\u1ECDng.",
        "EnglishMeaning": "The class should begin with simple examples and shared rules about respect.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.essays.05"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.essays.05.81f4adc7d1cc4355bd1b3a62fc7a826f",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 3,
        "VietnameseText": "V\u00EC th\u1EBF, m\u1ED9t l\u1EDDi nh\u1EADn x\u00E9t c\u00F3 th\u1EC3 qu\u00E1 chung chung ho\u1EB7c v\u00F4 t\u00ECnh l\u00E0m ng\u01B0\u1EDDi kh\u00E1c bu\u1ED3n.",
        "EnglishMeaning": "As a result, a comment may be too general or unintentionally upset someone.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.essays.05"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.essays.05.83761728292440c0b0d068b548ce6561",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 8,
        "VietnameseText": "\u0110i\u1EC1u \u0111\u00F3 t\u1EA1o ra cu\u1ED9c trao \u0111\u1ED5i thay v\u00EC m\u1ED9t danh s\u00E1ch l\u1ED7i m\u1ED9t chi\u1EC1u.",
        "EnglishMeaning": "This creates a conversation rather than a one-way list of mistakes.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.essays.05"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.essays.05.87921ae6225b484a97856d50da9ce379",
      "kind": "WritingAcceptedAnswer",
      "values": {
        "AnswerText": "Students should also know that they do not have to agree with every suggestion.",
        "NormalizedHash": "16f29a68dee89c7d2e11b71d5c1c493d4532398a8cf5df2606662b323aaf7393"
      },
      "references": {
        "WritingExerciseSentenceId": "team.writing.20261114.intermediate.essays.05.8867663645c4427ea684bda2f1b8a218",
        "ApprovedByUserId": "owner:system"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.essays.05.879eb13513dd4b26bb43cd19df8087e7",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 6,
        "VietnameseText": "L\u1EDDi khen c\u0169ng h\u1EEFu \u00EDch h\u01A1n khi gi\u1EA3i th\u00EDch ch\u00EDnh x\u00E1c \u0111i\u1EC1u g\u00EC \u0111\u00E3 hi\u1EC7u qu\u1EA3.",
        "EnglishMeaning": "Praise is also more useful when it explains exactly what worked well.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.essays.05"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.essays.05.8867663645c4427ea684bda2f1b8a218",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 11,
        "VietnameseText": "H\u1ECDc sinh c\u0169ng c\u1EA7n hi\u1EC3u r\u1EB1ng c\u00E1c em kh\u00F4ng bu\u1ED9c ph\u1EA3i \u0111\u1ED3ng \u00FD v\u1EDBi m\u1ECDi nh\u1EADn x\u00E9t.",
        "EnglishMeaning": "Students also need to understand that they are not obliged to accept every comment.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.essays.05"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.essays.05.e717c4d1c8f6465b8a1bd75bccb9442b",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 9,
        "VietnameseText": "T\u1EA5t nhi\u00EAn, gi\u00E1o vi\u00EAn c\u1EA7n theo d\u00F5i \u0111\u1EC3 vi\u1EC7c g\u00F3p \u00FD kh\u00F4ng tr\u1EDF th\u00E0nh ch\u00EA bai c\u00E1 nh\u00E2n.",
        "EnglishMeaning": "Of course, teachers need to ensure that feedback does not turn into personal criticism.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.essays.05"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.essays.05.fafd622cc3634564a0568e9400059afb",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 4,
        "VietnameseText": "Vi\u1EC7c luy\u1EC7n t\u1EADp s\u1EBD gi\u00FAp c\u00E1c em n\u00F3i r\u00F5 v\u1EA5n \u0111\u1EC1 m\u00E0 v\u1EABn t\u00F4n tr\u1ECDng ng\u01B0\u1EDDi nghe.",
        "EnglishMeaning": "Practice would help them explain a problem clearly while respecting the listener.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.essays.05"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.essays.05.fe15d5d592594a6bba02c5fb2f60b3a4",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 5,
        "VietnameseText": "Ch\u1EB3ng h\u1EA1n, nh\u1EADn x\u00E9t v\u1EC1 m\u1ED9t \u0111o\u1EA1n v\u0103n n\u00EAn ch\u1EC9 ra ch\u1ED7 ng\u01B0\u1EDDi \u0111\u1ECDc kh\u00F3 hi\u1EC3u.",
        "EnglishMeaning": "For instance, feedback on a paragraph should identify where the reader becomes confused.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.essays.05"
      }
    }
  ],
