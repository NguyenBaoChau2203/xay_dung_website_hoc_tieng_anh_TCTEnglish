  "version": 1,
  "dependsOn": [],
  "records": [
    {
      "key": "team.writing.20261114.intermediate.stories.04",
      "kind": "WritingExercise",
      "values": {
        "Title": "\u00C1nh \u0111\u00E8n sau c\u00E1nh g\u00E0",
        "Level": "intermediate",
        "ContentType": "stories",
        "Topic": "S\u00E2n kh\u1EA5u",
        "SourceType": "original-20261114",
        "PreviewText": "Truy\u1EC7n v\u1EC1 s\u1EF1 c\u1ED1 tr\u01B0\u1EDBc bu\u1ED5i di\u1EC5n v\u00E0 c\u00E1ch m\u1ED9t th\u00E0nh vi\u00EAn h\u1EADu tr\u01B0\u1EDDng gi\u00FAp c\u1EA3 nh\u00F3m.",
        "IsPublished": true
      },
      "references": {}
    },
    {
      "key": "team.writing.20261114.intermediate.stories.04.1bf3ec937ca14f54a74a727b7d37744f",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 3,
        "VietnameseText": "Thay v\u00EC t\u1EF1 th\u00E1o m\u00E1y, anh ch\u1EA1y \u0111i b\u00E1o cho ng\u01B0\u1EDDi k\u1EF9 thu\u1EADt.",
        "EnglishMeaning": "Instead of taking the equipment apart himself, he went to tell the technician.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.stories.04"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.stories.04.20ad7235009c4d38a1df594aee339349",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 1,
        "VietnameseText": "M\u01B0\u1EDDi ph\u00FAt tr\u01B0\u1EDBc bu\u1ED5i di\u1EC5n, Qu\u00E2n ph\u00E1t hi\u1EC7n chi\u1EBFc \u0111\u00E8n ch\u00EDnh kh\u00F4ng b\u1EADt l\u00EAn.",
        "EnglishMeaning": "Ten minutes before the performance, Quan discovered that the main light would not turn on.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.stories.04"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.stories.04.27f8f68f7def4e67a0a2470705c50d4b",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 5,
        "VietnameseText": "Ph\u01B0\u01A1ng \u00E1n \u0111\u00F3 ch\u1EC9 c\u00F3 hai \u0111\u00E8n nh\u1ECF, n\u00EAn c\u1EA3nh m\u1EDF \u0111\u1EA7u ph\u1EA3i thay \u0111\u1ED5i.",
        "EnglishMeaning": "That plan used only two small lights, so the opening scene had to change.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.stories.04"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.stories.04.34963803148541db882cb7a6cbbb3415",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 11,
        "VietnameseText": "Sau m\u00E0n ch\u00E0o cu\u1ED1i, \u0111\u1EA1o di\u1EC5n g\u1ECDi Qu\u00E2n ra c\u00F9ng nh\u1EADn tr\u00E0ng v\u1ED7 tay.",
        "EnglishMeaning": "After the final bow, the director called Quan out to share the applause.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.stories.04"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.stories.04.39812293ca1d4257b52bd4fc6fc436fa",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 9,
        "VietnameseText": "C\u1EA3 nh\u00F3m th\u1EED nhanh m\u1ED9t l\u1EA7n tr\u01B0\u1EDBc khi ti\u1EBFng chu\u00F4ng b\u00E1o b\u1EAFt \u0111\u1EA7u vang l\u00EAn.",
        "EnglishMeaning": "The group tried it once before the bell signalled the start of the performance.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.stories.04"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.stories.04.6b6aa4623b224ddb9ae6f7bacfd72d3f",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 2,
        "VietnameseText": "Anh ph\u1EE5 tr\u00E1ch \u0111\u1EA1o c\u1EE5 v\u00E0 ch\u01B0a t\u1EEBng x\u1EED l\u00FD thi\u1EBFt b\u1ECB chi\u1EBFu s\u00E1ng tr\u01B0\u1EDBc \u0111\u00F3.",
        "EnglishMeaning": "He was responsible for props and had never handled the lighting equipment before.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.stories.04"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.stories.04.8d50875916ae4abfb32738df05d3ea1d",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 7,
        "VietnameseText": "Qu\u00E2n nh\u1EDB c\u00F3 m\u1ED9t t\u1EA5m b\u1EA3ng tr\u1EAFng trong kho m\u00E0 h\u1ECD \u0111\u00E3 d\u00F9ng \u0111\u1EC3 t\u1EADp.",
        "EnglishMeaning": "Quan remembered a white board in storage that they had used during rehearsals.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.stories.04"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.stories.04.909b80abe07b4aca900238d88921a9d8",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 6,
        "VietnameseText": "Di\u1EC5n vi\u00EAn ch\u00EDnh lo kh\u00E1n gi\u1EA3 s\u1EBD kh\u00F4ng th\u1EA5y r\u00F5 chi\u1EBFc b\u1EA3n \u0111\u1ED3 quan tr\u1ECDng.",
        "EnglishMeaning": "The lead actor worried that the audience would not see the important map clearly.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.stories.04"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.stories.04.ba88bff40a9b462c81675284eeadd1b4",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 12,
        "VietnameseText": "Anh v\u1EABn th\u00EDch \u0111\u1EE9ng sau c\u00E1nh g\u00E0, nh\u01B0ng gi\u1EDD hi\u1EC3u r\u1EB1ng c\u00F4ng vi\u1EC7c c\u1EE7a m\u00ECnh c\u0169ng t\u1EA1o kh\u00E1c bi\u1EC7t.",
        "EnglishMeaning": "He still preferred staying backstage, but now understood that his work made a difference too.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.stories.04"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.stories.04.e24b81accef447fe8c3f67761c05688f",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 4,
        "VietnameseText": "Ng\u01B0\u1EDDi k\u1EF9 thu\u1EADt ki\u1EC3m tra r\u1ED3i n\u00F3i h\u1ECD c\u1EA7n d\u00F9ng ph\u01B0\u01A1ng \u00E1n d\u1EF1 ph\u00F2ng.",
        "EnglishMeaning": "The technician checked it and said they would need to use the backup plan.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.stories.04"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.stories.04.e766c0f18c9e4041b8cb730868c22ab5",
      "kind": "WritingAcceptedAnswer",
      "values": {
        "AnswerText": "Following the final bow, the director invited Quan onstage to receive applause with the others.",
        "NormalizedHash": "0524f70b5ad366dd6ffdddb83d9db991e7c00d4a764384867f9b316c48e63360"
      },
      "references": {
        "WritingExerciseSentenceId": "team.writing.20261114.intermediate.stories.04.34963803148541db882cb7a6cbbb3415",
        "ApprovedByUserId": "owner:system"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.stories.04.e8e3a5f188e34342987fc98cd3ea411c",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 8,
        "VietnameseText": "Anh \u0111\u1EC1 ngh\u1ECB \u0111\u1EB7t b\u1EA3n \u0111\u1ED3 l\u00EAn \u0111\u00F3 v\u00E0 \u0111\u01B0a n\u00F3 g\u1EA7n ph\u00EDa tr\u01B0\u1EDBc s\u00E2n kh\u1EA5u.",
        "EnglishMeaning": "He suggested placing the map on it and moving it towards the front of the stage.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.stories.04"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.stories.04.ffc424dce5414966bad4b6f78ebb50f5",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 10,
        "VietnameseText": "Bu\u1ED5i di\u1EC5n di\u1EC5n ra su\u00F4n s\u1EBB, v\u00E0 kh\u00F4ng ai trong kh\u00E1n ph\u00F2ng bi\u1EBFt v\u1EC1 s\u1EF1 c\u1ED1.",
        "EnglishMeaning": "The performance went smoothly, and nobody in the audience knew about the problem.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.stories.04"
      }
    }
  ],
