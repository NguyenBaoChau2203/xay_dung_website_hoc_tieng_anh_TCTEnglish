  "records": [
    {
      "key": "team.writing.20261114.beginner.small-stage",
      "kind": "WritingExercise",
      "values": {
        "Title": "Ti\u1EBFng h\u00E1t trong h\u1ED9i tr\u01B0\u1EDDng",
        "Level": "beginner",
        "ContentType": "stories",
        "Topic": "T\u1EF1 tin",
        "SourceType": "original-20261114",
        "PreviewText": "C\u00E2u chuy\u1EC7n v\u1EC1 m\u1ED9t b\u1EA1n nh\u1ECF v\u01B0\u1EE3t qua s\u1EF1 h\u1ED3i h\u1ED9p.",
        "IsPublished": true
      },
      "references": {}
    },
    {
      "key": "team.writing.20261114.beginner.small-stage.56adfb22864c45a69a3e461bf52126ab",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 6,
        "VietnameseText": "C\u1EADu h\u00EDt th\u1EDF ch\u1EADm r\u1ED3i nh\u1EDB l\u1EA1i giai \u0111i\u1EC7u quen thu\u1ED9c.",
        "EnglishMeaning": "He took a slow breath and remembered the familiar tune.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.beginner.small-stage"
      }
    },
    {
      "key": "team.writing.20261114.beginner.small-stage.6a07f64e924f4e959546831de774daeb",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 8,
        "VietnameseText": "Sau bu\u1ED5i di\u1EC5n, c\u1EADu c\u1EA3m \u01A1n em g\u00E1i v\u00EC n\u1EE5 c\u01B0\u1EDDi \u1EA5y.",
        "EnglishMeaning": "After the show, he thanked his sister for that smile.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.beginner.small-stage"
      }
    },
    {
      "key": "team.writing.20261114.beginner.small-stage.8f22efc567b44a44aeef791c82d0bde5",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 4,
        "VietnameseText": "Trong h\u1ED9i tr\u01B0\u1EDDng, m\u1ECDi ng\u01B0\u1EDDi im l\u1EB7ng ch\u1EDD c\u1EADu b\u1EAFt \u0111\u1EA7u.",
        "EnglishMeaning": "In the hall, everyone waited quietly for him to begin.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.beginner.small-stage"
      }
    },
    {
      "key": "team.writing.20261114.beginner.small-stage.9535f3139cf44ed9880598d4fd972a67",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 5,
        "VietnameseText": "An nh\u00ECn th\u1EA5y em g\u00E1i m\u1EC9m c\u01B0\u1EDDi \u1EDF h\u00E0ng gh\u1EBF \u0111\u1EA7u.",
        "EnglishMeaning": "An saw his sister smiling in the front row.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.beginner.small-stage"
      }
    },
    {
      "key": "team.writing.20261114.beginner.small-stage.9fb6aff9ab624100a35b27009d5659dc",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 2,
        "VietnameseText": "\u1EDE nh\u00E0, c\u1EADu h\u00E1t r\u1EA5t to tr\u01B0\u1EDBc m\u1EB7t em g\u00E1i.",
        "EnglishMeaning": "At home, he sang loudly in front of his younger sister.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.beginner.small-stage"
      }
    },
    {
      "key": "team.writing.20261114.beginner.small-stage.dcae59cff48942d38e198d9c34edca52",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 1,
        "VietnameseText": "An t\u1EADp m\u1ED9t b\u00E0i h\u00E1t ng\u1EAFn cho ng\u00E0y h\u1ED9i c\u1EE7a tr\u01B0\u1EDDng.",
        "EnglishMeaning": "An practised a short song for the school festival.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.beginner.small-stage"
      }
    },
    {
      "key": "team.writing.20261114.beginner.small-stage.e786e16f197f4a38a922ff54c51bd252",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 3,
        "VietnameseText": "Nh\u01B0ng khi b\u01B0\u1EDBc l\u00EAn s\u00E2n kh\u1EA5u, c\u1EADu qu\u00EAn m\u1EA5t c\u00E2u \u0111\u1EA7u ti\u00EAn.",
        "EnglishMeaning": "But when he stepped onto the stage, he forgot the first line.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.beginner.small-stage"
      }
    },
    {
      "key": "team.writing.20261114.beginner.small-stage.eee65f404aa64e8fb8bb53d36ef53594",
      "kind": "WritingAcceptedAnswer",
      "values": {
        "AnswerText": "An saw his sister smiling in the first row.",
        "NormalizedHash": "eff75ec42380834e596001c4b543d5eab9f2582912712e0af74ccc543e4d98b3"
      },
      "references": {
        "WritingExerciseSentenceId": "team.writing.20261114.beginner.small-stage.9535f3139cf44ed9880598d4fd972a67",
        "ApprovedByUserId": "owner:system"
      }
    },
    {
      "key": "team.writing.20261114.beginner.small-stage.f0bf6cce73574fd2882f04465b8c1270",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 7,
        "VietnameseText": "L\u1EA7n n\u00E0y, c\u1EADu h\u00E1t tr\u1ECDn b\u00E0i v\u00E0 nh\u1EADn \u0111\u01B0\u1EE3c ti\u1EBFng v\u1ED7 tay.",
        "EnglishMeaning": "This time, he sang the whole song and received applause.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.beginner.small-stage"
      }
    }
  ],
