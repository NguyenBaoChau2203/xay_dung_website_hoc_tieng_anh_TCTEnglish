      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 6,
        "VietnameseText": "H\u1ECD \u0111\u1EB7t c\u00E1c ng\u00F4i sao quanh \u0111\u0129a b\u00E1nh th\u1EADt c\u1EA9n th\u1EADn.",
        "EnglishMeaning": "They carefully placed the stars around the cake plate.",
        "BreakAfter": false
