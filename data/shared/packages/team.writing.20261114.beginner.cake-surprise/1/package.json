      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 7,
        "VietnameseText": "M\u1EB9 b\u1EADt c\u01B0\u1EDDi khi th\u1EA5y chi\u1EBFc b\u00E1nh v\u00E0 nh\u1EEFng l\u1EDDi ch\u00FAc vi\u1EBFt tay.",
        "EnglishMeaning": "Their mother laughed when she saw the cake and handwritten wishes.",
