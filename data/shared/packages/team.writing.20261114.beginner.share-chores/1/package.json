      }
    },
    {
      "key": "team.writing.20261114.beginner.share-chores.9380b2da75e1480a8663f917785ab92f",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 4,
        "VietnameseText": "Nh\u1EEFng ng\u01B0\u1EDDi l\u1EDBn h\u01A1n c\u00F3 th\u1EC3 r\u1EEDa b\u00E1t v\u00E0 chu\u1EA9n b\u1ECB b\u1EEFa t\u1ED1i.",
        "EnglishMeaning": "Older family members can wash dishes and prepare dinner.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.beginner.share-chores"
      }
    },
    {
      "key": "team.writing.20261114.beginner.share-chores.f5a9fad29a214ad7856b4a427d0151dd",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 3,
        "VietnameseText": "Tr\u1EBB nh\u1ECF c\u00F3 th\u1EC3 c\u1EA5t \u0111\u1ED3 ch\u01A1i ho\u1EB7c x\u1EBFp gi\u00E0y g\u1ECDn g\u00E0ng.",
        "EnglishMeaning": "Young children can put away toys or arrange shoes neatly.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.beginner.share-chores"
      }
    }
