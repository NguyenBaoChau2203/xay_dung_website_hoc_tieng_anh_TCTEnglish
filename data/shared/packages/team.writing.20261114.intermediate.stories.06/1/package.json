  "records": [
    {
      "key": "team.writing.20261114.intermediate.stories.06",
      "kind": "WritingExercise",
      "values": {
        "Title": "T\u1EA5m v\u00E9 v\u00E0 ng\u01B0\u1EDDi kh\u00E1ch cu\u1ED1i",
        "Level": "intermediate",
        "ContentType": "stories",
        "Topic": "T\u00ECnh hu\u1ED1ng \u0111\u1EDDi th\u01B0\u1EDDng",
        "SourceType": "original-20261114",
        "PreviewText": "Truy\u1EC7n v\u1EC1 m\u1ED9t m\u00F3n \u0111\u1ED3 \u0111\u00E1nh r\u01A1i v\u00E0 l\u1EF1a ch\u1ECDn gi\u00FAp ng\u01B0\u1EDDi kh\u00E1c tr\u01B0\u1EDBc chuy\u1EBFn xe.",
        "IsPublished": true
      },
      "references": {}
    },
    {
      "key": "team.writing.20261114.intermediate.stories.06.059f8d0e63b7415aa95494e65ec1f679",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 12,
        "VietnameseText": "Chuy\u1EBFn \u0111i b\u1EAFt \u0111\u1EA7u ch\u1EADm h\u01A1n anh mong \u0111\u1EE3i, nh\u01B0ng cu\u1ED9c tr\u00F2 chuy\u1EC7n khi\u1EBFn \u0111\u01B0\u1EDDng v\u1EC1 ng\u1EAFn l\u1EA1i.",
        "EnglishMeaning": "The journey began more slowly than he had hoped, but the conversation made it seem shorter.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.stories.06"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.stories.06.3aab307425ec4d78b645644928aa42d9",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 8,
        "VietnameseText": "B\u00E0 ki\u1EC3m tra th\u00F4ng tin r\u1ED3i th\u1EDF ph\u00E0o v\u00EC t\u01B0\u1EDFng m\u00ECnh \u0111\u00E3 ph\u1EA3i mua l\u1EA1i v\u00E9.",
        "EnglishMeaning": "She checked the details and sighed with relief, having thought she would need another ticket.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.stories.06"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.stories.06.706d8c4abe684d73aec8d06dc2633633",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 1,
        "VietnameseText": "Khi \u0111ang \u0111\u1EE3i xe kh\u00E1ch, H\u1EA3i th\u1EA5y m\u1ED9t t\u1EA5m v\u00E9 r\u01A1i c\u1EA1nh gh\u1EBF.",
        "EnglishMeaning": "While waiting for his coach, Hai noticed a ticket lying beside a seat.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.stories.06"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.stories.06.7a536b44848b469c8ae4f0aecd1a5f34",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 5,
        "VietnameseText": "Anh kh\u00F4ng mu\u1ED1n b\u1ECF h\u00E0nh l\u00FD n\u00EAn nh\u1EDD nh\u00E2n vi\u00EAn g\u1EA7n \u0111\u00F3 gi\u00FAp.",
        "EnglishMeaning": "He did not want to leave his luggage unattended, so he asked a nearby employee for help.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.stories.06"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.stories.06.814b1c1f5d4c4efe936b57bd3e272de0",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 4,
        "VietnameseText": "H\u1EA3i nh\u1EB7t v\u00E9 l\u00EAn v\u00E0 g\u1ECDi, nh\u01B0ng ti\u1EBFng loa \u0111\u00E3 \u00E1t m\u1EA5t gi\u1ECDng anh.",
        "EnglishMeaning": "Hai picked up the ticket and called, but an announcement drowned out his voice.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.stories.06"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.stories.06.85d9dbeef58b40e08bcb789502c870b4",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 9,
        "VietnameseText": "H\u1EA3i quay l\u1EA1i gh\u1EBF th\u00EC th\u1EA5y h\u00E0ng ch\u1EDD chuy\u1EBFn xe c\u1EE7a m\u00ECnh \u0111\u00E3 d\u00E0i h\u01A1n.",
        "EnglishMeaning": "Hai returned to his seat and found that the queue for his coach had grown.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.stories.06"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.stories.06.905f186c4ad043129f4656bb8e5e1b18",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 2,
        "VietnameseText": "Chuy\u1EBFn xe ghi tr\u00EAn v\u00E9 s\u1EBD kh\u1EDFi h\u00E0nh tr\u01B0\u1EDBc chuy\u1EBFn c\u1EE7a anh ch\u1EC9 m\u01B0\u1EDDi ph\u00FAt.",
        "EnglishMeaning": "The departure shown on it was only ten minutes before his own coach.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.stories.06"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.stories.06.a1929c40ef7b4eb1be1fa2fb0248325d",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 11,
        "VietnameseText": "Tr\u00EAn gh\u1EBF c\u00F3 m\u1ED9t cu\u1ED1n s\u00E1ch m\u00E0 ng\u01B0\u1EDDi kh\u00E1ch b\u00EAn c\u1EA1nh vui v\u1EBB \u0111\u1EC1 ngh\u1ECB cho anh \u0111\u1ECDc c\u00F9ng.",
        "EnglishMeaning": "On the seat was a book that the passenger beside him happily offered to share.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.stories.06"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.stories.06.abc991dbf9c74bd18be5ae3a6c6bb554",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 6,
        "VietnameseText": "Nh\u00E2n vi\u00EAn \u0111\u01B0a anh \u0111\u1EBFn b\u00E0n h\u01B0\u1EDBng d\u1EABn v\u00E0 ph\u00E1t th\u00F4ng b\u00E1o t\u00ECm ch\u1EE7 v\u00E9.",
        "EnglishMeaning": "The employee took him to the information desk and announced that a ticket had been found.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.stories.06"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.stories.06.baae53401cea42729e8f6b1bf8aece6a",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 3,
        "VietnameseText": "M\u1ED9t ng\u01B0\u1EDDi ph\u1EE5 n\u1EEF v\u1EEBa r\u1EDDi gh\u1EBF \u0111\u00F3 \u0111ang v\u1ED9i \u0111i v\u1EC1 ph\u00EDa qu\u1EA7y b\u00E1n \u0111\u1ED3.",
        "EnglishMeaning": "A woman who had just left that seat was hurrying towards the snack counter.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.stories.06"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.stories.06.c9ad9fac9aee4188b0de57cce2c51d62",
      "kind": "WritingAcceptedAnswer",
      "values": {
        "AnswerText": "Although the trip started more slowly than he expected, talking made the journey feel shorter.",
        "NormalizedHash": "8eade2b179834ab687e5bcb4f99205c8cd553cf8173cf348939b645cf4f68722"
      },
      "references": {
        "WritingExerciseSentenceId": "team.writing.20261114.intermediate.stories.06.059f8d0e63b7415aa95494e65ec1f679",
        "ApprovedByUserId": "owner:system"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.stories.06.dac5670159cd477fb58dd9522f982429",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 10,
        "VietnameseText": "Anh l\u00EAn xe g\u1EA7n cu\u1ED1i v\u00E0 ch\u1EC9 c\u00F2n m\u1ED9t ch\u1ED7 tr\u1ED1ng \u1EDF h\u00E0ng sau.",
        "EnglishMeaning": "He boarded near the end and found just one empty seat in the back row.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.stories.06"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.stories.06.f883e0fb26f4460c820b6dca7fdde484",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 7,
        "VietnameseText": "Ng\u01B0\u1EDDi ph\u1EE5 n\u1EEF ch\u1EA1y \u0111\u1EBFn khi chuy\u1EBFn xe c\u1EE7a b\u00E0 b\u1EAFt \u0111\u1EA7u \u0111\u00F3n nh\u1EEFng kh\u00E1ch cu\u1ED1i.",
        "EnglishMeaning": "The woman arrived as her coach began boarding its last passengers.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.stories.06"
      }
    }
  ],
