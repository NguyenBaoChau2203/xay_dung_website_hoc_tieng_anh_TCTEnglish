    {
      "key": "team.writing.20261114.beginner.return-umbrella.6752fa72c3984d97be145094a1e1a342",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 2,
        "VietnameseText": "Tr\u1EDDi m\u01B0a r\u1EA5t to khi m\u00ECnh r\u1EDDi l\u1EDBp h\u1ECDc ti\u1EBFng Anh.",
        "EnglishMeaning": "It rained heavily when I left my English class.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.beginner.return-umbrella"
      }
    },
    {
      "key": "team.writing.20261114.beginner.return-umbrella.d86d1b4685fc48c4b50faace722e8dd7",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 1,
        "VietnameseText": "Ch\u00E0o Mai, c\u1EA3m \u01A1n b\u1EA1n \u0111\u00E3 cho m\u00ECnh m\u01B0\u1EE3n \u00F4 h\u00F4m qua.",
        "EnglishMeaning": "Hi Mai, thank you for lending me your umbrella yesterday.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.beginner.return-umbrella"
      }
    },
    {
      "key": "team.writing.20261114.beginner.return-umbrella.ee10eacb82bf40ae9f615bb61f5475bc",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 8,
        "VietnameseText": "Mong s\u1EDBm g\u1EB7p l\u1EA1i b\u1EA1n, v\u00E0 m\u1ED9t l\u1EA7n n\u1EEFa c\u1EA3m \u01A1n b\u1EA1n nh\u00E9.",
        "EnglishMeaning": "See you soon, and thanks again for your help.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.beginner.return-umbrella"
      }
    },
    {
      "key": "team.writing.20261114.beginner.return-umbrella.f48760b47fa74afda09ad68b5ba7ecf1",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 5,
        "VietnameseText": "M\u00ECnh c\u00F3 th\u1EC3 tr\u1EA3 \u00F4 cho b\u1EA1n sau gi\u1EDD h\u1ECDc ng\u00E0y mai kh\u00F4ng?",
        "EnglishMeaning": "Can I return it to you after school tomorrow?",
        "BreakAfter": false
      },
      "references": {
