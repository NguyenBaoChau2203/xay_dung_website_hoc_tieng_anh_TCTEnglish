      }
    },
    {
      "key": "team.writing.20261114.beginner.garden-visit.1653fe1f361e42a7809b3346196cedce",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 4,
        "VietnameseText": "Sau \u0111\u00F3, h\u1ECDc sinh quan s\u00E1t c\u00E1ch t\u01B0\u1EDBi n\u01B0\u1EDBc v\u00E0o g\u1ED1c c\u00E2y.",
        "EnglishMeaning": "Then the students watched how to water the plants at their roots.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.beginner.garden-visit"
      }
    },
    {
      "key": "team.writing.20261114.beginner.garden-visit.527deed94ad544f5a2c188609d9d0495",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 2,
        "VietnameseText": "L\u1EDBp \u0111\u1EBFn khu v\u01B0\u1EDDn v\u00E0o l\u00FAc ch\u00EDn gi\u1EDD s\u00E1ng th\u1EE9 Hai.",
        "EnglishMeaning": "The class arrived at the garden at nine on Monday morning.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.beginner.garden-visit"
      }
    },
    {
      "key": "team.writing.20261114.beginner.garden-visit.691087cea9284759a1212578e0fc49b1",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 8,
        "VietnameseText": "C\u1EA3 l\u1EDBp r\u1EDDi v\u01B0\u1EDDn \u0111\u00FAng gi\u1EDD v\u00E0 mang r\u00E1c theo v\u1EC1.",
        "EnglishMeaning": "The class left on time and took their rubbish with them.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.beginner.garden-visit"
      }
    },
    {
      "key": "team.writing.20261114.beginner.garden-visit.6962496d1afd48018733b1f4b1dfd30f",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 7,
        "VietnameseText": "Gi\u00E1o vi\u00EAn \u0111\u1EC1 ngh\u1ECB ki\u1EC3m tra \u0111\u1ED3 d\u00F9ng tr\u01B0\u1EDBc chuy\u1EBFn \u0111i ti\u1EBFp theo.",
        "EnglishMeaning": "The teacher suggested checking supplies before the next trip.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.beginner.garden-visit"
      }
    },
    {
