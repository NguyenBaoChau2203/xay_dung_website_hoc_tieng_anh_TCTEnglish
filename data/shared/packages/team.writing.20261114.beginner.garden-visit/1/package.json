      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 5,
        "VietnameseText": "M\u1ED7i nh\u00F3m ghi l\u1EA1i hai \u0111i\u1EC1u m\u1EDBi h\u1ECDc \u0111\u01B0\u1EE3c trong s\u1ED5.",
