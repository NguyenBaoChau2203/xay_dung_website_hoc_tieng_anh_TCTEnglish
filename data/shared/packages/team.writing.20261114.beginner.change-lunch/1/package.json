      "values": {
        "Title": "\u0110\u1ED5i gi\u1EDD \u0103n tr\u01B0a",
        "Level": "beginner",
        "ContentType": "emails",
        "Topic": "H\u1EB9n g\u1EB7p",
        "SourceType": "original-20261114",
        "PreviewText": "Email xin \u0111\u1ED5i gi\u1EDD h\u1EB9n v\u00E0 \u0111\u1EC1 xu\u1EA5t \u0111\u1ECBa \u0111i\u1EC3m r\u00F5 r\u00E0ng.",
        "IsPublished": true
      },
      "references": {}
    },
    {
      "key": "team.writing.20261114.beginner.change-lunch.2feb1e926f6b431e9c6ea2ff864a5a63",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 4,
        "VietnameseText": "Ch\u00FAng ta c\u00F3 th\u1EC3 \u0103n tr\u01B0a l\u00FAc m\u1ED9t gi\u1EDD \u0111\u01B0\u1EE3c kh\u00F4ng?",
        "EnglishMeaning": "Could we have lunch at one instead?",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.beginner.change-lunch"
      }
    },
    {
      "key": "team.writing.20261114.beginner.change-lunch.3e3c77c77f17472fbdc771242065d13e",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 8,
        "VietnameseText": "M\u00ECnh xin l\u1ED7i v\u00EC \u0111\u00E3 thay \u0111\u1ED5i k\u1EBF ho\u1EA1ch v\u00E0o ph\u00FAt ch\u00F3t.",
        "EnglishMeaning": "I am sorry for changing our plan at the last minute.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.beginner.change-lunch"
      }
    },
    {
      "key": "team.writing.20261114.beginner.change-lunch.48118c2dd43d416b8ebe210d92e25f57",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 1,
        "VietnameseText": "Ch\u00E0o Nam, m\u00ECnh vi\u1EBFt th\u01B0 \u0111\u1EC3 h\u1ECFi v\u1EC1 bu\u1ED5i \u0103n tr\u01B0a ng\u00E0y mai.",
        "EnglishMeaning": "Hi Nam, I am writing about our lunch tomorrow.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.beginner.change-lunch"
      }
    },
    {
      "key": "team.writing.20261114.beginner.change-lunch.95a8f6147f054c51a30251c9418edeae",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 3,
        "VietnameseText": "V\u00EC v\u1EADy, m\u00ECnh kh\u00F4ng th\u1EC3 g\u1EB7p b\u1EA1n l\u00FAc m\u01B0\u1EDDi hai gi\u1EDD.",
        "EnglishMeaning": "So I cannot meet you at twelve.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.beginner.change-lunch"
      }
    },
    {
      "key": "team.writing.20261114.beginner.change-lunch.a0751a021b6e4af8b4db8860ba1c4d0e",
      "kind": "WritingAcceptedAnswer",
      "values": {
        "AnswerText": "Could we eat lunch at one instead?",
        "NormalizedHash": "8023ff9dcaff43b11353265d4a8c3ff93cbe3018bdc96a531bdf71ce060fadd7"
      },
      "references": {
        "WritingExerciseSentenceId": "team.writing.20261114.beginner.change-lunch.2feb1e926f6b431e9c6ea2ff864a5a63",
        "ApprovedByUserId": "owner:system"
      }
    },
    {
      "key": "team.writing.20261114.beginner.change-lunch.b1ea765b812f4d5bbf1aa8fc4e8252c9",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 5,
        "VietnameseText": "Qu\u00E1n m\u00EC c\u1EA1nh tr\u01B0\u1EDDng v\u1EABn m\u1EDF c\u1EEDa v\u00E0o gi\u1EDD \u0111\u00F3.",
        "EnglishMeaning": "The noodle shop next to school is still open then.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.beginner.change-lunch"
      }
    },
    {
      "key": "team.writing.20261114.beginner.change-lunch.c60b86a032d446c38b61a4550c386a12",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 2,
        "VietnameseText": "Bu\u1ED5i h\u1ECDc c\u1EE7a m\u00ECnh s\u1EBD k\u1EBFt th\u00FAc mu\u1ED9n h\u01A1n th\u01B0\u1EDDng l\u1EC7.",
        "EnglishMeaning": "My class will finish later than usual.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.beginner.change-lunch"
      }
    },
    {
      "key": "team.writing.20261114.beginner.change-lunch.c88d5b93998d4388a9d95f46ee49acf5",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 7,
        "VietnameseText": "H\u00E3y cho m\u00ECnh bi\u1EBFt gi\u1EDD m\u1EDBi c\u00F3 ph\u00F9 h\u1EE3p v\u1EDBi b\u1EA1n kh\u00F4ng nh\u00E9.",
        "EnglishMeaning": "Please let me know if the new time works for you.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.beginner.change-lunch"
      }
    },
    {
      "key": "team.writing.20261114.beginner.change-lunch.e8ce2d8d038d42878737c24d2aebc544",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 6,
        "VietnameseText": "M\u00ECnh c\u00F3 th\u1EC3 \u0111\u1EBFn tr\u01B0\u1EDBc v\u00E0 gi\u1EEF m\u1ED9t b\u00E0n cho ch\u00FAng ta.",
        "EnglishMeaning": "I can arrive first and get a table for us.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.beginner.change-lunch"
      }
    }
