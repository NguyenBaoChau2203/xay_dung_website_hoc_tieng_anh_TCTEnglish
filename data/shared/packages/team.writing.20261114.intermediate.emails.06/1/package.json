  "records": [
    {
      "key": "team.writing.20261114.intermediate.emails.06",
      "kind": "WritingExercise",
      "values": {
        "Title": "X\u00E1c nh\u1EADn c\u00E1ch t\u1ED5 ch\u1EE9c bu\u1ED5i trao \u0111\u1ED5i s\u00E1ch",
        "Level": "intermediate",
        "ContentType": "emails",
        "Topic": "C\u1ED9ng \u0111\u1ED3ng",
        "SourceType": "original-20261114",
        "PreviewText": "Email x\u00E1c nh\u1EADn th\u1ECFa thu\u1EADn v\u00E0 l\u00E0m r\u00F5 tr\u00E1ch nhi\u1EC7m cho s\u1EF1 ki\u1EC7n \u0111\u1ED5i s\u00E1ch.",
        "IsPublished": true
      },
      "references": {}
    },
    {
      "key": "team.writing.20261114.intermediate.emails.06.2533d140acc94f479ad90e1673ee41bd",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 8,
        "VietnameseText": "Ch\u00FAng ta n\u00EAn \u0111\u1EC3 ri\u00EAng s\u00E1ch h\u1ECFng \u0111\u1EC3 tr\u00E1nh v\u00F4 t\u00ECnh \u0111\u01B0a ch\u00FAng l\u00EAn b\u00E0n.",
        "EnglishMeaning": "We should set damaged books aside to avoid accidentally putting them on the tables.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.emails.06"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.emails.06.258199ae333b430084eba8d3149e3b23",
      "kind": "WritingAcceptedAnswer",
      "values": {
        "AnswerText": "Please tell me if you understood any of the details differently.",
        "NormalizedHash": "a2a169bd143c78ed5801655340c8c953d2a38737ab2b44af30c3108bb5f49776"
      },
      "references": {
        "WritingExerciseSentenceId": "team.writing.20261114.intermediate.emails.06.462523feda3649609e8714462f76c266",
        "ApprovedByUserId": "owner:system"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.emails.06.2899c124f20640afb03ba217d487662c",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 2,
        "VietnameseText": "M\u00ECnh vi\u1EBFt th\u01B0 \u0111\u1EC3 x\u00E1c nh\u1EADn nh\u1EEFng vi\u1EC7c ch\u00FAng ta \u0111\u00E3 th\u1ED1ng nh\u1EA5t qua \u0111i\u1EC7n tho\u1EA1i.",
        "EnglishMeaning": "I am writing to confirm the arrangements we discussed on the phone.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.emails.06"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.emails.06.3c6d691f3c1f46088f92d465762b4f48",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 4,
        "VietnameseText": "Ch\u00FAng ta s\u1EBD c\u00F3 n\u1EEDa gi\u1EDD \u0111\u1EC3 s\u1EAFp x\u1EBFp b\u00E0n tr\u01B0\u1EDBc khi kh\u00E1ch \u0111\u1EBFn.",
        "EnglishMeaning": "We will have half an hour to arrange the tables before visitors arrive.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.emails.06"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.emails.06.3fa5f8083bb8429d86c697ea5bd70503",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 7,
        "VietnameseText": "M\u1ED7i ng\u01B0\u1EDDi c\u00F3 th\u1EC3 mang t\u1ED1i \u0111a n\u0103m cu\u1ED1n, mi\u1EC5n l\u00E0 s\u00E1ch c\u00F2n t\u1ED1t.",
        "EnglishMeaning": "Each person may bring up to five books, provided they are in good condition.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.emails.06"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.emails.06.43fccd5394374a1a8e702191e2d83c36",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 5,
        "VietnameseText": "Nh\u00F3m c\u1EE7a m\u00ECnh ph\u1EE5 tr\u00E1ch ti\u1EBFp nh\u1EADn s\u00E1ch v\u00E0 ph\u00E2n lo\u1EA1i theo \u0111\u1ED9 tu\u1ED5i.",
        "EnglishMeaning": "My team will receive the books and sort them by age group.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.emails.06"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.emails.06.462523feda3649609e8714462f76c266",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 11,
        "VietnameseText": "Xin h\u00E3y b\u00E1o n\u1EBFu c\u00F3 chi ti\u1EBFt n\u00E0o kh\u00E1c v\u1EDBi c\u00E1ch b\u1EA1n hi\u1EC3u.",
        "EnglishMeaning": "Please let me know if any details differ from your understanding.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.emails.06"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.emails.06.6c1daee2b6964831b17e43bc46e8ea11",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 1,
        "VietnameseText": "Ch\u00E0o Minh, c\u1EA3m \u01A1n b\u1EA1n \u0111\u00E3 \u0111\u1ED3ng \u00FD ph\u1ED1i h\u1EE3p t\u1ED5 ch\u1EE9c bu\u1ED5i trao \u0111\u1ED5i s\u00E1ch.",
        "EnglishMeaning": "Hi Minh, thank you for agreeing to help organise the book exchange.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.emails.06"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.emails.06.6f9329951d2544ff8428071dfcc25f77",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 10,
        "VietnameseText": "M\u00ECnh s\u1EBD mang nh\u00E3n gi\u1EA5y, nh\u01B0ng b\u1EA1n c\u00F3 th\u1EC3 chu\u1EA9n b\u1ECB th\u00EAm b\u00FAt vi\u1EBFt \u0111\u01B0\u1EE3c kh\u00F4ng?",
        "EnglishMeaning": "I will bring paper labels, but could you provide some extra pens?",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.emails.06"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.emails.06.795d5b5943f44a0b985239014f1c1c2d",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 12,
        "VietnameseText": "M\u00ECnh mong \u0111\u01B0\u1EE3c c\u00F9ng b\u1EA1n t\u1ED5 ch\u1EE9c m\u1ED9t bu\u1ED5i s\u00E1ng h\u1EEFu \u00EDch cho m\u1ECDi ng\u01B0\u1EDDi.",
        "EnglishMeaning": "I look forward to working with you on a useful morning for everyone.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.emails.06"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.emails.06.954997627adf406bae663d0b87b24813",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 9,
        "VietnameseText": "S\u00E1ch c\u00F2n l\u1EA1i s\u1EBD \u0111\u01B0\u1EE3c gi\u1EEF cho s\u1EF1 ki\u1EC7n sau n\u1EBFu ch\u1EE7 s\u00E1ch \u0111\u1ED3ng \u00FD.",
        "EnglishMeaning": "Any remaining books will be kept for the next event if their owners agree.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.emails.06"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.emails.06.96f1c91317fb491295c4ddf7e3d1e5f5",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 6,
        "VietnameseText": "Nh\u00F3m c\u1EE7a b\u1EA1n c\u00F3 th\u1EC3 h\u01B0\u1EDBng d\u1EABn kh\u00E1ch v\u00E0 gi\u1EA3i th\u00EDch c\u00E1ch trao \u0111\u1ED5i kh\u00F4ng?",
        "EnglishMeaning": "Could your team welcome visitors and explain how the exchange works?",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.emails.06"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.emails.06.f3b58036f57e4b2abede447a6f92817b",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 3,
        "VietnameseText": "S\u1EF1 ki\u1EC7n s\u1EBD b\u1EAFt \u0111\u1EA7u l\u00FAc ch\u00EDn gi\u1EDD s\u00E1ng Ch\u1EE7 nh\u1EADt t\u1EA1i h\u1ED9i tr\u01B0\u1EDDng khu ph\u1ED1.",
        "EnglishMeaning": "The event will start at nine on Sunday morning in the neighbourhood hall.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.emails.06"
      }
    }
  ],
