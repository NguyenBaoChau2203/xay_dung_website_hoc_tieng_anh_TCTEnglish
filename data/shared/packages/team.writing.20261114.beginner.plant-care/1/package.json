      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 7,
        "VietnameseText": "M\u00ECnh s\u1EBD v\u1EC1 v\u00E0o t\u1ED1i Ch\u1EE7 nh\u1EADt v\u00E0 g\u1ECDi cho b\u1EA1n.",
        "EnglishMeaning": "I will be back on Sunday evening and call you.",
