  "records": [
    {
      "key": "team.writing.20261114.intermediate.articles.05",
      "kind": "WritingExercise",
      "values": {
        "Title": "M\u1ED9t phi\u00EAn trao \u0111\u1ED5i k\u1EF9 n\u0103ng gi\u1EEFa h\u00E0ng x\u00F3m",
        "Level": "intermediate",
        "ContentType": "articles",
        "Topic": "C\u1ED9ng \u0111\u1ED3ng",
        "SourceType": "original-20261114",
        "PreviewText": "B\u00E0i vi\u1EBFt gi\u1EA3i th\u00EDch c\u00E1ch t\u1ED5 ch\u1EE9c bu\u1ED5i chia s\u1EBB k\u1EF9 n\u0103ng c\u00F3 ho\u1EA1t \u0111\u1ED9ng th\u1EF1c h\u00E0nh.",
        "IsPublished": true
      },
      "references": {}
    },
    {
      "key": "team.writing.20261114.intermediate.articles.05.04706797c073468391e103afdf6c01b9",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 6,
        "VietnameseText": "Nh\u00F3m nh\u1ECF s\u1EBD t\u1EA1o \u0111i\u1EC1u ki\u1EC7n cho ng\u01B0\u1EDDi tham gia \u0111\u1EB7t c\u00E2u h\u1ECFi v\u00E0 t\u1EF1 th\u1EF1c h\u00E0nh.",
        "EnglishMeaning": "Small groups give participants a chance to ask questions and practise for themselves.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.articles.05"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.articles.05.18bf654ee84848debc34788dc7b1b701",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 1,
        "VietnameseText": "M\u1ED9t bu\u1ED5i trao \u0111\u1ED5i k\u1EF9 n\u0103ng cho ph\u00E9p h\u00E0ng x\u00F3m h\u1ECDc \u0111i\u1EC1u h\u1EEFu \u00EDch t\u1EEB nhau.",
        "EnglishMeaning": "A skill-sharing session allows neighbours to learn something useful from one another.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.articles.05"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.articles.05.4e5c23ccedea4eb682a6ac361df0a7b8",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 12,
        "VietnameseText": "Khi tr\u00E1ch nhi\u1EC7m \u0111\u01B0\u1EE3c chia s\u1EBB, ho\u1EA1t \u0111\u1ED9ng s\u1EBD b\u1EDBt ph\u1EE5 thu\u1ED9c v\u00E0o m\u1ED9t ng\u01B0\u1EDDi duy nh\u1EA5t.",
        "EnglishMeaning": "When responsibilities are shared, the activity depends less on any single person.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.articles.05"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.articles.05.841af4b5b5c9414ba1aabcd0c455f7e1",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 2,
        "VietnameseText": "M\u1ED9t ng\u01B0\u1EDDi c\u00F3 th\u1EC3 h\u01B0\u1EDBng d\u1EABn kh\u00E2u c\u00FAc \u00E1o, trong khi ng\u01B0\u1EDDi kh\u00E1c ch\u1EC9 c\u00E1ch s\u1EEDa xe \u0111\u1EA1p.",
        "EnglishMeaning": "One person might demonstrate sewing a button, while another explains a bicycle repair.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.articles.05"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.articles.05.9085f5cda12f4d91b09acf52c6e5e13f",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 11,
        "VietnameseText": "Ban t\u1ED5 ch\u1EE9c c\u0169ng c\u00F3 th\u1EC3 ghi danh nh\u1EEFng ng\u01B0\u1EDDi mu\u1ED1n h\u1ED7 tr\u1EE3 l\u1EA7n sau.",
        "EnglishMeaning": "Organisers can also take the names of people willing to help next time.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.articles.05"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.articles.05.925d54cd705246fe97311529b0e8125c",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 9,
        "VietnameseText": "Cu\u1ED1i bu\u1ED5i, h\u00E3y d\u00E0nh th\u1EDDi gian \u0111\u1EC3 m\u1ECDi ng\u01B0\u1EDDi n\u00F3i \u0111i\u1EC1u g\u00EC c\u00F2n kh\u00F3.",
        "EnglishMeaning": "At the end, allow time for people to explain what they still find difficult.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.articles.05"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.articles.05.9be4adac2bf843c9a365fbccb4f14d15",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 7,
        "VietnameseText": "D\u1EE5ng c\u1EE5 c\u1EA7n \u0111\u01B0\u1EE3c chu\u1EA9n b\u1ECB tr\u01B0\u1EDBc, c\u00F9ng h\u01B0\u1EDBng d\u1EABn s\u1EED d\u1EE5ng an to\u00E0n ph\u00F9 h\u1EE3p.",
        "EnglishMeaning": "Tools should be prepared beforehand, together with suitable instructions for safe use.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.articles.05"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.articles.05.ae6461a3849e45909420c8aabb5766ea",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 10,
        "VietnameseText": "Nh\u1EEFng nh\u1EADn x\u00E9t \u0111\u00F3 s\u1EBD gi\u00FAp ng\u01B0\u1EDDi h\u01B0\u1EDBng d\u1EABn \u0111i\u1EC1u ch\u1EC9nh bu\u1ED5i ti\u1EBFp theo.",
        "EnglishMeaning": "Those comments will help demonstrators adapt the next session.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.articles.05"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.articles.05.b0099023412d48adb68fbb0243e8d247",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 5,
        "VietnameseText": "Ng\u01B0\u1EDDi h\u01B0\u1EDBng d\u1EABn n\u00EAn chia c\u00F4ng vi\u1EC7c th\u00E0nh c\u00E1c b\u01B0\u1EDBc m\u00E0 ng\u01B0\u1EDDi m\u1EDBi c\u00F3 th\u1EC3 l\u00E0m theo.",
        "EnglishMeaning": "Demonstrators should divide each task into steps that beginners can follow.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.articles.05"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.articles.05.b3a649f10ca24b3cbd11ab994f2aa20e",
      "kind": "WritingAcceptedAnswer",
      "values": {
        "AnswerText": "That feedback will help the people teaching improve the following session.",
        "NormalizedHash": "cc23012d9738a892e5f0a549edcb07b01a0b6d0428ed07b2c75795b669adc5c9"
      },
      "references": {
        "WritingExerciseSentenceId": "team.writing.20261114.intermediate.articles.05.ae6461a3849e45909420c8aabb5766ea",
        "ApprovedByUserId": "owner:system"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.articles.05.bbe140f7254149fd8572561eba85a91b",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 4,
        "VietnameseText": "Ch\u1EC9 ch\u1ECDn hai ho\u1EA1t \u0111\u1ED9ng cho bu\u1ED5i \u0111\u1EA7u s\u1EBD gi\u00FAp vi\u1EC7c chu\u1EA9n b\u1ECB d\u1EC5 h\u01A1n.",
        "EnglishMeaning": "Selecting just two activities for the first session makes preparation easier.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.articles.05"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.articles.05.c436f83c43854588a5b0eaa7ba6e19e6",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 3,
        "VietnameseText": "\u0110\u1EC3 b\u1EAFt \u0111\u1EA7u, ban t\u1ED5 ch\u1EE9c n\u00EAn h\u1ECFi c\u01B0 d\u00E2n mu\u1ED1n h\u1ECDc v\u00E0 c\u00F3 th\u1EC3 d\u1EA1y \u0111i\u1EC1u g\u00EC.",
        "EnglishMeaning": "To begin, organisers should ask residents what they want to learn and can teach.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.articles.05"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.articles.05.fcbb4829836a4ea9af7ef9cb1b15525d",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 8,
        "VietnameseText": "N\u1EBFu m\u1ED9t k\u1EF9 n\u0103ng c\u1EA7n chuy\u00EAn m\u00F4n, bu\u1ED5i chia s\u1EBB kh\u00F4ng n\u00EAn thay th\u1EBF d\u1ECBch v\u1EE5 chuy\u00EAn nghi\u1EC7p.",
        "EnglishMeaning": "If a skill requires expertise, the session should not replace a professional service.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.articles.05"
      }
    }
  ],
