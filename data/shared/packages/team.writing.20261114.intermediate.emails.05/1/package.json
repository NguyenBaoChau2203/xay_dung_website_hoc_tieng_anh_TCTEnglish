  "dependsOn": [],
  "records": [
    {
      "key": "team.writing.20261114.intermediate.emails.05",
      "kind": "WritingExercise",
      "values": {
        "Title": "Xin g\u00F3p \u00FD cho b\u1EA3n thi\u1EBFt k\u1EBF \u00E1p ph\u00EDch",
        "Level": "intermediate",
        "ContentType": "emails",
        "Topic": "S\u1EF1 ki\u1EC7n",
        "SourceType": "original-20261114",
        "PreviewText": "Email xin ph\u1EA3n h\u1ED3i c\u1EE5 th\u1EC3 v\u00E0 gi\u1EA3i th\u00EDch c\u00E1ch d\u00F9ng g\u00F3p \u00FD tr\u01B0\u1EDBc khi in.",
        "IsPublished": true
      },
      "references": {}
    },
    {
      "key": "team.writing.20261114.intermediate.emails.05.1311af18758f4785bb91e74e6b8af549",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 3,
        "VietnameseText": "V\u00EC th\u1EBF, ch\u00FAng em ch\u1ECDn m\u1ED9t \u1EA3nh l\u1EDBn v\u00E0 \u0111\u1EB7t th\u00F4ng tin ch\u00EDnh \u1EDF ph\u00EDa d\u01B0\u1EDBi.",
        "EnglishMeaning": "We have therefore chosen one large photograph and placed the main information underneath.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.emails.05"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.emails.05.2739d232ee65408581ad8a2446686c22",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 9,
        "VietnameseText": "H\u1EA1n g\u1EEDi b\u1EA3n cu\u1ED1i l\u00E0 chi\u1EC1u th\u1EE9 T\u01B0, nh\u01B0ng ch\u00FAng em v\u1EABn c\u00F2n th\u1EDDi gian ch\u1EC9nh s\u1EEDa.",
        "EnglishMeaning": "The final design is due on Wednesday afternoon, but we still have time for changes.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.emails.05"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.emails.05.280c31dfb8f84c968636074ec5eb4549",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 7,
        "VietnameseText": "\u1EA2nh nh\u1ECF th\u1EE9 hai c\u00F3 th\u1EC3 l\u00E0m b\u1ED1 c\u1EE5c ch\u1EADt h\u01A1n, n\u00EAn ch\u00FAng em \u0111ang c\u00E2n nh\u1EAFc b\u1ECF \u1EA3nh \u0111\u00F3.",
        "EnglishMeaning": "The second small photograph may crowd the layout, so we are considering removing it.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.emails.05"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.emails.05.3b9d54748abe42a8b5afaefd1eb66488",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 1,
        "VietnameseText": "Ch\u00E0o c\u00F4 H\u01B0\u01A1ng, em \u0111\u00E3 \u0111\u00EDnh k\u00E8m b\u1EA3n thi\u1EBFt k\u1EBF \u0111\u1EA7u ti\u00EAn cho \u00E1p ph\u00EDch tri\u1EC3n l\u00E3m.",
        "EnglishMeaning": "Hello Ms Huong, I have attached the first design for the exhibition poster.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.emails.05"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.emails.05.44a5fc29f27e406bb83f26b7fea78b6c",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 11,
        "VietnameseText": "Ch\u00FAng em s\u1EBD t\u1ED5ng h\u1EE3p g\u00F3p \u00FD v\u00E0 g\u1EEDi l\u1EA1i m\u1ED9t b\u1EA3n \u0111\u1EC3 c\u00F4 x\u00E1c nh\u1EADn.",
        "EnglishMeaning": "We will combine the suggestions and send you another version for confirmation.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.emails.05"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.emails.05.5c868a74e3fe49e9ba047b47a3208c62",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 10,
        "VietnameseText": "C\u00F4 vui l\u00F2ng g\u1EEDi nh\u1EADn x\u00E9t tr\u01B0\u1EDBc t\u1ED1i th\u1EE9 Ba n\u1EBFu thu\u1EADn ti\u1EC7n.",
        "EnglishMeaning": "Please send your comments by Tuesday evening if that is convenient.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.emails.05"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.emails.05.5d400874f6674ef4b2a879341b60ac7c",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 6,
        "VietnameseText": "Ch\u00FAng em c\u0169ng ch\u01B0a ch\u1EAFc m\u00E0u ch\u1EEF c\u00F3 d\u1EC5 \u0111\u1ECDc t\u1EEB xa hay kh\u00F4ng.",
        "EnglishMeaning": "We are also unsure whether the text colour is easy to read from a distance.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.emails.05"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.emails.05.618879cdceca4eeda221fad363ca9650",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 12,
        "VietnameseText": "Em c\u1EA3m \u01A1n c\u00F4 \u0111\u00E3 gi\u00FAp nh\u00F3m chu\u1EA9n b\u1ECB m\u1ED9t \u00E1p ph\u00EDch r\u00F5 r\u00E0ng v\u00E0 h\u1EA5p d\u1EABn.",
        "EnglishMeaning": "Thank you for helping our group prepare a clear and attractive poster.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.emails.05"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.emails.05.6bf6e38e801e478a9d50fe1c285a3f94",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 8,
        "VietnameseText": "N\u1EBFu c\u00F4 \u0111\u1ED3ng \u00FD, ch\u00FAng em s\u1EBD d\u00F9ng kho\u1EA3ng tr\u1ED1ng \u0111\u00F3 cho \u0111\u01B0\u1EDDng d\u1EABn \u0111\u0103ng k\u00FD.",
        "EnglishMeaning": "If you agree, we will use that space for the registration link.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.emails.05"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.emails.05.8818e714f2ac49498800bf4b5be3e1a0",
      "kind": "WritingAcceptedAnswer",
      "values": {
        "AnswerText": "If possible, please send your feedback by Tuesday evening.",
        "NormalizedHash": "8bdd6de0022783d8a413a8f466517870879c8cbf31a643912aacaf4949f4b3f1"
      },
      "references": {
        "WritingExerciseSentenceId": "team.writing.20261114.intermediate.emails.05.5c868a74e3fe49e9ba047b47a3208c62",
        "ApprovedByUserId": "owner:system"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.emails.05.9df1835bcaf54314b6c6ea78824d3de6",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 4,
        "VietnameseText": "Tr\u01B0\u1EDBc khi g\u1EEDi \u0111i in, ch\u00FAng em r\u1EA5t mong nh\u1EADn \u0111\u01B0\u1EE3c g\u00F3p \u00FD c\u1EE7a c\u00F4.",
        "EnglishMeaning": "Before sending it to the printer, we would really appreciate your feedback.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.emails.05"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.emails.05.c017e496c2fa455480cc16235466a84d",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 2,
        "VietnameseText": "Nh\u00F3m mu\u1ED1n nh\u1EA5n m\u1EA1nh c\u00E1c t\u00E1c ph\u1EA9m c\u1EE7a h\u1ECDc sinh thay v\u00EC d\u00F9ng qu\u00E1 nhi\u1EC1u ch\u1EEF.",
        "EnglishMeaning": "Our group wants to highlight the students\u0027 work instead of using too much text.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.emails.05"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.emails.05.fb6ff13587b644e3a47c260fc5a2fd9d",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 5,
        "VietnameseText": "C\u00F4 c\u00F3 th\u1EC3 ki\u1EC3m tra xem ng\u00E0y gi\u1EDD v\u00E0 \u0111\u1ECBa \u0111i\u1EC3m \u0111\u00E3 \u0111\u1EE7 r\u00F5 ch\u01B0a kh\u00F4ng \u1EA1?",
        "EnglishMeaning": "Could you check whether the date, time and location are clear enough, please?",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.emails.05"
      }
    }
  ],
