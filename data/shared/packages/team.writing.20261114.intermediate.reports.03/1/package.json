        "ApprovedByUserId": "owner:system"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.reports.03.f1f5dee4e524445292cc50c533fec6d2",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 1,
        "VietnameseText": "B\u1EA3n b\u00E1o c\u00E1o m\u00F4 t\u1EA3 ph\u1EA3n h\u1ED3i trong m\u1ED9t ng\u00E0y h\u1ED9i \u0111\u1ECBnh h\u01B0\u1EDBng gi\u1EA3 \u0111\u1ECBnh cho sinh vi\u00EAn m\u1EDBi.",
        "EnglishMeaning": "This report describes feedback from a fictional orientation event for new students.",
        "BreakAfter": false
      },
      "references": {
