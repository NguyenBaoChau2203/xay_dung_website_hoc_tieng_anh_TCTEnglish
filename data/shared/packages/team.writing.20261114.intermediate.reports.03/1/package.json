  "records": [
    {
      "key": "team.writing.20261114.intermediate.reports.03",
      "kind": "WritingExercise",
      "values": {
        "Title": "Ph\u1EA3n h\u1ED3i sau ng\u00E0y h\u1ED9i \u0111\u1ECBnh h\u01B0\u1EDBng",
        "Level": "intermediate",
        "ContentType": "reports",
        "Topic": "S\u1EF1 ki\u1EC7n h\u1ECDc t\u1EADp",
        "SourceType": "original-20261114",
        "PreviewText": "B\u00E1o c\u00E1o gi\u1EA3 \u0111\u1ECBnh v\u1EC1 m\u1EE9c h\u1EEFu \u00EDch, ch\u1EC9 d\u1EABn \u0111\u1ECBa \u0111i\u1EC3m v\u00E0 \u0111\u1EC1 xu\u1EA5t cho ng\u00E0y h\u1ED9i ti\u1EBFp theo.",
        "IsPublished": true
      },
      "references": {}
    },
    {
      "key": "team.writing.20261114.intermediate.reports.03.0d754193b0864f9b8e2ed4174798a18c",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 11,
        "VietnameseText": "L\u1EA7n sau n\u00EAn d\u00E0nh kho\u1EA3ng ngh\u1EC9 d\u00E0i h\u01A1n gi\u1EEFa nh\u1EEFng ho\u1EA1t \u0111\u1ED9ng \u1EDF xa nhau.",
        "EnglishMeaning": "Next time, longer breaks should separate activities that take place far apart.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.reports.03"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.reports.03.1adb1fa2ab0b4c17a818f04b6c449578",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 4,
        "VietnameseText": "Nh\u1EADn x\u00E9t \u0111\u01B0\u1EE3c t\u1ED5ng h\u1EE3p m\u00E0 kh\u00F4ng g\u1EAFn v\u1EDBi t\u00EAn c\u1EE7a ng\u01B0\u1EDDi tr\u1EA3 l\u1EDDi.",
        "EnglishMeaning": "Comments were summarised without being linked to the names of respondents.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.reports.03"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.reports.03.218c27f7c5f149228c868663b91656da",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 9,
        "VietnameseText": "Ban t\u1ED5 ch\u1EE9c n\u00EAn th\u00EAm s\u1ED1 t\u1EA7ng v\u00E0o m\u1ECDi b\u1EA3ng ch\u1EC9 d\u1EABn v\u00E0 th\u01B0 m\u1EDDi.",
        "EnglishMeaning": "Organisers should add floor numbers to all signs and invitations.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.reports.03"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.reports.03.229eaf3d543b487c931f1d57b234881e",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 5,
        "VietnameseText": "Ba m\u01B0\u01A1i ng\u01B0\u1EDDi \u0111\u00E1nh gi\u00E1 ph\u1EA7n gi\u1EDBi thi\u1EC7u d\u1ECBch v\u1EE5 h\u1ED7 tr\u1EE3 l\u00E0 h\u1EEFu \u00EDch nh\u1EA5t.",
        "EnglishMeaning": "Thirty people rated the introduction to support services as the most useful part.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.reports.03"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.reports.03.271d101dde934ecc94e82389a7866aa0",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 12,
        "VietnameseText": "Do kh\u00F4ng ph\u1EA3i m\u1ECDi ng\u01B0\u1EDDi \u0111\u1EC1u tr\u1EA3 l\u1EDDi, s\u1ED1 li\u1EC7u gi\u1EA3 \u0111\u1ECBnh ch\u1EC9 ph\u1EA3n \u00E1nh nh\u00F3m tham gia kh\u1EA3o s\u00E1t.",
        "EnglishMeaning": "Since not everyone responded, the fictional figures reflect only the surveyed group.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.reports.03"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.reports.03.2ae11e80f2b84b22a86c668d648c662c",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 2,
        "VietnameseText": "Ban t\u1ED5 ch\u1EE9c gi\u1EA3 \u0111\u1ECBnh nh\u1EADn \u0111\u01B0\u1EE3c b\u1ED1n m\u01B0\u01A1i phi\u1EBFu tr\u1EA3 l\u1EDDi sau s\u1EF1 ki\u1EC7n.",
        "EnglishMeaning": "In this scenario, organisers received forty response forms after the event.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.reports.03"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.reports.03.2beee63e5bb84cb09ad6dce628e99c99",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 7,
        "VietnameseText": "Tuy nhi\u00EAn, m\u01B0\u1EDDi hai ng\u01B0\u1EDDi \u0111\u00E3 \u0111\u1EBFn tr\u1EC5 m\u1ED9t ho\u1EA1t \u0111\u1ED9ng do \u0111\u1ECDc nh\u1EA7m s\u01A1 \u0111\u1ED3.",
        "EnglishMeaning": "However, twelve arrived late for an activity because they misread the map.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.reports.03"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.reports.03.592aaeee4226496b88b57a3ca0e5f73a",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 10,
        "VietnameseText": "M\u1ED9t b\u00E0n h\u01B0\u1EDBng d\u1EABn g\u1EA7n l\u1ED1i v\u00E0o c\u0169ng c\u00F3 th\u1EC3 gi\u00FAp kh\u00E1ch ki\u1EC3m tra l\u1ECBch.",
        "EnglishMeaning": "An information desk near the entrance could also help visitors check their schedules.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.reports.03"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.reports.03.82536f02afc845b7a9201422780c49fc",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 6,
        "VietnameseText": "C\u00E1c chuy\u1EBFn tham quan nh\u00F3m nh\u1ECF c\u0169ng \u0111\u01B0\u1EE3c khen v\u00EC c\u00F3 th\u1EDDi gian \u0111\u1EB7t c\u00E2u h\u1ECFi.",
        "EnglishMeaning": "Small-group tours were also praised because they allowed time for questions.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.reports.03"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.reports.03.aec35ba0385f453fadad5c16dc94cb8e",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 8,
        "VietnameseText": "Hai ph\u00F2ng c\u00F3 t\u00EAn g\u1EA7n gi\u1ED1ng nhau khi\u1EBFn m\u1ED9t s\u1ED1 ng\u01B0\u1EDDi \u0111i sai t\u1EA7ng.",
        "EnglishMeaning": "Two rooms with similar names caused some participants to go to the wrong floor.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.reports.03"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.reports.03.e01dc1b235414b2bad46ebfb37fa83ff",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 3,
        "VietnameseText": "Phi\u1EBFu h\u1ECFi v\u1EC1 m\u1EE9c h\u1EEFu \u00EDch c\u1EE7a ho\u1EA1t \u0111\u1ED9ng v\u00E0 m\u1EE9c d\u1EC5 t\u00ECm \u0111\u1ECBa \u0111i\u1EC3m.",
        "EnglishMeaning": "The forms asked about the activities\u0027 usefulness and how easily participants could find venues.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.reports.03"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.reports.03.ef235024f92445a3b6c5f511d6368fb5",
      "kind": "WritingAcceptedAnswer",
      "values": {
        "AnswerText": "Floor numbers should be included on every sign and invitation by the organisers.",
        "NormalizedHash": "ee55bab8599512429fcba18d6429256dc98b162ae3e40f3b1abf5130d4c41727"
      },
      "references": {
