  "records": [
    {
      "key": "team.writing.20261114.intermediate.emails.04",
      "kind": "WritingExercise",
      "values": {
        "Title": "B\u00E0n giao c\u00F4ng vi\u1EC7c tr\u01B0\u1EDBc k\u1EF3 ngh\u1EC9",
        "Level": "intermediate",
        "ContentType": "emails",
        "Topic": "C\u00F4ng vi\u1EC7c",
        "SourceType": "original-20261114",
        "PreviewText": "Email b\u00E0n giao t\u00ECnh tr\u1EA1ng c\u00F4ng vi\u1EC7c, t\u00E0i li\u1EC7u v\u00E0 \u0111\u1EA7u m\u1ED1i x\u1EED l\u00FD.",
        "IsPublished": true
      },
      "references": {}
    },
    {
      "key": "team.writing.20261114.intermediate.emails.04.0fab00ca574549e38e524bb09e73df5d",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 3,
        "VietnameseText": "Tuy nhi\u00EAn, nh\u00F3m thi\u1EBFt k\u1EBF v\u1EABn \u0111ang \u0111i\u1EC1u ch\u1EC9nh hai h\u00ECnh \u1EA3nh cho trang cu\u1ED1i.",
        "EnglishMeaning": "However, the design team is still adjusting two images for the final page.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.emails.04"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.emails.04.1c987069d7914a2b84eae003e897eb4a",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 4,
        "VietnameseText": "H\u1ECD \u0111\u00E3 h\u1EE9a g\u1EEDi b\u1EA3n c\u1EADp nh\u1EADt tr\u01B0\u1EDBc tr\u01B0a th\u1EE9 Ba \u0111\u1EC3 ch\u00FAng ta ki\u1EC3m tra.",
        "EnglishMeaning": "They have promised to send the updates before Tuesday lunchtime for us to check.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.emails.04"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.emails.04.2e0889a7301b44c1a342e0e71cb4ff6b",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 10,
        "VietnameseText": "Ch\u1ECB \u1EA5y bi\u1EBFt k\u1EBF ho\u1EA1ch v\u00E0 s\u1EBD c\u00F3 m\u1EB7t trong su\u1ED1t tu\u1EA7n t\u1EDBi.",
        "EnglishMeaning": "She is familiar with the plan and will be available throughout next week.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.emails.04"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.emails.04.3f1c15a4167d41168628df8de4ffa61b",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 7,
        "VietnameseText": "B\u1EA1n kh\u00F4ng c\u1EA7n vi\u1EBFt l\u1EA1i ph\u1EA7n gi\u1EDBi thi\u1EC7u v\u00EC ch\u1ECB Hoa \u0111\u00E3 duy\u1EC7t ph\u1EA7n \u0111\u00F3.",
        "EnglishMeaning": "You do not need to rewrite the introduction because Hoa has already approved it.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.emails.04"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.emails.04.439e3f742c30481aa636f36036d7c90f",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 9,
        "VietnameseText": "\u0110\u1ED1i v\u1EDBi y\u00EAu c\u1EA7u kh\u1EA9n c\u1EA5p t\u1EEB kh\u00E1ch h\u00E0ng, b\u1EA1n h\u00E3y li\u00EAn h\u1EC7 tr\u1EF1c ti\u1EBFp v\u1EDBi ch\u1ECB Hoa thay v\u00EC ch\u1EDD m\u00ECnh.",
        "EnglishMeaning": "For urgent customer requests, please contact Hoa directly rather than waiting for me.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.emails.04"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.emails.04.6a54ab13b7ef499cbb0de36e7bdaf49a",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 1,
        "VietnameseText": "Ch\u00E0o Linh, m\u00ECnh g\u1EEDi b\u1EA1n th\u00F4ng tin b\u00E0n giao tr\u01B0\u1EDBc khi ngh\u1EC9 ph\u00E9p tu\u1EA7n t\u1EDBi.",
        "EnglishMeaning": "Hi Linh, I am sending you the handover details before my leave next week.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.emails.04"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.emails.04.72aa7cb72004472bbfc110f9f7199a9f",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 6,
        "VietnameseText": "N\u1EBFu c\u00F3 t\u00EAn b\u1ECB sai ch\u00EDnh t\u1EA3, h\u00E3y nh\u1EDD nh\u00F3m thi\u1EBFt k\u1EBF s\u1EEDa tr\u01B0\u1EDBc khi xu\u1EA5t b\u1EA3n.",
        "EnglishMeaning": "If any names are misspelled, ask the design team to correct them before publication.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.emails.04"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.emails.04.8582adebad7a4b8d9cef31094479a45d",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 2,
        "VietnameseText": "M\u00ECnh \u0111\u00E3 ho\u00E0n th\u00E0nh b\u1EA3n d\u1EF1 th\u1EA3o b\u1EA3n tin v\u00E0 l\u01B0u trong th\u01B0 m\u1EE5c chung.",
        "EnglishMeaning": "I have finished the newsletter draft and saved it in the shared folder.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.emails.04"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.emails.04.8d11659e78df4c4b8157e7eb15f81ec2",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 5,
        "VietnameseText": "Khi nh\u1EADn \u0111\u01B0\u1EE3c h\u00ECnh \u1EA3nh, b\u1EA1n vui l\u00F2ng ki\u1EC3m tra ch\u00FA th\u00EDch v\u1EDBi b\u1EA3n danh s\u00E1ch \u0111\u00EDnh k\u00E8m.",
        "EnglishMeaning": "When the images arrive, please check the captions against the attached list.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.emails.04"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.emails.04.b2edbf3aa21440728191ca83096f770c",
      "kind": "WritingAcceptedAnswer",
      "values": {
        "AnswerText": "Thanks for monitoring the remaining tasks during my absence.",
        "NormalizedHash": "cbb2a158785f57f7ca0792c090eb0abb5dde977d4f6619d5f28adee5fdd85422"
      },
      "references": {
        "WritingExerciseSentenceId": "team.writing.20261114.intermediate.emails.04.d30c0a67f5fc46cea41a3f711d1b2220",
        "ApprovedByUserId": "owner:system"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.emails.04.d30c0a67f5fc46cea41a3f711d1b2220",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 11,
        "VietnameseText": "C\u1EA3m \u01A1n b\u1EA1n \u0111\u00E3 gi\u00FAp m\u00ECnh theo d\u00F5i nh\u1EEFng vi\u1EC7c c\u00F2n l\u1EA1i trong th\u1EDDi gian m\u00ECnh v\u1EAFng m\u1EB7t.",
        "EnglishMeaning": "Thank you for helping me keep track of the remaining tasks while I am away.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.emails.04"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.emails.04.f2331b5ae4b64a1e8a8b59ebba8f00b2",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 8,
        "VietnameseText": "M\u00ECnh c\u0169ng \u0111\u00E3 \u0111\u1EB7t l\u1ECBch g\u1EEDi, nh\u01B0ng l\u1ECBch n\u00E0y c\u00F3 th\u1EC3 \u0111\u1ED5i n\u1EBFu c\u1EA7n.",
        "EnglishMeaning": "I have also scheduled the delivery, although the timing can be changed if necessary.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.emails.04"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.emails.04.fda78dd5442a4e3598e970c64b25157f",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 12,
        "VietnameseText": "M\u00ECnh s\u1EBD \u0111\u1ECDc b\u1EA3n tin sau khi tr\u1EDF l\u1EA1i v\u00E0 ti\u1EBFp t\u1EE5c x\u1EED l\u00FD c\u00E1c ph\u1EA3n h\u1ED3i.",
        "EnglishMeaning": "I will read the newsletter when I return and follow up on the feedback.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.emails.04"
      }
    }
  ],
