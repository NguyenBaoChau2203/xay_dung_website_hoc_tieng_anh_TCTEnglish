      }
    },
    {
      "key": "team.writing.20261114.intermediate.reports.06.af9d98ccfbda4cdb8f6c88bd1464fe82",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 12,
        "VietnameseText": "K\u1EBFt qu\u1EA3 gi\u1EA3 \u0111\u1ECBnh c\u1EA7n \u0111\u01B0\u1EE3c ki\u1EC3m tra qua bu\u1ED5i ti\u1EBFp theo tr\u01B0\u1EDBc khi thay \u0111\u1ED5i to\u00E0n b\u1ED9 ch\u01B0\u01A1ng tr\u00ECnh.",
        "EnglishMeaning": "The fictional findings should be checked in another session before changing the entire programme.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.reports.06"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.reports.06.c684dccfc9b343dfad1b7f195beef1cb",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 7,
        "VietnameseText": "S\u00E1u ng\u01B0\u1EDDi c\u00F2n l\u1EA1i nh\u1EA7m gi\u1EEFa m\u1EE5c tr\u1EE3 gi\u00FAp k\u1EF9 thu\u1EADt v\u00E0 m\u1EE5c y\u00EAu c\u1EA7u ngh\u1EC9 ph\u00E9p.",
        "EnglishMeaning": "The remaining six confused the technical help section with the leave request section.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.reports.06"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.reports.06.e1f91e28471f47e3914f83d9dd851b33",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 2,
        "VietnameseText": "Trong t\u00ECnh hu\u1ED1ng n\u00E0y, m\u01B0\u1EDDi s\u00E1u ng\u01B0\u1EDDi tham gia bu\u1ED5i h\u01B0\u1EDBng d\u1EABn k\u00E9o d\u00E0i hai gi\u1EDD.",
        "EnglishMeaning": "In this scenario, sixteen people attended a session lasting two hours.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.reports.06"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.reports.06.f3d45ec8f47f4942bee3cbd66b64de5b",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 1,
        "VietnameseText": "B\u00E1o c\u00E1o n\u00E0y \u0111\u00E1nh gi\u00E1 m\u1ED9t bu\u1ED5i gi\u1EDBi thi\u1EC7u gi\u1EA3 \u0111\u1ECBnh d\u00E0nh cho nh\u00E2n vi\u00EAn m\u1EDBi.",
        "EnglishMeaning": "This report evaluates a fictional introductory session for new employees.",
