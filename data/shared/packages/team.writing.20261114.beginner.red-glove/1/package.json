    },
    {
      "key": "team.writing.20261114.beginner.red-glove.b25c18e9d71d4658bf634a24de691dfd",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 7,
        "VietnameseText": "Em m\u1EC9m c\u01B0\u1EDDi v\u00E0 \u0111eo ngay chi\u1EBFc g\u0103ng v\u00E0o tay ph\u1EA3i.",
        "EnglishMeaning": "He smiled and put the glove on his right hand at once.",
        "BreakAfter": false
      },
      "references": {
