  "records": [
    {
      "key": "team.writing.20261114.beginner.red-glove",
      "kind": "WritingExercise",
      "values": {
        "Title": "Chi\u1EBFc g\u0103ng tay m\u00E0u \u0111\u1ECF",
        "Level": "beginner",
        "ContentType": "stories",
        "Topic": "Gi\u00FAp \u0111\u1EE1",
        "SourceType": "original-20261114",
        "PreviewText": "C\u00E2u chuy\u1EC7n v\u1EC1 m\u1ED9t \u0111\u1ED3 v\u1EADt nh\u1ECF t\u00ECm \u0111\u01B0\u1EE3c ch\u1EE7 nh\u00E2n.",
        "IsPublished": true
      },
      "references": {}
    },
    {
      "key": "team.writing.20261114.beginner.red-glove.0e74da0da562465c996f9d5929feb347",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 4,
        "VietnameseText": "M\u1ED9t em b\u00E9 \u0111ang \u0111\u1EE9ng c\u00F9ng b\u1ED1 \u1EDF ph\u00EDa b\u00EAn kia \u0111\u01B0\u1EDDng.",
        "EnglishMeaning": "A small child was standing with his father across the road.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.beginner.red-glove"
      }
    },
    {
      "key": "team.writing.20261114.beginner.red-glove.2bb03733e6124a4bba32605dc22859f7",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 5,
        "VietnameseText": "Em ch\u1EC9 \u0111eo m\u1ED9t chi\u1EBFc g\u0103ng tay \u0111\u1ECF tr\u00EAn tay tr\u00E1i.",
        "EnglishMeaning": "He was wearing only one red glove on his left hand.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.beginner.red-glove"
      }
    },
    {
      "key": "team.writing.20261114.beginner.red-glove.391e879ecd7443f1a089c419ea99e9b5",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 3,
        "VietnameseText": "H\u00E0 nh\u1EB7t n\u00F3 l\u00EAn v\u00E0 nh\u00ECn quanh t\u00ECm ng\u01B0\u1EDDi \u0111\u00E1nh r\u01A1i.",
        "EnglishMeaning": "Ha picked it up and looked around for its owner.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.beginner.red-glove"
      }
    },
    {
      "key": "team.writing.20261114.beginner.red-glove.577fe9ae2e9647b5b4b4977762eeb465",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 6,
        "VietnameseText": "H\u00E0 ch\u1EDD \u0111\u00E8n xanh r\u1ED3i mang chi\u1EBFc g\u0103ng sang cho em.",
        "EnglishMeaning": "Ha waited for the green light and took the glove to him.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.beginner.red-glove"
      }
    },
    {
      "key": "team.writing.20261114.beginner.red-glove.58e02fc09cdc4358b54de1e8298665c4",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 2,
        "VietnameseText": "N\u00F3 n\u1EB1m c\u1EA1nh m\u1ED9t chi\u1EBFc gh\u1EBF d\u00E0i \u1EDF tr\u1EA1m xe bu\u00FDt.",
        "EnglishMeaning": "It was beside a bench at the bus stop.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.beginner.red-glove"
      }
    },
    {
      "key": "team.writing.20261114.beginner.red-glove.74571c09abd04e7d8945d13ead96f47f",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 8,
        "VietnameseText": "H\u00E0 ti\u1EBFp t\u1EE5c \u0111\u1EBFn tr\u01B0\u1EDDng v\u1EDBi m\u1ED9t ni\u1EC1m vui nh\u1ECF trong l\u00F2ng.",
        "EnglishMeaning": "Ha continued to school with a little happiness in her heart.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.beginner.red-glove"
      }
    },
    {
      "key": "team.writing.20261114.beginner.red-glove.862effd372de471c9b043f6b1005bb98",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 1,
        "VietnameseText": "Tr\u00EAn \u0111\u01B0\u1EDDng \u0111\u1EBFn tr\u01B0\u1EDDng, H\u00E0 nh\u00ECn th\u1EA5y m\u1ED9t chi\u1EBFc g\u0103ng tay \u0111\u1ECF.",
        "EnglishMeaning": "On her way to school, Ha saw a red glove.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.beginner.red-glove"
      }
    },
    {
      "key": "team.writing.20261114.beginner.red-glove.a0aa94920dec40949674c9d3516b0863",
      "kind": "WritingAcceptedAnswer",
      "values": {
        "AnswerText": "Ha waited until the light turned green and took the glove to him.",
        "NormalizedHash": "97817521f2f1888661836be7212a3d0c986a5eaa4439a8fb81f8d0c38ba8410c"
      },
      "references": {
