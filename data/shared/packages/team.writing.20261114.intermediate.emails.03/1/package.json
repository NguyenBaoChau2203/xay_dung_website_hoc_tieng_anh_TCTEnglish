  "records": [
    {
      "key": "team.writing.20261114.intermediate.emails.03",
      "kind": "WritingExercise",
      "values": {
        "Title": "M\u1EDDi ng\u01B0\u1EDDi h\u01B0\u1EDBng d\u1EABn tham gia bu\u1ED5i ngh\u1EC1 nghi\u1EC7p",
        "Level": "intermediate",
        "ContentType": "emails",
        "Topic": "Ngh\u1EC1 nghi\u1EC7p",
        "SourceType": "original-20261114",
        "PreviewText": "Email m\u1EDDi kh\u00E1ch chia s\u1EBB kinh nghi\u1EC7m v\u00E0 trao \u0111\u1ED5i y\u00EAu c\u1EA7u t\u1ED5 ch\u1EE9c.",
        "IsPublished": true
      },
      "references": {}
    },
    {
      "key": "team.writing.20261114.intermediate.emails.03.03d4b51892a74515a832d8456f8760da",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 5,
        "VietnameseText": "Bu\u1ED5i g\u1EB7p d\u1EF1 ki\u1EBFn di\u1EC5n ra tr\u1EF1c ti\u1EBFp v\u00E0o chi\u1EC1u th\u1EE9 B\u1EA3y t\u1EA1i trung t\u00E2m sinh vi\u00EAn.",
        "EnglishMeaning": "The meeting is planned for Saturday afternoon at the student centre.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.emails.03"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.emails.03.1404e83f6e3d47d79c4fab2e860913a7",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 12,
        "VietnameseText": "Ch\u00FAng em c\u1EA3m \u01A1n anh \u0111\u00E3 c\u00E2n nh\u1EAFc l\u1EDDi m\u1EDDi v\u00E0 hy v\u1ECDng s\u1EDBm nh\u1EADn \u0111\u01B0\u1EE3c ph\u1EA3n h\u1ED3i.",
        "EnglishMeaning": "Thank you for considering our invitation, and we hope to hear from you soon.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.emails.03"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.emails.03.354080a70b5140b9b6b4ed7de4da6a59",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 10,
        "VietnameseText": "Xin anh cho bi\u1EBFt li\u1EC7u anh c\u00F3 mu\u1ED1n tham gia bu\u1ED5i tr\u00F2 chuy\u1EC7n n\u00E0y kh\u00F4ng.",
        "EnglishMeaning": "Please let us know whether you would like to take part in this discussion.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.emails.03"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.emails.03.3850d49e6fc241b5b579b828140b887e",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 4,
        "VietnameseText": "L\u1EDDi khuy\u00EAn th\u1EF1c t\u1EBF c\u1EE7a anh c\u00F3 th\u1EC3 gi\u00FAp h\u1ECD hi\u1EC3u r\u00F5 h\u01A1n v\u1EC1 qu\u00E1 tr\u00ECnh n\u00E0y.",
        "EnglishMeaning": "Your practical advice could help them understand the process more clearly.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.emails.03"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.emails.03.404fd0f07f57487097d459832351685a",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 2,
        "VietnameseText": "Ch\u00FAng em mu\u1ED1n m\u1EDDi anh chia s\u1EBB tr\u1EA3i nghi\u1EC7m trong n\u0103m \u0111\u1EA7u \u0111i l\u00E0m.",
        "EnglishMeaning": "We would like to invite you to share your experience of your first year at work.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.emails.03"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.emails.03.4d49b6a0261548b6ad2cc2c578e22e76",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 11,
        "VietnameseText": "Sau khi anh x\u00E1c nh\u1EADn, ch\u00FAng em s\u1EBD g\u1EEDi ch\u01B0\u01A1ng tr\u00ECnh chi ti\u1EBFt \u0111\u1EC3 anh xem.",
        "EnglishMeaning": "Once you confirm, we will send you the detailed programme to review.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.emails.03"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.emails.03.8042d76143b248a19c77c12402621ca4",
      "kind": "WritingAcceptedAnswer",
      "values": {
        "AnswerText": "Please tell us whether you would be interested in joining this discussion.",
        "NormalizedHash": "6402207132a5ddfcc71f16bf513ecdaf4c6a52c596c56d4437dccf7f736df232"
      },
      "references": {
        "WritingExerciseSentenceId": "team.writing.20261114.intermediate.emails.03.354080a70b5140b9b6b4ed7de4da6a59",
        "ApprovedByUserId": "owner:system"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.emails.03.8739a3c4b4cd43f3b0952cef03831053",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 8,
        "VietnameseText": "Ch\u00FAng em c\u00F3 th\u1EC3 b\u1ED1 tr\u00ED m\u00E1y chi\u1EBFu v\u00E0 ho\u00E0n l\u1EA1i chi ph\u00ED \u0111i l\u1EA1i trong th\u00E0nh ph\u1ED1.",
        "EnglishMeaning": "We can arrange a projector and reimburse your travel costs within the city.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.emails.03"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.emails.03.a0f3e5633d3a465c9637c1eb8bf2689b",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 6,
        "VietnameseText": "Ch\u00FAng em \u0111\u1EC1 xu\u1EA5t hai m\u01B0\u01A1i ph\u00FAt chia s\u1EBB, sau \u0111\u00F3 l\u00E0 ph\u1EA7n h\u1ECFi \u0111\u00E1p.",
        "EnglishMeaning": "We suggest a twenty-minute talk followed by a question and answer session.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.emails.03"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.emails.03.a76d7534e79c4648ba1d28aebdcda421",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 9,
        "VietnameseText": "N\u1EBFu anh b\u1EADn v\u00E0o h\u00F4m \u0111\u00F3, ch\u00FAng em c\u0169ng c\u00F3 th\u1EC3 t\u1ED5 ch\u1EE9c v\u00E0o tu\u1EA7n sau.",
        "EnglishMeaning": "If you are busy that day, we could also hold the event the following week.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.emails.03"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.emails.03.d33d6e17f00d4188927df8db685586af",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 1,
        "VietnameseText": "Ch\u00E0o anh Nam, c\u00E2u l\u1EA1c b\u1ED9 c\u1EE7a ch\u00FAng em \u0111ang t\u1ED5 ch\u1EE9c m\u1ED9t bu\u1ED5i tr\u00F2 chuy\u1EC7n v\u1EC1 ngh\u1EC1 nghi\u1EC7p.",
        "EnglishMeaning": "Hello Nam, our club is organising a discussion about careers for students.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.emails.03"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.emails.03.eab84faab8b84992989b00f037015f99",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 7,
        "VietnameseText": "Anh kh\u00F4ng c\u1EA7n chu\u1EA9n b\u1ECB trang tr\u00ECnh chi\u1EBFu tr\u1EEB khi th\u1EA5y ch\u00FAng h\u1EEFu \u00EDch.",
        "EnglishMeaning": "You do not need to prepare slides unless you would find them useful.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.emails.03"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.emails.03.f138de4373f840c888882dff218f4193",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 3,
        "VietnameseText": "Nhi\u1EC1u th\u00E0nh vi\u00EAn \u0111ang t\u00ECm vi\u1EC7c th\u1EF1c t\u1EADp v\u00E0 ch\u01B0a bi\u1EBFt n\u00EAn chu\u1EA9n b\u1ECB nh\u1EEFng g\u00EC.",
        "EnglishMeaning": "Many members are looking for internships and are unsure what to prepare.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.emails.03"
      }
    }
  ],
