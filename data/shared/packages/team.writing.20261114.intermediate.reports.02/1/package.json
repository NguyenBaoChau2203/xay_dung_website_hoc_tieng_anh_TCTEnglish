  "records": [
    {
      "key": "team.writing.20261114.intermediate.reports.02",
      "kind": "WritingExercise",
      "values": {
        "Title": "T\u1ED5ng k\u1EBFt th\u1EED nghi\u1EC7m h\u1ED9p \u0111\u1EF1ng d\u00F9ng l\u1EA1i",
        "Level": "intermediate",
        "ContentType": "reports",
        "Topic": "M\u00F4i tr\u01B0\u1EDDng",
        "SourceType": "original-20261114",
        "PreviewText": "B\u00E1o c\u00E1o gi\u1EA3 \u0111\u1ECBnh so s\u00E1nh m\u1EE9c tham gia v\u00E0 kh\u00F3 kh\u0103n trong th\u1EED nghi\u1EC7m h\u1ED9p d\u00F9ng l\u1EA1i.",
        "IsPublished": true
      },
      "references": {}
    },
    {
      "key": "team.writing.20261114.intermediate.reports.02.0edb299d737c47c99f6c5356c30cad91",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 5,
        "VietnameseText": "Hai m\u01B0\u01A1i hai ng\u01B0\u1EDDi \u0111\u00E3 tr\u1EA3 h\u1ED9p \u0111\u00FAng th\u1EDDi h\u1EA1n \u00EDt nh\u1EA5t m\u1ED9t l\u1EA7n.",
        "EnglishMeaning": "Twenty-two people returned a container on time at least once.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.reports.02"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.reports.02.15257d3c57f243d7a78ef45f7ee5226a",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 2,
        "VietnameseText": "Trong hai tu\u1EA7n, m\u1ED9t qu\u1EA7y \u0103n gi\u1EA3 \u0111\u1ECBnh cung c\u1EA5p h\u1ED9p cho ba m\u01B0\u01A1i ng\u01B0\u1EDDi \u0111\u0103ng k\u00FD.",
        "EnglishMeaning": "Over two weeks, an imagined food stall provided containers to thirty registered participants.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.reports.02"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.reports.02.1d9bb4d25693497d94127207f45f7892",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 12,
        "VietnameseText": "Th\u1EED nghi\u1EC7m gi\u1EA3 \u0111\u1ECBnh n\u00E0y cho th\u1EA5y v\u1EA5n \u0111\u1EC1 c\u1EA7n ki\u1EC3m tra, ch\u01B0a ch\u1EE9ng minh l\u1EE3i \u00EDch m\u00F4i tr\u01B0\u1EDDng t\u1ED5ng th\u1EC3.",
        "EnglishMeaning": "This fictional trial identifies questions to investigate rather than proving an overall environmental benefit.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.reports.02"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.reports.02.43a90aa4134f4c359f827f0420773c1e",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 7,
        "VietnameseText": "Nhi\u1EC1u ng\u01B0\u1EDDi th\u00EDch k\u00EDch th\u01B0\u1EDBc h\u1ED9p, nh\u01B0ng m\u1ED9t s\u1ED1 th\u1EA5y n\u1EAFp kh\u00F3 \u0111\u00F3ng.",
        "EnglishMeaning": "Many liked the container size, but some found the lid difficult to close.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.reports.02"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.reports.02.471394f74bd74245b6d7fc41603d1d8a",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 9,
        "VietnameseText": "Nh\u00F3m \u0111\u1EC1 xu\u1EA5t th\u00EAm \u0111i\u1EC3m tr\u1EA3 thu\u1EADn ti\u1EC7n v\u00E0 d\u00F9ng h\u01B0\u1EDBng d\u1EABn c\u00F3 h\u00ECnh \u1EA3nh.",
        "EnglishMeaning": "The team suggests adding a convenient return point and using illustrated instructions.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.reports.02"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.reports.02.4f47c2835b0a4af088b7a8f63fe1ce95",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 6,
        "VietnameseText": "Nh\u1EEFng ng\u01B0\u1EDDi c\u00F2n l\u1EA1i th\u01B0\u1EDDng qu\u00EAn mang h\u1ED9p ho\u1EB7c kh\u00F4ng quay l\u1EA1i qu\u1EA7y trong tu\u1EA7n.",
        "EnglishMeaning": "The others usually forgot their container or did not revisit the stall that week.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.reports.02"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.reports.02.693b396283e84a2da187f485b3a9a499",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 1,
        "VietnameseText": "B\u00E1o c\u00E1o n\u00E0y t\u00F3m t\u1EAFt m\u1ED9t th\u1EED nghi\u1EC7m gi\u1EA3 \u0111\u1ECBnh v\u1EC1 h\u1ED9p \u0111\u1EF1ng th\u1EE9c \u0103n d\u00F9ng l\u1EA1i.",
        "EnglishMeaning": "This report summarises a fictional trial of reusable food containers.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.reports.02"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.reports.02.6b29566766bd4e55bff2190cda0637ae",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 10,
        "VietnameseText": "Lo\u1EA1i n\u1EAFp kh\u00E1c n\u00EAn \u0111\u01B0\u1EE3c th\u1EED tr\u01B0\u1EDBc khi t\u0103ng s\u1ED1 ng\u01B0\u1EDDi tham gia.",
        "EnglishMeaning": "A different lid should be tested before increasing the number of participants.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.reports.02"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.reports.02.8d7247ca1fe8406a8eb8594270bc826c",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 8,
        "VietnameseText": "Nh\u00E2n vi\u00EAn c\u0169ng c\u1EA7n th\u00EAm th\u1EDDi gian \u0111\u1EC3 ki\u1EC3m tra v\u00E0 v\u1EC7 sinh h\u1ED9p tr\u1EA3 l\u1EA1i.",
        "EnglishMeaning": "Staff also needed extra time to inspect and clean returned containers.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.reports.02"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.reports.02.91cd70a681fc4bbfa4ed47225ba37bc5",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 4,
        "VietnameseText": "Nh\u00F3m ghi l\u1EA1i s\u1ED1 l\u01B0\u1EE3t tr\u1EA3 v\u00E0 thu th\u1EADp nh\u1EADn x\u00E9t v\u00E0o cu\u1ED1i th\u1EED nghi\u1EC7m.",
        "EnglishMeaning": "The team recorded returns and collected comments at the end of the trial.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.reports.02"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.reports.02.b0bcefca33be44cbbcd878eb084b0627",
      "kind": "WritingAcceptedAnswer",
      "values": {
        "AnswerText": "Before more people join, another type of lid should be tried.",
        "NormalizedHash": "be3f74145b723effd0bd04bbb3124a13ab52d06dfeeb05e5804561bcfdf24cec"
      },
      "references": {
        "WritingExerciseSentenceId": "team.writing.20261114.intermediate.reports.02.6b29566766bd4e55bff2190cda0637ae",
        "ApprovedByUserId": "owner:system"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.reports.02.bf1720e285a440a19bf7e88060d0a13f",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 3,
        "VietnameseText": "Ng\u01B0\u1EDDi tham gia c\u00F3 th\u1EC3 tr\u1EA3 h\u1ED9p \u0111\u00E3 d\u00F9ng v\u00E0o l\u1EA7n mua ti\u1EBFp theo.",
        "EnglishMeaning": "Participants could return their used container when they made their next purchase.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.reports.02"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.reports.02.f78c386f800f4d8986ff00cd9051daae",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 11,
        "VietnameseText": "Chi ph\u00ED v\u1EC7 sinh c\u1EA7n \u0111\u01B0\u1EE3c t\u00EDnh c\u00F9ng chi ph\u00ED mua h\u1ED9p ban \u0111\u1EA7u.",
        "EnglishMeaning": "Cleaning costs need to be considered alongside the initial cost of buying containers.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.reports.02"
      }
    }
  ],
