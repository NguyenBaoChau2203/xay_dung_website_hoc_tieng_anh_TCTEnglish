  "version": 1,
  "dependsOn": [],
  "records": [
    {
      "key": "team.writing.20261114.intermediate.essays.02",
      "kind": "WritingExercise",
      "values": {
        "Title": "Th\u01B0 vi\u1EC7n c\u00F3 n\u00EAn cho m\u01B0\u1EE3n d\u1EE5ng c\u1EE5?",
        "Level": "intermediate",
        "ContentType": "essays",
        "Topic": "D\u1ECBch v\u1EE5 c\u1ED9ng \u0111\u1ED3ng",
        "SourceType": "original-20261114",
        "PreviewText": "B\u00E0i lu\u1EADn c\u00E2n nh\u1EAFc l\u1EE3i \u00EDch v\u00E0 h\u1EA1n ch\u1EBF c\u1EE7a vi\u1EC7c cho m\u01B0\u1EE3n \u0111\u1ED3 d\u00F9ng t\u1EA1i th\u01B0 vi\u1EC7n.",
        "IsPublished": true
      },
      "references": {}
    },
    {
      "key": "team.writing.20261114.intermediate.essays.02.05e4d75a43dc4a958fe68c9454c7fe8f",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 1,
        "VietnameseText": "Th\u01B0 vi\u1EC7n c\u1ED9ng \u0111\u1ED3ng c\u00F3 th\u1EC3 h\u1EEFu \u00EDch h\u01A1n n\u1EBFu cho m\u01B0\u1EE3n m\u1ED9t s\u1ED1 d\u1EE5ng c\u1EE5 gia \u0111\u00ECnh.",
        "EnglishMeaning": "Community libraries could become more useful by lending a small selection of household tools.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.essays.02"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.essays.02.174306d241a940cd9f3275e71a4b0bce",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 7,
        "VietnameseText": "Th\u01B0 vi\u1EC7n c\u0169ng c\u1EA7n quy \u0111\u1ECBnh r\u00F5 ai ch\u1ECBu tr\u00E1ch nhi\u1EC7m n\u1EBFu \u0111\u1ED3 b\u1ECB h\u1ECFng.",
        "EnglishMeaning": "The library would also need clear rules about responsibility when something gets damaged.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.essays.02"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.essays.02.3598c910f9e2464fbacdae6cd5ff8faa",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 3,
        "VietnameseText": "Vi\u1EC7c mua ri\u00EAng nh\u1EEFng m\u00F3n n\u00E0y c\u00F3 th\u1EC3 t\u1ED1n ti\u1EC1n v\u00E0 chi\u1EBFm ch\u1ED7 trong nh\u00E0.",
        "EnglishMeaning": "Buying these items individually can cost money and take up space at home.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.essays.02"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.essays.02.3ad308c3b7bd460cb2313f4f31bf5cbd",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 2,
        "VietnameseText": "Nhi\u1EC1u ng\u01B0\u1EDDi ch\u1EC9 c\u1EA7n m\u00E1y khoan ho\u1EB7c b\u1ED9 d\u1EE5ng c\u1EE5 s\u1EEDa ch\u1EEFa v\u00E0i l\u1EA7n m\u1ED7i n\u0103m.",
        "EnglishMeaning": "Many people need a drill or a repair kit only a few times each year.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.essays.02"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.essays.02.541e550016a44eebb436e0719340bd16",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 9,
        "VietnameseText": "T\u00F4i cho r\u1EB1ng th\u01B0 vi\u1EC7n n\u00EAn th\u1EED m\u1ED9t danh m\u1EE5c nh\u1ECF g\u1ED3m c\u00E1c d\u1EE5ng c\u1EE5 \u0111\u01A1n gi\u1EA3n.",
        "EnglishMeaning": "I believe libraries should trial a small collection of simple tools.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.essays.02"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.essays.02.788636e3422e4e289773a380659d578e",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 10,
        "VietnameseText": "Ng\u01B0\u1EDDi m\u01B0\u1EE3n c\u1EA7n \u0111\u01B0\u1EE3c h\u01B0\u1EDBng d\u1EABn v\u00E0 bi\u1EBFt r\u00F5 th\u1EDDi h\u1EA1n tr\u1EA3 tr\u01B0\u1EDBc khi nh\u1EADn \u0111\u1ED3.",
        "EnglishMeaning": "Borrowers should receive instructions and understand the return deadline before collecting an item.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.essays.02"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.essays.02.7b7dc33d89194fb4870452f31fd489ca",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 6,
        "VietnameseText": "Nh\u00E2n vi\u00EAn ph\u1EA3i bi\u1EBFt li\u1EC7u m\u1ED9t thi\u1EBFt b\u1ECB c\u00F3 an to\u00E0n tr\u01B0\u1EDBc khi cho ng\u01B0\u1EDDi ti\u1EBFp theo m\u01B0\u1EE3n.",
        "EnglishMeaning": "Staff must know whether an item is safe before lending it to the next person.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.essays.02"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.essays.02.893adf48f12448939425600ed224bb50",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 11,
        "VietnameseText": "Sau ba th\u00E1ng, th\u01B0 vi\u1EC7n c\u00F3 th\u1EC3 xem m\u1EE9c s\u1EED d\u1EE5ng v\u00E0 chi ph\u00ED b\u1EA3o tr\u00EC.",
        "EnglishMeaning": "After three months, the library could review usage and maintenance costs.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.essays.02"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.essays.02.9f9ae0a697c54e3db351cd08fec4bc48",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 4,
        "VietnameseText": "M\u1ED9t d\u1ECBch v\u1EE5 d\u00F9ng chung s\u1EBD gi\u00FAp c\u01B0 d\u00E2n ho\u00E0n th\u00E0nh c\u00E1c vi\u1EC7c nh\u1ECF v\u1EDBi chi ph\u00ED th\u1EA5p h\u01A1n.",
        "EnglishMeaning": "A shared service would help residents complete small jobs at a lower cost.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.essays.02"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.essays.02.a0da4f83b61544fea9ec5a7dca772043",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 8,
        "VietnameseText": "N\u1EBFu thi\u1EBFu th\u1EDDi gian v\u00E0 ng\u00E2n s\u00E1ch, d\u1ECBch v\u1EE5 m\u1EDBi c\u00F3 th\u1EC3 \u1EA3nh h\u01B0\u1EDFng \u0111\u1EBFn c\u00E1c ho\u1EA1t \u0111\u1ED9ng hi\u1EC7n c\u00F3.",
        "EnglishMeaning": "Without enough time and funding, the new service could affect existing activities.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.essays.02"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.essays.02.ae050bc7b4d4464f8cb817e6a17dc3d7",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 5,
        "VietnameseText": "M\u1EB7t kh\u00E1c, d\u1EE5ng c\u1EE5 c\u1EA7n \u0111\u01B0\u1EE3c ki\u1EC3m tra th\u01B0\u1EDDng xuy\u00EAn h\u01A1n so v\u1EDBi s\u00E1ch.",
        "EnglishMeaning": "On the other hand, tools need to be checked more frequently than books.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.essays.02"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.essays.02.ef6a330558ac4fe3bd892d9e5ab25f8f",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 12,
        "VietnameseText": "Vi\u1EC7c m\u1EDF r\u1ED9ng ch\u1EC9 n\u00EAn di\u1EC5n ra n\u1EBFu d\u1ECBch v\u1EE5 \u0111\u00E1p \u1EE9ng nhu c\u1EA7u m\u00E0 kh\u00F4ng l\u00E0m qu\u00E1 t\u1EA3i nh\u00E2n vi\u00EAn.",
        "EnglishMeaning": "Expansion should happen only if the service meets a need without overloading staff.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.essays.02"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.essays.02.fc92174dbad74bdfbb6f9d733bbb7086",
      "kind": "WritingAcceptedAnswer",
      "values": {
        "AnswerText": "In my opinion, libraries should begin by testing a small range of basic tools.",
        "NormalizedHash": "40c8d20e2322409c32f78869d401df273dd35ae21cd7e99cc588c40944069b16"
      },
      "references": {
        "WritingExerciseSentenceId": "team.writing.20261114.intermediate.essays.02.541e550016a44eebb436e0719340bd16",
        "ApprovedByUserId": "owner:system"
      }
    }
  ],
