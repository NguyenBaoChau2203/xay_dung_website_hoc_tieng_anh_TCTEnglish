      "kind": "ListeningQuizQuestion",
      "values": {
        "OrderIndex": 2,
        "QuestionText": "What is the habitable zone?",
        "OptionA": "The distance from a star where a planet could have liquid water",
        "OptionB": "The inside of the Sun",
        "OptionC": "A kind of telescope",
        "OptionD": "A planet\u0027s atmosphere",
        "CorrectAnswer": "A",
        "Explanation": "\u0022Ones that are about the same size that are just the right distance from their star. We call this distance the habitable zone.\u0022 \u2014 00:34"
      },
      "references": {
