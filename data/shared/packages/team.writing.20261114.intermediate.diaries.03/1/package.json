  "version": 1,
  "dependsOn": [],
  "records": [
    {
      "key": "team.writing.20261114.intermediate.diaries.03",
      "kind": "WritingExercise",
      "values": {
        "Title": "T\u1ED1i \u0111\u1EA7u ti\u00EAn \u1EDF l\u1EDBp l\u00E0m g\u1ED1m",
        "Level": "intermediate",
        "ContentType": "diaries",
        "Topic": "S\u1EDF th\u00EDch",
        "SourceType": "original-20261114",
        "PreviewText": "Nh\u1EADt k\u00FD h\u1ECDc l\u00E0m g\u1ED1m, \u0111\u1ED1i m\u1EB7t v\u1EDBi l\u1ED7i v\u00E0 ch\u1EA5p nh\u1EADn ti\u1EBFn b\u1ED9 ch\u1EADm.",
        "IsPublished": true
      },
      "references": {}
    },
    {
      "key": "team.writing.20261114.intermediate.diaries.03.08f478501bc34c2dbf4eb4faf2095126",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 2,
        "VietnameseText": "T\u00F4i \u0111\u00E3 xem v\u00E0i video n\u00EAn ngh\u0129 b\u01B0\u1EDBc t\u1EA1o h\u00ECnh s\u1EBD kh\u00E1 \u0111\u01A1n gi\u1EA3n.",
        "EnglishMeaning": "I had watched several videos, so I thought shaping the clay would be fairly simple.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.diaries.03"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.diaries.03.093c526fded14816a164d569119d02a2",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 12,
        "VietnameseText": "T\u00F4i \u0111\u00E3 \u0111\u0103ng k\u00FD bu\u1ED5i ti\u1EBFp theo v\u00E0 mu\u1ED1n xem chi\u1EBFc c\u1ED1c s\u1EBD thay \u0111\u1ED5i th\u1EBF n\u00E0o.",
        "EnglishMeaning": "I have signed up for the next class and want to see how my mug changes.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.diaries.03"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.diaries.03.15a30d415cc74b518db892320f27a3fc",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 5,
        "VietnameseText": "C\u00F4 gi\u00E1o b\u1EA3o t\u00F4i gi\u1EA3m t\u1ED1c \u0111\u1ED9 v\u00E0 ch\u00FA \u00FD \u0111\u1EBFn c\u00E1ch \u0111\u1EB7t hai b\u00E0n tay.",
        "EnglishMeaning": "The teacher told me to slow down and pay attention to my hand position.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.diaries.03"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.diaries.03.324f9c2d0c8540369981fe5cc1da6d9e",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 3,
        "VietnameseText": "Nh\u01B0ng khi b\u00E0n xoay b\u1EAFt \u0111\u1EA7u ch\u1EA1y, kh\u1ED1i \u0111\u1EA5t c\u1EE7a t\u00F4i nghi\u00EAng ngay sang m\u1ED9t b\u00EAn.",
        "EnglishMeaning": "But when the wheel started turning, my lump of clay immediately leaned sideways.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.diaries.03"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.diaries.03.33a2b4c59abe498680388999bd59c4ef",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 4,
        "VietnameseText": "T\u00F4i nh\u00ECn chi\u1EBFc b\u00E1t tr\u00F2n c\u1EE7a ng\u01B0\u1EDDi b\u00EAn c\u1EA1nh v\u00E0 th\u1EA5y h\u01A1i th\u1EA5t v\u1ECDng.",
        "EnglishMeaning": "I looked at the round bowl beside me and felt a little disappointed.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.diaries.03"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.diaries.03.83c40edc664342ad87ada286e02364d7",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 6,
        "VietnameseText": "C\u00F4 kh\u00F4ng l\u00E0m h\u1ED9 m\u00E0 \u0111\u1EC3 t\u00F4i th\u1EED l\u1EA1i v\u1EDBi m\u1ED9t kh\u1ED1i \u0111\u1EA5t m\u1EDBi.",
        "EnglishMeaning": "She let me try again with fresh clay instead of doing it for me.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.diaries.03"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.diaries.03.894285cb9cdb4eba8d86945a8b7f39d7",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 9,
        "VietnameseText": "Cu\u1ED1i bu\u1ED5i, ch\u00FAng t\u00F4i \u0111\u1EC3 s\u1EA3n ph\u1EA9m tr\u00EAn gi\u00E1 \u0111\u1EC3 ch\u1EDD \u0111\u01B0\u1EE3c nung.",
        "EnglishMeaning": "At the end, we left our work on a shelf to be fired.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.diaries.03"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.diaries.03.99dbd5b053764ae6ae73e7556b513ed8",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 7,
        "VietnameseText": "L\u1EA7n th\u1EE9 hai, t\u00F4i c\u1EA3m nh\u1EADn \u0111\u01B0\u1EE3c kh\u1ED1i \u0111\u1EA5t thay \u0111\u1ED5i d\u01B0\u1EDBi c\u00E1c ng\u00F3n tay.",
        "EnglishMeaning": "On the second attempt, I could feel the clay changing beneath my fingers.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.diaries.03"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.diaries.03.af814cc7a4bb486aa94b24a23ce8f691",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 10,
        "VietnameseText": "T\u00F4i v\u1EC1 nh\u00E0 v\u1EDBi \u0111\u00F4i tay c\u00F2n d\u00EDnh \u0111\u1EA5t v\u00E0 t\u00E2m tr\u1EA1ng vui h\u01A1n l\u00FAc \u0111\u1EBFn.",
        "EnglishMeaning": "I went home with clay on my hands and a happier mood than before.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.diaries.03"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.diaries.03.bc6e28bd8b2e44198fa00cc2438f3bfb",
      "kind": "WritingAcceptedAnswer",
      "values": {
        "AnswerText": "I have enrolled in the next class and am curious to see how my mug turns out.",
        "NormalizedHash": "e649eaab0abe216b7846553ca9ab251b789570c8f33c3c6cf572b655f1bd5bec"
      },
      "references": {
        "WritingExerciseSentenceId": "team.writing.20261114.intermediate.diaries.03.093c526fded14816a164d569119d02a2",
        "ApprovedByUserId": "owner:system"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.diaries.03.d1d683e386f94988b6371cda94ada25d",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 1,
        "VietnameseText": "T\u1ED1i nay t\u00F4i \u0111\u1EBFn l\u1EDBp l\u00E0m g\u1ED1m v\u1EDBi hy v\u1ECDng mang v\u1EC1 m\u1ED9t chi\u1EBFc c\u1ED1c \u0111\u1EB9p.",
        "EnglishMeaning": "Tonight I went to a pottery class hoping to bring home a beautiful mug.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.diaries.03"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.diaries.03.d3355110ecb34da6afc228c90d7fd1ac",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 8,
        "VietnameseText": "Chi\u1EBFc c\u1ED1c v\u1EABn th\u1EA5p h\u01A1n d\u1EF1 \u0111\u1ECBnh, nh\u01B0ng \u00EDt nh\u1EA5t n\u00F3 kh\u00F4ng b\u1ECB \u0111\u1ED5.",
        "EnglishMeaning": "The mug was still shorter than planned, but at least it did not collapse.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.diaries.03"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.diaries.03.f434797887694999bcfbe356aa0a6112",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 11,
        "VietnameseText": "H\u00F3a ra vi\u1EC7c h\u1ECDc m\u1ED9t k\u1EF9 n\u0103ng m\u1EDBi \u0111\u00F2i h\u1ECFi s\u1EF1 ki\u00EAn nh\u1EABn m\u00E0 nh\u1EEFng video h\u01B0\u1EDBng d\u1EABn kh\u00F4ng th\u1EC3 mang l\u1EA1i.",
        "EnglishMeaning": "It turns out that learning a new skill requires patience that instruction videos cannot provide.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.diaries.03"
      }
    }
  ],
