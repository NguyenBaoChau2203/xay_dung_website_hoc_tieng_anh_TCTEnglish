{
  "schemaVersion": 1,
  "id": "team.writing.20261114.intermediate.stories.05",
  "version": 1,
  "dependsOn": [],
  "records": [
    {
      "key": "team.writing.20261114.intermediate.stories.05",
      "kind": "WritingExercise",
      "values": {
        "Title": "C\u00F4ng th\u1EE9c thi\u1EBFu m\u1ED9t d\u00F2ng",
        "Level": "intermediate",
        "ContentType": "stories",
        "Topic": "\u1EA8m th\u1EF1c",
        "SourceType": "original-20261114",
        "PreviewText": "Truy\u1EC7n t\u00ECm \u00FD ngh\u0129a c\u1EE7a m\u1ED9t c\u00F4ng th\u1EE9c c\u0169 qua l\u1EA7n th\u1EED b\u00E1nh kh\u00F4ng th\u00E0nh.",
        "IsPublished": true
      },
      "references": {}
    },
    {
      "key": "team.writing.20261114.intermediate.stories.05.1596910c7fe3459d88d3a62b2c5bbf84",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 12,
        "VietnameseText": "Nhi vi\u1EBFt th\u00EAm ghi ch\u00FA v\u00E0o s\u1ED5, c\u00F2n em trai n\u00F3i \u0111\u00E2y m\u1EDBi l\u00E0 m\u00F3n qu\u00E0 \u0111\u00E1ng nh\u1EDB.",
        "EnglishMeaning": "Nhi added notes to the book, while her brother called it a truly memorable gift.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.stories.05"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.stories.05.417db6f59cd24b2184dfcb271e6fae2b",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 10,
        "VietnameseText": "B\u00E0 c\u0169ng nh\u1EAFc r\u1EB1ng th\u1EDDi gian n\u01B0\u1EDBng ph\u1EE5 thu\u1ED9c v\u00E0o k\u00EDch th\u01B0\u1EDBc khu\u00F4n.",
        "EnglishMeaning": "She also reminded them that baking time depended on the size of the tin.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.stories.05"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.stories.05.45245260087146fb90250eeb2e132a85",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 4,
        "VietnameseText": "Nhi \u0111o\u00E1n \u0111\u00F3 ch\u1EC9 l\u00E0 l\u1EDDi nh\u1EAFc trang tr\u00ED n\u00EAn b\u1EAFt \u0111\u1EA7u ngay.",
        "EnglishMeaning": "Nhi assumed it was only a decorating reminder and began straight away.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.stories.05"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.stories.05.4811dcfbe5b44ae88896441d70c550d8",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 2,
        "VietnameseText": "C\u00F4 mu\u1ED1n l\u00E0m b\u00E1nh cho sinh nh\u1EADt em trai m\u00E0 kh\u00F4ng nh\u1EDD ai gi\u00FAp.",
        "EnglishMeaning": "She wanted to bake for her brother\u0027s birthday without asking anyone for help.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.stories.05"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.stories.05.9755fdebbccb425fbf9b14df47ff3e7f",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 5,
        "VietnameseText": "Chi\u1EBFc b\u00E1nh \u0111\u1EA7u ti\u00EAn nh\u00ECn \u0111\u1EB9p nh\u01B0ng b\u00EAn trong v\u1EABn c\u00F2n \u01B0\u1EDBt khi c\u1EAFt ra.",
        "EnglishMeaning": "The first cake looked attractive but was still wet inside when she cut it.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.stories.05"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.stories.05.9ed6c13d0aaf461abdb0ce672e8cefc3",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 7,
        "VietnameseText": "Thay v\u00EC gi\u1EA5u chi\u1EBFc b\u00E1nh, Nhi \u0111\u01B0a cho em xem trang gi\u1EA5y b\u1ECB nh\u00F2e.",
        "EnglishMeaning": "Instead of hiding the cake, Nhi showed him the stained page.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.stories.05"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.stories.05.abc9abd27519413aa1fe315e3cdf5499",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 3,
        "VietnameseText": "C\u00E1c nguy\u00EAn li\u1EC7u \u0111\u1EC1u r\u00F5 r\u00E0ng, nh\u01B0ng d\u00F2ng cu\u1ED1i \u0111\u00E3 b\u1ECB m\u1ED9t v\u1EBFt n\u01B0\u1EDBc che m\u1EA5t.",
        "EnglishMeaning": "The ingredients were clear, but a water stain had covered the final line.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.stories.05"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.stories.05.d3f4bedc541645c8899af070e46f27bd",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 6,
        "VietnameseText": "C\u00F4 \u0111\u1ECBnh b\u1ECF cu\u1ED9c th\u00EC em trai b\u01B0\u1EDBc v\u00E0o b\u1EBFp v\u00E0 h\u1ECFi chuy\u1EC7n g\u00EC x\u1EA3y ra.",
        "EnglishMeaning": "She was about to give up when her brother entered the kitchen and asked what happened.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.stories.05"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.stories.05.d6cd5e58545f466a9d244b2e8fd0e4eb",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 1,
        "VietnameseText": "Nhi t\u00ECm th\u1EA5y c\u00F4ng th\u1EE9c l\u00E0m b\u00E1nh trong cu\u1ED1n s\u1ED5 c\u0169 c\u1EE7a b\u00E0.",
        "EnglishMeaning": "Nhi found a cake recipe in her grandmother\u0027s old notebook one afternoon.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.stories.05"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.stories.05.e40ceb4857b14a6685e69803c1fa034f",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 9,
        "VietnameseText": "Hai ch\u1ECB em g\u1ECDi cho b\u00E0 v\u00E0 bi\u1EBFt d\u00F2ng cu\u1ED1i h\u01B0\u1EDBng d\u1EABn ki\u1EC3m tra b\u00E1nh tr\u01B0\u1EDBc khi l\u1EA5y ra.",
        "EnglishMeaning": "They called their grandmother and learned that the last line explained checking the cake before removing it.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.stories.05"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.stories.05.f0c5c8ac481f4b4dbc0a6100778dd6b0",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 8,
        "VietnameseText": "C\u1EADu nh\u1EDB b\u00E0 th\u01B0\u1EDDng d\u00F9ng m\u1ED9t chi\u1EBFc khu\u00F4n n\u00F4ng h\u01A1n chi\u1EBFc c\u00F4 \u0111\u00E3 ch\u1ECDn.",
        "EnglishMeaning": "He remembered that their grandmother used a shallower tin than the one she had chosen.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.stories.05"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.stories.05.f712fe8c51e14cefb30d2d5615af1a7f",
      "kind": "WritingAcceptedAnswer",
      "values": {
        "AnswerText": "The second batch worked after they made it together and checked it with care.",
        "NormalizedHash": "6c4e9c89f33d04affce1db21918bd7224e78e3f5f426ea0e073600cf8840fe6f"
      },
      "references": {
        "WritingExerciseSentenceId": "team.writing.20261114.intermediate.stories.05.f839dc42813e40129e3918b7a26608bc",
        "ApprovedByUserId": "owner:system"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.stories.05.f839dc42813e40129e3918b7a26608bc",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 11,
        "VietnameseText": "M\u1EBB th\u1EE9 hai th\u00E0nh c\u00F4ng sau khi hai ch\u1ECB em c\u00F9ng l\u00E0m v\u00E0 ki\u1EC3m tra c\u1EA9n th\u1EADn.",
        "EnglishMeaning": "The second batch succeeded after they worked together and checked it carefully.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.stories.05"
      }
    }
  ],
