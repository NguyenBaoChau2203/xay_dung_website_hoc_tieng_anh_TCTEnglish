  "records": [
    {
      "key": "team.writing.20261114.intermediate.diaries.02",
      "kind": "WritingExercise",
      "values": {
        "Title": "M\u1ED9t ng\u00E0y kh\u00F4ng b\u1EADt th\u00F4ng b\u00E1o",
        "Level": "intermediate",
        "ContentType": "diaries",
        "Topic": "Th\u00F3i quen",
        "SourceType": "original-20261114",
        "PreviewText": "Nh\u1EADt k\u00FD th\u1EED t\u1EAFt th\u00F4ng b\u00E1o v\u00E0 suy ngh\u0129 v\u1EC1 s\u1EF1 t\u1EADp trung trong ng\u00E0y.",
        "IsPublished": true
      },
      "references": {}
    },
    {
      "key": "team.writing.20261114.intermediate.diaries.02.0cc7f69709794b77a4e8fbc47029a5ce",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 2,
        "VietnameseText": "T\u00F4i \u0111\u00E3 \u0111\u1ECBnh l\u00E0m \u0111i\u1EC1u n\u00E0y t\u1EEB l\u00E2u, nh\u01B0ng lu\u00F4n lo s\u1EBD b\u1ECF l\u1EE1 chuy\u1EC7n quan tr\u1ECDng.",
        "EnglishMeaning": "I had intended to do this for ages, but always worried about missing something important.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.diaries.02"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.diaries.02.0d07993b635a4604b18837b7f975c0ac",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 8,
        "VietnameseText": "T\u00F4i th\u1EA5y nh\u1EB9 nh\u00F5m, nh\u01B0ng c\u0169ng ng\u1EA1c nhi\u00EAn v\u00EC m\u1ED9t thay \u0111\u1ED5i nh\u1ECF l\u1EA1i h\u1EEFu \u00EDch nh\u01B0 v\u1EADy.",
        "EnglishMeaning": "I felt relieved, but also surprised that such a small change could help.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.diaries.02"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.diaries.02.1daab66d616540cea2187a53eac714bf",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 11,
        "VietnameseText": "T\u00F4i kh\u00F4ng mu\u1ED1n b\u1ECF \u0111i\u1EC7n tho\u1EA1i, v\u00EC n\u00F3 gi\u00FAp t\u00F4i gi\u1EEF li\u00EAn l\u1EA1c v\u1EDBi m\u1ECDi ng\u01B0\u1EDDi.",
        "EnglishMeaning": "I do not want to give up my phone, because it helps me stay connected.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.diaries.02"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.diaries.02.25e6affab1dd44309b985f95445499dc",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 7,
        "VietnameseText": "\u0110\u1EBFn gi\u1EDD \u0103n tr\u01B0a, t\u00F4i \u0111\u00E3 s\u1EEDa xong ph\u1EA7n m\u00E0 h\u00F4m qua l\u00E0m m\u00E3i ch\u01B0a xong.",
        "EnglishMeaning": "By lunchtime, I had revised the section I had struggled to finish yesterday.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.diaries.02"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.diaries.02.2782b7582ec84373b469721bcf1f5275",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 1,
        "VietnameseText": "H\u00F4m nay t\u00F4i th\u1EED t\u1EAFt c\u00E1c th\u00F4ng b\u00E1o kh\u00F4ng c\u1EA7n thi\u1EBFt trong khi l\u00E0m vi\u1EC7c.",
        "EnglishMeaning": "Today I tried turning off unnecessary notifications while I was working.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.diaries.02"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.diaries.02.46b8dc523d2747298235b88dab558d21",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 4,
        "VietnameseText": "Sau \u0111\u00F3 t\u00F4i \u0111\u1EB7t \u0111i\u1EC7n tho\u1EA1i trong ng\u0103n k\u00E9o v\u00E0 m\u1EDF b\u1EA3n d\u1ECBch \u0111ang l\u00E0m d\u1EDF.",
        "EnglishMeaning": "Then I put my phone in a drawer and opened my unfinished translation.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.diaries.02"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.diaries.02.5269437ad7bd437c99832a8452a20b8b",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 9,
        "VietnameseText": "Bu\u1ED5i chi\u1EC1u t\u00F4i ki\u1EC3m tra tin nh\u1EAFn v\u00E0o hai th\u1EDDi \u0111i\u1EC3m \u0111\u00E3 ch\u1ECDn tr\u01B0\u1EDBc.",
        "EnglishMeaning": "In the afternoon, I checked my messages at two times I had chosen beforehand.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.diaries.02"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.diaries.02.7d67987ca43e4894bfb76cfe54efba9a",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 5,
        "VietnameseText": "Trong gi\u1EDD \u0111\u1EA7u ti\u00EAn, t\u00F4i li\u00EAn t\u1EE5c mu\u1ED1n ki\u1EC3m tra m\u00E0n h\u00ECnh d\u00F9 kh\u00F4ng c\u00F3 ti\u1EBFng b\u00E1o.",
        "EnglishMeaning": "During the first hour, I kept wanting to check the screen despite the silence.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.diaries.02"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.diaries.02.8443a89cafcf4bb89af87cfd12d2eb6d",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 3,
        "VietnameseText": "Tr\u01B0\u1EDBc khi b\u1EAFt \u0111\u1EA7u, t\u00F4i b\u00E1o cho gia \u0111\u00ECnh r\u1EB1ng h\u1ECD v\u1EABn c\u00F3 th\u1EC3 g\u1ECDi \u0111i\u1EC7n.",
        "EnglishMeaning": "Before starting, I told my family that they could still call me.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.diaries.02"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.diaries.02.bfbf2b51a70442e39bcc4a09b202f04c",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 12,
        "VietnameseText": "T\u00F4i ch\u1EC9 mu\u1ED1n ch\u1EE7 \u0111\u1ED9ng h\u01A1n trong vi\u1EC7c quy\u1EBFt \u0111\u1ECBnh khi n\u00E0o m\u00ECnh ch\u00FA \u00FD \u0111\u1EBFn n\u00F3.",
        "EnglishMeaning": "I simply want more control over when I choose to give it my attention.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.diaries.02"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.diaries.02.c9234fbebb7948ebb63da264263732be",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 10,
        "VietnameseText": "Kh\u00F4ng c\u00F3 vi\u1EC7c kh\u1EA9n c\u1EA5p n\u00E0o b\u1ECB b\u1ECF s\u00F3t v\u00E0 t\u00F4i v\u1EABn tr\u1EA3 l\u1EDDi b\u1EA1n b\u00E8 \u0111\u01B0\u1EE3c.",
        "EnglishMeaning": "No urgent matter was missed, and I was still able to reply to friends.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.diaries.02"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.diaries.02.d494fa555f1a4befbcc5d812c0164a5f",
      "kind": "WritingAcceptedAnswer",
      "values": {
        "AnswerText": "I just want to decide more deliberately when to pay attention to it.",
        "NormalizedHash": "e683654e1ccad9e159955be784a23643e4ca0a3af95d14c3d172bed4370a64f9"
      },
      "references": {
        "WritingExerciseSentenceId": "team.writing.20261114.intermediate.diaries.02.bfbf2b51a70442e39bcc4a09b202f04c",
        "ApprovedByUserId": "owner:system"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.diaries.02.eddd5438d5554986b79a6895da2db0ce",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 6,
        "VietnameseText": "Tuy nhi\u00EAn, c\u1EA3m gi\u00E1c \u0111\u00F3 gi\u1EA3m d\u1EA7n khi t\u00F4i t\u1EADp trung v\u00E0o nh\u1EEFng \u0111o\u1EA1n kh\u00F3.",
        "EnglishMeaning": "However, that feeling gradually faded as I concentrated on the difficult passages.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.diaries.02"
      }
    }
  ],
