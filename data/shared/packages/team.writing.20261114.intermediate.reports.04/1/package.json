  "records": [
    {
      "key": "team.writing.20261114.intermediate.reports.04",
      "kind": "WritingExercise",
      "values": {
        "Title": "So s\u00E1nh hai c\u00E1ch \u0111\u1EB7t l\u1ECBch ph\u00F2ng h\u1ECDp",
        "Level": "intermediate",
        "ContentType": "reports",
        "Topic": "Quy tr\u00ECnh c\u00F4ng vi\u1EC7c",
        "SourceType": "original-20261114",
        "PreviewText": "B\u00E1o c\u00E1o gi\u1EA3 \u0111\u1ECBnh so s\u00E1nh s\u1ED5 gi\u1EA5y v\u00E0 l\u1ECBch chung theo c\u00F9ng ti\u00EAu ch\u00ED.",
        "IsPublished": true
      },
      "references": {}
    },
    {
      "key": "team.writing.20261114.intermediate.reports.04.0a93c6b8666842319dec4396fe7b700c",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 9,
        "VietnameseText": "Nh\u00F3m \u0111\u1EC1 xu\u1EA5t ti\u1EBFp t\u1EE5c l\u1ECBch \u0111i\u1EC7n t\u1EED k\u00E8m m\u1ED9t h\u01B0\u1EDBng d\u1EABn ng\u1EAFn cho nh\u00E2n vi\u00EAn.",
        "EnglishMeaning": "The team recommends keeping the digital calendar with a short guide for staff.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.reports.04"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.reports.04.11cd36d7cb6143a59fbcd2b8c6ca57d1",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 2,
        "VietnameseText": "Nh\u00F3m d\u00F9ng s\u1ED5 gi\u1EA5y m\u1ED9t tu\u1EA7n r\u1ED3i th\u1EED l\u1ECBch \u0111i\u1EC7n t\u1EED chung v\u00E0o tu\u1EA7n ti\u1EBFp theo.",
        "EnglishMeaning": "The team used a paper register for one week, then trialled a shared digital calendar.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.reports.04"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.reports.04.25a94133aa824bf5aa27e74fe1dc6fa1",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 5,
        "VietnameseText": "S\u1ED5 gi\u1EA5y d\u1EC5 s\u1EED d\u1EE5ng nh\u01B0ng ch\u1EC9 xem \u0111\u01B0\u1EE3c khi nh\u00E2n vi\u00EAn \u0111\u1EBFn g\u1EA7n ph\u00F2ng.",
        "EnglishMeaning": "The paper register was easy to use but could only be checked beside the room.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.reports.04"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.reports.04.2874f02d5ab44d379f16822e37d8e9e3",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 3,
        "VietnameseText": "C\u1EA3 hai c\u00E1ch \u0111\u01B0\u1EE3c \u0111\u00E1nh gi\u00E1 theo \u0111\u1ED9 r\u00F5 r\u00E0ng v\u00E0 s\u1ED1 l\u1EA7n \u0111\u1EB7t tr\u00F9ng.",
        "EnglishMeaning": "Both methods were assessed for clarity and the number of overlapping bookings.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.reports.04"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.reports.04.4f1d4deff9884e678291e14bb806fa0a",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 8,
        "VietnameseText": "Tuy v\u1EADy, hai ng\u01B0\u1EDDi c\u1EA7n \u0111\u01B0\u1EE3c gi\u00FAp \u0111\u1EC3 bi\u1EBFt c\u00E1ch s\u1EEDa gi\u1EDD \u0111\u00E3 \u0111\u1EB7t.",
        "EnglishMeaning": "However, two people needed help learning how to change a reserved time.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.reports.04"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.reports.04.6303df4e4c964a078065aeb912305064",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 1,
        "VietnameseText": "B\u00E1o c\u00E1o n\u00E0y so s\u00E1nh hai c\u00E1ch \u0111\u1EB7t ph\u00F2ng trong m\u1ED9t v\u0103n ph\u00F2ng gi\u1EA3 \u0111\u1ECBnh.",
        "EnglishMeaning": "This report compares two room-booking methods in a fictional office setting.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.reports.04"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.reports.04.85fd8135646b4b7cbb52858d81b26036",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 6,
        "VietnameseText": "Trong tu\u1EA7n \u0111\u1EA7u, ba cu\u1ED9c h\u1ECDp b\u1ECB \u0111\u1EB7t tr\u00F9ng v\u00EC c\u00F3 ng\u01B0\u1EDDi qu\u00EAn ghi l\u1EA1i.",
        "EnglishMeaning": "During the first week, three meetings overlapped because someone forgot to register a booking.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.reports.04"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.reports.04.8c4373ee81834915a8216eab1ae0c712",
      "kind": "WritingAcceptedAnswer",
      "values": {
        "AnswerText": "The office should reassess use after one month before deciding on a permanent arrangement.",
        "NormalizedHash": "d0674d9686731e421c9889afaa4be99cf81618b1bcb239cc454330dd5e7436eb"
      },
      "references": {
        "WritingExerciseSentenceId": "team.writing.20261114.intermediate.reports.04.ccc4c92e240a44c7b25bf2e7ff819ae3",
        "ApprovedByUserId": "owner:system"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.reports.04.98b7755ab4024c9fa7a0d7799d62661f",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 4,
        "VietnameseText": "M\u01B0\u1EDDi nh\u00E2n vi\u00EAn tham gia th\u1EED nghi\u1EC7m v\u00E0 ghi l\u1EA1i nh\u1EEFng kh\u00F3 kh\u0103n g\u1EB7p ph\u1EA3i.",
        "EnglishMeaning": "Ten employees took part in the trial and recorded the difficulties they encountered.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.reports.04"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.reports.04.9a73f2f0275e4180ac215b461f1fe0b5",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 10,
        "VietnameseText": "M\u1ED7i cu\u1ED9c h\u1EB9n n\u00EAn c\u00F3 ng\u01B0\u1EDDi li\u00EAn h\u1EC7 \u0111\u1EC3 d\u1EC5 x\u1EED l\u00FD khi c\u1EA7n thay \u0111\u1ED5i.",
        "EnglishMeaning": "Each booking should name a contact person to make changes easier to manage.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.reports.04"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.reports.04.a94e26c81c9f4412b894be973bd51bc8",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 12,
        "VietnameseText": "K\u1EBFt qu\u1EA3 trong t\u00ECnh hu\u1ED1ng gi\u1EA3 \u0111\u1ECBnh n\u00E0y kh\u00F4ng \u0111\u1EE7 \u0111\u1EC3 k\u1EBFt lu\u1EADn v\u1EC1 m\u1ECDi n\u01A1i l\u00E0m vi\u1EC7c.",
        "EnglishMeaning": "The results of this fictional scenario cannot support conclusions about every workplace.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.reports.04"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.reports.04.ccc4c92e240a44c7b25bf2e7ff819ae3",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 11,
        "VietnameseText": "Sau m\u1ED9t th\u00E1ng, v\u0103n ph\u00F2ng n\u00EAn ki\u1EC3m tra l\u1EA1i m\u1EE9c s\u1EED d\u1EE5ng tr\u01B0\u1EDBc khi quy\u1EBFt \u0111\u1ECBnh l\u00E2u d\u00E0i.",
        "EnglishMeaning": "After a month, the office should review usage before making a long-term decision.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.reports.04"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.reports.04.ebf3b104221d4b46aafc70423cdb1ce3",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 7,
        "VietnameseText": "L\u1ECBch \u0111i\u1EC7n t\u1EED cho ph\u00E9p ki\u1EC3m tra t\u1EEB b\u00E0n l\u00E0m vi\u1EC7c v\u00E0 ch\u1EC9 c\u00F3 m\u1ED9t l\u1EA7n tr\u00F9ng.",
        "EnglishMeaning": "The digital calendar could be checked from a desk and had just one overlap.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.reports.04"
      }
    }
  ],
