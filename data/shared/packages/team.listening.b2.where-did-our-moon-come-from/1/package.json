        "EndTime": 49.8
      },
      "references": {
        "LessonId": "team.listening.b2.where-did-our-moon-come-from"
      }
    },
    {
      "key": "team.listening.b2.where-did-our-moon-come-from.1c26ea18cb744042a35451b5bf2fe06d",
      "kind": "ListeningTranscriptLine",
      "values": {
        "OrderIndex": 11,
        "Speaker": "Narrator",
        "Text": "And this collision ripped apart early Earth\u0027s crust.",
        "VietnameseMeaning": "V\u00E0 v\u1EE5 va ch\u1EA1m n\u00E0y \u0111\u00E3 x\u00E9 to\u1EA1c l\u1EDBp v\u1ECF c\u1EE7a Tr\u00E1i \u0110\u1EA5t thu\u1EDF s\u01A1 khai.",
