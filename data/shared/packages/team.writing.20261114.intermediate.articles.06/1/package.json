  "records": [
    {
      "key": "team.writing.20261114.intermediate.articles.06",
      "kind": "WritingExercise",
      "values": {
        "Title": "Gi\u1EEF cu\u1ED9c trao \u0111\u1ED5i nh\u00F3m r\u00F5 r\u00E0ng tr\u00EAn m\u1EA1ng",
        "Level": "intermediate",
        "ContentType": "articles",
        "Topic": "L\u00E0m vi\u1EC7c nh\u00F3m",
        "SourceType": "original-20261114",
        "PreviewText": "B\u00E0i vi\u1EBFt h\u01B0\u1EDBng d\u1EABn vi\u1EBFt tin nh\u1EAFn c\u00F4ng vi\u1EC7c c\u00F3 ng\u1EEF c\u1EA3nh, y\u00EAu c\u1EA7u v\u00E0 th\u1EDDi h\u1EA1n.",
        "IsPublished": true
      },
      "references": {}
    },
    {
      "key": "team.writing.20261114.intermediate.articles.06.0eee29daae2d4317b59899316bebf2a2",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 3,
        "VietnameseText": "H\u00E3y b\u1EAFt \u0111\u1EA7u b\u1EB1ng nhi\u1EC7m v\u1EE5 \u0111ang l\u00E0m v\u00E0 m\u00F4 t\u1EA3 ng\u1EAFn \u0111i\u1EC1u b\u1EA1n \u0111\u00E3 th\u1EED.",
        "EnglishMeaning": "Start with the task you are working on and briefly describe what you have tried.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.articles.06"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.articles.06.11217b9f96db4f838f3793b01d5d3e8e",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 12,
        "VietnameseText": "Nh\u1EEFng th\u00F3i quen nh\u1ECF n\u00E0y gi\u00FAp c\u00F4ng vi\u1EC7c ti\u1EBFp t\u1EE5c ngay c\u1EA3 khi m\u1ECDi ng\u01B0\u1EDDi kh\u00F4ng tr\u1EF1c tuy\u1EBFn c\u00F9ng l\u00FAc.",
        "EnglishMeaning": "These small habits keep work moving even when people are not online together.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.articles.06"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.articles.06.31ee6b4241764bde984243a792f420a8",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 4,
        "VietnameseText": "Sau \u0111\u00F3 n\u00EAu \u0111i\u1EC1u c\u1EE5 th\u1EC3 m\u00E0 b\u1EA1n c\u1EA7n nh\u00F3m gi\u00FAp quy\u1EBFt \u0111\u1ECBnh.",
        "EnglishMeaning": "Then state the specific point you need the group to help decide.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.articles.06"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.articles.06.76cdd06b0e61472894c67898af936875",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 5,
        "VietnameseText": "N\u1EBFu tin nh\u1EAFn c\u00F3 h\u1EA1n tr\u1EA3 l\u1EDDi, h\u00E3y ghi th\u1EDDi \u0111i\u1EC3m v\u00E0 l\u00FD do r\u00F5 r\u00E0ng.",
        "EnglishMeaning": "If your message has a response deadline, give the time and the reason clearly.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.articles.06"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.articles.06.8103f9323931460b8358851bdf648434",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 2,
        "VietnameseText": "M\u1ED9t c\u00E2u h\u1ECFi ch\u1EC9 ghi r\u1EB1ng c\u00F3 v\u1EA5n \u0111\u1EC1 th\u01B0\u1EDDng bu\u1ED9c ng\u01B0\u1EDDi kh\u00E1c ph\u1EA3i h\u1ECFi l\u1EA1i.",
        "EnglishMeaning": "A question saying only that there is a problem usually forces others to ask for details.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.articles.06"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.articles.06.884aca46fa844c39bc8b6ab0e2835d70",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 1,
        "VietnameseText": "Trong m\u1ED9t nh\u00F3m tr\u1EF1c tuy\u1EBFn, tin nh\u1EAFn r\u00F5 r\u00E0ng c\u00F3 th\u1EC3 ti\u1EBFt ki\u1EC7m th\u1EDDi gian cho m\u1ECDi ng\u01B0\u1EDDi.",
        "EnglishMeaning": "In an online group, clear messages can save time for everyone involved.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.articles.06"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.articles.06.8f9f219b0d3b48219e5d2bfec234e7c7",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 9,
        "VietnameseText": "Sau khi c\u00F3 quy\u1EBFt \u0111\u1ECBnh, m\u1ED9t ng\u01B0\u1EDDi n\u00EAn t\u00F3m t\u1EAFt k\u1EBFt qu\u1EA3 trong cu\u1ED9c trao \u0111\u1ED5i.",
        "EnglishMeaning": "Once a decision is made, someone should summarise the outcome in the conversation.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.articles.06"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.articles.06.9d79908fb8714f5abfb246801261c936",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 8,
        "VietnameseText": "Ng\u01B0\u1EDDi nh\u1EADn s\u1EBD \u00EDt nh\u1EA7m l\u1EABn h\u01A1n khi c\u1EA3 nh\u00F3m xem c\u00F9ng m\u1ED9t ngu\u1ED3n.",
        "EnglishMeaning": "Recipients are less likely to become confused when everyone uses the same source.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.articles.06"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.articles.06.c4691592c4264b9ea0a6aec64711a43a",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 7,
        "VietnameseText": "\u0110\u1ED1i v\u1EDBi t\u00E0i li\u1EC7u, h\u00E3y g\u1EEDi \u0111\u01B0\u1EDDng d\u1EABn \u0111\u1EBFn b\u1EA3n hi\u1EC7n t\u1EA1i thay v\u00EC nhi\u1EC1u b\u1EA3n sao.",
        "EnglishMeaning": "For documents, share a link to the current version rather than several copies.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.articles.06"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.articles.06.cc4be97df9c741bd929e6dccbe3a67aa",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 11,
        "VietnameseText": "Nh\u1EDD v\u1EADy, th\u00E0nh vi\u00EAn v\u1EAFng m\u1EB7t c\u00F3 th\u1EC3 theo k\u1ECBp m\u00E0 kh\u00F4ng ph\u1EA3i \u0111\u1ECDc l\u1EA1i m\u1ECDi tin nh\u1EAFn.",
        "EnglishMeaning": "This allows absent members to catch up without rereading every message.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.articles.06"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.articles.06.d92b388932794cbabc4e8cdb75161c22",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 6,
        "VietnameseText": "Kh\u00F4ng n\u00EAn \u0111\u00E1nh d\u1EA5u m\u1ECDi y\u00EAu c\u1EA7u l\u00E0 kh\u1EA9n c\u1EA5p v\u00EC \u0111i\u1EC1u \u0111\u00F3 l\u00E0m m\u1EA5t \u00FD ngh\u0129a c\u1EE7a nh\u00E3n.",
        "EnglishMeaning": "Avoid marking every request as urgent, since that makes the label less meaningful.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.articles.06"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.articles.06.e3c21e8a45264835a901b1dac5dc01af",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 10,
        "VietnameseText": "B\u1EA3n t\u00F3m t\u1EAFt c\u1EA7n ghi ai s\u1EBD l\u00E0m g\u00EC v\u00E0 khi n\u00E0o c\u1EA7n ho\u00E0n th\u00E0nh.",
        "EnglishMeaning": "The summary should say who will do what and when it needs to be finished.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.articles.06"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.articles.06.edaff36588714471af34ea8609f9e7cb",
      "kind": "WritingAcceptedAnswer",
      "values": {
        "AnswerText": "As a result, members who were away can catch up without reading all the messages again.",
        "NormalizedHash": "3cc65e20fbe437f124ed9bc8911e94ecab5295203802d0428ab075d9b906fd51"
      },
      "references": {
        "WritingExerciseSentenceId": "team.writing.20261114.intermediate.articles.06.cc4be97df9c741bd929e6dccbe3a67aa",
        "ApprovedByUserId": "owner:system"
      }
    }
  ],
