    },
    {
      "key": "team.writing.20261114.beginner.rainy-match.e123c56c4fb54e68b55d26265662c409",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 3,
        "VietnameseText": "Nh\u01B0ng tr\u1EDDi b\u1EAFt \u0111\u1EA7u m\u01B0a ngay khi ch\u00FAng t\u00F4i ra c\u1EEDa.",
        "EnglishMeaning": "But it started to rain just as we went outside.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.beginner.rainy-match"
      }
    },
    {
      "key": "team.writing.20261114.beginner.rainy-match.f371458366fe461e8a594c7b22b0b2c4",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 8,
        "VietnameseText": "\u0110\u00F4i khi m\u1ED9t k\u1EBF ho\u1EA1ch m\u1EDBi c\u0169ng mang l\u1EA1i nh\u1EEFng k\u1EF7 ni\u1EC7m \u0111\u1EB9p.",
        "EnglishMeaning": "Sometimes a new plan can also bring happy memories.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.beginner.rainy-match"
      }
    },
    {
      "key": "team.writing.20261114.beginner.rainy-match.f3af548757dd45b3ba7c1c5443a64d17",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 2,
        "VietnameseText": "T\u00F4i mang v\u1EE3t \u0111\u1EBFn nh\u00E0 b\u1EA1n An sau b\u1EEFa tr\u01B0a.",
        "EnglishMeaning": "I brought my racket to An\u0027s house after lunch.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.beginner.rainy-match"
      }
    },
    {
      "key": "team.writing.20261114.beginner.rainy-match.f7b89b330c6a4b669dacc653d1dfe554",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 1,
        "VietnameseText": "H\u00F4m nay ch\u00FAng t\u00F4i \u0111\u1ECBnh ch\u01A1i c\u1EA7u l\u00F4ng \u1EDF c\u00F4ng vi\u00EAn.",
        "EnglishMeaning": "Today we planned to play badminton in the park.",
        "BreakAfter": false
      },
      "references": {
