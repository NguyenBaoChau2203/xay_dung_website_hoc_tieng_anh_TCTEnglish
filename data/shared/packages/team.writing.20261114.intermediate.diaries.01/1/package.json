  "version": 1,
  "dependsOn": [],
  "records": [
    {
      "key": "team.writing.20261114.intermediate.diaries.01",
      "kind": "WritingExercise",
      "values": {
        "Title": "L\u1EA7n \u0111\u1EA7u \u0111i\u1EC1u ph\u1ED1i cu\u1ED9c h\u1ECDp",
        "Level": "intermediate",
        "ContentType": "diaries",
        "Topic": "Tr\u1EA3i nghi\u1EC7m c\u00F4ng vi\u1EC7c",
        "SourceType": "original-20261114",
        "PreviewText": "Nh\u1EADt k\u00FD nh\u00ECn l\u1EA1i l\u1EA7n \u0111i\u1EC1u ph\u1ED1i cu\u1ED9c h\u1ECDp v\u00E0 b\u00E0i h\u1ECDc v\u1EC1 l\u1EAFng nghe.",
        "IsPublished": true
      },
      "references": {}
    },
    {
      "key": "team.writing.20261114.intermediate.diaries.01.111dbd68b1a34df19b2da8817717aa70",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 2,
        "VietnameseText": "T\u1ED1i qua t\u00F4i \u0111\u00E3 chu\u1EA9n b\u1ECB m\u1ED9t danh s\u00E1ch c\u00E2u h\u1ECFi v\u00EC s\u1EE3 cu\u1ED9c th\u1EA3o lu\u1EADn b\u1ECB ng\u1EEBng l\u1EA1i.",
        "EnglishMeaning": "Last night I prepared a list of questions because I feared the discussion might stop.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.diaries.01"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.diaries.01.2691bf97e48d4e18bfdfc62c3689fae2",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 12,
        "VietnameseText": "L\u1EA7n t\u1EDBi t\u00F4i s\u1EBD ghi m\u1EE5c ti\u00EAu l\u00EAn \u0111\u1EA7u trang \u0111\u1EC3 kh\u00F4ng b\u1ECF s\u00F3t n\u1EEFa.",
        "EnglishMeaning": "Next time I will write the aim at the top of the page so I remember it.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.diaries.01"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.diaries.01.2ae224b6669b42f58015a2e8a24c1cfb",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 11,
        "VietnameseText": "D\u00F9 v\u1EADy, t\u00F4i t\u1EF1 h\u00E0o v\u00EC \u0111\u00E3 b\u00ECnh t\u0129nh h\u01A1n thay v\u00EC c\u1ED1 t\u1ECF ra ho\u00E0n h\u1EA3o.",
        "EnglishMeaning": "Even so, I am proud that I became calmer instead of trying to seem perfect.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.diaries.01"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.diaries.01.2e0b2540497242af8a9d760cd8eae39a",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 10,
        "VietnameseText": "T\u00F4i v\u1EABn th\u1EA5y h\u01A1i ng\u01B0\u1EE3ng khi nh\u1EDB l\u1EA1i ph\u1EA7n m\u1EDF \u0111\u1EA7u v\u1ED9i v\u00E0ng c\u1EE7a m\u00ECnh.",
        "EnglishMeaning": "I still feel slightly embarrassed when I remember my rushed introduction.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.diaries.01"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.diaries.01.68ce1d8dfe2243c4a078d0e75ac1dd90",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 3,
        "VietnameseText": "Khi m\u1ECDi ng\u01B0\u1EDDi ng\u1ED3i xu\u1ED1ng, t\u00F4i n\u00F3i nhanh \u0111\u1EBFn m\u1EE9c qu\u00EAn gi\u1EDBi thi\u1EC7u m\u1EE5c ti\u00EAu.",
        "EnglishMeaning": "When everyone sat down, I spoke so quickly that I forgot to explain the aim.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.diaries.01"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.diaries.01.78711050c0064f00b780598e8768d14a",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 9,
        "VietnameseText": "Cu\u1ED9c h\u1ECDp k\u1EBFt th\u00FAc mu\u1ED9n n\u0103m ph\u00FAt, nh\u01B0ng ch\u00FAng t\u00F4i th\u1ED1ng nh\u1EA5t \u0111\u01B0\u1EE3c c\u00E1c b\u01B0\u1EDBc ti\u1EBFp theo.",
        "EnglishMeaning": "The meeting finished five minutes late, but we agreed on the next steps.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.diaries.01"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.diaries.01.7894ac83212544daafea348fbd61a42a",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 6,
        "VietnameseText": "C\u00F4ng vi\u1EC7c c\u1EE7a t\u00F4i l\u00E0 gi\u00FAp m\u1ECDi ng\u01B0\u1EDDi chia s\u1EBB \u00FD ki\u1EBFn v\u00E0 hi\u1EC3u nhau.",
        "EnglishMeaning": "My job was to help people share their views and understand each other.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.diaries.01"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.diaries.01.8c2012bbd9c44807a7f695d01bfdc768",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 7,
        "VietnameseText": "T\u00F4i b\u1EAFt \u0111\u1EA7u ch\u1EDD l\u00E2u h\u01A1n tr\u01B0\u1EDBc khi chuy\u1EC3n sang ch\u1EE7 \u0111\u1EC1 ti\u1EBFp theo.",
        "EnglishMeaning": "I began waiting longer before moving on to the next topic.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.diaries.01"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.diaries.01.9b67ffc70c7f46698aa111394e6b9cd9",
      "kind": "WritingAcceptedAnswer",
      "values": {
        "AnswerText": "Next time I will put the aim at the top of the page to help me remember it.",
        "NormalizedHash": "05919576b503f9eea019c6e5a1e4f1bcffefa052905c0adf6c481d88653b9fbb"
      },
      "references": {
        "WritingExerciseSentenceId": "team.writing.20261114.intermediate.diaries.01.2691bf97e48d4e18bfdfc62c3689fae2",
        "ApprovedByUserId": "owner:system"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.diaries.01.a8dabd7829934f9ebf8df5dcfa0e9b49",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 8,
        "VietnameseText": "M\u1ED9t th\u00E0nh vi\u00EAn th\u01B0\u1EDDng \u00EDt n\u00F3i \u0111\u00E3 \u0111\u1EC1 xu\u1EA5t c\u00E1ch gi\u1EA3i quy\u1EBFt m\u00E0 ch\u00FAng t\u00F4i ch\u01B0a ngh\u0129 \u0111\u1EBFn.",
        "EnglishMeaning": "A usually quiet member suggested a solution that none of us had considered.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.diaries.01"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.diaries.01.aef8ff155d8641e78a7609176b63d2d2",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 1,
        "VietnameseText": "S\u00E1ng nay t\u00F4i \u0111i\u1EC1u ph\u1ED1i cu\u1ED9c h\u1ECDp nh\u00F3m l\u1EA7n \u0111\u1EA7u ti\u00EAn k\u1EC3 t\u1EEB khi v\u00E0o c\u00F4ng ty.",
        "EnglishMeaning": "This morning I led a team meeting for the first time since joining the company.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.diaries.01"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.diaries.01.c899a13949bf4763bbec252b0748d328",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 4,
        "VietnameseText": "May l\u00E0 m\u1ED9t \u0111\u1ED3ng nghi\u1EC7p \u0111\u00E3 nh\u1EB9 nh\u00E0ng nh\u1EAFc t\u00F4i v\u00E0 gi\u00FAp c\u1EA3 nh\u00F3m t\u1EADp trung.",
        "EnglishMeaning": "Fortunately, a colleague gently reminded me and helped the group focus.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.diaries.01"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.diaries.01.f98d8993bce043f69d89f40d06c324ed",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 5,
        "VietnameseText": "Sau v\u00E0i ph\u00FAt, t\u00F4i nh\u1EADn ra m\u00ECnh kh\u00F4ng c\u1EA7n tr\u1EA3 l\u1EDDi m\u1ECDi c\u00E2u h\u1ECFi.",
        "EnglishMeaning": "After a few minutes, I realised that I did not need to answer every question.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.diaries.01"
      }
    }
  ],
