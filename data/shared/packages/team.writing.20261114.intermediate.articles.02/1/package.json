  "records": [
    {
      "key": "team.writing.20261114.intermediate.articles.02",
      "kind": "WritingExercise",
      "values": {
        "Title": "Chu\u1EA9n b\u1ECB cho m\u1ED9t cu\u1ED9c ph\u1ECFng v\u1EA5n tr\u1EF1c tuy\u1EBFn",
        "Level": "intermediate",
        "ContentType": "articles",
        "Topic": "Ngh\u1EC1 nghi\u1EC7p",
        "SourceType": "original-20261114",
        "PreviewText": "B\u00E0i vi\u1EBFt \u0111\u01B0a c\u00E1c b\u01B0\u1EDBc chu\u1EA9n b\u1ECB th\u1EF1c t\u1EBF tr\u01B0\u1EDBc v\u00E0 trong ph\u1ECFng v\u1EA5n qua m\u1EA1ng.",
        "IsPublished": true
      },
      "references": {}
    },
    {
      "key": "team.writing.20261114.intermediate.articles.02.26ba866d1c964c73be9436a2ab203210",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 9,
        "VietnameseText": "N\u1EBFu \u00E2m thanh b\u1ECB ng\u1EAFt, h\u00E3y xin ng\u01B0\u1EDDi ph\u1ECFng v\u1EA5n nh\u1EAFc l\u1EA1i c\u00E2u h\u1ECFi.",
        "EnglishMeaning": "If the sound cuts out, ask the interviewer to repeat the question.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.articles.02"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.articles.02.28a5563f3c2f44cbb884ce22b97c074e",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 12,
        "VietnameseText": "Chu\u1EA9n b\u1ECB chu \u0111\u00E1o kh\u00F4ng \u0111\u1EA3m b\u1EA3o \u0111\u01B0\u1EE3c tuy\u1EC3n, nh\u01B0ng s\u1EBD gi\u00FAp b\u1EA1n th\u1EC3 hi\u1EC7n r\u00F5 h\u01A1n.",
        "EnglishMeaning": "Careful preparation does not guarantee a job, but it helps you present yourself more clearly.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.articles.02"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.articles.02.467e05bbb51f45b7ac5aa28518ecd2b6",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 8,
        "VietnameseText": "H\u00E3y t\u1EADp n\u00F3i \u0111\u1EE7 ch\u1EADm \u0111\u1EC3 ng\u01B0\u1EDDi nghe theo k\u1ECBp d\u00F9 k\u1EBFt n\u1ED1i c\u00F3 \u0111\u1ED9 tr\u1EC5.",
        "EnglishMeaning": "Practise speaking slowly enough for listeners to follow even if the connection has a delay.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.articles.02"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.articles.02.4811492643444db5a6a380298d2495ec",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 7,
        "VietnameseText": "Ghi v\u00E0i t\u1EEB kh\u00F3a s\u1EBD h\u1EEFu \u00EDch h\u01A1n vi\u1EC7c \u0111\u1ECDc nguy\u00EAn c\u00E2u tr\u1EA3 l\u1EDDi \u0111\u00E3 vi\u1EBFt s\u1EB5n.",
        "EnglishMeaning": "Writing a few keywords is more useful than reading an entire prepared answer.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.articles.02"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.articles.02.6406b9e012954cd9bad65bfa33ac7b83",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 5,
        "VietnameseText": "V\u1EC1 n\u1ED9i dung, h\u00E3y chu\u1EA9n b\u1ECB v\u00E0i v\u00ED d\u1EE5 c\u1EE5 th\u1EC3 t\u1EEB kinh nghi\u1EC7m c\u1EE7a m\u00ECnh.",
        "EnglishMeaning": "For the content, prepare a few specific examples from your own experience.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.articles.02"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.articles.02.74d06f0904344a3ba12d3bb484a0f22d",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 2,
        "VietnameseText": "Tr\u01B0\u1EDBc ng\u00E0y h\u1EB9n, h\u00E3y ki\u1EC3m tra \u0111\u01B0\u1EDDng d\u1EABn v\u00E0 ph\u1EA7n m\u1EC1m m\u00E0 b\u00EAn tuy\u1EC3n d\u1EE5ng s\u1EED d\u1EE5ng.",
        "EnglishMeaning": "Before the appointment, check the link and the software used by the employer.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.articles.02"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.articles.02.95d90db5409448119feba28e0888cfc1",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 3,
        "VietnameseText": "Th\u1EED \u00E2m thanh v\u1EDBi m\u1ED9t ng\u01B0\u1EDDi b\u1EA1n s\u1EBD gi\u00FAp ph\u00E1t hi\u1EC7n v\u1EA5n \u0111\u1EC1 s\u1EDBm.",
        "EnglishMeaning": "Testing the sound with a friend will help you discover problems early.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.articles.02"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.articles.02.a6e97c979f1e44d9a46a4d1e817936ec",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 10,
        "VietnameseText": "B\u1EA1n kh\u00F4ng c\u1EA7n \u0111o\u00E1n r\u1ED3i tr\u1EA3 l\u1EDDi m\u1ED9t \u0111i\u1EC1u ch\u01B0a nghe r\u00F5.",
        "EnglishMeaning": "You do not need to guess and answer something you have not heard clearly.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.articles.02"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.articles.02.b09d3033e91c4f70ab430ba8116f7e7b",
      "kind": "WritingAcceptedAnswer",
      "values": {
        "AnswerText": "If the audio stops briefly, request that the interviewer ask the question again.",
        "NormalizedHash": "05ada7e0e71319e003f135d4555c25495bd0241512a895cbc6ecd50cdf66e253"
      },
      "references": {
        "WritingExerciseSentenceId": "team.writing.20261114.intermediate.articles.02.26ba866d1c964c73be9436a2ab203210",
        "ApprovedByUserId": "owner:system"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.articles.02.b19d9cf60e8043bbbf3b5b665a91c19b",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 6,
        "VietnameseText": "M\u1ED7i v\u00ED d\u1EE5 n\u00EAn n\u00EAu t\u00ECnh hu\u1ED1ng, vi\u1EC7c b\u1EA1n l\u00E0m v\u00E0 k\u1EBFt qu\u1EA3 \u0111\u1EA1t \u0111\u01B0\u1EE3c.",
        "EnglishMeaning": "Each example should explain the situation, your actions and the outcome.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.articles.02"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.articles.02.baae4696cffe4b2ab5da32d6c31aa72d",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 1,
        "VietnameseText": "M\u1ED9t cu\u1ED9c ph\u1ECFng v\u1EA5n tr\u1EF1c tuy\u1EBFn b\u1EAFt \u0111\u1EA7u thu\u1EADn l\u1EE3i h\u01A1n khi b\u1EA1n chu\u1EA9n b\u1ECB c\u1EA3 n\u1ED9i dung l\u1EABn thi\u1EBFt b\u1ECB.",
        "EnglishMeaning": "An online interview starts more smoothly when you prepare both your answers and your equipment.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.articles.02"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.articles.02.d188cd9add7149b897655b8b54e3c3ec",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 11,
        "VietnameseText": "Cu\u1ED1i bu\u1ED5i, h\u00E3y h\u1ECFi v\u1EC1 c\u00E1c b\u01B0\u1EDBc ti\u1EBFp theo v\u00E0 c\u1EA3m \u01A1n ng\u01B0\u1EDDi ph\u1ECFng v\u1EA5n.",
        "EnglishMeaning": "At the end, ask about the next steps and thank the interviewer.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.articles.02"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.articles.02.e8ae0a6d993f4a679b3ccd0cee35483b",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 4,
        "VietnameseText": "B\u1EA1n c\u0169ng n\u00EAn ch\u1ECDn n\u01A1i \u00EDt b\u1ECB gi\u00E1n \u0111o\u1EA1n v\u00E0 \u0111\u1EB7t m\u00E1y \u1EDF \u0111\u1ED9 cao ph\u00F9 h\u1EE3p.",
        "EnglishMeaning": "You should also choose somewhere with few interruptions and position the camera at a suitable height.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.articles.02"
      }
    }
  ],
