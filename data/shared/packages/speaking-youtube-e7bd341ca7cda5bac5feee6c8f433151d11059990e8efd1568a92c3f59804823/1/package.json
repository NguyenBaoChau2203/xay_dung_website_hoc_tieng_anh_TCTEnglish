    },
    {
      "key": "tct.speaking.youtube.e7bd341ca7cda5bac5feee6c8f433151d11059990e8efd1568a92c3f59804823.dd53e096d4f743ba8b273a6a04c80c4c",
      "kind": "SpeakingSentence",
      "values": {
        "StartTime": 302,
        "EndTime": 309.039,
        "Text": "Yes, I\u0027m being nice. Don\u0027t push your luck. Okay. Okay. 900 p.m. I promise.",
        "VietnameseMeaning": ""
      },
      "references": {
        "VideoId": "tct.speaking.youtube.e7bd341ca7cda5bac5feee6c8f433151d11059990e8efd1568a92c3f59804823"
