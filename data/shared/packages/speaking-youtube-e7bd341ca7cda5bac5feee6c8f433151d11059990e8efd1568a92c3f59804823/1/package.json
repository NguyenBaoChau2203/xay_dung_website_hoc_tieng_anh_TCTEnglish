      "kind": "SpeakingSentence",
      "values": {
        "StartTime": 229,
        "EndTime": 231.76,
        "Text": "I\u0027ll be careful. I promise.",
        "VietnameseMeaning": ""
      },
      "references": {
        "VideoId": "tct.speaking.youtube.e7bd341ca7cda5bac5feee6c8f433151d11059990e8efd1568a92c3f59804823"
