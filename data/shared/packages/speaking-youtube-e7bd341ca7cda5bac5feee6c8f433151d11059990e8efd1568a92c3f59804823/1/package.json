    },
    {
      "key": "tct.speaking.youtube.e7bd341ca7cda5bac5feee6c8f433151d11059990e8efd1568a92c3f59804823.e7ed4e3f80a14f1daa628692e53fb592",
      "kind": "SpeakingSentence",
      "values": {
        "StartTime": 185,
        "EndTime": 192.56,
        "Text": "Just with my friends. We want to hang out and eat something. What time will you come home? Maybe around 10:00 p.m.",
        "VietnameseMeaning": ""
      },
      "references": {
        "VideoId": "tct.speaking.youtube.e7bd341ca7cda5bac5feee6c8f433151d11059990e8efd1568a92c3f59804823"
      }
    },
    {
      "key": "tct.speaking.youtube.e7bd341ca7cda5bac5feee6c8f433151d11059990e8efd1568a92c3f59804823.e95bf8eb155843e2834ed1243f819d86",
      "kind": "SpeakingSentence",
      "values": {
        "StartTime": 236,
        "EndTime": 244.08,
        "Text": "8:00 p.m. That\u0027s so early. We haven\u0027t even finished eating by then. Then don\u0027t eat too slow.",
        "VietnameseMeaning": ""
      },
      "references": {
        "VideoId": "tct.speaking.youtube.e7bd341ca7cda5bac5feee6c8f433151d11059990e8efd1568a92c3f59804823"
      }
    },
    {
      "key": "tct.speaking.youtube.e7bd341ca7cda5bac5feee6c8f433151d11059990e8efd1568a92c3f59804823.ea1240787e0e4bf48a2a77afad5c9851",
      "kind": "SpeakingSentence",
      "values": {
        "StartTime": 285,
        "EndTime": 292.479,
        "Text": "You bought ice cream and didn\u0027t even eat dinner. That was last time. I\u0027ve changed. Really? For one week?",
        "VietnameseMeaning": ""
      },
      "references": {
        "VideoId": "tct.speaking.youtube.e7bd341ca7cda5bac5feee6c8f433151d11059990e8efd1568a92c3f59804823"
      }
    },
    {
      "key": "tct.speaking.youtube.e7bd341ca7cda5bac5feee6c8f433151d11059990e8efd1568a92c3f59804823.ec8abba8a1e44c59ab9dcce9576dd1eb",
      "kind": "SpeakingSentence",
      "values": {
        "StartTime": 416,
        "EndTime": 419.919,
        "Text": "Fine. [snorts] Then can I at least get some more money?",
        "VietnameseMeaning": ""
      },
      "references": {
        "VideoId": "tct.speaking.youtube.e7bd341ca7cda5bac5feee6c8f433151d11059990e8efd1568a92c3f59804823"
      }
    },
    {
      "key": "tct.speaking.youtube.e7bd341ca7cda5bac5feee6c8f433151d11059990e8efd1568a92c3f59804823.ee69efd600f24d3389f573b425dbcae1",
      "kind": "SpeakingSentence",
      "values": {
        "StartTime": 45,
        "EndTime": 53.36,
        "Text": "You still live in my house, so you follow my rules. Mom, you never let me do anything fun.",
        "VietnameseMeaning": ""
      },
      "references": {
        "VideoId": "tct.speaking.youtube.e7bd341ca7cda5bac5feee6c8f433151d11059990e8efd1568a92c3f59804823"
      }
    },
    {
      "key": "tct.speaking.youtube.e7bd341ca7cda5bac5feee6c8f433151d11059990e8efd1568a92c3f59804823.f51219b456a84f1fb6f60efea051986d",
      "kind": "SpeakingSentence",
      "values": {
        "StartTime": 182,
        "EndTime": 185.84,
        "Text": "Mom, can I go out tonight? Out? Where are you going?",
        "VietnameseMeaning": ""
      },
      "references": {
        "VideoId": "tct.speaking.youtube.e7bd341ca7cda5bac5feee6c8f433151d11059990e8efd1568a92c3f59804823"
      }
    },
    {
      "key": "tct.speaking.youtube.e7bd341ca7cda5bac5feee6c8f433151d11059990e8efd1568a92c3f59804823.f78471320bc54922b1d5082b5b926f89",
      "kind": "SpeakingSentence",
      "values": {
        "StartTime": 18,
        "EndTime": 25.439,
        "Text": "Just with my friends. We want to hang out and eat something. What time will you come home? Maybe around 10:00 p.m.",
        "VietnameseMeaning": ""
      },
      "references": {
        "VideoId": "tct.speaking.youtube.e7bd341ca7cda5bac5feee6c8f433151d11059990e8efd1568a92c3f59804823"
