    },
    {
      "key": "tct.speaking.youtube.e7bd341ca7cda5bac5feee6c8f433151d11059990e8efd1568a92c3f59804823.f87ddbd1abdd45568a9d7f90d9731d0e",
      "kind": "SpeakingSentence",
      "values": {
        "StartTime": 490,
        "EndTime": 491.68,
        "Text": "Fine.",
        "VietnameseMeaning": ""
      },
      "references": {
        "VideoId": "tct.speaking.youtube.e7bd341ca7cda5bac5feee6c8f433151d11059990e8efd1568a92c3f59804823"
      }
    },
    {
      "key": "tct.speaking.youtube.e7bd341ca7cda5bac5feee6c8f433151d11059990e8efd1568a92c3f59804823.fc323e30c29e4838b4e0756c8984f54d",
      "kind": "SpeakingSentence",
      "values": {
        "StartTime": 138,
        "EndTime": 147.04,
        "Text": "Okay. Okay. 900 p.m. I promise. And don\u0027t forget to text me where you are. Yes, Mom. You\u0027re the best.",
        "VietnameseMeaning": ""
      },
      "references": {
        "VideoId": "tct.speaking.youtube.e7bd341ca7cda5bac5feee6c8f433151d11059990e8efd1568a92c3f59804823"
      }
    },
    {
      "key": "tct.speaking.youtube.e7bd341ca7cda5bac5feee6c8f433151d11059990e8efd1568a92c3f59804823.fcb11529ebb042a196f9f30d9bb5a711",
      "kind": "SpeakingSentence",
      "values": {
        "StartTime": 53,
        "EndTime": 62.16,
        "Text": "That\u0027s not true. You went out last weekend, remember? But that was just for 2 hours. That\u0027s enough. I worry about you.",
        "VietnameseMeaning": ""
      },
      "references": {
        "VideoId": "tct.speaking.youtube.e7bd341ca7cda5bac5feee6c8f433151d11059990e8efd1568a92c3f59804823"
      }
    },
    {
      "key": "tct.speaking.youtube.e7bd341ca7cda5bac5feee6c8f433151d11059990e8efd1568a92c3f59804823.ff41fa74d03a41f880f0c68a2e11fa1d",
      "kind": "SpeakingSentence",
      "values": {
        "StartTime": 202,
        "EndTime": 205.36,
        "Text": "But all my friends can stay out until 10:00.",
        "VietnameseMeaning": ""
      },
      "references": {
