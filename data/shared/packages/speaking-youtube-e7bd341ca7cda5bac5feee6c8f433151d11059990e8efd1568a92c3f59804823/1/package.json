    {
      "key": "tct.speaking.youtube.e7bd341ca7cda5bac5feee6c8f433151d11059990e8efd1568a92c3f59804823.d5c823f921a14019890a6c3568bda52b",
      "kind": "SpeakingSentence",
      "values": {
        "StartTime": 231,
        "EndTime": 236.64,
        "Text": "No, Ben. 1000 p.m. is too late. You can come home by 8.",
        "VietnameseMeaning": ""
      },
      "references": {
        "VideoId": "tct.speaking.youtube.e7bd341ca7cda5bac5feee6c8f433151d11059990e8efd1568a92c3f59804823"
