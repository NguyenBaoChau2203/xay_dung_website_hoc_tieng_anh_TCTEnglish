    {
      "key": "tct.speaking.youtube.e7bd341ca7cda5bac5feee6c8f433151d11059990e8efd1568a92c3f59804823.e449c4d661ae48a697561cff05d182dd",
      "kind": "SpeakingSentence",
      "values": {
        "StartTime": 92,
        "EndTime": 99.92,
        "Text": "For food and maybe some milk tea and maybe a taxi home. You don\u0027t need a taxi. You can walk.",
        "VietnameseMeaning": ""
      },
      "references": {
        "VideoId": "tct.speaking.youtube.e7bd341ca7cda5bac5feee6c8f433151d11059990e8efd1568a92c3f59804823"
