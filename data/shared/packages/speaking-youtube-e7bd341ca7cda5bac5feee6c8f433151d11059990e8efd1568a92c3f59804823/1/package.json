    },
    {
      "key": "tct.speaking.youtube.e7bd341ca7cda5bac5feee6c8f433151d11059990e8efd1568a92c3f59804823.dff557b0460348f68efa574f22130a32",
      "kind": "SpeakingSentence",
      "values": {
        "StartTime": 339,
        "EndTime": 347.08,
        "Text": "Okay. Okay. I\u0027ll be back early. Good boy. Now, hurry up.",
        "VietnameseMeaning": ""
      },
      "references": {
        "VideoId": "tct.speaking.youtube.e7bd341ca7cda5bac5feee6c8f433151d11059990e8efd1568a92c3f59804823"
