      "references": {}
    },
    {
      "key": "team.writing.20261114.beginner.museum-afternoon.22d603df66244b05a7e1b716fb9dd990",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 6,
        "VietnameseText": "Khi v\u1EC1 nh\u00E0, t\u00F4i k\u1EC3 cho \u00F4ng nghe v\u1EC1 chi\u1EBFc \u0111\u00E0i.",
        "EnglishMeaning": "When I got home, I told my grandfather about the radio.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.beginner.museum-afternoon"
      }
    },
    {
      "key": "team.writing.20261114.beginner.museum-afternoon.2ba1502f42a84ae58779ec7942c7b68e",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 4,
        "VietnameseText": "C\u00F4 h\u01B0\u1EDBng d\u1EABn gi\u1EA3i th\u00EDch c\u00E1ch m\u1ECDi ng\u01B0\u1EDDi nghe tin t\u1EE9c tr\u01B0\u1EDBc \u0111\u00E2y.",
        "EnglishMeaning": "Our guide explained how people listened to the news in the past.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.beginner.museum-afternoon"
      }
    },
    {
      "key": "team.writing.20261114.beginner.museum-afternoon.326f6449bb5e45588405c7380113292a",
      "kind": "WritingAcceptedAnswer",
      "values": {
        "AnswerText": "I noted down a few new words in my notebook.",
