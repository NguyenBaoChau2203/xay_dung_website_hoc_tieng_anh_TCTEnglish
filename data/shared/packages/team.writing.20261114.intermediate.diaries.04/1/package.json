  "version": 1,
  "dependsOn": [],
  "records": [
    {
      "key": "team.writing.20261114.intermediate.diaries.04",
      "kind": "WritingExercise",
      "values": {
        "Title": "Chuy\u1EBFn t\u00E0u l\u1EE1 v\u00E0 bu\u1ED5i chi\u1EC1u kh\u00E1c k\u1EBF ho\u1EA1ch",
        "Level": "intermediate",
        "ContentType": "diaries",
        "Topic": "Du l\u1ECBch",
        "SourceType": "original-20261114",
        "PreviewText": "Nh\u1EADt k\u00FD x\u1EED l\u00FD chuy\u1EBFn t\u00E0u b\u1ECB l\u1EE1 v\u00E0 t\u00ECm ni\u1EC1m vui trong l\u1ECBch tr\u00ECnh m\u1EDBi.",
        "IsPublished": true
      },
      "references": {}
    },
    {
      "key": "team.writing.20261114.intermediate.diaries.04.09ce43dc1f9342aca1c27ea9700a924e",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 10,
        "VietnameseText": "Tuy nhi\u00EAn, kho\u1EA3ng ch\u1EDD \u0111\u00F3 \u0111\u00E3 cho t\u00F4i m\u1ED9t bu\u1ED5i ngh\u1EC9 th\u1EF1c s\u1EF1 hi\u1EBFm c\u00F3.",
        "EnglishMeaning": "However, the wait had given me a genuine break that I rarely allow myself.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.diaries.04"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.diaries.04.0d6c21daee504e6f9835daf7533ef11f",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 4,
        "VietnameseText": "Ban \u0111\u1EA7u t\u00F4i r\u1EA5t b\u1EF1c m\u00ECnh v\u00EC t\u01B0\u1EDFng c\u1EA3 bu\u1ED5i chi\u1EC1u \u0111\u00E3 b\u1ECB l\u00E3ng ph\u00ED.",
        "EnglishMeaning": "At first I was annoyed because I thought the whole afternoon had been wasted.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.diaries.04"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.diaries.04.1523e39baa18495f895eee80421cd3cd",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 7,
        "VietnameseText": "G\u1EA7n ga c\u00F3 m\u1ED9t c\u00F4ng vi\u00EAn nh\u1ECF m\u00E0 t\u00F4i ch\u01B0a t\u1EEBng \u0111\u1EC3 \u00FD tr\u01B0\u1EDBc \u0111\u00E2y.",
        "EnglishMeaning": "There was a small park near the station that I had never noticed before.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.diaries.04"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.diaries.04.2052afd53b434ec689da1380819bd3c3",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 9,
        "VietnameseText": "Khi quay l\u1EA1i ga, t\u00F4i v\u1EABn ti\u1EBFc v\u00EC \u0111\u00E3 kh\u00F4ng qu\u1EA3n l\u00FD th\u1EDDi gian t\u1ED1t h\u01A1n.",
        "EnglishMeaning": "When I returned, I still regretted not managing my time more carefully.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.diaries.04"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.diaries.04.368099941eca429aafcd0e628b6971e8",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 6,
        "VietnameseText": "T\u00F4i g\u1ECDi v\u1EC1 nh\u00E0 \u0111\u1EC3 b\u00E1o t\u00ECnh h\u00ECnh r\u1ED3i \u0111i t\u00ECm m\u1ED9t ch\u1ED7 ng\u1ED3i y\u00EAn t\u0129nh.",
        "EnglishMeaning": "I called home to explain the situation and then looked for somewhere quiet to sit.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.diaries.04"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.diaries.04.3a9b653c733d4752a62aa0b4f7343f56",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 8,
        "VietnameseText": "T\u00F4i ng\u1ED3i d\u01B0\u1EDBi g\u1ED1c c\u00E2y v\u00E0 cu\u1ED1i c\u00F9ng \u0111\u1ECDc \u0111\u01B0\u1EE3c m\u1ED9t ch\u01B0\u01A1ng c\u1EE7a cu\u1ED1n s\u00E1ch \u0111\u00E3 mua th\u00E1ng tr\u01B0\u1EDBc.",
        "EnglishMeaning": "I sat beneath a tree and finally read a chapter of the book I bought last month.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.diaries.04"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.diaries.04.675119157d784506a0c869b4d8140c90",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 3,
        "VietnameseText": "Khi \u0111\u1EBFn s\u00E2n ga, t\u00F4i ch\u1EC9 c\u00F2n th\u1EA5y toa cu\u1ED1i \u0111ang r\u1EDDi \u0111i.",
        "EnglishMeaning": "When I reached the platform, I could only see the last carriage leaving.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.diaries.04"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.diaries.04.74d2b39132694ff7b70f810d1c1dc13d",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 12,
        "VietnameseText": "T\u00F4i c\u0169ng mu\u1ED1n nh\u1EDB r\u1EB1ng m\u1ED9t sai s\u00F3t nh\u1ECF kh\u00F4ng nh\u1EA5t thi\u1EBFt l\u00E0m h\u1ECFng c\u1EA3 ng\u00E0y.",
        "EnglishMeaning": "I also want to remember that a small mistake need not ruin an entire day.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.diaries.04"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.diaries.04.7ad613cb16824a36a673771bdcd6b600",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 11,
        "VietnameseText": "T\u00F4i s\u1EBD \u0111\u1EB7t l\u1EDDi nh\u1EAFc s\u1EDBm h\u01A1n cho nh\u1EEFng chuy\u1EBFn \u0111i sau n\u00E0y.",
        "EnglishMeaning": "I will set an earlier reminder for future journeys.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.diaries.04"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.diaries.04.92542c3d2ac5434795259ee640cca915",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 2,
        "VietnameseText": "T\u00F4i \u0111\u00E3 d\u00E0nh qu\u00E1 l\u00E2u \u1EDF hi\u1EC7u s\u00E1ch v\u00E0 kh\u00F4ng \u0111\u1EC3 \u00FD gi\u1EDD \u0111\u00F3ng c\u1EEDa l\u00EAn t\u00E0u.",
        "EnglishMeaning": "I had spent too long in a bookshop and overlooked the boarding deadline.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.diaries.04"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.diaries.04.a9e814405b1d4fe08abdbe81acabdd67",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 1,
        "VietnameseText": "Chi\u1EC1u nay t\u00F4i l\u1EE1 chuy\u1EBFn t\u00E0u v\u1EC1 nh\u00E0 sau chuy\u1EBFn th\u0103m m\u1ED9t ng\u01B0\u1EDDi b\u1EA1n.",
        "EnglishMeaning": "This afternoon I missed my train home after visiting a friend.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.diaries.04"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.diaries.04.b825e03507cc4f6ea2274e875eacae35",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 5,
        "VietnameseText": "Nh\u00E2n vi\u00EAn nh\u00E0 ga gi\u00FAp t\u00F4i \u0111\u1ED5i v\u00E9 sang chuy\u1EBFn sau m\u00E0 kh\u00F4ng tr\u00E1ch m\u00F3c.",
        "EnglishMeaning": "A station employee helped me change my ticket to a later train without criticism.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.diaries.04"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.diaries.04.d588d86ec1f74fe28c592feb2efb6e1e",
      "kind": "WritingAcceptedAnswer",
      "values": {
        "AnswerText": "For future trips, I will set a reminder further in advance.",
        "NormalizedHash": "e6af094859916b7b0c4aeb6684390198ea2e4da3297650bace517286457038c7"
      },
      "references": {
        "WritingExerciseSentenceId": "team.writing.20261114.intermediate.diaries.04.7ad613cb16824a36a673771bdcd6b600",
        "ApprovedByUserId": "owner:system"
      }
    }
  ],
