    {
      "key": "team.writing.20261114.beginner.desk-light.fb2b8560b2c24169a75bd34c4520191c",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 6,
        "VietnameseText": "Gi\u1EEF m\u1ED9t kho\u1EA3ng tr\u1ED1ng \u0111\u1EC3 vi\u1EBFt v\u00E0 \u0111\u1EB7t tay tho\u1EA3i m\u00E1i.",
        "EnglishMeaning": "Leave a clear space to write and rest your arms comfortably.",
