    {
      "key": "team.listening.b1.what-causes-sea-level-rise.b761df74cd3c45d8911f8870c34e5654",
      "kind": "ListeningTranscriptLine",
      "values": {
        "OrderIndex": 20,
        "Speaker": "Narrator",
        "Text": "And after they finish one measurement, they start measuring all over again.",
        "VietnameseMeaning": "V\u00E0 sau khi ho\u00E0n th\u00E0nh m\u1ED9t l\u1EA7n \u0111o, ch\u00FAng b\u1EAFt \u0111\u1EA7u \u0111o l\u1EA1i t\u1EEB \u0111\u1EA7u.",
        "StartTime": 136,
        "EndTime": 141.5
      },
      "references": {
        "LessonId": "team.listening.b1.what-causes-sea-level-rise"
      }
    },
    {
      "key": "team.listening.b1.what-causes-sea-level-rise.c5ed223766e54282800e52011d989eb2",
      "kind": "ListeningTranscriptLine",
      "values": {
        "OrderIndex": 3,
        "Speaker": "Narrator",
        "Text": "Of course ocean water doesn\u2019t stay at the same level all the time.",
        "VietnameseMeaning": "D\u0129 nhi\u00EAn n\u01B0\u1EDBc bi\u1EC3n kh\u00F4ng gi\u1EEF nguy\u00EAn m\u1ED9t m\u1EF1c n\u01B0\u1EDBc su\u1ED1t c\u1EA3 ng\u00E0y.",
        "StartTime": 11.2,
        "EndTime": 16.1
