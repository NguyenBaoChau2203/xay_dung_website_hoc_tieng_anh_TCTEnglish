    {
      "key": "team.listening.b1.what-causes-sea-level-rise.f806338d7eb346068b4312867d25a178",
      "kind": "ListeningTranscriptLine",
      "values": {
        "OrderIndex": 8,
        "Speaker": "Narrator",
        "Text": "NASA measures the average sea level of the whole ocean from space. This measurement is called the global sea level.",
        "VietnameseMeaning": "NASA \u0111o m\u1EF1c n\u01B0\u1EDBc bi\u1EC3n trung b\u00ECnh c\u1EE7a to\u00E0n b\u1ED9 \u0111\u1EA1i d\u01B0\u01A1ng t\u1EEB kh\u00F4ng gian. Ph\u00E9p \u0111o n\u00E0y \u0111\u01B0\u1EE3c g\u1ECDi l\u00E0 m\u1EF1c n\u01B0\u1EDBc bi\u1EC3n to\u00E0n c\u1EA7u.",
