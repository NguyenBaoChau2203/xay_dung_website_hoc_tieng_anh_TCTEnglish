    {
      "key": "team.listening.b1.what-causes-sea-level-rise.9ec6f25dc6ca465bafe9a2f8a52c7dc8",
      "kind": "ListeningTranscriptLine",
      "values": {
        "OrderIndex": 4,
        "Speaker": "Narrator",
        "Text": "Waves and tides cause the level of the water to rise and sink all day long.",
        "VietnameseMeaning": "S\u00F3ng v\u00E0 th\u1EE7y tri\u1EC1u l\u00E0m m\u1EF1c n\u01B0\u1EDBc d\u00E2ng l\u00EAn r\u1ED3i h\u1EA1 xu\u1ED1ng c\u1EA3 ng\u00E0y.",
        "StartTime": 16.1,
        "EndTime": 22
      },
      "references": {
        "LessonId": "team.listening.b1.what-causes-sea-level-rise"
      }
    },
    {
      "key": "team.listening.b1.what-causes-sea-level-rise.9f86169e9b2e41a69c2574218337988c",
      "kind": "ListeningTranscriptLine",
      "values": {
        "OrderIndex": 17,
        "Speaker": "Narrator",
        "Text": "Rising sea levels can have an impact on how we live \u2013 especially in communities near the coasts.",
        "VietnameseMeaning": "M\u1EF1c n\u01B0\u1EDBc bi\u1EC3n d\u00E2ng c\u00F3 th\u1EC3 \u1EA3nh h\u01B0\u1EDFng \u0111\u1EBFn c\u00E1ch ch\u00FAng ta s\u1ED1ng \u2013 \u0111\u1EB7c bi\u1EC7t l\u00E0 \u1EDF c\u00E1c c\u1ED9ng \u0111\u1ED3ng g\u1EA7n b\u1EDD bi\u1EC3n.",
        "StartTime": 117.4,
        "EndTime": 124.5
      },
      "references": {
        "LessonId": "team.listening.b1.what-causes-sea-level-rise"
      }
    },
