    {
      "key": "team.writing.20261114.intermediate.reports.05",
      "kind": "WritingExercise",
      "values": {
        "Title": "Kh\u1EA3o s\u00E1t \u0111i\u1EC3m d\u1EEBng xe bu\u00FDt g\u1EA7n trung t\u00E2m",
        "Level": "intermediate",
        "ContentType": "reports",
        "Topic": "Giao th\u00F4ng \u0111\u1ECBa ph\u01B0\u01A1ng",
        "SourceType": "original-20261114",
        "PreviewText": "B\u00E1o c\u00E1o gi\u1EA3 \u0111\u1ECBnh ghi nh\u1EADn b\u1EA3ng th\u00F4ng tin, ch\u1ED7 ng\u1ED3i v\u00E0 gi\u1EDBi h\u1EA1n quan s\u00E1t.",
        "IsPublished": true
      },
      "references": {}
    },
    {
      "key": "team.writing.20261114.intermediate.reports.05.01fd9d4501c04e8e84de76a4b4aac845",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 10,
        "VietnameseText": "B\u1EA3ng th\u00F4ng tin n\u00EAn \u0111\u01B0\u1EE3c ki\u1EC3m tra t\u1EEB v\u1ECB tr\u00ED c\u1EE7a c\u1EA3 ng\u01B0\u1EDDi \u0111\u1EE9ng l\u1EABn ng\u01B0\u1EDDi ng\u1ED3i.",
        "EnglishMeaning": "The board should be checked from both standing and seated positions.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.reports.05"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.reports.05.18d894ae1dcb4eb790ad2bbaa04a51f1",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 9,
        "VietnameseText": "Nh\u00F3m \u0111\u1EC1 xu\u1EA5t b\u00E1o cho \u0111\u01A1n v\u1ECB ph\u1EE5 tr\u00E1ch \u0111\u1EC3 x\u1EED l\u00FD c\u00E0nh c\u00E2y v\u00E0 v\u1EADt c\u1EA3n.",
        "EnglishMeaning": "The team suggests notifying the responsible service about the branch and obstruction.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.reports.05"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.reports.05.217482ca9e0046039e52432346db879b",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 11,
        "VietnameseText": "C\u1EA7n quan s\u00E1t th\u00EAm v\u00E0o gi\u1EDD \u0111\u00F4ng v\u00E0 ng\u00E0y m\u01B0a tr\u01B0\u1EDBc khi \u0111\u1EC1 xu\u1EA5t thay \u0111\u1ED5i l\u1EDBn.",
        "EnglishMeaning": "Further observation during busy periods and rain is needed before proposing major changes.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.reports.05"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.reports.05.2ac2f852b3de4b87b567f36bbe90c3b0",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 12,
        "VietnameseText": "C\u00E1c ghi nh\u1EADn gi\u1EA3 \u0111\u1ECBnh n\u00E0y ch\u1EC9 m\u00F4 t\u1EA3 \u0111i\u1EC1u ki\u1EC7n trong nh\u1EEFng bu\u1ED5i \u0111\u00E3 ch\u1ECDn.",
        "EnglishMeaning": "These fictional observations describe conditions only during the selected morning visits.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.reports.05"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.reports.05.495dc08fb7cd465ea6cb5ecb4bb7b075",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 1,
        "VietnameseText": "B\u00E1o c\u00E1o n\u00E0y tr\u00ECnh b\u00E0y m\u1ED9t cu\u1ED9c quan s\u00E1t gi\u1EA3 \u0111\u1ECBnh t\u1EA1i \u0111i\u1EC3m d\u1EEBng g\u1EA7n trung t\u00E2m c\u1ED9ng \u0111\u1ED3ng.",
        "EnglishMeaning": "This report presents a fictional observation at a stop near a community centre.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.reports.05"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.reports.05.660104f61b9d424caa83f51221d03b2d",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 6,
        "VietnameseText": "Tuy nhi\u00EAn, b\u1EA3ng tuy\u1EBFn \u0111\u01B0\u1EDDng b\u1ECB m\u1ED9t c\u00E0nh c\u00E2y che khu\u1EA5t m\u1ED9t ph\u1EA7n.",
        "EnglishMeaning": "However, a tree branch partly obscured the route information board.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.reports.05"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.reports.05.68d655e3e8954471adc75dce67d94748",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 3,
        "VietnameseText": "H\u1ECD ghi l\u1EA1i t\u00ECnh tr\u1EA1ng ch\u1ED7 ng\u1ED3i, b\u1EA3ng th\u00F4ng tin v\u00E0 l\u1ED1i \u0111i l\u00EAn xe.",
        "EnglishMeaning": "They recorded the seating, information board and access path to the bus.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.reports.05"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.reports.05.775f66f9499f49e8afc923334d2bcd78",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 2,
        "VietnameseText": "Hai t\u00ECnh nguy\u1EC7n vi\u00EAn gi\u1EA3 \u0111\u1ECBnh \u0111\u00E3 \u0111\u1EBFn v\u00E0o ba bu\u1ED5i s\u00E1ng c\u00F3 th\u1EDDi ti\u1EBFt kh\u00F4 r\u00E1o.",
        "EnglishMeaning": "In the scenario, two volunteers visited on three mornings with dry weather.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.reports.05"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.reports.05.a2782a32f8464a34a31373a614749cc4",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 5,
        "VietnameseText": "Gh\u1EBF ng\u1ED3i s\u1EA1ch v\u00E0 ph\u1EA7n l\u1EDBn th\u1EDDi gian v\u1EABn c\u00F2n ch\u1ED7 cho ng\u01B0\u1EDDi ch\u1EDD.",
        "EnglishMeaning": "The seats were clean, with space available for waiting passengers most of the time.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.reports.05"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.reports.05.b78368131ebd45379b6d97e89e7815b6",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 7,
        "VietnameseText": "Hai ng\u01B0\u1EDDi h\u1ECFi t\u00ECnh nguy\u1EC7n vi\u00EAn v\u1EC1 h\u01B0\u1EDBng \u0111i v\u00EC h\u1ECD kh\u00F4ng nh\u00ECn r\u00F5 s\u01A1 \u0111\u1ED3.",
        "EnglishMeaning": "Two people asked the volunteers for directions because they could not see the map clearly.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.reports.05"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.reports.05.cbabd87e17cf486bb1bdd5b83492507d",
      "kind": "WritingAcceptedAnswer",
      "values": {
        "AnswerText": "Someone should check whether the information is visible to people standing and sitting.",
        "NormalizedHash": "7d1e0729fed255bfd32423139edbef68afc7e65d724ef8301f142f72f6bbbcb4"
      },
      "references": {
