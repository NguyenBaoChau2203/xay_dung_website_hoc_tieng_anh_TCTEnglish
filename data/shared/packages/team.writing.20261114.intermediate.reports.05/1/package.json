      }
    },
    {
      "key": "team.writing.20261114.intermediate.reports.05.ce994f1d58844a48bacc4e703915f223",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 8,
        "VietnameseText": "M\u1ED9t th\u00F9ng h\u00E0ng t\u1EA1m \u0111\u1EB7t g\u1EA7n l\u1EC1 c\u0169ng khi\u1EBFn l\u1ED1i l\u00EAn xe h\u1EB9p l\u1EA1i.",
        "EnglishMeaning": "A box temporarily placed near the kerb also narrowed the boarding path.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.reports.05"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.reports.05.e637c564d7964438bb58c39f86bc53c8",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 4,
        "VietnameseText": "H\u1ECD kh\u00F4ng \u0111o \u0111\u1ED9 \u0111\u00FAng gi\u1EDD c\u1EE7a tuy\u1EBFn v\u00EC \u0111\u00F3 n\u1EB1m ngo\u00E0i ph\u1EA1m vi kh\u1EA3o s\u00E1t.",
        "EnglishMeaning": "They did not measure service punctuality because it was outside the survey\u0027s scope.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.reports.05"
      }
    }
