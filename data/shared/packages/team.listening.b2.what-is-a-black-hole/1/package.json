    {
      "key": "team.listening.b2.what-is-a-black-hole.01d225c451a940719a518726ce66cef4",
      "kind": "ListeningQuizQuestion",
      "values": {
        "OrderIndex": 2,
        "QuestionText": "How do some black holes form?",
        "OptionA": "At the end of some stars\u0027 lives",
        "OptionB": "From melting ice",
        "OptionC": "From comets",
        "OptionD": "When planets collide with the Sun",
        "CorrectAnswer": "A",
        "Explanation": "\u0022Black holes form at the end of some stars\u2019 lives.\u0022 \u2014 00:29"
      },
      "references": {
