    },
    {
      "key": "team.listening.b2.what-is-a-black-hole.8aadc46a70074f9bae989b0206c4450e",
      "kind": "ListeningTranscriptLine",
      "values": {
        "OrderIndex": 24,
        "Speaker": "Narrator",
        "Text": "For a transcript of this video and a fun downloadable poster visit the Space Place.",
        "VietnameseMeaning": "\u0110\u1EC3 xem b\u1EA3n ghi l\u1EDDi tho\u1EA1i c\u1EE7a video n\u00E0y v\u00E0 m\u1ED9t t\u1EA5m \u00E1p ph\u00EDch vui c\u00F3 th\u1EC3 t\u1EA3i v\u1EC1, h\u00E3y truy c\u1EADp Space Place.",
        "StartTime": 172,
        "EndTime": 178.4
      },
      "references": {
