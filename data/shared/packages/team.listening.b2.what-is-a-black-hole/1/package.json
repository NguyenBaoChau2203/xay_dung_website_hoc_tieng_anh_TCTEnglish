    {
      "key": "team.listening.b2.what-is-a-black-hole.65cec42a0d7c4861853c32a53f6078ac",
      "kind": "ListeningTranscriptLine",
      "values": {
        "OrderIndex": 17,
        "Speaker": "Narrator",
        "Text": "An event horizon is probably what you are thinking of when you think of a black hole.",
        "VietnameseMeaning": "Ch\u00E2n tr\u1EDDi s\u1EF1 ki\u1EC7n c\u00F3 l\u1EBD l\u00E0 th\u1EE9 b\u1EA1n ngh\u0129 \u0111\u1EBFn khi ngh\u0129 v\u1EC1 m\u1ED9t h\u1ED1 \u0111en.",
