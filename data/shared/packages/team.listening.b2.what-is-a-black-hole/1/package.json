      "key": "team.listening.b2.what-is-a-black-hole.8990a34be0c644a192eea9052afeeb7c",
      "kind": "ListeningTranscriptLine",
      "values": {
        "OrderIndex": 9,
        "Speaker": "Narrator",
        "Text": "Black holes can form in many ways though,",
        "VietnameseMeaning": "Tuy nhi\u00EAn h\u1ED1 \u0111en c\u00F3 th\u1EC3 h\u00ECnh th\u00E0nh theo nhi\u1EC1u c\u00E1ch,",
