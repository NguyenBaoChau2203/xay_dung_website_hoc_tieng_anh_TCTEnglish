  "records": [
    {
      "key": "team.writing.20261114.intermediate.essays.01",
      "kind": "WritingExercise",
      "values": {
        "Title": "C\u00F3 n\u00EAn cho h\u1ECDc sinh ch\u1ECDn m\u1ED9t ph\u1EA7n b\u00E0i t\u1EADp?",
        "Level": "intermediate",
        "ContentType": "essays",
        "Topic": "Gi\u00E1o d\u1EE5c",
        "SourceType": "original-20261114",
        "PreviewText": "B\u00E0i lu\u1EADn \u0111\u01B0a quan \u0111i\u1EC3m v\u1EC1 quy\u1EC1n l\u1EF1a ch\u1ECDn b\u00E0i t\u1EADp v\u00E0 \u0111i\u1EC1u ki\u1EC7n \u0111\u1EC3 \u00E1p d\u1EE5ng.",
        "IsPublished": true
      },
      "references": {}
    },
    {
      "key": "team.writing.20261114.intermediate.essays.01.0de38261d9124ba4a1307de080815cf6",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 12,
        "VietnameseText": "Quy\u1EC1n l\u1EF1a ch\u1ECDn c\u00F3 gi\u1EDBi h\u1EA1n s\u1EBD h\u1EEFu \u00EDch h\u01A1n vi\u1EC7c ch\u1EC9 t\u0103ng s\u1ED1 l\u01B0\u1EE3ng b\u00E0i t\u1EADp.",
        "EnglishMeaning": "A limited choice would be more useful than simply increasing the amount of homework.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.essays.01"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.essays.01.23419c78e3b24a24aad71c880eec37f1",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 9,
        "VietnameseText": "Gi\u00E1o vi\u00EAn c\u00F3 th\u1EC3 giao m\u1ED9t b\u00E0i b\u1EAFt bu\u1ED9c v\u00E0 hai b\u00E0i \u0111\u1EC3 h\u1ECDc sinh ch\u1ECDn.",
        "EnglishMeaning": "A teacher could set one compulsory task and offer two alternatives for students to choose from.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.essays.01"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.essays.01.3c06be287c0e46288bce2412a72d8030",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 2,
        "VietnameseText": "Vi\u1EC7c l\u1EF1a ch\u1ECDn c\u00F3 th\u1EC3 gi\u00FAp c\u00E1c em k\u1EBFt n\u1ED1i b\u00E0i h\u1ECDc v\u1EDBi s\u1EDF th\u00EDch c\u00E1 nh\u00E2n.",
        "EnglishMeaning": "Having a choice can help them connect lessons with their personal interests.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.essays.01"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.essays.01.3ec21305597143ec819e723030e81e56",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 3,
        "VietnameseText": "V\u00ED d\u1EE5, c\u00F9ng m\u1ED9t k\u1EF9 n\u0103ng vi\u1EBFt c\u00F3 th\u1EC3 \u0111\u01B0\u1EE3c luy\u1EC7n qua b\u00E0i \u0111\u00E1nh gi\u00E1 ho\u1EB7c c\u00E2u chuy\u1EC7n.",
        "EnglishMeaning": "For example, the same writing skill could be practised through a review or a story.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.essays.01"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.essays.01.4a259f274faf4ef0929c0b2475242311",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 1,
        "VietnameseText": "Theo t\u00F4i, h\u1ECDc sinh n\u00EAn \u0111\u01B0\u1EE3c ch\u1ECDn m\u1ED9t ph\u1EA7n b\u00E0i t\u1EADp m\u00E0 c\u00E1c em l\u00E0m \u1EDF nh\u00E0.",
        "EnglishMeaning": "In my view, students should be allowed to choose some of their homework tasks.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.essays.01"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.essays.01.59c4f2278fe14aae8c2a091298e39c76",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 5,
        "VietnameseText": "Tuy nhi\u00EAn, gi\u00E1o vi\u00EAn v\u1EABn c\u1EA7n \u0111\u1EA3m b\u1EA3o c\u1EA3 l\u1EDBp luy\u1EC7n nh\u1EEFng k\u1EF9 n\u0103ng thi\u1EBFt y\u1EBFu.",
        "EnglishMeaning": "However, teachers still need to ensure that everyone practises the essential skills.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.essays.01"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.essays.01.63ee3b04a09d4de9b0e5da504da09f81",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 11,
        "VietnameseText": "C\u00E1ch n\u00E0y gi\u1EEF \u0111\u01B0\u1EE3c t\u00EDnh c\u00F4ng b\u1EB1ng m\u00E0 v\u1EABn cho h\u1ECDc sinh m\u1ED9t ph\u1EA7n tr\u00E1ch nhi\u1EC7m.",
        "EnglishMeaning": "This approach maintains fairness while giving students a share of responsibility.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.essays.01"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.essays.01.753a6cfda7a044808d60dc6ff3cfa47a",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 6,
        "VietnameseText": "N\u1EBFu m\u1ECDi b\u00E0i t\u1EADp \u0111\u1EC1u t\u00F9y ch\u1ECDn, m\u1ED9t s\u1ED1 em c\u00F3 th\u1EC3 lu\u00F4n tr\u00E1nh ph\u1EA7n kh\u00F3.",
        "EnglishMeaning": "If every task is optional, some students might consistently avoid difficult areas.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.essays.01"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.essays.01.a58ae3d171274783bfd1825bae13ff73",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 10,
        "VietnameseText": "C\u1EA3 hai l\u1EF1a ch\u1ECDn n\u00EAn c\u00F3 \u0111\u1ED9 kh\u00F3 t\u01B0\u01A1ng \u0111\u01B0\u01A1ng v\u00E0 \u0111\u01B0\u1EE3c ch\u1EA5m theo c\u00F9ng ti\u00EAu ch\u00ED.",
        "EnglishMeaning": "Both options should have similar difficulty and be marked using the same criteria.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.essays.01"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.essays.01.ced57c1f962c419c8c53b27f7d05c9e0",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 8,
        "VietnameseText": "V\u00EC v\u1EADy, quy\u1EC1n l\u1EF1a ch\u1ECDn c\u1EA7n \u0111i k\u00E8m m\u1ED9t s\u1ED1 y\u00EAu c\u1EA7u chung r\u00F5 r\u00E0ng.",
        "EnglishMeaning": "Therefore, choice should be accompanied by a clear set of shared requirements.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.essays.01"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.essays.01.eb12d470f9744fe59c923b195b3cada2",
      "kind": "WritingAcceptedAnswer",
      "values": {
        "AnswerText": "This method keeps assessment fair while allowing students some responsibility.",
        "NormalizedHash": "2812896d03e800d12bf19382d65bd7a7cf7ee82c26e3872393b56f01f0a27018"
      },
      "references": {
        "WritingExerciseSentenceId": "team.writing.20261114.intermediate.essays.01.63ee3b04a09d4de9b0e5da504da09f81",
        "ApprovedByUserId": "owner:system"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.essays.01.f5a2cc89a3f8429d8d3d71307d40ef7c",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 4,
        "VietnameseText": "Khi hi\u1EC3u m\u1EE5c \u0111\u00EDch c\u1EE7a b\u00E0i t\u1EADp, h\u1ECDc sinh c\u00F3 th\u1EC3 s\u1EB5n s\u00E0ng \u0111\u1EA7u t\u01B0 c\u00F4ng s\u1EE9c h\u01A1n.",
        "EnglishMeaning": "When students understand a task\u0027s purpose, they may be more willing to make an effort.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.essays.01"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.essays.01.fad868ddf00c460ca850bb850e96e644",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 7,
        "VietnameseText": "\u0110i\u1EC1u n\u00E0y c\u00F3 th\u1EC3 khi\u1EBFn c\u00E1c em th\u1EA5y tho\u1EA3i m\u00E1i nh\u01B0ng kh\u00F4ng ti\u1EBFn b\u1ED9 nhi\u1EC1u.",
        "EnglishMeaning": "This could make them feel comfortable without helping them make much progress.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.essays.01"
      }
    }
  ],
