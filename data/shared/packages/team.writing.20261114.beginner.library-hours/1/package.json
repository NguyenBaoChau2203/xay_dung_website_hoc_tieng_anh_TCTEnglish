      }
    },
    {
      "key": "team.writing.20261114.beginner.library-hours.1f78f8b4eb2541dd8347737af2855d78",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 2,
        "VietnameseText": "Em h\u1ECDc g\u1EA7n \u0111\u00E2y nh\u01B0ng ch\u01B0a c\u00F3 th\u1EBB th\u01B0 vi\u1EC7n.",
        "EnglishMeaning": "I study nearby, but I do not have a library card yet.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.beginner.library-hours"
      }
    },
    {
      "key": "team.writing.20261114.beginner.library-hours.8517e20e25524bd7a4a0ed6d35bd0335",
      "kind": "WritingAcceptedAnswer",
      "values": {
        "AnswerText": "When does the library open in the morning?",
        "NormalizedHash": "964c6d7fc65f83aeb6f9d1d88fcf00802484467e1b918884ab84259ad3a47c9d"
      },
      "references": {
