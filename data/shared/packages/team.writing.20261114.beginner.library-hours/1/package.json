      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 8,
        "VietnameseText": "Em ch\u00FAc c\u00F4 m\u1ED9t ng\u00E0y t\u1ED1t l\u00E0nh.",
        "EnglishMeaning": "I hope you have a lovely day.",
        "BreakAfter": true
      },
      "references": {
