    },
    {
      "key": "team.writing.20261114.beginner.library-hours.8e0dad5065574783973a2eaa23fb1f06",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 5,
        "VietnameseText": "Em c\u0169ng mu\u1ED1n m\u01B0\u1EE3n m\u1ED9t cu\u1ED1n s\u00E1ch ti\u1EBFng Anh \u0111\u01A1n gi\u1EA3n.",
        "EnglishMeaning": "I would also like to borrow a simple English book.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.beginner.library-hours"
      }
    },
    {
      "key": "team.writing.20261114.beginner.library-hours.9fae58f7d64c44cc8acfdbbe6a28d670",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 4,
        "VietnameseText": "Em c\u00F3 th\u1EC3 mang th\u1EBB h\u1ECDc sinh \u0111\u1EC3 \u0111\u0103ng k\u00FD kh\u00F4ng \u1EA1?",
        "EnglishMeaning": "Can I bring my student card to register?",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.beginner.library-hours"
      }
    },
    {
      "key": "team.writing.20261114.beginner.library-hours.a0c07567aab4451ca80ce333fe87f08d",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 6,
        "VietnameseText": "C\u00F4 c\u00F3 th\u1EC3 ch\u1EC9 cho em khu s\u00E1ch d\u00E0nh cho ng\u01B0\u1EDDi m\u1EDBi h\u1ECDc kh\u00F4ng \u1EA1?",
        "EnglishMeaning": "Could you show me the section for beginners?",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.beginner.library-hours"
      }
    },
    {
      "key": "team.writing.20261114.beginner.library-hours.a91362fbcd054d15be3c73b56c0b359b",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 7,
        "VietnameseText": "Em c\u1EA3m \u01A1n c\u00F4 \u0111\u00E3 gi\u00FAp \u0111\u1EE1 v\u00E0 mong nh\u1EADn \u0111\u01B0\u1EE3c h\u1ED3i \u00E2m.",
        "EnglishMeaning": "Thank you for your help, and I look forward to your reply.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.beginner.library-hours"
      }
    },
    {
      "key": "team.writing.20261114.beginner.library-hours.afb1ed1da095437e82fe2109c90c8063",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 1,
        "VietnameseText": "K\u00EDnh g\u1EEDi c\u00F4 th\u1EE7 th\u01B0, em mu\u1ED1n \u0111\u1EBFn th\u01B0 vi\u1EC7n v\u00E0o th\u1EE9 B\u1EA3y n\u00E0y.",
        "EnglishMeaning": "Dear librarian, I would like to visit the library this Saturday.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.beginner.library-hours"
      }
    },
    {
      "key": "team.writing.20261114.beginner.library-hours.d62cfca153424cb28398b8192c9a7cd2",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 3,
        "VietnameseText": "Th\u01B0 vi\u1EC7n m\u1EDF c\u1EEDa l\u00FAc m\u1EA5y gi\u1EDD v\u00E0o bu\u1ED5i s\u00E1ng \u1EA1?",
        "EnglishMeaning": "What time does the library open in the morning?",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.beginner.library-hours"
      }
    }
