  "records": [
    {
      "key": "team.writing.20261114.intermediate.articles.04",
      "kind": "WritingExercise",
      "values": {
        "Title": "T\u1ED5 ch\u1EE9c th\u01B0 m\u1EE5c \u1EA3nh m\u00E0 kh\u00F4ng b\u1ECB qu\u00E1 t\u1EA3i",
        "Level": "intermediate",
        "ContentType": "articles",
        "Topic": "K\u1EF9 n\u0103ng s\u1ED1",
        "SourceType": "original-20261114",
        "PreviewText": "B\u00E0i vi\u1EBFt h\u01B0\u1EDBng d\u1EABn chia nh\u1ECF vi\u1EC7c s\u1EAFp x\u1EBFp \u1EA3nh v\u00E0 b\u1EA3o v\u1EC7 b\u1EA3n g\u1ED1c tr\u01B0\u1EDBc khi s\u1EEDa.",
        "IsPublished": true
      },
      "references": {}
    },
    {
      "key": "team.writing.20261114.intermediate.articles.04.11dfbeeaf9124457a543593723f0f24d",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 5,
        "VietnameseText": "Ti\u1EBFp theo, gom c\u00E1c \u1EA3nh li\u00EAn quan v\u00E0o th\u01B0 m\u1EE5c c\u00F3 t\u00EAn ng\u1EAFn v\u00E0 r\u00F5.",
        "EnglishMeaning": "Next, collect related photographs in folders with short and clear names.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.articles.04"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.articles.04.1cb70009672a4196ac37f2d14fbe56fc",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 1,
        "VietnameseText": "Khi \u1EA3nh t\u00EDch l\u1EA1i qua nhi\u1EC1u n\u0103m, vi\u1EC7c s\u1EAFp x\u1EBFp to\u00E0n b\u1ED9 c\u00F3 th\u1EC3 khi\u1EBFn b\u1EA1n n\u1EA3n.",
        "EnglishMeaning": "When photographs accumulate over several years, organising everything can feel discouraging.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.articles.04"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.articles.04.1de91e01bf96408b9dfd835dbb988d29",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 4,
        "VietnameseText": "Ki\u1EC3m tra xem b\u1EA3n sao c\u00F3 m\u1EDF \u0111\u01B0\u1EE3c s\u1EBD gi\u00FAp b\u1EA1n tr\u00E1nh m\u1EA5t \u1EA3nh do s\u01A1 su\u1EA5t.",
        "EnglishMeaning": "Checking that the copy opens will help you avoid losing photographs through an oversight.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.articles.04"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.articles.04.43593dbf98324b058068625f013561c1",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 2,
        "VietnameseText": "Thay v\u00EC b\u1EAFt \u0111\u1EA7u v\u1EDBi c\u1EA3 b\u1ED9 s\u01B0u t\u1EADp, h\u00E3y ch\u1ECDn m\u1ED9t th\u00E1ng ho\u1EB7c m\u1ED9t chuy\u1EBFn \u0111i.",
        "EnglishMeaning": "Instead of starting with the whole collection, choose one month or one trip.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.articles.04"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.articles.04.527b26e1601e4d60a2158791342dca6c",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 10,
        "VietnameseText": "M\u1ED9t s\u1ED1 k\u1EF7 ni\u1EC7m vui v\u1EABn c\u00F3 th\u1EC3 l\u00E0 chuy\u1EC7n ri\u00EAng \u0111\u1ED1i v\u1EDBi ng\u01B0\u1EDDi kh\u00E1c.",
        "EnglishMeaning": "Some happy memories may still be private matters for someone else.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.articles.04"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.articles.04.6a4062d78ee04abf837a9ada929ce9f2",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 9,
        "VietnameseText": "N\u1EBFu mu\u1ED1n chia s\u1EBB m\u1ED9t album, h\u00E3y h\u1ECFi nh\u1EEFng ng\u01B0\u1EDDi xu\u1EA5t hi\u1EC7n trong \u0111\u00F3 tr\u01B0\u1EDBc.",
        "EnglishMeaning": "If you want to share an album, ask the people pictured in it first.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.articles.04"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.articles.04.7681757893a245f2be7616b33cff8f58",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 8,
        "VietnameseText": "M\u1EE5c ti\u00EAu l\u00E0 t\u00ECm \u0111\u01B0\u1EE3c \u1EA3nh khi c\u1EA7n, ch\u1EE9 kh\u00F4ng ph\u1EA3i gi\u1EA3m s\u1ED1 l\u01B0\u1EE3ng b\u1EB1ng m\u1ECDi gi\u00E1.",
        "EnglishMeaning": "The aim is to find photographs when needed, rather than reduce their number at any cost.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.articles.04"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.articles.04.80e167a03a494328a7ac989b20e3d127",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 11,
        "VietnameseText": "Sau m\u1ED7i ph\u1EA7n nh\u1ECF, h\u00E3y d\u1EEBng l\u1EA1i v\u00E0 ghi \u0111i\u1EC1u b\u1EA1n s\u1EBD l\u00E0m ti\u1EBFp theo.",
        "EnglishMeaning": "After each small section, stop and note what you will do next.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.articles.04"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.articles.04.92f2223dd5ac42cbacb3099bb1b5d1dc",
      "kind": "WritingAcceptedAnswer",
      "values": {
        "AnswerText": "When you finish a small section, pause and write down your next step.",
        "NormalizedHash": "057bf8420a004a7a732cb3a05c98ae5ea3c84b9d7981f2da7e7fc14c766539f6"
      },
      "references": {
        "WritingExerciseSentenceId": "team.writing.20261114.intermediate.articles.04.80e167a03a494328a7ac989b20e3d127",
        "ApprovedByUserId": "owner:system"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.articles.04.99508ce1972046af9dadfb2577249338",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 7,
        "VietnameseText": "B\u1EA1n c\u00F3 th\u1EC3 gi\u1EEF v\u00E0i t\u1EA5m gi\u1ED1ng nhau n\u1EBFu ch\u00FAng ghi l\u1EA1i nh\u1EEFng bi\u1EC3u c\u1EA3m kh\u00E1c nhau.",
        "EnglishMeaning": "You can keep similar shots if they capture different expressions.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.articles.04"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.articles.04.a96189a46f654aca8cc08740c90121ab",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 12,
        "VietnameseText": "Nh\u1EEFng bu\u1ED5i ng\u1EAFn \u0111\u1EC1u \u0111\u1EB7n th\u01B0\u1EDDng d\u1EC5 duy tr\u00EC h\u01A1n m\u1ED9t ng\u00E0y d\u1ECDn d\u1EB9p k\u00E9o d\u00E0i.",
        "EnglishMeaning": "Regular short sessions are usually easier to maintain than one long day of sorting.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.articles.04"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.articles.04.b219abda5f5541b697640c516f5b87e7",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 6,
        "VietnameseText": "T\u00EAn g\u1ED3m n\u0103m v\u00E0 s\u1EF1 ki\u1EC7n th\u01B0\u1EDDng d\u1EC5 hi\u1EC3u h\u01A1n m\u1ED9t chu\u1ED7i k\u00FD hi\u1EC7u t\u00F9y \u00FD.",
        "EnglishMeaning": "A name containing the year and event is usually clearer than random symbols.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.articles.04"
      }
    },
    {
      "key": "team.writing.20261114.intermediate.articles.04.e8df79e0aa7d4732883b8fb6732aefc8",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 3,
        "VietnameseText": "Tr\u01B0\u1EDBc khi ch\u1EC9nh s\u1EEDa hay x\u00F3a \u1EA3nh, h\u00E3y t\u1EA1o m\u1ED9t b\u1EA3n sao \u1EDF n\u01A1i ri\u00EAng.",
        "EnglishMeaning": "Before editing or deleting photographs, create a copy in a separate location.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.intermediate.articles.04"
      }
    }
  ],
