  "dependsOn": [],
  "records": [
    {
      "key": "team.writing.20261114.beginner.dog-at-gate",
      "kind": "WritingExercise",
      "values": {
        "Title": "Ch\u00FA ch\u00F3 tr\u01B0\u1EDBc c\u1ED5ng",
        "Level": "beginner",
        "ContentType": "stories",
        "Topic": "\u0110\u1ED9ng v\u1EADt",
        "SourceType": "original-20261114",
        "PreviewText": "C\u00E2u chuy\u1EC7n t\u00ECm ch\u1EE7 c\u1EE7a ch\u00FA ch\u00F3 b\u1EB1ng s\u1EF1 gi\u00FAp \u0111\u1EE1 c\u1EE7a ng\u01B0\u1EDDi l\u1EDBn.",
        "IsPublished": true
      },
      "references": {}
    },
    {
      "key": "team.writing.20261114.beginner.dog-at-gate.12019a2d296e4b35a97bb763e44c0007",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 7,
        "VietnameseText": "Ch\u00FA ch\u00F3 v\u1EABy \u0111u\u00F4i ngay khi nh\u00ECn th\u1EA5y c\u00F4.",
        "EnglishMeaning": "The dog wagged its tail as soon as it saw her.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.beginner.dog-at-gate"
      }
    },
    {
      "key": "team.writing.20261114.beginner.dog-at-gate.365a7e2dfa51474e8dd49c84cdf0fc79",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 8,
        "VietnameseText": "Vy vui v\u00EC ch\u00FA ch\u00F3 \u0111\u00E3 c\u00F3 th\u1EC3 tr\u1EDF v\u1EC1 nh\u00E0 an to\u00E0n.",
        "EnglishMeaning": "Vy was happy that the dog could go home safely.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.beginner.dog-at-gate"
      }
    },
    {
      "key": "team.writing.20261114.beginner.dog-at-gate.4997eb07785049eb98066cbaefb07edd",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 1,
        "VietnameseText": "M\u1ED9t bu\u1ED5i chi\u1EC1u, Vy th\u1EA5y m\u1ED9t ch\u00FA ch\u00F3 ng\u1ED3i tr\u01B0\u1EDBc c\u1ED5ng nh\u00E0.",
        "EnglishMeaning": "One afternoon, Vy saw a dog sitting outside her gate.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.beginner.dog-at-gate"
      }
    },
    {
      "key": "team.writing.20261114.beginner.dog-at-gate.5dde856e89204f55a202f0946ee96d60",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 5,
        "VietnameseText": "\u00D4ng g\u1ECDi cho ch\u1EE7 c\u1EE7a ch\u00FA ch\u00F3 v\u00E0 m\u00F4 t\u1EA3 v\u1ECB tr\u00ED nh\u00E0.",
        "EnglishMeaning": "He called the dog\u0027s owner and described the location of their house.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.beginner.dog-at-gate"
      }
    },
    {
      "key": "team.writing.20261114.beginner.dog-at-gate.b369f63528584e48a60c2d2022c317ab",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 4,
        "VietnameseText": "B\u1ED1 nh\u00ECn th\u1EA5y m\u1ED9t s\u1ED1 \u0111i\u1EC7n tho\u1EA1i tr\u00EAn chi\u1EBFc th\u1EBB \u1EDF v\u00F2ng c\u1ED5.",
        "EnglishMeaning": "Her father saw a phone number on the collar tag.",
        "BreakAfter": true
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.beginner.dog-at-gate"
      }
    },
    {
      "key": "team.writing.20261114.beginner.dog-at-gate.bb4100adc7144e868e24b67b79a2ec3e",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 6,
        "VietnameseText": "M\u1ED9t l\u00E1t sau, m\u1ED9t c\u00F4 h\u00E0ng x\u00F3m \u0111\u1EBFn c\u00F9ng d\u00E2y d\u1EAFt.",
        "EnglishMeaning": "A little later, a neighbour arrived with a lead.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.beginner.dog-at-gate"
      }
    },
    {
      "key": "team.writing.20261114.beginner.dog-at-gate.c2a470f8aca44710a4d0857c1161a824",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 3,
        "VietnameseText": "Vy g\u1ECDi b\u1ED1 ra xem thay v\u00EC t\u1EF1 m\u1EDF c\u1ED5ng.",
        "EnglishMeaning": "Vy called her father instead of opening the gate herself.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.beginner.dog-at-gate"
      }
    },
    {
      "key": "team.writing.20261114.beginner.dog-at-gate.cfa9c92cfcc8450a8eadead2d7ad680f",
      "kind": "WritingExerciseSentence",
      "values": {
        "SortOrder": 2,
        "VietnameseText": "N\u00F3 \u0111eo v\u00F2ng c\u1ED5 m\u00E0u v\u00E0ng nh\u01B0ng kh\u00F4ng c\u00F3 ai \u0111i c\u00F9ng.",
        "EnglishMeaning": "It wore a yellow collar, but no one was with it.",
        "BreakAfter": false
      },
      "references": {
        "WritingExerciseId": "team.writing.20261114.beginner.dog-at-gate"
      }
    },
    {
      "key": "team.writing.20261114.beginner.dog-at-gate.f90f027f4582454fa12917f0d6c21fbd",
      "kind": "WritingAcceptedAnswer",
      "values": {
        "AnswerText": "As soon as the dog saw her, it wagged its tail.",
