    {
      "key": "team.reading.b2.remote-work.02f72517be7047fdb198b04be14a38fd",
      "kind": "ReadingParagraph",
      "values": {
        "ExternalParagraphKey": "P5",
        "ParagraphOrder": 5,
        "ParagraphContent": "Hiring and onboarding also change under remote conditions. New colleagues need structured introductions to tools, norms, and decision rights; otherwise they copy the loudest voices rather than the clearest process. Organisations that invest early in shared rituals reduce later conflict about who is responsible for which deliverable and how success will be recognised across time zones."
      },
