#!/bin/sh
# Enabled locally by setup. A plain pull on a fresh clone cannot install hooks.
set -eu
cd "$(git rev-parse --show-toplevel)"
if command -v node >/dev/null 2>&1; then
    node scripts/agent-tools.cjs setup
    exec node scripts/shared-data-hook.cjs
fi
echo 'TCT tools: install Node.js 22+, then open SETUP-AGENTS.cmd.' >&2
exit 1
