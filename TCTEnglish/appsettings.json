{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Google": {
      "ClientId": "",
      "ClientSecret": ""
    },
    "Facebook": {
      "AppId": "",
      "AppSecret": ""
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "SmtpSettings": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "SenderEmail": "",
    "SenderName": "TCT English",
    "Password": ""
  },
  "AI": {
    "BaseUrl": "https://api.openai.com/v1",
    "Model": "gpt-6-luna",
    "ReasoningEffort": "low",
    "MaxOutputTokens": 2048
  },
  "Learning": {
    "Speech": {
      "Enabled": true,
      "InferenceTimeoutSeconds": 15,
      "MaxAudioSeconds": 15,
      "MaxPayloadBytes": 2097152,
      "AssessmentTtlMinutes": 10,
      "MaxConcurrentInferences": 1,
      "MaxQueuedInferences": 4,
      "MaxAssessmentsPerUserPerMinute": 10,
      "OpenAI": {
        "Model": "gpt-transcribe",
        "BaseUrl": "https://api.openai.com/v1/",
        "MaxResponseBytes": 262144
      }
    },
    "AudioImport": {
      "TotalTimeoutSeconds": 300,
      "MaxTranscriptionRequests": 180
    }
  },
  "Pixabay": {
    "ApiKey": ""
  },
  "Billing": {
    "PendingPaymentCleanupWorkerEnabled": true,
    "PremiumExpiryWorkerEnabled": true
  },
  "Database": {
    "ApplyMigrationsOnStartup": false,
    "SeedOnStartup": false,
    "ServerVersion": "10.5.23-mariadb"
  }
}
