@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var adminName = User.Identity?.Name ?? "Admin";
    var avatarUrl = User.Claims.FirstOrDefault(c => c.Type == "AvatarUrl")?.Value;
}
<!DOCTYPE html>
<html lang="vi" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — TCT Admin</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
          rel="stylesheet"
          integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN"
          crossorigin="anonymous" />

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          rel="stylesheet" />

    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
          rel="stylesheet" />

    <!-- Shared TCT design tokens and opt-in components (DESIGN.md) -->
    <link rel="stylesheet" href="~/css/tct-learning-ui.css" asp-append-version="true" />

    <!-- Admin-specific shared CSS (preserved for legacy consumer compatibility) -->
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />

    <!-- Shared Admin Shell CSS (AS01) -->
    <link rel="stylesheet" href="~/css/admin-shell.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/page-loader.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="admin-shell">
    <partial name="_Loader" />
    <a href="#admin-main-content" class="visually-hidden-focusable admin-skip-link">Chuyển đến nội dung chính</a>

    <!-- Mobile Drawer Backdrop -->
    <div id="adminSidebarBackdrop" class="admin-backdrop" aria-hidden="true"></div>

    <div class="admin-layout">
        <!-- =============== SIDEBAR =============== -->
        <aside class="admin-sidebar" id="adminSidebar" aria-label="Thanh điều hướng quản trị">
            <!-- Brand -->
            <div class="admin-sidebar-brand justify-content-between">
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
                   class="admin-brand-link text-decoration-none d-flex align-items-center gap-2">
                    <div class="admin-brand-icon">
                        <i class="bi bi-shield-lock-fill"></i>
                    </div>
                    <div>
                        <span class="admin-brand-title fw-bold">TCT Admin</span>
                        <span class="admin-brand-badge">Control</span>
                    </div>
                </a>
                <button type="button" class="btn btn-sm text-secondary d-lg-none" id="sidebarCloseBtn" aria-label="Đóng thanh điều hướng">
                    <i class="bi bi-x-lg fs-5"></i>
                </button>
            </div>

            <!-- Navigation List -->
            <nav class="admin-sidebar-nav" aria-label="Danh mục quản trị">
                <ul class="nav flex-column list-unstyled mb-0">
                    <!-- Dashboard -->
                    <li class="nav-item">
                        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
                           class="admin-nav-link @(currentController == "Dashboard" ? "active" : "")"
                           aria-current="@(currentController == "Dashboard" ? "page" : null)">
                            <i class="bi bi-speedometer2"></i>
                            <span>Dashboard</span>
                        </a>
                    </li>

                    <!-- Section: Content Management -->
                    <li class="admin-nav-section-title mt-2">Quản lý nội dung</li>
                    <li class="nav-item">
                        <a asp-area="Admin" asp-controller="UserManagement" asp-action="Index"
                           class="admin-nav-link @(currentController == "UserManagement" ? "active" : "")"
                           aria-current="@(currentController == "UserManagement" ? "page" : null)">
                            <i class="bi bi-people-fill"></i>
                            <span>Users</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-area="Admin" asp-controller="ClassManagement" asp-action="Index"
                           class="admin-nav-link @(currentController == "ClassManagement" ? "active" : "")"
                           aria-current="@(currentController == "ClassManagement" ? "page" : null)">
                            <i class="bi bi-collection-fill"></i>
                            <span>Classes</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-area="Admin" asp-controller="SetManagement" asp-action="Index"
                           class="admin-nav-link @(currentController == "SetManagement" ? "active" : "")"
                           aria-current="@(currentController == "SetManagement" ? "page" : null)">
                            <i class="bi bi-journals"></i>
                            <span>Vocabulary Sets</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-area="Admin" asp-controller="SpeakingVideoManagement" asp-action="Index"
                           class="admin-nav-link @(currentController == "SpeakingVideoManagement" ? "active" : "")"
                           aria-current="@(currentController == "SpeakingVideoManagement" ? "page" : null)">
                            <i class="bi bi-mic-fill"></i>
                            <span>Speaking Videos</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-area="Admin" asp-controller="ListeningManagement" asp-action="Index"
                           class="admin-nav-link @(currentController == "ListeningManagement" ? "active" : "")"
                           aria-current="@(currentController == "ListeningManagement" ? "page" : null)">
                            <i class="bi bi-headphones"></i>
                            <span>Listening Lessons</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-area="Admin" asp-controller="WritingExerciseManagement" asp-action="Index"
                           class="admin-nav-link @(currentController == "WritingExerciseManagement" ? "active" : "")"
                           aria-current="@(currentController == "WritingExerciseManagement" ? "page" : null)">
                            <i class="bi bi-pencil-square"></i>
                            <span>Writing Exercises</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-area="Admin" asp-controller="ReadingManagement" asp-action="Index"
                           class="admin-nav-link @(currentController == "ReadingManagement" ? "active" : "")"
                           aria-current="@(currentController == "ReadingManagement" ? "page" : null)">
                            <i class="bi bi-book-fill"></i>
                            <span>Reading Passages</span>
                        </a>
                    </li>

                    <!-- Section: System -->
                    <li class="admin-nav-section-title mt-2">Hệ thống</li>
                    <li class="nav-item">
                        <a asp-area="Admin" asp-controller="NotificationManagement" asp-action="Create"
                           class="admin-nav-link @(currentController == "NotificationManagement" ? "active" : "")"
                           aria-current="@(currentController == "NotificationManagement" ? "page" : null)">
                            <i class="bi bi-megaphone-fill"></i>
                            <span>Thông báo</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-area="Admin" asp-controller="MessageManagement" asp-action="Index"
                           class="admin-nav-link @(currentController == "MessageManagement" ? "active" : "")"
                           aria-current="@(currentController == "MessageManagement" ? "page" : null)">
                            <i class="bi bi-chat-dots-fill"></i>
                            <span>Messages</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-area="Admin" asp-controller="AiManagement" asp-action="Index"
                           class="admin-nav-link @(currentController == "AiManagement" ? "active" : "")"
                           aria-current="@(currentController == "AiManagement" ? "page" : null)">
                            <i class="bi bi-robot"></i>
                            <span>AI Management</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-area="Admin" asp-controller="BillingManagement" asp-action="PremiumUsers"
                           class="admin-nav-link @(currentController == "BillingManagement" && (currentAction == "PremiumUsers" || currentAction == "PremiumUserDetails") ? "active" : "")"
                           aria-current="@(currentController == "BillingManagement" && (currentAction == "PremiumUsers" || currentAction == "PremiumUserDetails") ? "page" : null)">
                            <i class="bi bi-gem"></i>
                            <span>Quản lý Premium</span>
                        </a>
                    </li>
                </ul>
            </nav>

            <!-- Sidebar Footer -->
            <div class="admin-sidebar-footer">
                <a asp-controller="Home" asp-action="Index" asp-area=""
                   class="btn btn-outline-secondary admin-return-btn w-100">
                    <i class="bi bi-box-arrow-left me-2"></i>Về trang chính
                </a>
            </div>
        </aside>

        <!-- =============== MAIN WRAPPER =============== -->
        <div class="admin-main">
            <!-- Top Navbar -->
            <header class="admin-header">
                <!-- Mobile toggle button -->
                <button type="button" class="admin-header-toggle d-lg-none me-3" id="sidebarToggle"
                        aria-label="Mở thanh điều hướng quản trị" aria-controls="adminSidebar" aria-expanded="false">
                    <i class="bi bi-list fs-5"></i>
                </button>

                <span class="admin-header-title mb-0 d-none d-md-block">
                    @ViewData["Title"]
                </span>

                <div class="ms-auto d-flex align-items-center gap-3">
                    <!-- Admin Profile Dropdown -->
                    <div class="dropdown">
                        <a class="admin-user-btn d-flex align-items-center gap-2 text-decoration-none dropdown-toggle"
                           href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false" id="adminUserDropdown">
                            @if (!string.IsNullOrEmpty(avatarUrl))
                            {
                                <img src="@avatarUrl" alt="Avatar" class="admin-avatar" width="32" height="32" />
                            }
                            else
                            {
                                <div class="admin-avatar-fallback">
                                    <i class="bi bi-person-fill"></i>
                                </div>
                            }
                            <span class="fw-semibold text-dark small d-none d-sm-inline">@adminName</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end admin-dropdown-menu" aria-labelledby="adminUserDropdown">
                            <li>
                                <a class="dropdown-item admin-dropdown-item" asp-controller="Account" asp-action="Profile" asp-area="">
                                    <i class="bi bi-person text-primary"></i>Hồ sơ cá nhân
                                </a>
                            </li>
                            <li><hr class="dropdown-divider my-1" /></li>
                            <li>
                                <a class="dropdown-item admin-dropdown-item text-danger" asp-controller="Account" asp-action="Logout" asp-area="">
                                    <i class="bi bi-box-arrow-right text-danger"></i>Đăng xuất
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <!-- Page Content Landmark -->
            <main class="admin-content" id="admin-main-content">
                @Html.AntiForgeryToken()
                @RenderBody()
            </main>

            <!-- Footer -->
            <footer class="admin-footer">
                <div>
                    &copy; @DateTime.Now.Year <strong>TCT English</strong> — Bảng điều khiển Quản trị viên
                </div>
                <div>
                    <span class="badge bg-primary bg-opacity-10 text-primary fw-medium px-2 py-1">
                        <i class="bi bi-shield-check me-1"></i>Hệ thống bảo mật
                    </span>
                </div>
            </footer>
        </div>
    </div>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL"
            crossorigin="anonymous"></script>

    <!-- Shared Admin Shell Script (AS01) -->
    <script src="~/js/admin-shell.js" asp-append-version="true"></script>

    <!-- SweetAlert2 -->
    <script src="~/lib/pinned/sweetalert2-11.26.25.all.min.js" asp-append-version="true"></script>

    <!-- SignalR & Real-time Presence -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <script src="~/js/user-activity.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
