@using TCTEnglish.Services.Admin
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@model SetCardsViewModel
@{
    var set = Model.Cards;
    // A local picture that is not in wwwroot would only produce a 404; show the emoji or the initial instead.
    bool ImageUsable(string? url) => !string.IsNullOrWhiteSpace(url)
        && (!url.StartsWith('/') || Env.WebRootFileProvider.GetFileInfo(url).Exists);
    ViewData["Title"] = "Thẻ của " + set.SetName;
    var exposureTag = set.Exposure switch
    {
        "Public" => "Công khai",
        "Link" => "Có liên kết",
        _ => "Riêng tư",
    };
    var actions = new List<AcAction>();
    if (set.IsSystem)
    {
        actions.Add(new AcAction("Xem như học viên", "/Vocabulary/Index", "fa-solid fa-arrow-up-right-from-square", "outline", "Mở trang Từ vựng của học viên"));
        actions.Add(new AcAction("Sửa thông tin", Url.Action("Edit", "SetManagement", new { area = "Admin", id = set.SetId })!, "fa-solid fa-pen"));
        actions.Add(new AcAction("Tải JSON", Url.Action("Export", "SetManagement", new { area = "Admin", id = set.SetId })!, "fa-solid fa-download", "outline", "Tải bộ này theo định dạng system-vocabulary.json"));
        actions.Add(new AcAction("Thêm thẻ", Url.Action("AddCard", "SetManagement", new { area = "Admin", setId = set.SetId })!, "fa-solid fa-plus", "primary"));
    }
    else if (set.Exposure == "Public")
    {
        actions.Add(new AcAction("Xem như học viên", $"/Sets/{set.SetId}", "fa-solid fa-arrow-up-right-from-square", "outline", "Mở trang bộ thẻ công khai"));
    }

    var header = new AcPageHeaderModel
    {
        Icon = "fa-solid fa-clone",
        Title = set.SetName,
        Subtitle = $"Thư mục: {(string.IsNullOrWhiteSpace(set.FolderName) ? "không có" : set.FolderName)} · Chủ sở hữu: {set.OwnerName} · {exposureTag}",
        Crumbs = new[] { new AcCrumb("Quản lý bộ từ vựng", Url.Action("Index", "SetManagement", new { area = "Admin" })), new AcCrumb(set.SetName) },
        Tags = new[] { set.IsSystem ? new AcTag("Từ vựng hệ thống", AcTone.Primary) : new AcTag("Của người dùng", AcTone.Info) },
        Actions = actions,
    };
    var figures = new List<AcFigure>
    {
        new("Tổng số thẻ", set.TotalCards.ToString("N0"), "fa-solid fa-clone", AcTone.Primary),
        new("Bài học", set.LessonCount.ToString("N0"), "fa-solid fa-book-open", AcTone.Info, "Chia theo chủ đề, khoảng 10 thẻ mỗi bài"),
        new("Thiếu ví dụ hoặc IPA", set.MissingExampleOrPhonetic.ToString("N0"), "fa-solid fa-triangle-exclamation", AcTone.Warning),
        new("Học viên đã học", set.LearnerCount.ToString("N0"), "fa-solid fa-user-graduate", AcTone.Success),
    };
    var topicOptions = new List<AcOption> { new("", "Mọi chủ đề") };
    topicOptions.AddRange(set.Topics.Select(t => new AcOption(t, t)));
    var filter = new AcFilterBarModel
    {
        Controller = "SetManagement",
        Action = "Cards",
        FormId = "cardFilterForm",
        Hidden = new Dictionary<string, string> { ["id"] = set.SetId.ToString() },
        Fields = new AcFilterField[]
        {
            new() { Name = "q", Label = "Tìm từ hoặc nghĩa", Kind = "search", Value = Model.Q, Placeholder = "Tìm từ hoặc nghĩa..." },
            new() { Name = "topic", Label = "Chủ đề (bài)", Value = Model.Topic, Options = topicOptions },
            new() { Name = "quality", Label = "Kiểm tra", Value = Model.Quality, Options = new[] { new AcOption("", "Tất cả"), new AcOption("complete", "Đủ thông tin"), new AcOption("missing-example", "Thiếu ví dụ"), new AcOption("missing-phonetic", "Thiếu IPA"), new AcOption("missing-picture", "Thiếu hình") } },
        },
    };
    var tableHeader = new AcTableHeaderModel { Title = "Thẻ trong bộ", Icon = "fa-solid fa-list", Count = set.TotalItems };
    var tagComplete = new AcTag("Đủ thông tin", AcTone.Success);
    var tagNoExample = new AcTag("Thiếu ví dụ", AcTone.Warning);
    var tagNoPhonetic = new AcTag("Thiếu IPA", AcTone.Warning);
    var tagNoPicture = new AcTag("Thiếu hình", AcTone.Warning);
    var pager = new AcPagerModel
    {
        Action = "Cards", Page = set.Page, PageSize = set.PageSize, TotalItems = set.TotalItems,
        Route = new Dictionary<string, string?> { ["id"] = set.SetId.ToString(), ["q"] = Model.Q, ["topic"] = Model.Topic, ["quality"] = Model.Quality },
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-content.css" asp-append-version="true" />
}

<div class="ac-page ac-sets">
    <partial name="_AcPageHeader" model="header" />
    <partial name="_AcAlerts" />

    @if (set.IsSystem)
    {
        <div class="ac-notice" role="note">
            <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
            <div><strong>Bộ hệ thống được đồng bộ từ tệp dữ liệu.</strong> Khi bật đồng bộ lúc khởi động, thẻ không có trong tệp sẽ bị xóa. Hãy sửa đồng thời <code>system-vocabulary.json</code> nếu muốn giữ thay đổi (nút "Tải JSON" xuất đúng định dạng của tệp).</div>
        </div>
    }
    else
    {
        <div class="ac-notice ac-notice--info" role="note">
            <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
            <div>Bộ thẻ của <strong>@set.OwnerName</strong>. Admin chỉ xem; có thể đặt riêng tư hoặc xóa ở danh sách bộ từ vựng.</div>
        </div>
    }

    <partial name="_AcFigures" model="@((IReadOnlyList<AcFigure>)figures)" />
    <partial name="_AcFilterBar" model="filter" />

    <div class="ac-card">
        <partial name="_AcTableHeader" model="tableHeader" />
        <div class="ac-table-wrap">
            <table class="ac-table">
                <thead>
                    <tr>
                        <th scope="col">Từ</th>
                        <th scope="col">Nghĩa</th>
                        <th scope="col">Chủ đề (bài)</th>
                        <th scope="col">Ví dụ</th>
                        <th scope="col">Kiểm tra</th>
                        @if (set.IsSystem)
                        {
                            <th scope="col" class="ac-actions">Hành động</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (set.Rows.Count == 0)
                    {
                        <tr>
                            <td colspan="@(set.IsSystem ? 6 : 5)">
                                <div class="ac-empty">
                                    <i class="fa-regular fa-clone" aria-hidden="true"></i>
                                    <p class="mb-0">@(set.TotalCards == 0 ? "Bộ này chưa có thẻ nào." : "Không có thẻ nào khớp với bộ lọc hiện tại.")</p>
                                </div>
                            </td>
                        </tr>
                    }
                    @foreach (var card in set.Rows)
                    {
                        var initial = string.IsNullOrWhiteSpace(card.Term) ? "?" : card.Term.Trim().Substring(0, 1).ToUpperInvariant();
                        <tr>
                            <td>
                                <div class="ac-word">
                                    <span class="ac-word-pic" aria-hidden="true">
                                        @if (ImageUsable(card.ImageUrl))
                                        {
                                            <img src="@card.ImageUrl" alt="" loading="lazy" data-ac-fallback data-ac-initial="@initial" />
                                        }
                                        else if (!string.IsNullOrWhiteSpace(card.Emoji))
                                        {
                                            <span>@card.Emoji</span>
                                        }
                                        else
                                        {
                                            <span class="ac-word-initial">@initial</span>
                                        }
                                    </span>
                                    <div>
                                        <div class="ac-cell-main">@card.Term</div>
                                        <div class="ac-cell-sub">@(string.IsNullOrWhiteSpace(card.Phonetic) ? "—" : card.Phonetic)</div>
                                    </div>
                                </div>
                            </td>
                            <td>@card.Definition</td>
                            <td>@(string.IsNullOrWhiteSpace(card.Topic) ? "—" : card.Topic)</td>
                            <td class="ac-cell-clip">@(string.IsNullOrWhiteSpace(card.Example) ? "—" : card.Example)</td>
                            <td>
                                @if (card.IsComplete)
                                {
                                    <partial name="_AcStatusTag" model="tagComplete" />
                                }
                                else
                                {
                                    <div class="ac-tag-stack">
                                        @if (card.MissingExample) { <partial name="_AcStatusTag" model="tagNoExample" /> }
                                        @if (card.MissingPhonetic) { <partial name="_AcStatusTag" model="tagNoPhonetic" /> }
                                        @if (card.MissingPicture) { <partial name="_AcStatusTag" model="tagNoPicture" /> }
                                    </div>
                                }
                            </td>
                            @if (set.IsSystem)
                            {
                                var deleteModel = new AcConfirmDeleteModel
                                {
                                    Action = "DeleteCard",
                                    Controller = "SetManagement",
                                    Route = new Dictionary<string, string> { ["cardId"] = card.CardId.ToString() },
                                    ConfirmName = card.Term,
                                    Title = "Xóa thẻ?",
                                    Impact = "Thẻ và tiến độ học của học viên với thẻ này sẽ bị xóa.",
                                    AriaLabel = $"Xóa thẻ {card.Term}",
                                };
                                <td class="ac-actions">
                                    <div class="ac-actions-row">
                                        <a asp-action="EditCard" asp-route-id="@card.CardId" class="ac-icon-btn" title="Sửa thẻ" aria-label="Sửa thẻ @card.Term">
                                            <i class="fa-solid fa-pen" aria-hidden="true"></i>
                                        </a>
                                        <partial name="_AcConfirmDelete" model="deleteModel" />
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_AcPager" model="pager" />
    </div>
</div>

@section Scripts {
    <script src="~/js/admin-content.js" asp-append-version="true"></script>
}
