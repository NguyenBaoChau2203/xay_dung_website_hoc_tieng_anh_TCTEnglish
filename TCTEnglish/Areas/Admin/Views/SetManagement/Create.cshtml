@model SetFormViewModel
@{
    ViewData["Title"] = "Tạo bộ từ vựng hệ thống";
    var header = new AcPageHeaderModel
    {
        Icon = "fa-solid fa-layer-group",
        Title = "Tạo bộ từ vựng hệ thống",
        Subtitle = "Bộ mới thuộc về hệ thống, luôn công khai và hiển thị trên trang Từ vựng của học viên.",
        Crumbs = new[] { new AcCrumb("Quản lý bộ từ vựng", Url.Action("Index", "SetManagement", new { area = "Admin" })), new AcCrumb("Tạo bộ từ vựng") },
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-content.css" asp-append-version="true" />
}

<div class="ac-page ac-sets">
    <partial name="_AcPageHeader" model="header" />
    <partial name="_AcAlerts" />
    <partial name="_SetForm" model="Model" />
</div>

@section Scripts {
    <script src="~/js/admin-content.js" asp-append-version="true"></script>
}
