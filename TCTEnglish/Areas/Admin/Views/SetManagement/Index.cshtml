@using TCTEnglish.Services.Admin
@using TCTEnglish.Services.Billing
@model SetManagementIndexViewModel
@{
    ViewData["Title"] = "Quản lý bộ từ vựng";
    var list = Model.List;
    var figures = Model.Figures;
    var header = new AcPageHeaderModel
    {
        Icon = "fa-solid fa-layer-group",
        Title = "Quản lý bộ từ vựng",
        Subtitle = "Bộ từ vựng hệ thống (trang Từ vựng) và bộ thẻ người dùng tạo.",
        Actions = new[] { new AcAction("Tạo bộ từ vựng hệ thống", Url.Action("Create", "SetManagement", new { area = "Admin" })!, "fa-solid fa-plus", "primary") },
    };
    var cards = new List<AcFigure>
    {
        new("Bộ từ vựng hệ thống", figures.SystemSets.ToString("N0"), "fa-solid fa-layer-group", AcTone.Primary),
        new("Thẻ hệ thống", figures.SystemCards.ToString("N0"), "fa-solid fa-clone", AcTone.Success),
        new("Bộ thẻ người dùng", figures.UserSets.ToString("N0"), "fa-solid fa-user", AcTone.Info),
        new("Thẻ thiếu ví dụ/IPA", figures.SystemCardsMissingExampleOrPhonetic.ToString("N0"), "fa-solid fa-triangle-exclamation", AcTone.Warning, "Chỉ tính thẻ hệ thống"),
    };
    var folderOptions = new List<AcOption> { new("", "Tất cả thư mục hệ thống") };
    folderOptions.AddRange(list.SystemFolders.Select(f => new AcOption(f.FolderId.ToString(), f.Name)));
    var filter = new AcFilterBarModel
    {
        Controller = "SetManagement",
        FormId = "setFilterForm",
        Fields = new AcFilterField[]
        {
            new() { Name = "q", Label = "Tìm kiếm", Kind = "search", Value = Model.Q, Placeholder = "Tên bộ hoặc mô tả..." },
            new() { Name = "ownerFilter", Label = "Nguồn", Value = Model.OwnerFilter, Options = new[] { new AcOption("", "Tất cả"), new AcOption("system", "Từ vựng hệ thống"), new AcOption("user", "Của người dùng") } },
            new() { Name = "folderId", Label = "Thư mục", Value = Model.FolderId?.ToString(), Disabled = Model.OwnerFilter != "system", Hint = Model.OwnerFilter != "system" ? "Chọn Nguồn = Từ vựng hệ thống để lọc theo thư mục." : null, Options = folderOptions },
            new() { Name = "visibility", Label = "Hiển thị", Value = Model.Visibility, Options = new[] { new AcOption("", "Tất cả"), new AcOption("Public", "Công khai"), new AcOption("Link", "Có liên kết"), new AcOption("Private", "Riêng tư") } },
        },
    };
    var tableHeader = new AcTableHeaderModel
    {
        Title = "Danh sách bộ từ vựng",
        Icon = "fa-solid fa-list",
        Count = list.TotalItems,
        SortFormId = "setFilterForm",
        Sort = new AcFilterField
        {
            Name = "sort", Label = "Sắp xếp", Value = Model.Sort,
            Options = new[] { new AcOption("newest", "Mới tạo trước"), new AcOption("name", "Tên A–Z"), new AcOption("cards", "Nhiều thẻ nhất"), new AcOption("views", "Nhiều lượt học nhất") },
        },
    };
    var pager = new AcPagerModel
    {
        Page = list.Page, PageSize = list.PageSize, TotalItems = list.TotalItems,
        Route = new Dictionary<string, string?>
        {
            ["q"] = Model.Q, ["ownerFilter"] = Model.OwnerFilter, ["folderId"] = Model.FolderId?.ToString(),
            ["visibility"] = Model.Visibility, ["sort"] = Model.Sort == "newest" ? null : Model.Sort,
        },
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-content.css" asp-append-version="true" />
}

<div class="ac-page ac-sets">
    <partial name="_AcPageHeader" model="header" />
    <partial name="_AcAlerts" />
    <partial name="_AcFigures" model="@((IReadOnlyList<AcFigure>)cards)" />
    <partial name="_AcFilterBar" model="filter" />

    <div class="ac-card">
        <partial name="_AcTableHeader" model="tableHeader" />
        <div class="ac-table-wrap">
            <table class="ac-table">
                <thead>
                    <tr>
                        <th scope="col">Bộ từ vựng</th>
                        <th scope="col">Nguồn</th>
                        <th scope="col">Chủ sở hữu</th>
                        <th scope="col">Thư mục</th>
                        <th scope="col">Hiển thị</th>
                        <th scope="col" class="ac-num">Thẻ</th>
                        <th scope="col" class="ac-num">Lượt học</th>
                        <th scope="col">Ngày tạo</th>
                        <th scope="col" class="ac-actions">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (list.Rows.Count == 0)
                    {
                        <tr>
                            <td colspan="9">
                                <div class="ac-empty">
                                    <i class="fa-regular fa-folder-open" aria-hidden="true"></i>
                                    <p class="mb-0">Không có bộ từ vựng nào khớp với bộ lọc hiện tại.</p>
                                </div>
                            </td>
                        </tr>
                    }
                    @foreach (var row in list.Rows)
                    {
                        var exposure = row.Exposure switch
                        {
                            "Public" => new AcTag("Công khai", AcTone.Success),
                            "Link" => new AcTag("Có liên kết", AcTone.Warning),
                            _ => new AcTag("Riêng tư", AcTone.Danger),
                        };
                        var source = row.IsSystem ? new AcTag("Từ vựng hệ thống", AcTone.Primary) : new AcTag("Của người dùng", AcTone.Info);
                        var deleteModel = new AcConfirmDeleteModel
                        {
                            Controller = "SetManagement",
                            Route = new Dictionary<string, string> { ["id"] = row.SetId.ToString() },
                            ConfirmName = row.Name,
                            Title = "Xóa bộ từ vựng?",
                            Impact = $"{row.CardCount} thẻ và tiến độ học của học viên sẽ bị xóa."
                                + (row.IsSystem ? " Bộ hệ thống sẽ được tạo lại ở lần đồng bộ sau nếu còn trong system-vocabulary.json." : ""),
                            AriaLabel = $"Xóa bộ {row.Name}",
                        };
                        <tr>
                            <td>
                                <div class="ac-cell-main">@(string.IsNullOrWhiteSpace(row.Name) ? "(Chưa đặt tên)" : row.Name)</div>
                                <div class="ac-cell-sub">@(row.IsSystem ? $"{row.TopicCount} chủ đề" : "Bộ thẻ cá nhân")</div>
                            </td>
                            <td><partial name="_AcStatusTag" model="source" /></td>
                            <td>@(row.IsSystem ? "TCT English (hệ thống)" : row.OwnerName)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.FolderName) ? "—" : row.FolderName)</td>
                            <td><partial name="_AcStatusTag" model="exposure" /></td>
                            <td class="ac-num">@row.CardCount.ToString("N0")</td>
                            <td class="ac-num">@row.ViewCount.ToString("N0")</td>
                            <td class="ac-num">@(row.CreatedAt.HasValue ? BillingTime.ToDisplayDate(row.CreatedAt.Value) : "—")</td>
                            <td class="ac-actions">
                                <div class="ac-actions-row">
                                    <a asp-action="Cards" asp-route-id="@row.SetId" class="ac-icon-btn" title="@(row.IsSystem ? "Quản lý thẻ" : "Xem thẻ")" aria-label="@(row.IsSystem ? "Quản lý thẻ của" : "Xem thẻ của") @row.Name">
                                        <i class="fa-solid fa-list-check" aria-hidden="true"></i>
                                    </a>
                                    @if (row.IsSystem)
                                    {
                                        <a asp-action="Edit" asp-route-id="@row.SetId" class="ac-icon-btn" title="Sửa thông tin" aria-label="Sửa thông tin @row.Name">
                                            <i class="fa-solid fa-pen" aria-hidden="true"></i>
                                        </a>
                                    }
                                    else if (row.Exposure != "Private")
                                    {
                                        <form method="post" asp-action="SetVisibility" asp-route-id="@row.SetId" class="ac-inline-form">
                                            <input type="hidden" name="visibility" value="Private" />
                                            <button type="submit" class="btn ac-icon-btn" title="Đặt riêng tư và tắt liên kết chia sẻ" aria-label="Đặt riêng tư bộ @row.Name">
                                                <i class="fa-solid fa-eye-slash" aria-hidden="true"></i>
                                            </button>
                                        </form>
                                    }
                                    <partial name="_AcConfirmDelete" model="deleteModel" />
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_AcPager" model="pager" />
    </div>
</div>

@section Scripts {
    <script src="~/js/admin-content.js" asp-append-version="true"></script>
}
