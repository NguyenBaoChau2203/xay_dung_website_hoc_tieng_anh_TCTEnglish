@model SetFormViewModel
@{
    ViewData["Title"] = "Sửa bộ từ vựng";
    var header = new AcPageHeaderModel
    {
        Icon = "fa-solid fa-pen",
        Title = "Sửa bộ từ vựng",
        Subtitle = "Đổi mô tả và thư mục. Tên bộ giữ nguyên vì tệp dữ liệu đồng bộ theo tên.",
        Crumbs = new[]
        {
            new AcCrumb("Quản lý bộ từ vựng", Url.Action("Index", "SetManagement", new { area = "Admin" })),
            new AcCrumb(string.IsNullOrWhiteSpace(Model.Name) ? "Bộ từ vựng" : Model.Name, Url.Action("Cards", "SetManagement", new { area = "Admin", id = Model.SetId })),
            new AcCrumb("Sửa thông tin"),
        },
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-content.css" asp-append-version="true" />
}

<div class="ac-page ac-sets">
    <partial name="_AcPageHeader" model="header" />
    <partial name="_AcAlerts" />
    <partial name="_SetForm" model="Model" />
</div>

@section Scripts {
    <script src="~/js/admin-content.js" asp-append-version="true"></script>
}
