@model CardFormViewModel
@{
    ViewData["Title"] = "Sửa thẻ";
    var header = new AcPageHeaderModel
    {
        Icon = "fa-solid fa-pen",
        Title = "Sửa thẻ",
        Subtitle = "Thẻ trong bộ " + Model.SetName + ".",
        Crumbs = new[]
        {
            new AcCrumb("Quản lý bộ từ vựng", Url.Action("Index", "SetManagement", new { area = "Admin" })),
            new AcCrumb(Model.SetName, Url.Action("Cards", "SetManagement", new { area = "Admin", id = Model.SetId })),
            new AcCrumb("Sửa thẻ"),
        },
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-content.css" asp-append-version="true" />
}

<div class="ac-page ac-sets">
    <partial name="_AcPageHeader" model="header" />
    <partial name="_AcAlerts" />
    <partial name="_CardForm" model="Model" />
</div>

@section Scripts {
    <script src="~/js/admin-content.js" asp-append-version="true"></script>
}
