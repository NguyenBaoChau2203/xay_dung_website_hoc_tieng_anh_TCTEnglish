@model TCTVocabulary.Areas.Admin.ViewModels.SpeakingVideoEditViewModel
@{
    ViewData["Title"] = "Chỉnh sửa Speaking Video";
    var thumb = string.IsNullOrEmpty(Model.ThumbnailUrl)
        ? $"https://img.youtube.com/vi/{Model.YoutubeId}/hqdefault.jpg"
        : Model.ThumbnailUrl;
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-speaking-video.css" asp-append-version="true" />
}

<div class="tct-theme container-fluid py-4 admin-speaking-page">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            @* Header & Back Button *@
            <div class="d-flex align-items-center mb-4 gap-3">
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                    <i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i> Quay lại
                </a>
                <div>
                    <h1 class="h2 mb-0 fw-bold text-dark">Chỉnh sửa Video</h1>
                    <p class="text-muted mb-0 small">Cập nhật thông tin phân loại và chủ đề bài học</p>
                </div>
            </div>

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                    <i class="fa-solid fa-triangle-exclamation me-2" aria-hidden="true"></i>@TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng thông báo"></button>
                </div>
            }

            @* Video Preview Card (Clay Surface) *@
            <div class="admin-speaking-card p-4 mb-4">
                <div class="d-flex gap-4 align-items-center flex-wrap">
                    <img src="@thumb" alt="Thumbnail @Model.Title" class="admin-video-thumb-lg" />
                    <div class="flex-grow-1">
                        <p class="text-muted small mb-1 fw-semibold">YouTube Video</p>
                        <a href="https://youtube.com/watch?v=@Model.YoutubeId" target="_blank" rel="noopener noreferrer"
                           class="badge bg-danger text-white text-decoration-none fs-6 mb-2">
                            <i class="fa-brands fa-youtube me-1" aria-hidden="true"></i> @Model.YoutubeId
                        </a>
                        <p class="text-muted small mb-0 mt-2">
                            <i class="fa-solid fa-list-check me-1 text-primary" aria-hidden="true"></i>
                            <strong>@Model.SentenceCount</strong> câu thoại đã được trích xuất
                        </p>
                    </div>
                </div>
            </div>

            @* Edit Form Card (Clay Surface) *@
            <div class="admin-speaking-card p-4 p-md-5 mb-4">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                <form asp-action="Edit" asp-route-id="@Model.Id" method="post" id="editVideoForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <div class="row g-4">
                        @* Title *@
                        <div class="col-12">
                            <label asp-for="Title" class="form-label fw-bold">
                                Tiêu đề bài học <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Title" class="form-control" placeholder="Nhập tiêu đề hiển thị cho học viên" />
                            <span asp-validation-for="Title" class="text-danger small mt-1 d-block"></span>
                        </div>

                        @* Level *@
                        <div class="col-md-6">
                            <label asp-for="Level" class="form-label fw-bold">
                                Trình độ CEFR <span class="text-danger">*</span>
                            </label>
                            <select asp-for="Level" class="form-select">
                                <option value="">-- Chọn trình độ --</option>
                                <option value="A1">A1 (Beginner — Sơ cấp)</option>
                                <option value="A2">A2 (Pre-Intermediate — Cơ bản)</option>
                                <option value="B1">B1 (Intermediate — Trung cấp)</option>
                                <option value="B2">B2 (Upper-Intermediate — Khá)</option>
                                <option value="C1">C1 (Advanced — Cao cấp)</option>
                                <option value="C2">C2 (Proficient — Thành thạo)</option>
                            </select>
                            <span asp-validation-for="Level" class="text-danger small mt-1 d-block"></span>
                        </div>

                        @* Topic *@
                        <div class="col-md-6">
                            <label asp-for="Topic" class="form-label fw-bold">Chủ đề</label>
                            <input asp-for="Topic" class="form-control" placeholder="Ví dụ: Daily Life, Business, Vlogs..." />
                            <span asp-validation-for="Topic" class="text-danger small mt-1 d-block"></span>
                        </div>

                        @* Playlist *@
                        <div class="col-12">
                            <label asp-for="PlaylistId" class="form-label fw-bold">Playlist</label>
                            <select asp-for="PlaylistId" class="form-select">
                                <option value="0">-- Mặc định (General) --</option>
                                @foreach (var playlist in Model.Playlists)
                                {
                                    <option value="@playlist.Id">@playlist.Name</option>
                                }
                            </select>
                            <span asp-validation-for="PlaylistId" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>

                    <hr class="my-4 opacity-10" />

                    @* Form Actions *@
                    <div class="d-flex justify-content-end gap-3">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">Hủy bỏ</a>
                        <button type="submit" class="btn btn-primary px-4 shadow-sm" id="btnEditSubmit">
                            <span class="d-none spinner-border spinner-border-sm me-2" role="status" aria-hidden="true" id="editSpinner"></span>
                            <i class="fa-solid fa-check me-1" id="editIcon" aria-hidden="true"></i>
                            <span id="editText">Lưu thay đổi</span>
                            <span id="editTextLoading" class="d-none">Đang lưu...</span>
                        </button>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            'use strict';
            var form = document.getElementById('editVideoForm');
            var btn = document.getElementById('btnEditSubmit');
            var spinner = document.getElementById('editSpinner');
            var icon = document.getElementById('editIcon');
            var text = document.getElementById('editText');
            var textLoading = document.getElementById('editTextLoading');

            if (form && btn) {
                form.addEventListener('submit', function () {
                    if (form.checkValidity()) {
                        btn.disabled = true;
                        if (icon) icon.classList.add('d-none');
                        if (spinner) spinner.classList.remove('d-none');
                        if (text) text.classList.add('d-none');
                        if (textLoading) textLoading.classList.remove('d-none');
                    }
                });
            }
        })();
    </script>
}
