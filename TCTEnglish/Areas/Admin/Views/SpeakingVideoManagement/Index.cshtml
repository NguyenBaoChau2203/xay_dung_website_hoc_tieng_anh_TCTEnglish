@model TCTVocabulary.Areas.Admin.ViewModels.SpeakingVideoIndexViewModel
@{
    ViewData["Title"] = "Quản lý Speaking Video";
    var videos = Model?.Videos ?? new List<TCTVocabulary.Areas.Admin.ViewModels.SpeakingVideoListItemViewModel>();
    var levels = Model.Levels;
    var topics = Model.Topics;
}

<div class="container-fluid py-4">
    <div class="row mb-4 align-items-center">
        <div class="col-md-6">
            <h2 class="mb-0 text-dark fw-bold">Quản lý Speaking Video</h2>
            <p class="text-muted mb-0">Quản lý các video luyện nói và phụ đề</p>
        </div>
        <div class="col-md-6 text-md-end mt-3 mt-md-0 d-flex justify-content-md-end gap-2">
            <a asp-action="Create" class="btn btn-primary shadow-sm rounded-pill px-4">
                <i class="fa-solid fa-plus me-2"></i> Thêm Video Mới
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-4" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i><strong>Thành công!</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm rounded-4" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i><strong>Lỗi!</strong> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @* Filter Section *@
    <div class="card border-0 shadow-sm rounded-4 mb-3">
        <div class="card-body py-3 px-4">
            <form method="get" asp-action="Index" class="row g-3 align-items-end" id="catalogFilters">
                <div class="col-md-4">
                    <label for="filterLevel" class="form-label fw-semibold text-muted small mb-1">
                        <i class="fa-solid fa-layer-group me-1"></i> Lọc theo Trình độ
                    </label>
                    <select id="filterLevel" name="level" class="form-select form-select-sm" aria-label="Lọc video theo trình độ">
                        <option value="">Tất cả trình độ</option>
                        @foreach (var level in levels)
                        {
                            <option value="@level" selected="@(Model.Level == level)">@level</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label for="filterTopic" class="form-label fw-semibold text-muted small mb-1">
                        <i class="fa-solid fa-tag me-1"></i> Lọc theo Chủ đề
                    </label>
                    <select id="filterTopic" name="topic" class="form-select form-select-sm" aria-label="Lọc video theo chủ đề">
                        <option value="">Tất cả chủ đề</option>
                        @foreach (var topic in topics)
                        {
                            <option value="@topic" selected="@(Model.Topic == topic)">@topic</option>
                        }
                    </select>
                </div>
                <div class="col-md-4 d-flex align-items-end gap-2">
                    <button type="button" id="btnResetFilter" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                        <i class="fa-solid fa-rotate-left me-1"></i> Đặt lại
                    </button>
                    <span id="filterResultCount" class="text-muted small ms-auto">@Model.TotalCount kết quả</span>
                </div>
            <div class="col-auto"><button type="submit" class="btn btn-primary btn-sm">Lọc</button></div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="videoTable">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4 border-0 text-muted" style="width: 120px;">Ảnh nhỏ</th>
                            <th class="border-0 text-muted">Video</th>
                            <th class="border-0 text-muted">YouTube ID</th>
                            <th class="border-0 text-muted">Trình độ / Chủ đề</th>
                            <th class="border-0 text-muted text-center" style="width: 150px;">Số câu thoại</th>
                            <th class="pe-4 border-0 text-muted text-center" style="width: 120px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody id="videoTableBody">
                        @if (!videos.Any())
                        {
                            <tr class="empty-row">
                                <td colspan="6" class="text-center py-5">
                                    <div class="text-muted">
                                        <i class="fa-solid fa-video-slash fa-3x mb-3 text-secondary opacity-50"></i>
                                        <h5>Chưa có video nào</h5>
                                        <p>Hãy thêm video đầu tiên của bạn.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in videos)
                            {
                                <tr data-level="@item.Level" data-topic="@item.Topic">
                                    <td class="ps-4 py-3">
                                        <img src="@(string.IsNullOrWhiteSpace(item.ThumbnailUrl) ? $"https://img.youtube.com/vi/{item.YoutubeId}/hqdefault.jpg" : item.ThumbnailUrl)"
                                             alt="Ảnh nhỏ"
                                             class="img-fluid rounded-3 shadow-sm admin-video-thumb" />
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark text-truncate admin-title-truncate" title="@item.Title">
                                            @item.Title
                                        </div>
                                        <div class="text-muted small">
                                            <i class="fa-regular fa-clock me-1"></i> @(item.Duration ?? "--:--")
                                        </div>
                                    </td>
                                    <td>
                                        <a href="https://youtube.com/watch?v=@item.YoutubeId" target="_blank" rel="noopener noreferrer"
                                           class="text-decoration-none badge bg-danger text-white rounded-pill">
                                            <i class="fa-brands fa-youtube me-1"></i> @item.YoutubeId
                                        </a>
                                    </td>
                                    <td>
                                        <div class="d-flex flex-column gap-1 align-items-start">
                                            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25">
                                                Level @item.Level
                                            </span>
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25">
                                                @item.Topic
                                            </span>
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-success rounded-pill px-3 py-2">
                                            @item.SentenceCount câu
                                        </span>
                                    </td>
                                    <td class="pe-4 text-center">
                                        <div class="d-flex gap-1 justify-content-center">
                                            <a asp-action="Edit" asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-primary" title="Chỉnh sửa"
                                               aria-label="Chỉnh sửa video @item.Title">
                                                <i class="fa-solid fa-pen"></i>
                                            </a>
                                            <button type="button" class="btn btn-sm btn-outline-danger btn-delete-video"
                                                    data-video-id="@item.Id"
                                                    data-video-title="@item.Title"
                                                    title="Xóa"
                                                    aria-label="Xóa video @item.Title">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <partial name="_CatalogPager" model="Model" />
</div>
@Html.AntiForgeryToken()

<!-- ===== DELETE VIDEO CONFIRMATION MODAL ===== -->
<div class="modal fade" id="deleteVideoModal" tabindex="-1" aria-labelledby="deleteVideoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-danger bg-opacity-10 border-bottom">
                <h5 class="modal-title fw-semibold text-danger" id="deleteVideoModalLabel">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i> Xác nhận xóa video
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted mb-1">Bạn có chắc chắn muốn xóa video:</p>
                <p class="fw-bold text-dark" id="deleteVideoTitle"></p>
                <p class="text-danger small mb-0">Mọi câu thoại liên quan cũng sẽ bị xóa. Hành động này không thể hoàn tác.</p>
            </div>
            <div class="modal-footer border-top">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <form asp-action="Delete" method="post" id="deleteVideoForm" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="deleteVideoId" />
                    <button type="submit" class="btn btn-danger fw-medium">
                        <i class="fa-solid fa-trash me-1"></i> Xóa vĩnh viễn
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            document.querySelectorAll('#catalogFilters select').forEach(function (select) {
                select.addEventListener('change', function () { document.getElementById('catalogFilters').requestSubmit(); });
            });
            document.getElementById('btnResetFilter').addEventListener('click', function () { window.location.href = '@Url.Action("Index")'; });

            // Delete video modal binding
            document.querySelectorAll('.btn-delete-video').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var videoId = this.dataset.videoId;
                    var videoTitle = this.dataset.videoTitle;
                    document.getElementById('deleteVideoId').value = videoId;
                    document.getElementById('deleteVideoTitle').textContent = videoTitle;
                    new bootstrap.Modal(document.getElementById('deleteVideoModal')).show();
                });
            });
        })();
    </script>
}
