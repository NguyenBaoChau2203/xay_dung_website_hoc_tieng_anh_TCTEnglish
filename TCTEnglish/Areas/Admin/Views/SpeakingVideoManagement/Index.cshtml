@model TCTVocabulary.Areas.Admin.ViewModels.SpeakingVideoIndexViewModel
@{
    ViewData["Title"] = "Quản lý Speaking Video";
    var videos = Model?.Videos ?? new List<TCTVocabulary.Areas.Admin.ViewModels.SpeakingVideoListItemViewModel>();
    var levels = Model?.Levels ?? new List<string>();
    var topics = Model?.Topics ?? new List<string>();
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-speaking-video.css" asp-append-version="true" />
}

<div class="tct-theme container-fluid py-4 admin-speaking-page">
    @* Page Header *@
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h1 class="h2 mb-1 fw-bold text-dark">Quản lý Speaking Video</h1>
            <p class="text-muted mb-0">Quản lý kho video luyện nói theo chuẩn CEFR, đồng bộ phụ đề và AI chấm điểm</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary px-4 shadow-sm">
                <i class="fa-solid fa-plus me-1" aria-hidden="true"></i> Thêm Video Mới
            </a>
        </div>
    </div>

    @* Alerts *@
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="fa-solid fa-circle-check me-2" aria-hidden="true"></i><strong>Thành công!</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng thông báo"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2" aria-hidden="true"></i><strong>Lỗi!</strong> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng thông báo"></button>
        </div>
    }

    @* Filter Toolbar (Clay Surface) *@
    <section class="admin-speaking-filter mb-4" aria-label="Bộ lọc danh mục video">
        <form method="get" asp-action="Index" class="row g-3 align-items-end" id="catalogFilters">
            <div class="col-md-4">
                <label for="filterLevel" class="form-label">
                    <i class="fa-solid fa-layer-group me-1 text-primary" aria-hidden="true"></i> Lọc theo Trình độ
                </label>
                <select id="filterLevel" name="level" class="form-select form-select-sm" aria-label="Lọc video theo trình độ">
                    <option value="">Tất cả trình độ</option>
                    @foreach (var level in levels)
                    {
                        <option value="@level" selected="@(Model?.Level == level)">@level</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label for="filterTopic" class="form-label">
                    <i class="fa-solid fa-tag me-1 text-primary" aria-hidden="true"></i> Lọc theo Chủ đề
                </label>
                <select id="filterTopic" name="topic" class="form-select form-select-sm" aria-label="Lọc video theo chủ đề">
                    <option value="">Tất cả chủ đề</option>
                    @foreach (var topic in topics)
                    {
                        <option value="@topic" selected="@(Model?.Topic == topic)">@topic</option>
                    }
                </select>
            </div>
            <div class="col-md-4 d-flex align-items-center justify-content-between gap-2">
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-sm px-3">
                        <i class="fa-solid fa-filter me-1" aria-hidden="true"></i> Lọc
                    </button>
                    <button type="button" id="btnResetFilter" class="btn btn-outline-secondary btn-sm px-3">
                        <i class="fa-solid fa-rotate-left me-1" aria-hidden="true"></i> Đặt lại
                    </button>
                </div>
                <span id="filterResultCount" class="badge bg-light text-secondary border px-3 py-2">
                    <i class="fa-solid fa-video me-1" aria-hidden="true"></i>@(Model?.TotalCount ?? 0) video
                </span>
            </div>
        </form>
    </section>

    @* Table Card (Quiet Clay Surface) *@
    <div class="admin-speaking-card admin-speaking-card--quiet mb-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="videoTable">
                <thead>
                    <tr>
                        <th class="ps-4" style="width: 120px;">Ảnh nhỏ</th>
                        <th>Video</th>
                        <th>YouTube ID</th>
                        <th>Trình độ / Chủ đề</th>
                        <th class="text-center" style="width: 150px;">Số câu thoại</th>
                        <th class="pe-4 text-center" style="width: 130px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody id="videoTableBody">
                    @if (!videos.Any())
                    {
                        <tr class="empty-row">
                            <td colspan="6" class="text-center py-5">
                                <div class="py-4">
                                    <i class="fa-solid fa-video-slash fa-3x mb-3 text-muted opacity-50" aria-hidden="true"></i>
                                    <h5 class="fw-bold text-dark">Chưa có video nào</h5>
                                    <p class="text-muted mb-3">Hãy thêm video đầu tiên để bắt đầu xây dựng bài luyện nói.</p>
                                    <a asp-action="Create" class="btn btn-primary btn-sm px-3">
                                        <i class="fa-solid fa-plus me-1" aria-hidden="true"></i> Thêm video ngay
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in videos)
                        {
                            <tr data-level="@item.Level" data-topic="@item.Topic">
                                <td class="ps-4 py-3">
                                    <img src="@(string.IsNullOrWhiteSpace(item.ThumbnailUrl) ? $"https://img.youtube.com/vi/{item.YoutubeId}/hqdefault.jpg" : item.ThumbnailUrl)"
                                         alt="@item.Title"
                                         class="admin-video-thumb"
                                         loading="lazy" />
                                </td>
                                <td>
                                    <div class="fw-bold text-dark admin-title-truncate" title="@item.Title">
                                        @item.Title
                                    </div>
                                    <div class="text-muted small mt-1">
                                        <i class="fa-regular fa-clock me-1" aria-hidden="true"></i>@(item.Duration ?? "--:--")
                                    </div>
                                </td>
                                <td>
                                    <a href="https://youtube.com/watch?v=@item.YoutubeId" target="_blank" rel="noopener noreferrer"
                                       class="badge bg-danger text-white text-decoration-none">
                                        <i class="fa-brands fa-youtube me-1" aria-hidden="true"></i>@item.YoutubeId
                                    </a>
                                </td>
                                <td>
                                    <div class="d-flex flex-column gap-1 align-items-start">
                                        <span class="admin-level-badge admin-level-badge--@item.Level">
                                            @item.Level
                                        </span>
                                        @if (!string.IsNullOrEmpty(item.Topic))
                                        {
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25">
                                                @item.Topic
                                            </span>
                                        }
                                    </div>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2">
                                        <i class="fa-solid fa-list-check me-1" aria-hidden="true"></i>@item.SentenceCount câu
                                    </span>
                                </td>
                                <td class="pe-4 text-center">
                                    <div class="d-flex gap-1 justify-content-center">
                                        <a asp-action="Edit" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-primary" title="Chỉnh sửa"
                                           aria-label="Chỉnh sửa video @item.Title">
                                            <i class="fa-solid fa-pen" aria-hidden="true"></i>
                                        </a>
                                        <button type="button" class="btn btn-sm btn-outline-danger btn-delete-video"
                                                data-video-id="@item.Id"
                                                data-video-title="@item.Title"
                                                title="Xóa"
                                                aria-label="Xóa video @item.Title">
                                            <i class="fa-solid fa-trash" aria-hidden="true"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    @* Pagination *@
    <partial name="_CatalogPager" model="Model" />
</div>

@Html.AntiForgeryToken()

<!-- ===== DELETE VIDEO CONFIRMATION MODAL (Clay Dialog) ===== -->
<div class="modal fade tct-theme" id="deleteVideoModal" tabindex="-1" aria-labelledby="deleteVideoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="spk-modal-content">
            <div class="spk-modal-header">
                <div class="spk-modal-header-icon--danger">
                    <i class="fa-solid fa-trash-can fa-lg" aria-hidden="true"></i>
                </div>
                <div class="flex-grow-1">
                    <h5 class="spk-modal-title" id="deleteVideoModalLabel">Xác nhận xóa video</h5>
                    <p class="spk-modal-subtitle">Hành động quản trị này không thể hoàn tác.</p>
                </div>
                <button type="button" class="spk-modal-close" data-bs-dismiss="modal" aria-label="Đóng">
                    <i class="fa-solid fa-xmark fa-lg" aria-hidden="true"></i>
                </button>
            </div>
            <div class="spk-modal-body">
                <p class="text-muted mb-2">Bạn có chắc chắn muốn xóa video này khỏi hệ thống?</p>
                <div class="spk-modal-target-box mb-3">
                    <i class="fa-solid fa-film text-primary fs-5" aria-hidden="true"></i>
                    <strong class="text-dark d-block" id="deleteVideoTitle"></strong>
                </div>
                <div class="spk-modal-warning-box">
                    <i class="fa-solid fa-triangle-exclamation spk-modal-warning-icon" aria-hidden="true"></i>
                    <div>
                        <strong>Cảnh báo quan trọng:</strong> Toàn bộ câu thoại trích xuất và tiến trình học liên quan sẽ bị xóa vĩnh viễn khỏi hệ thống.
                    </div>
                </div>
            </div>
            <div class="spk-modal-footer">
                <button type="button" class="spk-btn spk-btn--ghost" data-bs-dismiss="modal">
                    <i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i>
                    Hủy bỏ
                </button>
                <form asp-action="Delete" method="post" id="deleteVideoForm" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="deleteVideoId" />
                    <button type="submit" class="spk-btn spk-btn--danger" id="btnConfirmDelete">
                        <i class="fa-solid fa-trash-can me-1" aria-hidden="true"></i>
                        Xóa vĩnh viễn
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            'use strict';

            // Filter auto-submit on dropdown change
            document.querySelectorAll('#catalogFilters select').forEach(function (select) {
                select.addEventListener('change', function () {
                    document.getElementById('catalogFilters').requestSubmit();
                });
            });

            // Reset filter button
            var btnReset = document.getElementById('btnResetFilter');
            if (btnReset) {
                btnReset.addEventListener('click', function () {
                    window.location.href = '@Url.Action("Index")';
                });
            }

            // Delete video modal binding with focus management
            var deleteModalEl = document.getElementById('deleteVideoModal');
            var deleteModal = deleteModalEl ? new bootstrap.Modal(deleteModalEl) : null;
            var lastTriggerBtn = null;

            document.querySelectorAll('.btn-delete-video').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    lastTriggerBtn = this;
                    var videoId = this.dataset.videoId;
                    var videoTitle = this.dataset.videoTitle;
                    document.getElementById('deleteVideoId').value = videoId;
                    document.getElementById('deleteVideoTitle').textContent = videoTitle;
                    if (deleteModal) deleteModal.show();
                });
            });

            if (deleteModalEl) {
                deleteModalEl.addEventListener('shown.bs.modal', function () {
                    var confirmBtn = document.getElementById('btnConfirmDelete');
                    if (confirmBtn) confirmBtn.focus();
                });
                deleteModalEl.addEventListener('hidden.bs.modal', function () {
                    if (lastTriggerBtn) {
                        lastTriggerBtn.focus();
                        lastTriggerBtn = null;
                    }
                });

                // Pending submission state on delete
                var deleteForm = document.getElementById('deleteVideoForm');
                if (deleteForm) {
                    deleteForm.addEventListener('submit', function () {
                        var confirmBtn = document.getElementById('btnConfirmDelete');
                        if (confirmBtn) {
                            confirmBtn.disabled = true;
                            confirmBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Đang xóa...';
                        }
                    });
                }
            }
        })();
    </script>
}
