@using TCTEnglish.Services.Admin
@model RowView<TranscriptRowPost>
@{
    var i = Model.Index;
    var row = Model.Row;
    var text = Model.Error("Text");
    var speaker = Model.Error("Speaker");
    var meaning = Model.Error("VietnameseMeaning");
    var start = Model.Error("StartTime");
    var end = Model.Error("EndTime");
    var messages = new[] { text, speaker, meaning, start, end }.Where(m => m != null).ToList();
    var describedBy = messages.Count > 0 ? $"line-{i}-errors" : null;
}
<div class="ac-row ac-row--line @(Model.HasError ? "ac-row--invalid" : "")" data-ac-row>
    <div class="ac-row-head">
        <span class="ac-tag ac-tag--primary" data-ac-row-number data-ac-number-format="Dòng {n}">Dòng @Model.Number</span>
        <div class="ac-row-tools">
            <button type="button" class="btn ac-icon-btn" data-ac-move-up data-ac-aria-template="Chuyển dòng {n} lên" aria-label="Chuyển dòng @Model.Number lên" title="Lên"><i class="fa-solid fa-arrow-up" aria-hidden="true"></i></button>
            <button type="button" class="btn ac-icon-btn" data-ac-move-down data-ac-aria-template="Chuyển dòng {n} xuống" aria-label="Chuyển dòng @Model.Number xuống" title="Xuống"><i class="fa-solid fa-arrow-down" aria-hidden="true"></i></button>
            <button type="button" class="btn ac-icon-btn ac-icon-btn--danger" data-ac-remove-row data-ac-aria-template="Xóa dòng {n}" aria-label="Xóa dòng @Model.Number" title="Xóa dòng"><i class="fa-solid fa-trash-can" aria-hidden="true"></i></button>
        </div>
    </div>
    <div class="ac-row-fields ac-row-fields--line">
        <div class="ac-field">
            <label class="ac-label" for="line-@i-speaker">Người nói</label>
            <input id="line-@i-speaker" name="lines[@i].Speaker" value="@row.Speaker" class="form-control ac-control @(speaker != null ? "is-invalid" : "")" maxlength="@AdminListeningService.MaxLineSpeakerLength"
                   placeholder="Speaker 1" aria-invalid="@(speaker != null ? "true" : null)" aria-describedby="@describedBy" autocomplete="off" />
        </div>
        <div class="ac-field ac-field--text">
            <label class="ac-label" for="line-@i-text">Lời thoại</label>
            <textarea id="line-@i-text" name="lines[@i].Text" rows="2" class="form-control ac-control @(text != null ? "is-invalid" : "")" maxlength="@AdminListeningService.MaxLineTextLength"
                      aria-invalid="@(text != null ? "true" : null)" aria-describedby="@describedBy">@row.Text</textarea>
        </div>
        <div class="ac-field ac-field--text">
            <label class="ac-label" for="line-@i-meaning">Nghĩa tiếng Việt</label>
            <textarea id="line-@i-meaning" name="lines[@i].VietnameseMeaning" rows="2" class="form-control ac-control @(meaning != null ? "is-invalid" : "")" maxlength="@AdminListeningService.MaxMeaningLength"
                      aria-invalid="@(meaning != null ? "true" : null)" aria-describedby="@describedBy">@row.VietnameseMeaning</textarea>
        </div>
        <div class="ac-field ac-field--time">
            <label class="ac-label" for="line-@i-start">Bắt đầu</label>
            <input id="line-@i-start" name="lines[@i].Start" value="@row.Start" class="form-control ac-control @(start != null ? "is-invalid" : "")" inputmode="decimal" placeholder="0:00.0"
                   aria-invalid="@(start != null ? "true" : null)" aria-describedby="@describedBy" autocomplete="off" />
        </div>
        <div class="ac-field ac-field--time">
            <label class="ac-label" for="line-@i-end">Kết thúc</label>
            <input id="line-@i-end" name="lines[@i].End" value="@row.End" class="form-control ac-control @(end != null ? "is-invalid" : "")" inputmode="decimal" placeholder="0:03.5"
                   aria-invalid="@(end != null ? "true" : null)" aria-describedby="@describedBy" autocomplete="off" />
        </div>
    </div>
    @if (messages.Count > 0)
    {
        <ul class="ac-row-errors" id="line-@i-errors" role="alert">
            @foreach (var message in messages)
            {
                <li class="ac-error"><i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i> @message</li>
            }
        </ul>
    }
</div>
