@using TCTEnglish.Services.Admin
@using TCTEnglish.Services.Billing
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@model ListeningIndexViewModel
@{
    ViewData["Title"] = "Quản lý bài nghe";
    var list = Model.List;
    var figures = Model.Figures;
    // A local picture that is not in wwwroot would only produce a 404.
    bool ImageUsable(string? url) => !string.IsNullOrWhiteSpace(url)
        && (!url.StartsWith('/') || Env.WebRootFileProvider.GetFileInfo(url).Exists);
    var header = new AcPageHeaderModel
    {
        Icon = "fa-solid fa-headphones",
        Title = "Quản lý bài nghe",
        Subtitle = "Bài nghe hệ thống theo trình độ A1–C2 và bài riêng do học viên Premium thêm.",
        Actions = new[] { new AcAction("Thêm bài nghe", Url.Action("Create", "ListeningManagement", new { area = "Admin" })!, "fa-solid fa-plus", "primary") },
    };
    var cards = new List<AcFigure>
    {
        new("Bài hệ thống", figures.SystemLessons.ToString("N0"), "fa-solid fa-headphones", AcTone.Primary),
        new("Đã xuất bản", figures.Published.ToString("N0"), "fa-solid fa-circle-check", AcTone.Success),
        new("Bản nháp / thiếu nội dung", figures.DraftOrIncomplete.ToString("N0"), "fa-solid fa-file-pen", AcTone.Warning, "Chỉ tính bài hệ thống"),
        new("Bài riêng của học viên", figures.LearnerLessons.ToString("N0"), "fa-solid fa-user-lock", AcTone.Info),
    };
    var levelOptions = new List<AcOption> { new("", "Tất cả") };
    levelOptions.AddRange(AdminInputRules.CefrLevels.Select(l => new AcOption(l, l)));
    var filter = new AcFilterBarModel
    {
        Controller = "ListeningManagement",
        FormId = "lessonFilterForm",
        Fields = new AcFilterField[]
        {
            new() { Name = "q", Label = "Tìm kiếm", Kind = "search", Value = Model.Q, Placeholder = "Tiêu đề, chủ đề, mã YouTube..." },
            new() { Name = "level", Label = "Trình độ", Value = Model.Level, Options = levelOptions },
            new() { Name = "source", Label = "Nguồn", Value = Model.Source, Options = new[] { new AcOption("system", "Hệ thống"), new AcOption("learner", "Bài riêng của học viên"), new AcOption("all", "Tất cả") } },
            new() { Name = "status", Label = "Trạng thái", Value = Model.Status, Options = new[] { new AcOption("", "Tất cả"), new AcOption("published", "Đã xuất bản"), new AcOption("draft", "Bản nháp"), new AcOption("incomplete", "Thiếu nội dung") } },
        },
    };
    var tableHeader = new AcTableHeaderModel { Title = "Danh sách bài nghe", Icon = "fa-solid fa-list", Count = list.TotalItems };
    var pager = new AcPagerModel
    {
        Page = list.Page, PageSize = list.PageSize, TotalItems = list.TotalItems,
        Route = new Dictionary<string, string?> { ["q"] = Model.Q, ["level"] = Model.Level, ["source"] = Model.Source == "system" ? null : Model.Source, ["status"] = Model.Status },
    };
    var tagPublished = new AcTag("Đã xuất bản", AcTone.Success);
    var tagDraft = new AcTag("Bản nháp", AcTone.Warning);
    var tagPrivate = new AcTag("Riêng tư", AcTone.Info);
    var tagIncomplete = new AcTag("Thiếu nội dung", AcTone.Danger);
    var tagSystem = new AcTag("Hệ thống", AcTone.Primary);
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-content.css" asp-append-version="true" />
}

<div class="ac-page ac-lessons">
    <partial name="_AcPageHeader" model="header" />
    <partial name="_AcAlerts" />
    <partial name="_AcFigures" model="@((IReadOnlyList<AcFigure>)cards)" />
    <partial name="_AcFilterBar" model="filter" />

    <div class="ac-card">
        <partial name="_AcTableHeader" model="tableHeader" />
        <div class="ac-table-wrap">
            <table class="ac-table">
                <thead>
                    <tr>
                        <th scope="col">Bài nghe</th>
                        <th scope="col">Trình độ</th>
                        <th scope="col">Nguồn</th>
                        <th scope="col">Trạng thái</th>
                        <th scope="col">Lời thoại</th>
                        <th scope="col" class="ac-num">Quiz</th>
                        <th scope="col" class="ac-num">Từ vựng</th>
                        <th scope="col" class="ac-actions">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (list.Rows.Count == 0)
                    {
                        <tr>
                            <td colspan="8">
                                <div class="ac-empty">
                                    <i class="fa-regular fa-folder-open" aria-hidden="true"></i>
                                    <p class="mb-0">Không có bài nghe nào khớp với bộ lọc hiện tại.</p>
                                </div>
                            </td>
                        </tr>
                    }
                    @foreach (var row in list.Rows)
                    {
                        var initial = string.IsNullOrWhiteSpace(row.Title) ? "?" : row.Title.Trim().Substring(0, 1).ToUpperInvariant();
                        var deleteModel = new AcConfirmDeleteModel
                        {
                            Controller = "ListeningManagement",
                            Route = new Dictionary<string, string> { ["id"] = row.Id.ToString() },
                            ConfirmName = row.Title,
                            Title = "Xóa bài nghe?",
                            Impact = "Lời thoại, quiz, từ vựng và tiến độ học của mọi học viên với bài này sẽ bị xóa.",
                            AriaLabel = $"Xóa bài nghe {row.Title}",
                        };
                        <tr>
                            <td>
                                <div class="ac-word">
                                    <span class="ac-thumb" aria-hidden="true">
                                        @if (ImageUsable(row.ThumbnailUrl))
                                        {
                                            <img src="@row.ThumbnailUrl" alt="" loading="lazy" referrerpolicy="no-referrer" data-ac-fallback data-ac-initial="@initial" />
                                        }
                                        else
                                        {
                                            <span class="ac-word-initial">@initial</span>
                                        }
                                    </span>
                                    <div>
                                        <div class="ac-cell-main">@row.Title</div>
                                        <div class="ac-cell-sub">@row.Topic · @(string.IsNullOrWhiteSpace(row.Duration) ? "—" : row.Duration)</div>
                                    </div>
                                </div>
                            </td>
                            <td><span class="ac-tag ac-tag--primary">@row.Level</span></td>
                            <td>
                                @if (row.IsLearnerOwned)
                                {
                                    <div class="ac-cell-main">@row.OwnerName</div>
                                    <div class="ac-cell-sub">Bài riêng của người dùng</div>
                                }
                                else
                                {
                                    <partial name="_AcStatusTag" model="tagSystem" />
                                }
                            </td>
                            <td>
                                <div class="ac-tag-stack">
                                    @if (row.IsLearnerOwned)
                                    {
                                        <partial name="_AcStatusTag" model="tagPrivate" />
                                    }
                                    else
                                    {
                                        <partial name="_AcStatusTag" model="@(row.IsPublished ? tagPublished : tagDraft)" />
                                        if (row.IsIncomplete)
                                        {
                                            <partial name="_AcStatusTag" model="tagIncomplete" />
                                        }
                                    }
                                </div>
                            </td>
                            <td>
                                <div class="ac-cell-main">@row.TranscriptCount dòng</div>
                                <div class="ac-cell-sub">@(row.TranscriptCount == 0 ? "Chưa có" : (row.TimedLineCount > 0 ? "Có mốc thời gian" : "Chưa có mốc thời gian"))</div>
                            </td>
                            <td class="ac-num">
                                @row.QuizCount câu
                                @if (row.HasInvalidQuiz)
                                {
                                    <div class="ac-cell-sub ac-cell-sub--warn">Có câu chưa hợp lệ</div>
                                }
                            </td>
                            <td class="ac-num">@row.VocabCount từ</td>
                            <td class="ac-actions">
                                <div class="ac-actions-row">
                                    <a asp-action="Editor" asp-route-id="@row.Id" class="ac-icon-btn" title="@(row.IsLearnerOwned ? "Xem bài nghe" : "Sửa bài nghe")" aria-label="@(row.IsLearnerOwned ? "Xem" : "Sửa") bài nghe @row.Title">
                                        <i class="@(row.IsLearnerOwned ? "fa-solid fa-eye" : "fa-solid fa-pen")" aria-hidden="true"></i>
                                    </a>
                                    @if (!row.IsLearnerOwned && row.IsPublished)
                                    {
                                        <a href="/Home/Listening/Practice/@row.Id" class="ac-icon-btn" title="Xem như học viên" aria-label="Xem như học viên: @row.Title">
                                            <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
                                        </a>
                                    }
                                    <partial name="_AcConfirmDelete" model="deleteModel" />
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_AcPager" model="pager" />
    </div>
</div>

@section Scripts {
    <script src="~/js/admin-content.js" asp-append-version="true"></script>
}
