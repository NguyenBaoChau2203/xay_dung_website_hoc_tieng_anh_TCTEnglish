@model TCTVocabulary.Areas.Admin.ViewModels.Billing.AdminPremiumUserDetailsViewModel
@{
    ViewData["Title"] = "Chi tiết người dùng Premium";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-content.css" asp-append-version="true" />
}

<div class="ac-page ac-billing">
<header class="ac-header">
    <div class="ac-header-row">
        <div class="ac-header-main">
            <span class="ac-header-icon" aria-hidden="true"><i class="fa-solid fa-id-badge"></i></span>
            <div class="ac-header-text">
                <h1 class="ac-title"><span>Chi tiết người dùng Premium</span></h1>
                <p class="ac-subtitle">Thông tin người dùng, gói đăng ký hiện tại và lịch sử thanh toán.</p>
            </div>
        </div>
        <div class="ac-header-actions">
            <a asp-area="Admin" asp-controller="BillingManagement" asp-action="PremiumUsers" class="btn ac-btn ac-btn--outline">
                <i class="fa-solid fa-arrow-left" aria-hidden="true"></i><span>Quay lại</span>
            </a>
        </div>
    </div>
</header>
<partial name="_AcAlerts" />

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-3">
        <div class="row g-2">
            <div class="col-md-3"><div class="small text-muted">UserId</div><div class="fw-semibold">#@Model.UserId</div></div>
            <div class="col-md-3"><div class="small text-muted">Email</div><div class="fw-semibold">@Model.Email</div></div>
            <div class="col-md-3"><div class="small text-muted">Họ tên</div><div class="fw-semibold">@Model.FullName</div></div>
            <div class="col-md-3"><div class="small text-muted">Loại tài khoản</div><div><span class="badge bg-light text-dark border">@Model.AccountType</span></div></div>
        </div>
        <div class="mt-2 d-flex flex-wrap gap-2">
            @if (Model.RolePremiumWithoutActiveSubscription)
            {
                <span class="badge bg-warning text-dark">Vai trò Premium nhưng không còn hoạt động</span>
            }
            @if (Model.ActiveSubscriptionButRoleNotPremium)
            {
                <span class="badge bg-danger">Gói đăng ký đang hoạt động nhưng vai trò chưa là Premium</span>
            }
            @if (Model.PaidOrderNotActivated)
            {
                <span class="badge bg-info text-dark">Đơn đã thanh toán nhưng chưa kích hoạt</span>
            }
            @if (!Model.RolePremiumWithoutActiveSubscription && !Model.ActiveSubscriptionButRoleNotPremium && !Model.PaidOrderNotActivated)
            {
                <span class="text-muted small">Không có cảnh báo dữ liệu.</span>
            }
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm mb-3">
    <div class="card-header bg-white py-2"><h2 class="h6 fw-semibold mb-0">Gói đăng ký hiện tại</h2></div>
    <div class="card-body py-3">
        @if (Model.CurrentSubscription == null)
        {
            <p class="text-muted mb-0">Chưa có dữ liệu gói đăng ký.</p>
        }
        else
        {
            <div class="row g-2">
                <div class="col-md-3"><div class="small text-muted">Gói</div><div class="fw-semibold">@Model.CurrentSubscription.PlanName</div></div>
                <div class="col-md-3"><div class="small text-muted">Trạng thái</div><div><span class="@Model.CurrentSubscription.SubscriptionBadgeClass">@TCTEnglish.Services.Admin.AdminBillingLabels.SubscriptionStatus(Model.CurrentSubscription.SubscriptionStatus)</span></div></div>
                <div class="col-md-3"><div class="small text-muted">Bắt đầu</div><div class="fw-semibold">@TCTEnglish.Services.Billing.BillingTime.ToDisplay(Model.CurrentSubscription.StartsAtUtc)</div></div>
                <div class="col-md-3"><div class="small text-muted">Kết thúc</div><div class="fw-semibold">@TCTEnglish.Services.Billing.BillingTime.ToDisplay(Model.CurrentSubscription.EndsAtUtc)</div></div>
                <div class="col-md-3"><div class="small text-muted">Còn lại</div><div class="fw-semibold">@(Model.CurrentSubscription.DaysRemaining?.ToString() ?? "-") ngày</div></div>
                <div class="col-md-3"><div class="small text-muted">Mã đơn kích hoạt</div><div class="fw-semibold">@(Model.CurrentSubscription.ActivatedByOrderCode ?? "-")</div></div>
                <div class="col-md-3"><div class="small text-muted">Cổng thanh toán</div><div class="fw-semibold">@(Model.CurrentSubscription.Provider ?? "-")</div></div>
                <div class="col-md-3"><div class="small text-muted">Nguồn</div><div class="fw-semibold">@(Model.CurrentSubscription.IsManualSubscription ? "Thủ công" : "Thanh toán")</div></div>
            </div>
        }
    </div>
</div>

<div class="card border-0 shadow-sm mb-3">
    <div class="card-header bg-white py-2"><h2 class="h6 fw-semibold mb-0">Lịch sử gói đăng ký</h2></div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">ID</th>
                        <th>Gói</th>
                        <th>Trạng thái</th>
                        <th>Thời hạn</th>
                        <th>Mã đơn</th>
                        <th>Cổng</th>
                        <th>Lý do hủy</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.SubscriptionHistory.Any())
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">Không có lịch sử gói đăng ký.</td></tr>
                    }
                    @foreach (var item in Model.SubscriptionHistory)
                    {
                        <tr>
                            <td class="ps-3">#@item.Id</td>
                            <td>@item.PlanName</td>
                            <td><span class="badge bg-light text-dark border">@TCTEnglish.Services.Admin.AdminBillingLabels.SubscriptionStatus(item.Status)</span></td>
                            <td>
                                <div class="small">@TCTEnglish.Services.Billing.BillingTime.ToDisplay(item.StartsAtUtc)</div>
                                <div class="small text-muted">đến @TCTEnglish.Services.Billing.BillingTime.ToDisplay(item.EndsAtUtc)</div>
                            </td>
                            <td>@(item.ActivatedByOrderCode ?? "-")</td>
                            <td>@(item.Provider ?? (item.IsManual ? "manual" : "-"))</td>
                            <td>@(item.CancelReason ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-2"><h2 class="h6 fw-semibold mb-0">Lịch sử đơn thanh toán</h2></div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Mã đơn</th>
                        <th>Cổng</th>
                        <th class="text-end">Số tiền</th>
                        <th>Trạng thái</th>
                        <th>Tạo lúc</th>
                        <th>Thanh toán lúc</th>
                        <th>Cảnh báo</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.PaymentOrders.Any())
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">Không có đơn thanh toán.</td></tr>
                    }
                    @foreach (var item in Model.PaymentOrders)
                    {
                        <tr>
                            <td class="ps-3">@item.OrderCode</td>
                            <td>@item.Provider</td>
                            <td class="text-end">@TCTEnglish.Services.Billing.BillingTime.FormatMoney(item.AmountVnd)</td>
                            <td><span class="badge bg-light text-dark border">@TCTEnglish.Services.Billing.PaymentOrderLabels.StatusLabel(item.Status)</span></td>
                            <td>@TCTEnglish.Services.Billing.BillingTime.ToDisplay(item.CreatedAtUtc)</td>
                            <td>@TCTEnglish.Services.Billing.BillingTime.ToDisplay(item.PaidAtUtc)</td>
                            <td>
                                @if (item.IsPaidButNotActivated)
                                {
                                    <span class="badge bg-info text-dark">Paid nhưng chưa activate</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
</div>
