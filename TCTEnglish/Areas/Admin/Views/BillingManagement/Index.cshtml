@using TCTEnglish.Services.Billing
@model TCTVocabulary.Areas.Admin.ViewModels.Billing.AdminBillingIndexViewModel
@{
    ViewData["Title"] = "Quản lý thanh toán";
    var figures = Model.Figures;
    var header = new AcPageHeaderModel
    {
        Icon = "fa-solid fa-credit-card",
        Title = "Quản lý thanh toán",
        Subtitle = "Đơn Premium, trạng thái cổng thanh toán và lịch sử xác nhận.",
        Actions = new[]
        {
            new AcAction("Gói đăng ký", Url.Action("Subscriptions", "BillingManagement", new { area = "Admin" })!, "fa-solid fa-gem"),
            new AcAction("Người dùng Premium", Url.Action("PremiumUsers", "BillingManagement", new { area = "Admin" })!, "fa-solid fa-users"),
            new AcAction("Tình trạng cổng", Url.Action("Health", "BillingManagement", new { area = "Admin" })!, "fa-solid fa-heart-pulse"),
            new AcAction("Đóng đơn chờ quá hạn", Url.Action("CleanupExpiredPending", "BillingManagement", new { area = "Admin" })!, "fa-solid fa-broom", "outline",
                "Chuyển các đơn đang chờ đã quá hạn sang hết hạn", IsPost: true,
                ConfirmMessage: "Đóng tất cả đơn đang chờ đã quá hạn và chuyển sang hết hạn?"),
        },
    };
    var cards = new List<AcFigure>
    {
        new("Doanh thu 30 ngày", BillingTime.FormatMoney(figures.RevenueLast30DaysVnd), "fa-solid fa-sack-dollar", AcTone.Success, "Đơn đã thanh toán"),
        new("Premium đang hoạt động", figures.ActivePremiumUsers.ToString("N0"), "fa-solid fa-gem", AcTone.Primary),
        new("Đơn đang chờ", figures.PendingOrders.ToString("N0"), "fa-solid fa-clock", AcTone.Warning,
            figures.OverduePendingOrders > 0 ? $"{figures.OverduePendingOrders} đơn đã quá hạn" : null),
        new("Đơn cần kiểm tra", figures.ManualReviewOrders.ToString("N0"), "fa-solid fa-triangle-exclamation", figures.ManualReviewOrders > 0 ? AcTone.Danger : AcTone.Muted),
    };
    var providerOptions = new List<AcOption> { new("", "Tất cả") };
    providerOptions.AddRange(Model.Providers.Select(p => new AcOption(p, PaymentOrderLabels.ProviderName(p))));
    var statusOptions = new List<AcOption> { new("", "Tất cả") };
    statusOptions.AddRange(Model.Statuses.Select(s => new AcOption(s, PaymentOrderLabels.StatusLabel(s))));
    var filter = new AcFilterBarModel
    {
        Controller = "BillingManagement",
        FormId = "orderFilterForm",
        Fields = new AcFilterField[]
        {
            new() { Name = "q", Label = "Tìm kiếm", Kind = "search", Value = Model.SearchQuery, Placeholder = "Mã đơn, email, mã giao dịch..." },
            new() { Name = "provider", Label = "Cổng", Value = Model.ProviderFilter, Options = providerOptions },
            new() { Name = "status", Label = "Trạng thái", Value = Model.StatusFilter, Options = statusOptions },
            new() { Name = "range", Label = "Thời gian", Value = Model.RangeFilter, Options = new[] { new AcOption("", "Tất cả"), new AcOption("7", "7 ngày qua"), new AcOption("30", "30 ngày qua"), new AcOption("90", "90 ngày qua") } },
        },
    };
    var tableHeader = new AcTableHeaderModel { Title = "Danh sách đơn thanh toán", Icon = "fa-solid fa-list", Count = Model.TotalFilteredCount };
    var pager = new AcPagerModel
    {
        Page = Model.CurrentPage, PageSize = Model.PageSize, TotalItems = Model.TotalFilteredCount,
        Route = new Dictionary<string, string?> { ["q"] = Model.SearchQuery, ["provider"] = Model.ProviderFilter, ["status"] = Model.StatusFilter, ["range"] = Model.RangeFilter },
    };
    string Tone(string status) => (status ?? "").ToLowerInvariant() switch
    {
        PaymentOrderStatuses.Paid => AcTone.Success,
        PaymentOrderStatuses.Pending => AcTone.Warning,
        PaymentOrderStatuses.Failed => AcTone.Danger,
        PaymentOrderStatuses.ManualReview => AcTone.Danger,
        PaymentOrderStatuses.Refunded or PaymentOrderStatuses.PartiallyRefunded => AcTone.Info,
        _ => AcTone.Muted,
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-content.css" asp-append-version="true" />
}

<div class="ac-page ac-billing">
    <partial name="_AcPageHeader" model="header" />
    <partial name="_AcAlerts" />

    @if (figures.ManualReviewOrders > 0)
    {
        <div class="alert ac-alert ac-alert--warning" role="status">
            <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
            <span class="ac-alert-text">Có <strong>@figures.ManualReviewOrders</strong> đơn cần kiểm tra thủ công trước khi kích hoạt Premium.</span>
            <a asp-action="Index" asp-route-status="@PaymentOrderStatuses.ManualReview" class="btn ac-btn ac-btn--outline">Xem các đơn này</a>
        </div>
    }

    <partial name="_AcFigures" model="@((IReadOnlyList<AcFigure>)cards)" />
    <partial name="_AcFilterBar" model="filter" />

    <div class="ac-card">
        <partial name="_AcTableHeader" model="tableHeader" />
        <div class="ac-table-wrap">
            <table class="ac-table">
                <thead>
                    <tr>
                        <th scope="col">Mã đơn</th>
                        <th scope="col">Người dùng</th>
                        <th scope="col">Gói</th>
                        <th scope="col">Cổng</th>
                        <th scope="col" class="ac-num">Số tiền</th>
                        <th scope="col">Trạng thái</th>
                        <th scope="col">Ngày tạo</th>
                        <th scope="col" class="ac-actions">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Orders.Any())
                    {
                        <tr>
                            <td colspan="8">
                                <div class="ac-empty">
                                    <i class="fa-regular fa-folder-open" aria-hidden="true"></i>
                                    <p class="mb-0">Không tìm thấy đơn thanh toán nào.</p>
                                </div>
                            </td>
                        </tr>
                    }
                    @foreach (var order in Model.Orders)
                    {
                        var statusTag = new AcTag(PaymentOrderLabels.StatusLabel(order.Status), Tone(order.Status));
                        <tr>
                            <td>
                                <div class="ac-cell-main">@order.OrderCode</div>
                                @if (!string.IsNullOrEmpty(order.ProviderTransactionId))
                                {
                                    <div class="ac-cell-sub">@order.ProviderTransactionId</div>
                                }
                            </td>
                            <td>
                                <div class="ac-cell-main">@order.UserDisplayName</div>
                                <div class="ac-cell-sub">#@order.UserId · @order.UserEmail</div>
                            </td>
                            <td>@order.PlanName</td>
                            <td><span class="ac-tag">@PaymentOrderLabels.ProviderName(order.Provider)</span></td>
                            <td class="ac-num">@BillingTime.FormatMoney(order.AmountVnd)</td>
                            <td><partial name="_AcStatusTag" model="statusTag" /></td>
                            <td class="ac-num">@BillingTime.ToDisplay(order.CreatedAtUtc)</td>
                            <td class="ac-actions">
                                <div class="ac-actions-row">
                                    <a asp-area="Admin" asp-controller="BillingManagement" asp-action="Details" asp-route-id="@order.Id"
                                       class="ac-icon-btn" title="Xem chi tiết đơn" aria-label="Xem chi tiết đơn @order.OrderCode">
                                        <i class="fa-solid fa-eye" aria-hidden="true"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_AcPager" model="pager" />
    </div>
</div>

@section Scripts {
    <script src="~/js/admin-content.js" asp-append-version="true"></script>
}
