@model TCTVocabulary.Areas.Admin.ViewModels.CreateAnnouncementViewModel
@{
    ViewData["Title"] = "Gửi thông báo hệ thống";
    Layout = "_AdminLayout";
    var header = new AcPageHeaderModel
    {
        Icon = "fa-solid fa-bullhorn",
        Title = "Gửi thông báo hệ thống",
        Subtitle = "Thông báo sẽ được gửi tới tất cả người dùng đang hoạt động (trừ tài khoản bị khóa hoặc đã xóa).",
        Actions = new[] { new AcAction("Lịch sử", Url.Action("History", "NotificationManagement", new { area = "Admin" })!, "fa-solid fa-clock-rotate-left") },
    };
    var count = Model.RecipientCount;
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-content.css" asp-append-version="true" />
}

<div class="ac-page ac-announce">
    <partial name="_AcPageHeader" model="header" />
    <partial name="_AcAlerts" />

    <div class="ac-split">
        <div class="ac-card ac-card-pad">
            <h2 class="ac-card-title ac-preview-title"><i class="fa-solid fa-pen-to-square" aria-hidden="true"></i><span>Soạn thông báo</span></h2>
            <form id="announcementForm" method="post" asp-action="Create" novalidate data-ac-pending>
                @Html.AntiForgeryToken()
                <input asp-for="BatchId" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="ac-error ac-error-summary"></div>

                <div class="ac-field">
                    <label asp-for="Title" for="titleInput" class="ac-label">Tiêu đề <span class="ac-required" aria-hidden="true">*</span></label>
                    <input asp-for="Title" id="titleInput" class="form-control ac-control" placeholder="VD: Cập nhật tính năng mới"
                           maxlength="200" data-ac-max="200" autocomplete="off" />
                    <div class="ac-field-foot">
                        <span asp-validation-for="Title" class="ac-error"></span>
                        <span class="ac-counter" data-ac-counter-for="titleInput" aria-hidden="true"></span>
                    </div>
                </div>

                <div class="ac-field">
                    <label asp-for="Message" for="messageInput" class="ac-label">Nội dung <span class="ac-required" aria-hidden="true">*</span></label>
                    <textarea asp-for="Message" id="messageInput" class="form-control ac-control" rows="5" placeholder="Nhập nội dung thông báo..."
                              maxlength="1000" data-ac-max="1000"></textarea>
                    <div class="ac-field-foot">
                        <span asp-validation-for="Message" class="ac-error"></span>
                        <span class="ac-counter" data-ac-counter-for="messageInput" aria-hidden="true"></span>
                    </div>
                </div>

                <div class="ac-field">
                    <label asp-for="Url" for="urlInput" class="ac-label">Liên kết <span class="ac-hint-inline">(không bắt buộc)</span></label>
                    <input asp-for="Url" id="urlInput" class="form-control ac-control" placeholder="/Premium" maxlength="500"
                           autocomplete="off" aria-describedby="urlHint" />
                    <div id="urlHint" class="ac-hint">Đường dẫn trong TCT English, ví dụ /Premium hoặc /Vocabulary</div>
                    <span asp-validation-for="Url" class="ac-error"></span>
                </div>

                <div class="ac-sticky-bar">
                    <p class="ac-sticky-text" role="status">
                        <i class="fa-solid fa-users" aria-hidden="true"></i>
                        Sẽ gửi tới <strong>@count.ToString("N0")</strong> tài khoản đang hoạt động
                    </p>
                    <button type="button" class="btn ac-btn ac-btn--primary" id="openConfirmBtn" data-bs-toggle="modal" data-bs-target="#confirmModal">
                        <i class="fa-solid fa-paper-plane" aria-hidden="true"></i><span>Gửi thông báo</span>
                    </button>
                </div>
            </form>
        </div>

        <aside class="ac-preview" aria-label="Xem trước thông báo" data-ac-preview data-ac-preview-form="announcementForm">
            <h2 class="ac-card-title ac-preview-title"><i class="fa-regular fa-eye" aria-hidden="true"></i><span>Xem trước</span></h2>
            <p class="ac-hint">Thông báo sẽ hiện như thế này trong chuông thông báo của người dùng:</p>
            <div class="ac-bell-item">
                <span class="ac-bell-icon" aria-hidden="true"><i class="fa-solid fa-bullhorn"></i></span>
                <div class="ac-bell-body">
                    <div class="ac-bell-title" data-ac-bind="Title" data-ac-empty="Tiêu đề thông báo"></div>
                    <div class="ac-bell-message" data-ac-bind="Message" data-ac-empty="Nội dung thông báo…"></div>
                    <div class="ac-bell-meta">Vừa xong<span data-ac-show-if="Url"> · <i class="fa-solid fa-link" aria-hidden="true"></i> Có liên kết</span></div>
                </div>
                <span class="ac-bell-dot" aria-hidden="true"></span>
            </div>
            <p class="ac-hint">
                <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
                Thông báo sẽ gửi đến <i>tất cả người dùng</i> không bị khóa hoặc đã xóa. Không thể thu hồi sau khi gửi.
            </p>
        </aside>
    </div>
</div>

@* Confirmation: names the number of accounts and mirrors what will be sent. *@
<div class="modal fade" id="confirmModal" tabindex="-1" aria-labelledby="confirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content ac-modal" data-ac-preview data-ac-preview-form="announcementForm">
            <div class="modal-header">
                <h2 class="modal-title ac-modal-title" id="confirmModalLabel">
                    <i class="fa-solid fa-paper-plane" aria-hidden="true"></i> Gửi thông báo tới @count.ToString("N0") tài khoản?
                </h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <div class="alert ac-alert ac-alert--warning">
                    <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
                    <div>Thông báo này sẽ được gửi tới <strong>tất cả người dùng</strong> đang hoạt động. Không thể thu hồi sau khi gửi.</div>
                </div>
                <div class="ac-modal-preview">
                    <div class="ac-modal-preview-title" id="modalPreviewTitle" data-ac-bind="Title" data-ac-empty=""></div>
                    <div class="ac-modal-preview-message" id="modalPreviewMessage" data-ac-bind="Message" data-ac-empty=""></div>
                    <div class="ac-hint" id="modalPreviewUrlRow" data-ac-show-if="Url">Liên kết: <code id="modalPreviewUrl" data-ac-bind="Url" data-ac-empty=""></code></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn ac-btn ac-btn--outline" data-bs-dismiss="modal">
                    <i class="fa-solid fa-xmark" aria-hidden="true"></i><span>Hủy</span>
                </button>
                <button type="button" class="btn ac-btn ac-btn--primary" id="confirmSendBtn" data-ac-submit-form="announcementForm" data-ac-dismiss-modal="confirmModal">
                    <i class="fa-solid fa-paper-plane" aria-hidden="true"></i><span>Xác nhận gửi</span>
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin-content.js" asp-append-version="true"></script>
}
