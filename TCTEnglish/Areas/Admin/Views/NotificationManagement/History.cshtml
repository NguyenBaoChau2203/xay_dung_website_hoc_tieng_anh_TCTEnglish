@model TCTVocabulary.Areas.Admin.ViewModels.AnnouncementHistoryViewModel
@{
    ViewData["Title"] = "Lịch sử thông báo";
    Layout = "_AdminLayout";
    var header = new AcPageHeaderModel
    {
        Icon = "fa-solid fa-clock-rotate-left",
        Title = "Lịch sử thông báo",
        Subtitle = "Các thông báo chung đã gửi tới người dùng, mới nhất ở trên. Giờ theo múi giờ Việt Nam.",
        Actions = new[] { new AcAction("Gửi thông báo mới", Url.Action("Create", "NotificationManagement", new { area = "Admin" })!, "fa-solid fa-paper-plane", "primary") },
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-content.css" asp-append-version="true" />
}

<div class="ac-page ac-announce">
    <partial name="_AcPageHeader" model="header" />
    <partial name="_AcAlerts" />

    <div class="ac-card">
        @if (!Model.Items.Any())
        {
            <div class="ac-empty">
                <i class="fa-solid fa-bullhorn" aria-hidden="true"></i>
                <h2 class="ac-card-title justify-content-center">Chưa có thông báo nào</h2>
                <p class="mb-3">Gửi thông báo đầu tiên để bắt đầu.</p>
                <a asp-action="Create" class="btn ac-btn ac-btn--primary">
                    <i class="fa-solid fa-paper-plane" aria-hidden="true"></i><span>Gửi thông báo mới</span>
                </a>
            </div>
        }
        else
        {
            <div class="ac-table-wrap">
                <table class="ac-table">
                    <caption class="visually-hidden">Các thông báo chung đã gửi, mới nhất ở trên</caption>
                    <thead>
                        <tr>
                            <th scope="col">Tiêu đề</th>
                            <th scope="col">Nội dung</th>
                            <th scope="col">Thời gian</th>
                            <th scope="col">Người gửi</th>
                            <th scope="col" class="ac-num">Đã đọc</th>
                            <th scope="col" class="ac-num">Số người nhận</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    <div class="ac-cell-main">@item.Title</div>
                                    @if (item.IsLegacy)
                                    {
                                        <div class="ac-cell-sub">(dữ liệu cũ)</div>
                                    }
                                </td>
                                <td class="ac-cell-wrap">
                                    <div class="ac-cell-sub ac-cell-sub--body">@item.Message</div>
                                    @if (!string.IsNullOrEmpty(item.Url))
                                    {
                                        <div class="ac-cell-sub">
                                            <i class="fa-solid fa-link" aria-hidden="true"></i>
                                            <span class="visually-hidden">Liên kết:</span> <code>@item.Url</code>
                                        </div>
                                    }
                                </td>
                                <td class="ac-num">@item.CreatedAtText</td>
                                <td>
                                    <span class="ac-tag ac-tag--primary"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i>@item.CreatedByName</span>
                                </td>
                                <td class="ac-num">@item.ReadCount/@item.RecipientCount</td>
                                <td class="ac-num">
                                    <span class="ac-count">@item.RecipientCount</span>
                                    @if (item.CopiesMayBeCleaned)
                                    {
                                        <div class="ac-cell-sub">còn @item.RecipientCount bản lưu</div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.TotalPages > 1)
            {
                <div class="ac-pager">
                    <p class="ac-pager-text" role="status">Trang @Model.CurrentPage / @Model.TotalPages</p>
                    <nav aria-label="Phân trang lịch sử thông báo">
                        <ul class="pagination ac-pagination mb-0">
                            <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                                <a class="page-link" aria-label="Trang trước" asp-action="History" asp-route-page="@(Model.CurrentPage - 1)">
                                    <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
                                </a>
                            </li>
                            @for (int p = 1; p <= Model.TotalPages; p++)
                            {
                                <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link" aria-label="Trang @p" aria-current="@(p == Model.CurrentPage ? "page" : null)" asp-action="History" asp-route-page="@p">@p</a>
                                </li>
                            }
                            <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" aria-label="Trang sau" asp-action="History" asp-route-page="@(Model.CurrentPage + 1)">
                                    <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/admin-content.js" asp-append-version="true"></script>
}
