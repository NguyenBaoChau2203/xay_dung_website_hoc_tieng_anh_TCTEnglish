@model TCTVocabulary.Areas.Admin.ViewModels.AnnouncementHistoryViewModel
@{
    ViewData["Title"] = "Lịch sử thông báo";
    Layout = "_AdminLayout";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-4">
    <div>
        <h1 class="h4 mb-0 fw-bold">
            <i class="bi bi-clock-history text-primary me-2" aria-hidden="true"></i>Lịch sử thông báo
        </h1>
        <p class="text-muted small mt-1 mb-0">
            Các thông báo chung đã gửi tới người dùng, mới nhất ở trên. Giờ theo múi giờ Việt Nam.
        </p>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-sm">
        <i class="fas fa-paper-plane me-1" aria-hidden="true"></i> Gửi thông báo mới
    </a>
</div>

@if (TempData["Success"] is string successMsg)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2" aria-hidden="true"></i>@successMsg
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
    </div>
}

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        @if (!Model.Items.Any())
        {
            @* ── Empty state ── *@
            <div class="text-center py-5 text-muted">
                <i class="bi bi-megaphone fs-1 d-block mb-3 opacity-25" aria-hidden="true"></i>
                <h2 class="h5 mb-1">Chưa có thông báo nào</h2>
                <p class="mb-3 small">Gửi thông báo đầu tiên để bắt đầu.</p>
                <a asp-action="Create" class="btn btn-primary btn-sm">
                    <i class="fas fa-paper-plane me-1" aria-hidden="true"></i> Gửi thông báo mới
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <caption class="visually-hidden">Các thông báo chung đã gửi, mới nhất ở trên</caption>
                    <thead class="table-dark">
                        <tr>
                            <th scope="col">Tiêu đề</th>
                            <th scope="col">Nội dung</th>
                            <th scope="col">Thời gian</th>
                            <th scope="col">Người gửi</th>
                            <th scope="col" class="text-center">Đã đọc</th>
                            <th scope="col" class="text-center">Số người nhận</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    <span class="fw-semibold">@item.Title</span>
                                    @if (item.IsLegacy)
                                    {
                                        <span class="d-block small text-muted">(dữ liệu cũ)</span>
                                    }
                                </td>
                                <td>
                                    <span class="d-block text-muted small">@item.Message</span>
                                    @if (!string.IsNullOrEmpty(item.Url))
                                    {
                                        <span class="d-block small mt-1">
                                            <i class="bi bi-link-45deg" aria-hidden="true"></i>
                                            <span class="visually-hidden">Liên kết:</span> <code>@item.Url</code>
                                        </span>
                                    }
                                </td>
                                <td class="text-nowrap">
                                    <span class="text-muted small">@item.CreatedAtText</span>
                                </td>
                                <td>
                                    <span class="badge bg-primary-subtle text-primary-emphasis">
                                        <i class="bi bi-shield-lock-fill me-1" aria-hidden="true"></i>@item.CreatedByName
                                    </span>
                                </td>
                                <td class="text-center text-nowrap">
                                    <span class="small">@item.ReadCount/@item.RecipientCount</span>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-secondary-subtle text-secondary-emphasis px-3">@item.RecipientCount</span>
                                    @if (item.CopiesMayBeCleaned)
                                    {
                                        <span class="d-block small text-muted mt-1">còn @item.RecipientCount bản lưu</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @* ── Pagination ── *@
            @if (Model.TotalPages > 1)
            {
                <div class="d-flex justify-content-center py-3">
                    <nav aria-label="Phân trang lịch sử thông báo">
                        <ul class="pagination pagination-sm mb-0">
                            @* Previous *@
                            <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                                <a class="page-link"
                                   aria-label="Trang trước"
                                   asp-action="History"
                                   asp-route-page="@(Model.CurrentPage - 1)">
                                    <i class="bi bi-chevron-left" aria-hidden="true"></i>
                                </a>
                            </li>

                            @for (int p = 1; p <= Model.TotalPages; p++)
                            {
                                <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link"
                                       aria-label="Trang @p"
                                       aria-current="@(p == Model.CurrentPage ? "page" : null)"
                                       asp-action="History"
                                       asp-route-page="@p">@p</a>
                                </li>
                            }

                            @* Next *@
                            <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                                <a class="page-link"
                                   aria-label="Trang sau"
                                   asp-action="History"
                                   asp-route-page="@(Model.CurrentPage + 1)">
                                    <i class="bi bi-chevron-right" aria-hidden="true"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        }
    </div>
</div>
