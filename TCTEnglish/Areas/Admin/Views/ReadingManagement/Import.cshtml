@{
    ViewData["Title"] = "Import bài đọc Excel";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-reading.css" asp-append-version="true" />
}

<div class="container-fluid py-4 tct-theme admin-reading-page">
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-end gap-3 mb-4">
        <div>
            <div class="admin-reading-eyebrow mb-2">Import Reading</div>
            <h1 class="h3 admin-reading-header-title mb-1">Import Excel + ảnh</h1>
            <p class="admin-reading-header-desc mb-0">
                Tải template, điền dữ liệu, (tuỳ chọn) kèm ZIP ảnh theo ReadingCode, rồi kiểm tra trước khi tạo bản nháp.
            </p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i>Danh sách
        </a>
    </div>

    <partial name="_ReadingImportSteps" model="1" />
    <partial name="_ReadingAlerts" />

    <div class="admin-reading-card p-3 p-md-4 mb-4">
        <h2 class="admin-reading-section-title mb-2">Chuẩn bị file</h2>
        <ul class="text-muted mb-3">
            <li>Sheet: Reading_Info (có cột ImageUrl), Passage, Questions, Answers, Vocabulary.</li>
            <li>ZIP ảnh (tuỳ chọn): chỉ file ở gốc, tên <code>{ReadingCode}.jpg|png|webp|gif</code> — ZIP thắng cột ImageUrl.</li>
            <li>Bài hợp lệ lưu dạng <strong>Bản nháp</strong>; không ghi đè ReadingCode đã tồn tại.</li>
            <li>Học viên chỉ thấy bài sau khi Admin duyệt và xuất bản.</li>
        </ul>
        <a asp-action="DownloadTemplate" class="btn btn-outline-secondary">
            <i class="fa-solid fa-download me-1" aria-hidden="true"></i>Tải template Excel
        </a>
    </div>

    <form asp-action="ImportPreview" method="post" enctype="multipart/form-data" class="admin-reading-card p-3 p-md-4">
        @Html.AntiForgeryToken()
        <h2 class="admin-reading-section-title mb-3">Bước 1 — Tải lên Excel + media</h2>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label" for="readingImportFile">File Excel (.xlsx)</label>
                <input id="readingImportFile" type="file" name="file"
                       accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
                       class="form-control" required />
                <div class="form-text">Bắt buộc. Tối đa 10MB.</div>
            </div>
            <div class="col-md-6">
                <label class="form-label" for="readingMediaZip">Gói ảnh ZIP (tuỳ chọn)</label>
                <input id="readingMediaZip" type="file" name="mediaZip"
                       accept=".zip,application/zip,application/x-zip-compressed"
                       class="form-control" />
                <div class="form-text">Tối đa 25MB. Ảnh lưu vào /images/reading/ khi xem trước.</div>
            </div>
        </div>
        <div class="d-flex flex-wrap gap-2 admin-reading-actions mt-4">
            <button type="submit" class="btn btn-primary">
                <span class="admin-reading-busy-label"><i class="fa-solid fa-magnifying-glass me-1" aria-hidden="true"></i>Kiểm tra &amp; xem trước</span>
                <span class="admin-reading-busy-spinner"><span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>Đang kiểm tra…</span>
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/admin-reading.js" asp-append-version="true"></script>
}
