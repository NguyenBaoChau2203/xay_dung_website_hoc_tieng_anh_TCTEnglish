@model TCTEnglish.Areas.Admin.ViewModels.ReadingEditorViewModel
@{
    ViewData["Title"] = "Tạo bài đọc";
}

@section Styles {
    <link rel="stylesheet" href="~/css/tct-image-upload.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-reading.css" asp-append-version="true" />
}

<div class="container-fluid py-4 tct-theme admin-reading-page">
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-end gap-3 mb-4">
        <div>
            <div class="admin-reading-eyebrow mb-2">Quản trị Reading</div>
            <h1 class="h3 admin-reading-header-title mb-1">Tạo bài đọc (bản nháp)</h1>
            <p class="admin-reading-header-desc mb-0">
                Soạn metadata, nội dung và câu hỏi (chọn đáp án / nhập chữ / ghép cặp). Từ vựng hàng loạt qua Excel.
            </p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i>Quay lại danh sách
        </a>
    </div>

    <partial name="_ReadingAlerts" />
    <partial name="_ReadingEditorForm" model="Model" />
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/tct-image-upload.js" asp-append-version="true"></script>
    <script src="~/js/admin-reading.js" asp-append-version="true"></script>
}
