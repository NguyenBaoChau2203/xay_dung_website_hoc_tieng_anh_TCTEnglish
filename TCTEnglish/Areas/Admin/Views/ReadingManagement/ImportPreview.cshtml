@model TCTEnglish.Services.Reading.ReadingExcelPreviewResult
@{
    ViewData["Title"] = "Xem trước Import";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-reading.css" asp-append-version="true" />
}

<div class="container-fluid py-4 tct-theme admin-reading-page">
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-end gap-3 mb-4">
        <div>
            <div class="admin-reading-eyebrow mb-2">Import Reading</div>
            <h1 class="h3 admin-reading-header-title mb-1">Kết quả kiểm tra Excel</h1>
            <p class="admin-reading-header-desc mb-0">
                Import tạo bản nháp. Học viên chỉ thấy bài sau khi Admin duyệt và xuất bản.
            </p>
        </div>
        <a asp-action="Import" class="btn btn-outline-secondary">
            <i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i>Chọn file khác
        </a>
    </div>

    <partial name="_ReadingImportSteps" model="2" />
    <partial name="_ReadingAlerts" />

    @if (Model.Warnings.Count > 0)
    {
        <div class="alert alert-warning">
            <strong><i class="fa-solid fa-triangle-exclamation me-1" aria-hidden="true"></i>Cảnh báo (@Model.Warnings.Count)</strong>
            <ul class="mb-0 mt-2">
                @foreach (var w in Model.Warnings.Take(20))
                {
                    <li>@w.ReadingCode / @w.Sheet dòng @w.Row: @w.Message</li>
                }
            </ul>
        </div>
    }

    @if (Model.FailedReadings.Count > 0)
    {
        <div class="admin-reading-card p-3 p-md-4 mb-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                <div>
                    <h2 class="admin-reading-section-title mb-1 text-danger">
                        @Model.FailedReadings.Count bài không hợp lệ
                    </h2>
                    <p class="text-muted small mb-0">Các bài này sẽ bị bỏ qua khi xác nhận Import.</p>
                </div>
                @if (ViewBag.HasErrorReport == true)
                {
                    <a asp-action="DownloadImportErrorReport" class="btn btn-outline-danger">
                        <i class="fa-solid fa-file-excel me-1" aria-hidden="true"></i>Tải báo cáo lỗi
                    </a>
                }
            </div>
            <div class="table-responsive">
                <table class="table table-sm admin-reading-table align-middle mb-0">
                    <thead>
                    <tr>
                        <th>ReadingCode</th>
                        <th>Sheet</th>
                        <th>Dòng</th>
                        <th>Cột</th>
                        <th>Giá trị</th>
                        <th>Lỗi</th>
                        <th>Cách sửa</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var err in Model.Errors)
                    {
                        <tr>
                            <td data-label="ReadingCode">@err.ReadingCode</td>
                            <td data-label="Sheet">@err.Sheet</td>
                            <td data-label="Dòng">@err.Row</td>
                            <td data-label="Cột">@err.Column</td>
                            <td data-label="Giá trị">@err.Value</td>
                            <td data-label="Lỗi">@err.Message</td>
                            <td data-label="Cách sửa">@err.FixHint</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (Model.HasImportableReadings)
    {
        <div class="alert alert-success">
            <i class="fa-solid fa-circle-check me-1" aria-hidden="true"></i>
            Có <strong>@Model.ValidReadings.Count</strong> bài hợp lệ sẵn sàng Import (partial import).
        </div>

        <div class="admin-reading-card overflow-hidden mb-4">
            <div class="table-responsive">
                <table class="table admin-reading-table align-middle mb-0">
                    <thead>
                    <tr>
                        <th class="ps-3">Ảnh</th>
                        <th>ReadingCode</th>
                        <th>Tiêu đề</th>
                        <th>CEFR</th>
                        <th>Đoạn</th>
                        <th>Câu hỏi</th>
                        <th class="pe-3">Từ vựng</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var r in Model.ValidReadings)
                    {
                        <tr>
                            <td class="ps-3" data-label="Ảnh">
                                @if (!string.IsNullOrWhiteSpace(r.ImageUrl))
                                {
                                    <img src="@r.ImageUrl" alt="" class="admin-reading-import-thumb" width="72" height="45" loading="lazy" />
                                }
                                else
                                {
                                    <span class="text-muted small">Không ảnh</span>
                                }
                            </td>
                            <td data-label="ReadingCode">@r.ExternalReadingKey</td>
                            <td data-label="Tiêu đề">@r.Title</td>
                            <td data-label="CEFR"><span class="admin-reading-level">@r.Level</span></td>
                            <td data-label="Đoạn">@r.Paragraphs.Count</td>
                            <td data-label="Câu hỏi">@r.Questions.Count</td>
                            <td class="pe-3" data-label="Từ vựng">@r.Vocabulary.Count</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2 admin-reading-actions">
            <form asp-action="ImportConfirm" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="previewJson" value="@ViewBag.ImportPreviewJson" />
                <button type="submit" class="btn btn-primary">
                    <span class="admin-reading-busy-label">
                        <i class="fa-solid fa-check me-1" aria-hidden="true"></i>Xác nhận Import (@Model.ValidReadings.Count bài)
                    </span>
                    <span class="admin-reading-busy-spinner">
                        <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>Đang import…
                    </span>
                </button>
            </form>
            <a asp-action="Import" class="btn btn-outline-secondary">Hủy</a>
        </div>
    }
    else
    {
        <div class="admin-reading-card admin-reading-empty">
            <i class="fa-solid fa-file-circle-xmark d-block mb-3" aria-hidden="true"></i>
            <h2 class="h5 mb-2">Không có bài hợp lệ để Import</h2>
            <p class="mb-3">Sửa file theo báo cáo lỗi rồi tải lên lại.</p>
            <a asp-action="Import" class="btn btn-outline-secondary">Quay lại bước tải lên</a>
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/admin-reading.js" asp-append-version="true"></script>
}
