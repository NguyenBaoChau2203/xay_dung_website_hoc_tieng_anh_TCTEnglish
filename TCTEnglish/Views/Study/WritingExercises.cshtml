@using System
@using System.Linq
@model TCTEnglish.ViewModels.WritingExerciseListViewModel
@{
    ViewData["Title"] = "Bài tập viết";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var hasMyExercises = Model.MyExercises.Any();
    var createFromAiUrl = Url.Action("CreateWritingExerciseFromAi", "Study") ?? string.Empty;
    var practiceUrl = Url.Action("WritingPractice", "Study") ?? string.Empty;
}

@section Styles {
    <link rel="stylesheet" href="~/css/writing-exercises.css" asp-append-version="true" />
}

<div class="tct-theme writing-exercises-page">
    <div class="writing-exercises-shell">

        @* ── Breadcrumbs ──────────────────────────────────── *@
        <nav class="writing-breadcrumb" aria-label="Điều hướng trang">
            <ol class="writing-breadcrumb-list">
                <li><a href="/Home">Trang chủ</a></li>
                <li class="writing-breadcrumb-sep" aria-hidden="true"><i class="fas fa-chevron-right"></i></li>
                <li><a asp-controller="Study" asp-action="Writing" asp-route-level="@Model.SelectedLevelKey">Viết</a></li>
                <li class="writing-breadcrumb-sep" aria-hidden="true"><i class="fas fa-chevron-right"></i></li>
                <li class="active" aria-current="page">@Model.SelectedContentTypeTitle</li>
            </ol>
        </nav>

        @* ── Flash Messages ───────────────────────────────── *@
        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="alert alert-success d-flex align-items-center gap-2 rounded-4 shadow-sm mb-4" role="status">
                <i class="fas fa-circle-check text-success" aria-hidden="true"></i>
                <div>@successMessage</div>
            </div>
        }

        @if (TempData["ErrorMessage"] is string errorMessage)
        {
            <div class="alert alert-danger d-flex align-items-center gap-2 rounded-4 shadow-sm mb-4" role="alert">
                <i class="fas fa-triangle-exclamation text-danger" aria-hidden="true"></i>
                <div>@Html.Raw(errorMessage)</div>
            </div>
        }

        @* ── Page Header ──────────────────────────────────── *@
        <div class="writing-exercises-head">
            <div class="writing-exercises-head-main">
                <div class="writing-exercises-badge">
                    <i class="fa-solid fa-layer-group me-1" aria-hidden="true"></i> @Model.SelectedLevelTitle
                </div>
                <h1 class="writing-exercises-title">Danh sách bài tập viết</h1>
                <p class="writing-exercises-subtitle">
                    Luyện tập từng câu với phản hồi thời gian thực từ hệ thống đánh giá thông minh.
                </p>
            </div>
            <div class="writing-exercises-head-meta">
                <span class="writing-count-badge">
                    <i class="far fa-file-alt me-1" aria-hidden="true"></i>
                    <strong>@Model.TotalCount</strong> bài tập khả dụng
                </span>
            </div>
        </div>

        @* ── Filter Toolbar ───────────────────────────────── *@
        <section class="writing-filter-toolbar" aria-label="Bộ lọc bài tập">
            <div class="writing-filter-info">
                <div class="writing-filter-icon" aria-hidden="true">
                    <i class="fas fa-filter"></i>
                </div>
                <div>
                    <span class="writing-filter-title">Bộ lọc theo chủ đề &amp; trạng thái</span>
                    <span class="writing-filter-desc">Chọn nhanh chủ đề để tìm bài viết phù hợp nhất</span>
                </div>
            </div>

            <form method="get"
                  asp-controller="Study"
                  asp-action="WritingExercises"
                  class="writing-filters-form"
                  data-writing-filter-form>
                <input type="hidden" name="level" value="@Model.SelectedLevelKey" />
                <input type="hidden" name="contentType" value="@Model.SelectedContentTypeKey" />
                <input type="hidden" name="page" value="1" />

                <div class="writing-select-wrap">
                    <label for="filterTopic" class="visually-hidden">Chủ đề bài viết</label>
                    <select id="filterTopic" name="topic" class="form-select writing-select" data-filter-select>
                        @foreach (var option in Model.TopicOptions)
                        {
                            <option value="@option.Value" selected="@(string.Equals(option.Value, Model.SelectedTopic, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">
                                @option.Label
                            </option>
                        }
                    </select>
                </div>

                @if (Model.ShowProgressMetadata)
                {
                    <div class="writing-select-wrap">
                        <label for="filterStatus" class="visually-hidden">Trạng thái học tập</label>
                        <select id="filterStatus" name="status" class="form-select writing-select" data-filter-select>
                            @foreach (var option in Model.StatusOptions)
                            {
                                <option value="@option.Value" selected="@(string.Equals(option.Value, Model.SelectedStatus, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">
                                    @option.Label
                                </option>
                            }
                        </select>
                    </div>
                }
            </form>
        </section>

        @* ── My Exercises (Authenticated) ─────────────────── *@
        @if (Model.IsAuthenticatedUser)
        {
            <section class="writing-user-section mb-5" aria-labelledby="my-exercises-heading">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h2 id="my-exercises-heading" class="writing-section-title">
                        <i class="fa-solid fa-user-pen me-2 text-primary" aria-hidden="true"></i>Bài viết của tôi
                    </h2>
                    @if (hasMyExercises)
                    {
                        <span class="badge rounded-pill bg-primary-subtle text-primary border border-primary-subtle px-3 py-2">
                            @Model.MyTotalCount bài cá nhân
                        </span>
                    }
                </div>

                @if (Model.CanCreateFromAi)
                {
                    <div class="writing-create-panel mb-4">
                        <div class="writing-create-grid">
                            <div class="writing-create-copy">
                                <div class="writing-create-badge">
                                    <i class="fa-solid fa-wand-magic-sparkles me-1" aria-hidden="true"></i> AI Assistant
                                </div>
                                <h3 class="writing-create-title">Tạo bài viết bằng AI</h3>
                                <p class="writing-create-desc">
                                    Dán một đoạn văn tiếng Việt hoặc tiếng Anh hoàn chỉnh. Hệ thống sẽ tự động tách câu, dịch song ngữ và đưa vào bài tập cá nhân của bạn.
                                </p>
                                <div class="writing-create-quota">
                                    <span class="writing-card-chip writing-card-chip--quota">
                                        <i class="fas fa-sparkles me-1" aria-hidden="true"></i> Tối đa 5 bài AI mỗi ngày
                                    </span>
                                </div>
                            </div>

                            <form class="writing-create-form"
                                  data-writing-create-form
                                  data-create-url="@createFromAiUrl"
                                  data-practice-url="@practiceUrl">
                                @Html.AntiForgeryToken()
                                <div class="mb-2 position-relative">
                                    <label for="writingSourceText" class="visually-hidden">Nội dung bài viết</label>
                                    <textarea id="writingSourceText"
                                              name="sourceText"
                                              class="form-control writing-create-textarea"
                                              rows="4"
                                              maxlength="4000"
                                              required
                                              placeholder="Dán nội dung bài viết của bạn tại đây (tối đa 4000 ký tự)..."></textarea>
                                </div>
                                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                    <span class="text-muted small">
                                        <i class="far fa-keyboard me-1" aria-hidden="true"></i>Tối đa 4000 ký tự
                                    </span>
                                    <button type="submit" class="btn btn-primary px-4 py-2" data-writing-create-submit>
                                        <i class="fa-solid fa-wand-magic-sparkles me-1" aria-hidden="true"></i>
                                        <span data-writing-create-submit-text>Tạo bài bằng AI</span>
                                    </button>
                                </div>
                                <p class="writing-create-message mt-2 mb-0" data-writing-create-message hidden></p>
                            </form>
                        </div>
                    </div>
                }
                else
                {
                    <div class="writing-create-panel writing-create-panel--locked mb-4">
                        <div class="d-flex align-items-center gap-3">
                            <div class="writing-lock-icon" aria-hidden="true">
                                <i class="fas fa-crown text-warning"></i>
                            </div>
                            <div>
                                <h3 class="h6 fw-bold mb-1">Mở khóa tính năng tạo bài bằng AI</h3>
                                <p class="text-muted small mb-0">
                                    Nâng cấp gói Premium để tự do tạo bài viết từ tài liệu cá nhân với hỗ trợ tách câu và gợi ý thông minh từ AI.
                                </p>
                            </div>
                        </div>
                    </div>
                }

                @if (hasMyExercises)
                {
                    @if (Model.IsMyExercisesLocked)
                    {
                        <div class="writing-lock-banner alert alert-warning d-flex align-items-center gap-3 rounded-4 shadow-sm mb-4" role="status">
                            <i class="fas fa-lock fa-lg text-warning" aria-hidden="true"></i>
                            <div>
                                <strong>Đã khóa do gói hiện tại</strong>
                                <p class="mb-0 small text-muted">
                                    Bạn vẫn nhìn thấy tiêu đề bài cũ nhưng không thể luyện tập hoặc xóa cho đến khi nâng cấp lại.
                                </p>
                            </div>
                        </div>
                    }

                    <div class="writing-exercise-grid mb-4">
                        @foreach (var exercise in Model.MyExercises)
                        {
                            var isLocked = exercise.IsLocked;
                            <article class="writing-exercise-card writing-exercise-card--private @(isLocked ? "is-locked" : "")">
                                <div class="writing-exercise-top">
                                    <span class="writing-card-chip writing-card-chip--private">
                                        <i class="fa-solid fa-user me-1" aria-hidden="true"></i>@exercise.Topic
                                    </span>
                                    <span class="writing-card-duration">
                                        <i class="far fa-file-lines me-1" aria-hidden="true"></i>@exercise.SentenceCount câu
                                    </span>
                                </div>
                                <div class="writing-exercise-main">
                                    <h3 class="writing-exercise-title">@exercise.Title</h3>
                                    <p class="writing-exercise-preview">@exercise.PreviewText</p>
                                </div>
                                <div class="writing-exercise-bottom">
                                    <div class="writing-status-group">
                                        @if (isLocked)
                                        {
                                            <span class="badge rounded-pill bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1">
                                                <i class="fas fa-lock me-1" aria-hidden="true"></i>Đã khóa
                                            </span>
                                        }
                                        else if (Model.ShowProgressMetadata)
                                        {
                                            var isCompleted = exercise.StatusKey == "completed";
                                            var badgeClass = isCompleted ? "bg-success-subtle text-success border-success-subtle" :
                                                             (string.IsNullOrWhiteSpace(exercise.StatusKey) || exercise.StatusKey == "not-started" ? "bg-light text-secondary border" : "bg-warning-subtle text-warning-emphasis border-warning-subtle");
                                            var icon = isCompleted ? "fa-check-circle" :
                                                       (string.IsNullOrWhiteSpace(exercise.StatusKey) || exercise.StatusKey == "not-started" ? "fa-circle" : "fa-clock");
                                            <span class="badge rounded-pill @badgeClass border px-2 py-1 writing-status-badge">
                                                <i class="fas @icon me-1" aria-hidden="true"></i>@exercise.StatusLabel
                                            </span>
                                            @if (exercise.AttemptCount > 0)
                                            {
                                                <span class="writing-attempt-badge">@exercise.AttemptCount lượt nộp</span>
                                            }
                                        }
                                    </div>
                                    <div class="writing-action-group">
                                        @if (!isLocked && exercise.CanDelete)
                                        {
                                            <form method="post"
                                                  asp-controller="Study"
                                                  asp-action="DeleteOwnedWritingExercise"
                                                  class="writing-delete-form"
                                                  data-writing-delete-form>
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="exerciseId" value="@exercise.Id" />
                                                <input type="hidden" name="level" value="@Model.SelectedLevelKey" />
                                                <input type="hidden" name="contentType" value="@Model.SelectedContentTypeKey" />
                                                <input type="hidden" name="topic" value="@Model.SelectedTopic" />
                                                <input type="hidden" name="status" value="@Model.SelectedStatus" />
                                                <input type="hidden" name="page" value="@Model.CurrentPage" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger writing-btn--icon" title="Xóa bài viết này" aria-label="Xóa bài viết @exercise.Title">
                                                    <i class="fas fa-trash-can" aria-hidden="true"></i>
                                                </button>
                                            </form>
                                        }

                                        @if (isLocked)
                                        {
                                            <button type="button" class="btn btn-secondary btn-sm px-3" disabled aria-disabled="true">
                                                <i class="fas fa-lock me-1" aria-hidden="true"></i>Khóa
                                            </button>
                                        }
                                        else
                                        {
                                            <a asp-controller="Study"
                                               asp-action="WritingPractice"
                                               asp-route-level="@Model.SelectedLevelKey"
                                               asp-route-contentType="@Model.SelectedContentTypeKey"
                                               asp-route-topic="@Model.SelectedTopic"
                                               asp-route-status="@Model.SelectedStatus"
                                               asp-route-page="@Model.CurrentPage"
                                               asp-route-exerciseId="@exercise.Id"
                                               class="btn btn-outline-primary btn-sm px-3">
                                                @(string.IsNullOrWhiteSpace(exercise.StartActionLabel) ? "Bắt đầu" : exercise.StartActionLabel)
                                                <i class="fas fa-chevron-right ms-1" aria-hidden="true"></i>
                                            </a>
                                        }
                                    </div>
                                </div>
                            </article>
                        }
                    </div>

                    @* My Exercises Pagination *@
                    @if (Model.MyTotalPages > 1)
                    {
                        <nav class="d-flex align-items-center justify-content-between p-3 rounded-4 bg-white shadow-sm mb-4" aria-label="Phân trang bài viết của tôi">
                            <span class="text-muted small">
                                Trang <strong>@Model.MyCurrentPage</strong> / <strong>@Model.MyTotalPages</strong> (@Model.MyTotalCount bài cá nhân)
                            </span>
                            <div class="d-flex gap-2">
                                @if (Model.MyCurrentPage > 1)
                                {
                                    <a asp-controller="Study" asp-action="WritingExercises"
                                       asp-route-level="@Model.SelectedLevelKey"
                                       asp-route-contentType="@Model.SelectedContentTypeKey"
                                       asp-route-topic="@Model.SelectedTopic"
                                       asp-route-status="@Model.SelectedStatus"
                                       asp-route-page="@Model.CurrentPage"
                                       asp-route-myPage="@(Model.MyCurrentPage - 1)"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="fas fa-chevron-left me-1" aria-hidden="true"></i> Trang trước
                                    </a>
                                }
                                @if (Model.MyCurrentPage < Model.MyTotalPages)
                                {
                                    <a asp-controller="Study" asp-action="WritingExercises"
                                       asp-route-level="@Model.SelectedLevelKey"
                                       asp-route-contentType="@Model.SelectedContentTypeKey"
                                       asp-route-topic="@Model.SelectedTopic"
                                       asp-route-status="@Model.SelectedStatus"
                                       asp-route-page="@Model.CurrentPage"
                                       asp-route-myPage="@(Model.MyCurrentPage + 1)"
                                       class="btn btn-sm btn-outline-primary">
                                        Trang tiếp <i class="fas fa-chevron-right ms-1" aria-hidden="true"></i>
                                    </a>
                                }
                            </div>
                        </nav>
                    }
                }
            </section>
        }

        @* ── System Catalog ───────────────────────────────── *@
        <section class="writing-system-section" aria-labelledby="system-catalog-heading">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h2 id="system-catalog-heading" class="writing-section-title">
                    <i class="fa-solid fa-book-bookmark me-2 text-primary" aria-hidden="true"></i>Catalog hệ thống
                </h2>
                <span class="text-muted small">
                    Hiển thị <strong>@Model.StartItemNumber-@Model.EndItemNumber</strong> / <strong>@Model.TotalCount</strong> bài
                </span>
            </div>

            @if (!Model.Exercises.Any())
            {
                <div class="writing-empty-state">
                    <img src="~/images/writing/writing-empty-search-clay.svg"
                         alt="Không tìm thấy bài tập"
                         width="120"
                         height="120"
                         class="mb-3" />
                    <h3 class="writing-empty-title">Không tìm thấy bài tập phù hợp</h3>
                    <p class="writing-empty-desc">
                        Không có bài viết nào khớp với bộ lọc hiện tại. Hãy thử chọn chủ đề khác hoặc đặt lại trạng thái.
                    </p>
                    <a asp-controller="Study"
                       asp-action="WritingExercises"
                       asp-route-level="@Model.SelectedLevelKey"
                       asp-route-contentType="@Model.SelectedContentTypeKey"
                       class="btn btn-outline-primary rounded-pill px-4">
                        <i class="fas fa-rotate-left me-1" aria-hidden="true"></i> Đặt lại bộ lọc
                    </a>
                </div>
            }
            else
            {
                <div class="writing-exercise-grid mb-4">
                    @foreach (var exercise in Model.Exercises)
                    {
                        var isStartedOrCompleted = !string.IsNullOrWhiteSpace(exercise.StatusKey) && exercise.StatusKey != "not-started";
                        var isCompleted = exercise.StatusKey == "completed";
                        var chipClass = exercise.Topic switch {
                            "Cơ bản" => "writing-card-chip--basic",
                            "Trung cấp" => "writing-card-chip--intermediate",
                            "Nâng cao" => "writing-card-chip--advanced",
                            _ => "writing-card-chip--default"
                        };
                        <article class="writing-exercise-card @(isStartedOrCompleted ? "writing-exercise-card--active" : "")">
                            <div class="writing-exercise-top">
                                <span class="writing-card-chip @chipClass">@exercise.Topic</span>
                                <span class="writing-card-duration">
                                    <i class="far fa-file-lines me-1" aria-hidden="true"></i>@exercise.SentenceCount câu
                                </span>
                            </div>
                            <div class="writing-exercise-main">
                                <h3 class="writing-exercise-title">@exercise.Title</h3>
                                <p class="writing-exercise-preview">@exercise.PreviewText</p>
                            </div>
                            <div class="writing-exercise-bottom">
                                <div class="writing-status-group">
                                    @if (Model.ShowProgressMetadata)
                                    {
                                        var badgeClass = isCompleted ? "bg-success-subtle text-success border-success-subtle" :
                                                         (string.IsNullOrWhiteSpace(exercise.StatusKey) || exercise.StatusKey == "not-started" ? "bg-light text-secondary border" : "bg-warning-subtle text-warning-emphasis border-warning-subtle");
                                        var icon = isCompleted ? "fa-check-circle" :
                                                   (string.IsNullOrWhiteSpace(exercise.StatusKey) || exercise.StatusKey == "not-started" ? "fa-circle" : "fa-clock");
                                        <span class="badge rounded-pill @badgeClass border px-2 py-1 writing-status-badge">
                                            <i class="fas @icon me-1" aria-hidden="true"></i>@exercise.StatusLabel
                                        </span>
                                        @if (exercise.AttemptCount > 0)
                                        {
                                            <span class="writing-attempt-badge">@exercise.AttemptCount lượt nộp</span>
                                        }
                                    }
                                </div>
                                <a asp-controller="Study"
                                   asp-action="WritingPractice"
                                   asp-route-level="@Model.SelectedLevelKey"
                                   asp-route-contentType="@Model.SelectedContentTypeKey"
                                   asp-route-topic="@Model.SelectedTopic"
                                   asp-route-status="@Model.SelectedStatus"
                                   asp-route-page="@Model.CurrentPage"
                                   asp-route-exerciseId="@exercise.Id"
                                   class="btn @(isStartedOrCompleted ? "btn-primary" : "btn-outline-primary") btn-sm px-3">
                                    @(string.IsNullOrWhiteSpace(exercise.StartActionLabel) ? "Bắt đầu" : exercise.StartActionLabel)
                                    <i class="fas fa-chevron-right ms-1" aria-hidden="true"></i>
                                </a>
                            </div>
                        </article>
                    }
                </div>

                @* System Pagination *@
                @if (Model.TotalPages > 1)
                {
                    <div class="writing-pagination-wrap">
                        <p class="writing-pagination-info">
                            Hiển thị <strong>@Model.StartItemNumber - @Model.EndItemNumber</strong> trên tổng số <strong>@Model.TotalCount</strong> bài
                        </p>

                        <nav aria-label="Phân trang bài tập">
                            <ul class="pagination pagination-sm mb-0">
                                @if (Model.CurrentPage > 1)
                                {
                                    <li class="page-item">
                                        <a asp-controller="Study" asp-action="WritingExercises"
                                           asp-route-level="@Model.SelectedLevelKey"
                                           asp-route-contentType="@Model.SelectedContentTypeKey"
                                           asp-route-topic="@Model.SelectedTopic"
                                           asp-route-status="@Model.SelectedStatus"
                                           asp-route-page="@(Model.CurrentPage - 1)"
                                           class="page-link" aria-label="Trang trước">
                                            <i class="fas fa-chevron-left" aria-hidden="true"></i>
                                        </a>
                                    </li>
                                }

                                @foreach (var pageNumber in Model.PageNumbers)
                                {
                                    if (pageNumber.HasValue)
                                    {
                                        <li class="page-item @(pageNumber.Value == Model.CurrentPage ? "active" : "")">
                                            <a asp-controller="Study" asp-action="WritingExercises"
                                               asp-route-level="@Model.SelectedLevelKey"
                                               asp-route-contentType="@Model.SelectedContentTypeKey"
                                               asp-route-topic="@Model.SelectedTopic"
                                               asp-route-status="@Model.SelectedStatus"
                                               asp-route-page="@pageNumber.Value"
                                               class="page-link"
                                               aria-current="@(pageNumber.Value == Model.CurrentPage ? "page" : null)">
                                                @pageNumber.Value
                                            </a>
                                        </li>
                                    }
                                    else
                                    {
                                        <li class="page-item disabled"><span class="page-link">...</span></li>
                                    }
                                }

                                @if (Model.CurrentPage < Model.TotalPages)
                                {
                                    <li class="page-item">
                                        <a asp-controller="Study" asp-action="WritingExercises"
                                           asp-route-level="@Model.SelectedLevelKey"
                                           asp-route-contentType="@Model.SelectedContentTypeKey"
                                           asp-route-topic="@Model.SelectedTopic"
                                           asp-route-status="@Model.SelectedStatus"
                                           asp-route-page="@(Model.CurrentPage + 1)"
                                           class="page-link" aria-label="Trang tiếp theo">
                                            <i class="fas fa-chevron-right" aria-hidden="true"></i>
                                        </a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    </div>
                }
            }
        </section>

    </div>
</div>

@section Scripts {
    <script src="~/js/writing-exercises.js" asp-append-version="true"></script>
}