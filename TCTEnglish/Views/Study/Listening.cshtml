@model TCTEnglish.ViewModels.ListeningIndexViewModel
@using System.Text.Json
@using TCTEnglish.ViewModels
@using TCTVocabulary.Security
@{
    ViewData["Title"] = "Luyện nghe tiếng Anh - TCT English";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // CEFR levels in display order. The label heads each shelf (text always accompanies the level key).
    var levels = new[]
    {
        (Key: "A1", Label: "A1 · Sơ cấp"),
        (Key: "A2", Label: "A2 · Cơ bản"),
        (Key: "B1", Label: "B1 · Trung cấp"),
        (Key: "B2", Label: "B2 · Trung cao cấp"),
        (Key: "C1", Label: "C1 · Nâng cao"),
        (Key: "C2", Label: "C2 · Thành thạo")
    };

    var header = new PageHeaderViewModel
    {
        Title = "Luyện nghe",
        Description = "Nghe hội thoại thật, tra từ ngay trong lời thoại, chép chính tả và làm quiz."
    };

    var visibleLevels = levels.Where(l => Model.LessonsByLevel.TryGetValue(l.Key, out var list) && list.Count > 0).ToList();
    var lessonCount = visibleLevels.Sum(l => Model.LessonsByLevel[l.Key].Count);
    var hasLessons = lessonCount > 0;
    var selectedLevel = Model.SelectedLevel ?? "all";
    var selectedTopic = Model.SelectedTopic ?? "all";
    var signedIn = Model.IsAuthenticated;
    var completedByLevel = Model.Levels.ToDictionary(l => l.Key, l => l.CompletedCount);

    // The signed-in user's id only keys the browser-local dictation results (D3); it is never sent anywhere.
    var userKey = User.TryGetUserId(out var currentUserId) ? currentUserId.ToString() : null;

    var config = new
    {
        isAuthenticated = signedIn,
        canImport = Model.CanImport,
        userKey,
        selectedLevel,
        selectedTopic,
        topics = Model.Topics,
        shelfSize = 4,
        gridSize = 8,
        urls = new
        {
            create = "/Home/Listening/My/Create",
            delete = "/Home/Listening/My/Delete",
            practice = "/Home/Listening/Practice/",
            premium = "/Account/Premium"
        }
    };
    var configJson = JsonSerializer.Serialize(config, new JsonSerializerOptions(JsonSerializerDefaults.Web));

    var noLessons = new StateMessageViewModel { Kind = StateMessageKind.Empty, Title = "Chưa có bài nghe nào.", Message = "Nội dung đang được cập nhật." };
    var noResults = new StateMessageViewModel { Kind = StateMessageKind.Empty, Title = "Không có bài nào khớp bộ lọc.", Message = "Thử từ khóa khác hoặc bỏ bớt bộ lọc." };

    var statusLabels = new[] { (Key: "all", Label: "Mọi trạng thái"), (Key: "new", Label: "Chưa học"), (Key: "progress", Label: "Đang học"), (Key: "done", Label: "Đã xong") };
}

@section Styles {
    <link rel="stylesheet" href="~/css/study-kit.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/listening.css" asp-append-version="true" />
}

<div class="tct-theme tct-page tl-page tl-page--index">
    @Html.AntiForgeryToken()

    <div class="tl-head">
        <partial name="~/Views/Shared/_PageHeader.cshtml" model="header" />
        @if (hasLessons)
        {
            <div class="tl-search" role="search">
                <label class="visually-hidden" for="tlSearch">Tìm bài nghe</label>
                <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                <input id="tlSearch" type="search" class="form-control" maxlength="80" autocomplete="off" placeholder="Tìm bài nghe, chủ đề…" />
            </div>
        }
    </div>

    <div class="tl-top@(Model.HeroMode == "none" ? " tl-top--solo" : string.Empty)">
        <partial name="_ListeningHero" model="Model" />
        <partial name="_ListeningYoutubeCard" model="Model" />
    </div>

    @if (hasLessons)
    {
        <partial name="_ListeningLevelRow" model="Model" />

        <div class="tl-filters">
            @if (signedIn)
            {
                <div class="tl-chips" id="tlStatuses" role="group" aria-label="Lọc theo trạng thái">
                    @foreach (var st in statusLabels)
                    {
                        <button type="button" class="tl-chip" data-status="@st.Key" aria-pressed="@(st.Key == "all" ? "true" : "false")">@st.Label</button>
                    }
                </div>
            }
            @if (Model.Topics.Count > 0)
            {
                <div class="tl-topic">
                    <label for="tlTopic" class="tl-topic__label">Chủ đề:</label>
                    <select id="tlTopic" class="form-select form-select-sm">
                        <option value="all" selected="@(selectedTopic == "all" ? "selected" : null)">Tất cả</option>
                        @foreach (var topic in Model.Topics)
                        {
                            <option value="@topic" selected="@(selectedTopic == topic ? "selected" : null)">@topic</option>
                        }
                    </select>
                </div>
            }
            <p class="tl-count visually-hidden" id="tlCount" aria-live="polite">@lessonCount bài nghe</p>
        </div>

        <div id="tlEmpty" hidden>
            <partial name="~/Views/Shared/_StateMessage.cshtml" model="noResults" />
            <div class="tl-empty-actions"><button type="button" class="btn btn-outline-primary" id="tlClearFilters">Xóa bộ lọc</button></div>
        </div>

        <div id="tlLevelsHost">
            @foreach (var lvl in visibleLevels)
            {
                var cards = Model.LessonsByLevel[lvl.Key];
                var done = completedByLevel.TryGetValue(lvl.Key, out var d) ? d : 0;
                <section class="tl-shelf" data-level-section="@lvl.Key" aria-labelledby="tl-level-@lvl.Key">
                    <header class="tl-shelf__head">
                        <h2 id="tl-level-@lvl.Key" class="tl-section-title">@lvl.Label</h2>
                        <span class="tct-badge tct-badge--primary tl-shelf__count" data-level-count data-done="@done">@(signedIn ? done + "/" + cards.Count : cards.Count + " bài")</span>
                        <button type="button" class="btn btn-link tl-shelf__all" data-level-all="@lvl.Key" hidden>Xem cả @cards.Count bài</button>
                    </header>
                    <ul class="tl-grid" data-level-grid>
                        @foreach (var card in cards)
                        {
                            @await Html.PartialAsync("_ListeningLessonCard", card, new ViewDataDictionary(ViewData) { { "Auth", signedIn } })
                        }
                    </ul>
                    <div class="tl-shelf__more"><button type="button" class="btn btn-outline-primary" data-level-more hidden>Xem thêm bài</button></div>
                </section>
            }
        </div>
    }
    else
    {
        <partial name="~/Views/Shared/_StateMessage.cshtml" model="noLessons" />
    }

    @if (signedIn && (Model.CanImport || Model.MyLessons.Count > 0))
    {
        <section class="tl-mine" id="tlMine" aria-labelledby="tl-mine-title" hidden="@(Model.MyLessons.Count == 0 ? "hidden" : null)">
            <header class="tl-shelf__head">
                <h2 id="tl-mine-title" class="tl-section-title" tabindex="-1">Bài nghe của tôi</h2>
                <span class="tct-badge tct-badge--primary tl-shelf__count" id="tlMineShelfCount">@Model.MyLessons.Count bài</span>
            </header>
            <ul class="tl-grid" id="tlMineGrid">
                @foreach (var mine in Model.MyLessons)
                {
                    <partial name="_ListeningMyLessonCard" model="mine" />
                }
            </ul>
        </section>
    }

    <div id="tsToastHost" class="toast-container ts-toast-host" aria-live="polite"></div>

    @if (signedIn && Model.CanImport)
    {
        <div class="modal fade" id="tlDeleteLesson" tabindex="-1" aria-labelledby="tlDeleteTitle" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2 class="modal-title fs-5" id="tlDeleteTitle">Xóa bài nghe?</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                    </div>
                    <div class="modal-body">
                        <p class="mb-0" id="tlDeleteBody"></p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-primary" data-bs-dismiss="modal">Hủy</button>
                        <button type="button" class="btn btn-outline-danger" id="tlDeleteConfirm">Xóa bài nghe</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script type="application/json" id="tlConfig">@Html.Raw(configJson)</script>
    <script src="~/js/personal-sets-common.js" asp-append-version="true"></script>
    <script src="~/js/listening-core.js" asp-append-version="true"></script>
    <script src="~/js/listening-index.js" asp-append-version="true"></script>
}
