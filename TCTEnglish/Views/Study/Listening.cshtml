@model TCTEnglish.ViewModels.ListeningIndexViewModel
@using System.Text.Json
@using TCTEnglish.ViewModels
@{
    ViewData["Title"] = "Luyện nghe tiếng Anh - TCT English";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // CEFR levels in display order: label, description, icon and hue (text always accompanies the colour).
    var levels = new[]
    {
        (Key: "A1", Label: "A1 · Sơ cấp", Desc: "Tiếng Anh dễ, nói chậm", Icon: "fa-seedling", Hue: "success"),
        (Key: "A2", Label: "A2 · Cơ bản", Desc: "Nói rõ, từ vựng thông dụng", Icon: "fa-leaf", Hue: "info"),
        (Key: "B1", Label: "B1 · Trung cấp", Desc: "Tốc độ tự nhiên, chủ đề quen thuộc", Icon: "fa-fire", Hue: "primary"),
        (Key: "B2", Label: "B2 · Trung cao cấp", Desc: "Vốn từ rộng hơn", Icon: "fa-bolt", Hue: "warning"),
        (Key: "C1", Label: "C1 · Nâng cao", Desc: "Nói nhanh, tự nhiên", Icon: "fa-rocket", Hue: "danger")
    };

    var header = new PageHeaderViewModel
    {
        Title = "Luyện nghe",
        Description = "Nghe hội thoại thực tế, xem lời thoại, luyện chính tả và làm quiz."
    };

    var visibleLevels = levels.Where(l => Model.LessonsByLevel.TryGetValue(l.Key, out var list) && list.Count > 0).ToList();
    var lessonCount = visibleLevels.Sum(l => Model.LessonsByLevel[l.Key].Count);
    var hasLessons = lessonCount > 0;
    var percentDone = Model.TotalLessons > 0 ? (int)Math.Round(100.0 * Model.CompletedLessons / Model.TotalLessons) : 0;
    var selectedLevel = Model.SelectedLevel ?? "all";
    var selectedTopic = Model.SelectedTopic ?? "all";

    var config = new
    {
        isAuthenticated = Model.IsAuthenticated,
        canImport = Model.CanImport,
        selectedLevel,
        selectedTopic,
        topics = Model.Topics,
        pageSize = 6,
        urls = new
        {
            create = "/Home/Listening/My/Create",
            delete = "/Home/Listening/My/Delete",
            practice = "/Home/Listening/Practice/",
            premium = "/Account/Premium"
        }
    };
    var configJson = JsonSerializer.Serialize(config, new JsonSerializerOptions(JsonSerializerDefaults.Web));

    var noLessons = new StateMessageViewModel { Kind = StateMessageKind.Empty, Title = "Chưa có bài nghe nào.", Message = "Nội dung đang được cập nhật." };
    var noResults = new StateMessageViewModel { Kind = StateMessageKind.Empty, Title = "Không tìm thấy bài nghe phù hợp.", Message = "Thử từ khóa khác hoặc bỏ bớt bộ lọc." };
    var noMine = new StateMessageViewModel { Kind = StateMessageKind.Empty, Title = "Chưa có bài nghe nào.", Message = "Dán link YouTube ở trên để tạo bài luyện nghe riêng." };

    var statusLabels = new[] { (Key: "all", Label: "Tất cả"), (Key: "new", Label: "Chưa học"), (Key: "progress", Label: "Đang học"), (Key: "done", Label: "Đã xong") };
}

@section Styles {
    <link rel="stylesheet" href="~/css/study-kit.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/listening.css" asp-append-version="true" />
}

<div class="tct-theme tct-page tl-page tl-page--index">
    @Html.AntiForgeryToken()
    <partial name="~/Views/Shared/_PageHeader.cshtml" model="header" />

    @if (Model.IsAuthenticated)
    {
        <section class="tl-overview k-panel tl-hue-primary" aria-labelledby="tl-overview-title">
            <div class="tl-overview__main">
                <h2 id="tl-overview-title" class="tl-overview__title">Tiến độ nghe của bạn</h2>
                <dl class="tl-overview__stats">
                    <div class="tl-overview__stat k-pillow tl-hue-success"><dt>bài đã xong</dt><dd>@Model.CompletedLessons</dd></div>
                    <div class="tl-overview__stat k-pillow tl-hue-warning"><dt>đang học</dt><dd>@Model.InProgressLessons</dd></div>
                    <div class="tl-overview__stat k-pillow tl-hue-primary"><dt>tổng số bài</dt><dd>@Model.TotalLessons</dd></div>
                </dl>
                <div class="k-progress k-progress--thin k-progress--success" role="img" aria-label="Đã xong @Model.CompletedLessons/@Model.TotalLessons bài">
                    <span class="k-progress__fill" style="--p:@(percentDone)%"></span>
                </div>
            </div>
            <div class="tl-overview__side">
                @if (Model.ContinueLesson is { } resume)
                {
                    var resumeThumb = resume.ThumbnailSrc;
                    <div class="tl-continue k-card">
                        <div class="tl-continue__thumb k-art-box">
                            @if (resumeThumb != null)
                            {
                                <img class="tl-thumb" src="@resumeThumb" alt="" width="160" height="90" loading="lazy" decoding="async" />
                            }
                            else
                            {
                                <span class="tl-thumb--empty" aria-hidden="true"><i class="fa-solid fa-headphones"></i></span>
                            }
                        </div>
                        <div class="tl-continue__body">
                            <p class="tl-continue__label">Tiếp tục nghe</p>
                            <p class="tl-continue__title tct-clamp-2 tct-break">@resume.Title</p>
                            <p class="tl-continue__meta">
                                <span class="tct-badge tct-badge--primary">@resume.Level</span>
                                @resume.StepsDone/@resume.StepsTotal phần
                            </p>
                            <a class="btn btn-primary btn-sm" href="/Home/Listening/Practice/@resume.Id"><i class="fa-solid fa-play" aria-hidden="true"></i> Nghe tiếp</a>
                        </div>
                    </div>
                }
                else if (Model.TotalLessons > 0)
                {
                    <p class="tl-overview__hint">Chọn một bài bên dưới để bắt đầu.</p>
                }
            </div>
        </section>
    }
    else
    {
        <div class="tl-guest k-panel k-panel--quiet" role="note">
            <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
            <p class="tl-guest__text">Đăng nhập để lưu tiến độ và thêm bài nghe của riêng bạn.</p>
            <a class="btn btn-primary btn-sm" href="/Account/Login">Đăng nhập</a>
        </div>
    }

    @if (Model.IsAuthenticated)
    {
        <section class="tl-mine" aria-labelledby="tl-mine-title">
            <header class="tl-mine__head">
                <h2 id="tl-mine-title" class="tl-section-title" tabindex="-1">Bài nghe của tôi</h2>
                <span class="tct-badge tct-badge--primary" id="tlMineCount">@Model.MyLessons.Count bài</span>
                @if (Model.IsMyLessonsSectionLocked)
                {
                    <span class="tct-badge tct-badge--warning"><i class="fa-solid fa-lock" aria-hidden="true"></i> Cần Premium</span>
                }
            </header>

            @if (Model.CanImport)
            {
                <form id="tlImport" class="tl-import k-panel" novalidate>
                    <label class="tl-import__label" for="tlImportUrl">Dán link YouTube</label>
                    <div class="tl-import__row">
                        <input id="tlImportUrl" name="youtubeUrl" type="url" class="form-control" required maxlength="300"
                               placeholder="https://www.youtube.com/watch?v=…" autocomplete="off" aria-describedby="tlImportHint tlImportError" />
                        <button type="submit" class="btn btn-primary" id="tlImportSubmit"><i class="fa-solid fa-plus" aria-hidden="true"></i> Thêm bài nghe</button>
                    </div>
                    <p class="tl-import__hint" id="tlImportHint">Chỉ hỗ trợ video tiếng Anh có phụ đề.</p>
                    <p class="tl-import__error" id="tlImportError" role="alert" hidden></p>
                    <div class="tl-import__status" id="tlImportStatus" role="status" aria-live="polite"></div>
                </form>
            }
            else
            {
                <div class="tl-locked k-panel">
                    <i class="fa-solid fa-crown" aria-hidden="true"></i>
                    <p class="tl-locked__text">Thêm bài nghe từ YouTube là tính năng Premium.</p>
                    <a class="btn btn-primary" href="/Account/Premium">Nâng cấp Premium</a>
                </div>
            }

            @if (Model.MyLessons.Count > 0)
            {
                <ul class="tl-grid" id="tlMineGrid">
                    @foreach (var mine in Model.MyLessons)
                    {
                        <partial name="_ListeningMyLessonCard" model="mine" />
                    }
                </ul>
            }
            <div id="tlMineEmpty" hidden="@(Model.MyLessons.Count > 0 || !Model.CanImport ? "hidden" : null)">
                <partial name="~/Views/Shared/_StateMessage.cshtml" model="noMine" />
            </div>
        </section>
    }

    @if (!hasLessons)
    {
        <partial name="~/Views/Shared/_StateMessage.cshtml" model="noLessons" />
    }
    else
    {
        <div class="tl-toolbar" role="search">
            <div class="tl-search">
                <label class="visually-hidden" for="tlSearch">Tìm bài nghe</label>
                <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                <input id="tlSearch" type="search" class="form-control" maxlength="80" autocomplete="off"
                       placeholder="Tìm theo tên bài hoặc chủ đề…" />
            </div>
            <div class="tl-filters">
                <div class="k-seg" id="tlLevels" role="group" aria-label="Lọc theo trình độ">
                    <button type="button" class="k-seg__item" data-level="all" aria-pressed="@(selectedLevel == "all" ? "true" : "false")">Tất cả</button>
                    @foreach (var lvl in levels)
                    {
                        <button type="button" class="k-seg__item" data-level="@lvl.Key" aria-pressed="@(selectedLevel == lvl.Key ? "true" : "false")">@lvl.Key</button>
                    }
                </div>
                @if (Model.IsAuthenticated)
                {
                    <div class="k-seg" id="tlStatuses" role="group" aria-label="Lọc theo trạng thái">
                        @foreach (var st in statusLabels)
                        {
                            <button type="button" class="k-seg__item" data-status="@st.Key" aria-pressed="@(st.Key == "all" ? "true" : "false")">@st.Label</button>
                        }
                    </div>
                }
            </div>
            @if (Model.Topics.Count > 0)
            {
                <div class="tl-topics">
                    <div class="k-seg k-seg--wrap" id="tlTopics" role="group" aria-label="Lọc theo chủ đề">
                        <button type="button" class="k-seg__item" data-topic="all" aria-pressed="@(selectedTopic == "all" ? "true" : "false")">Tất cả chủ đề</button>
                        @foreach (var topic in Model.Topics)
                        {
                            <button type="button" class="k-seg__item" data-topic="@topic" aria-pressed="@(selectedTopic == topic ? "true" : "false")">@topic</button>
                        }
                    </div>
                    <button type="button" class="btn btn-link tl-topics__toggle" id="tlTopicsToggle" aria-expanded="false" hidden>Xem thêm chủ đề</button>
                </div>
            }
            <p class="tl-count" id="tlCount" aria-live="polite">@lessonCount bài nghe</p>
        </div>

        <div id="tlEmpty" hidden>
            <partial name="~/Views/Shared/_StateMessage.cshtml" model="noResults" />
            <div class="tl-empty-actions"><button type="button" class="btn btn-outline-primary" id="tlClearFilters">Xóa bộ lọc</button></div>
        </div>

        <div id="tlLevelsHost">
            @foreach (var lvl in visibleLevels)
            {
                var cards = Model.LessonsByLevel[lvl.Key];
                <section class="tl-level tl-hue-@lvl.Hue" data-level-section="@lvl.Key" aria-labelledby="tl-level-@lvl.Key">
                    <header class="tl-level__head">
                        <span class="tl-level__icon k-pillow" aria-hidden="true"><i class="fa-solid @lvl.Icon"></i></span>
                        <div class="tl-level__titles">
                            <h2 id="tl-level-@lvl.Key" class="tl-section-title">@lvl.Label</h2>
                            <p class="tl-level__desc">@lvl.Desc</p>
                        </div>
                        <span class="tct-badge tct-badge--primary tl-level__count" data-level-count>@cards.Count bài</span>
                    </header>
                    <ul class="tl-grid" data-level-grid>
                        @foreach (var card in cards)
                        {
                            @await Html.PartialAsync("_ListeningLessonCard", card, new ViewDataDictionary(ViewData) { { "Auth", Model.IsAuthenticated } })
                        }
                    </ul>
                    <div class="tl-level__more"><button type="button" class="btn btn-outline-primary" data-level-more hidden>Xem thêm</button></div>
                </section>
            }
        </div>
    }

    <div id="tsToastHost" class="toast-container ts-toast-host" aria-live="polite"></div>

    @if (Model.IsAuthenticated && Model.CanImport)
    {
        <div class="modal fade" id="tlDeleteLesson" tabindex="-1" aria-labelledby="tlDeleteTitle" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2 class="modal-title fs-5" id="tlDeleteTitle">Xóa bài nghe?</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                    </div>
                    <div class="modal-body">
                        <p class="mb-0" id="tlDeleteBody"></p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-primary" data-bs-dismiss="modal">Hủy</button>
                        <button type="button" class="btn btn-outline-danger" id="tlDeleteConfirm">Xóa bài nghe</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script type="application/json" id="tlConfig">@Html.Raw(configJson)</script>
    <script src="~/js/personal-sets-common.js" asp-append-version="true"></script>
    <script src="~/js/listening-core.js" asp-append-version="true"></script>
    <script src="~/js/listening-index.js" asp-append-version="true"></script>
}
