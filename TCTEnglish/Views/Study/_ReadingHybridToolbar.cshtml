<div id="readingHybridToolbar"
     class="reading-hybrid-toolbar d-none"
     role="toolbar"
     aria-label="Công cụ đọc"
     aria-hidden="true">
    <button type="button" class="reading-hybrid-toolbar__btn" data-hybrid-action="highlight" title="Tô sáng">
        <i class="fa-solid fa-highlighter" aria-hidden="true"></i>
        <span>Highlight</span>
    </button>
    <button type="button" class="reading-hybrid-toolbar__btn" data-hybrid-action="listen" title="Nghe phát âm">
        <i class="fa-solid fa-volume-high" aria-hidden="true"></i>
        <span>Listen</span>
    </button>
    <button type="button" class="reading-hybrid-toolbar__btn" data-hybrid-action="translate" title="Dịch nghĩa">
        <i class="fa-solid fa-language" aria-hidden="true"></i>
        <span>Translate</span>
    </button>
    <button type="button" class="reading-hybrid-toolbar__btn" data-hybrid-action="dictionary" title="Tra từ điển">
        <i class="fa-solid fa-book" aria-hidden="true"></i>
        <span>Dictionary</span>
    </button>
</div>
