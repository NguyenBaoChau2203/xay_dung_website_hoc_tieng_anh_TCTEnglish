@model IEnumerable<TCTEnglish.ViewModels.ReadingListViewModel>
@{
    var items = Model?.ToList() ?? new List<TCTEnglish.ViewModels.ReadingListViewModel>();
    var topics = items
        .Select(x => (x.Topic ?? string.Empty).Trim())
        .Where(t => !string.IsNullOrWhiteSpace(t))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(t => t, StringComparer.OrdinalIgnoreCase)
        .ToList();
    var readingLevelGated = ViewBag.ReadingLevelGated as bool? ?? true;
    var studentLevel = ViewBag.StudentReadingLevel as string;
}

<link rel="stylesheet" href="~/css/Reading.css" asp-append-version="true" />

<div class="tct-theme reading-index-page">
    <div class="container">
        <header class="reading-hero tct-page-header">
            <div class="tct-page-header__row reading-hero__row">
                <div class="tct-page-header__text">
                    <h1 class="tct-page-title">Bài đọc tương tác</h1>
                    @if (readingLevelGated)
                    {
                        <p class="tct-page-desc reading-hero__desc">
                            Chọn bài phù hợp cấp độ CEFR của bạn. Chỉ hiển thị bài phù hợp cấp độ hiện tại.
                        </p>
                    }
                    else
                    {
                        <p class="tct-page-desc reading-hero__desc">
                            Bạn đang xem toàn bộ bài đã xuất bản (mọi cấp độ CEFR). Dùng bộ lọc bên dưới để thu hẹp danh sách.
                        </p>
                    }
                </div>
                <div class="tct-page-header__actions reading-hero__actions">
                    @if (readingLevelGated)
                    {
                        <span class="tct-badge tct-badge--primary reading-hero__level"
                              title="Cấp độ CEFR đang áp dụng cho thư viện bài đọc">
                            <i class="fa-solid fa-layer-group" aria-hidden="true"></i>
                            Cấp độ @(string.IsNullOrWhiteSpace(studentLevel) ? "A1" : studentLevel)
                        </span>
                    }
                    else
                    {
                        <span class="tct-badge tct-badge--info reading-hero__level"
                              title="Tài khoản Admin xem mọi cấp độ CEFR đã xuất bản">
                            <i class="fa-solid fa-layer-group" aria-hidden="true"></i>
                            Tất cả cấp độ
                        </span>
                    }
                    <a href="/Reading/Progress" class="btn btn-outline-primary">
                        <i class="fa-solid fa-chart-line me-1" aria-hidden="true"></i>
                        Tiến độ
                    </a>
                    <a href="/Reading/Notebook" class="btn btn-outline-secondary">
                        <i class="fa-solid fa-book me-1" aria-hidden="true"></i>
                        Sổ từ vựng
                    </a>
                </div>
            </div>
        </header>

        <div class="reading-toolbar-wrap mb-4">
            <div class="row align-items-center g-3">
                <div class="col-lg-4">
                    <div class="search-group">
                        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                        <label class="visually-hidden" for="readingSearch">Tìm tiêu đề bài đọc</label>
                        <input type="search"
                               id="readingSearch"
                               class="form-control search-input"
                               placeholder="Tìm tiêu đề bài đọc..."
                               autocomplete="off" />
                    </div>
                </div>
                <div class="col-lg-8">
                    <div class="d-flex flex-wrap justify-content-lg-end align-items-center gap-3">
                        <div class="filter-chips" role="group" aria-label="Lọc theo cấp độ CEFR">
                            <button type="button" class="filter-chip active" data-filter="all">Tất cả</button>
                            <button type="button" class="filter-chip" data-filter="A1">A1</button>
                            <button type="button" class="filter-chip" data-filter="A2">A2</button>
                            <button type="button" class="filter-chip" data-filter="B1">B1</button>
                            <button type="button" class="filter-chip" data-filter="B2">B2</button>
                            <button type="button" class="filter-chip" data-filter="C1">C1</button>
                            <button type="button" class="filter-chip" data-filter="C2">C2</button>
                        </div>
                        <div class="vr d-none d-md-block" aria-hidden="true"></div>
                        <div class="status-group" role="group" aria-label="Lọc theo tiến độ">
                            <button type="button" class="btn status-btn" data-status="inprogress" title="Đang làm" aria-pressed="false">
                                <i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i>
                                <span class="visually-hidden">Đang làm</span>
                            </button>
                            <button type="button" class="btn status-btn" data-status="completed" title="Đã xong" aria-pressed="false">
                                <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
                                <span class="visually-hidden">Đã xong</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            @if (topics.Count > 0)
            {
                <div class="topic-chips mt-3" role="group" aria-label="Lọc theo chủ đề">
                    <button type="button" class="filter-chip topic-chip active" data-topic-filter="all">Tất cả chủ đề</button>
                    @foreach (var topic in topics)
                    {
                        <button type="button"
                                class="filter-chip topic-chip"
                                data-topic-filter="@topic.ToLowerInvariant()">@topic</button>
                    }
                </div>
            }
        </div>

        @if (items.Count == 0)
        {
            <div class="text-center py-5">
                <img class="tct-mascot"
                     src="~/brand/mascot/poses/tico-mascot-welcome-color.png"
                     asp-append-version="true"
                     alt=""
                     width="160"
                     height="160"
                     decoding="async"
                     aria-hidden="true" />
                <h2 class="h4 mt-4 text-muted">Chưa có bài đọc nào được xuất bản.</h2>
            </div>
        }
        else
        {
            <div class="reading-card-grid" id="readingGrid">
                @foreach (var item in items.OrderBy(x => x.Level).ThenBy(x => x.Title))
                {
                    <partial name="_ReadingLessonCard" model="item" />
                }
            </div>

            <div id="noResults" class="text-center py-5 d-none">
                <i class="fa-solid fa-magnifying-glass display-4 text-muted opacity-25" aria-hidden="true"></i>
                <h2 class="h4 mt-4 text-muted">Không tìm thấy bài đọc phù hợp.</h2>
                <button type="button" class="btn btn-link" onclick="resetFilters()">Xóa bộ lọc</button>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/Reading.js" asp-append-version="true"></script>
}
