@model TCTEnglish.ViewModels.WritingIndexViewModel
@{
    ViewData["Title"] = "Kỹ năng Viết";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/writing-index.css" asp-append-version="true" />
}

<div class="tct-theme writing-index-page">
    <div class="writing-index-shell">

        @* ── Header ──────────────────────────────────────────── *@
        <header class="writing-header">
            <div class="writing-header-badge">
                <i class="fa-solid fa-pen-fancy me-1" aria-hidden="true"></i> Writing Mastery
            </div>
            <div class="writing-header-hero-row d-flex align-items-start gap-3 mt-2">
                <div class="writing-header-icon-clay" aria-hidden="true">
                    <i class="fa-solid fa-pen-nib"></i>
                </div>
                <div>
                    <h1 class="writing-header-title">Kỹ năng Viết</h1>
                    <p class="writing-header-subtitle">
                        <i class="fa-solid fa-compass-drafting me-1 text-primary opacity-75" aria-hidden="true"></i>
                        Hoàn thiện khả năng diễn đạt ý tưởng qua văn bản với các bài tập chuyên sâu từ email công việc đến báo cáo phân tích.
                    </p>
                </div>
            </div>
        </header>

        @* ── Bento Top Grid (Overview + Highlights) ──────────── *@
        <div class="writing-bento-grid">

            @* Overview / Call-to-action Card *@
            <article class="writing-continue-card">
                <div class="writing-continue-body">
                    <span class="writing-continue-badge">
                        <i class="fa-solid fa-pen-nib me-1" aria-hidden="true"></i> Lộ trình bài bản
                    </span>
                    <h2 class="writing-continue-title">Luyện Viết Song Ngữ Theo Ngữ Cảnh</h2>
                    <p class="writing-continue-desc">
                        Rèn luyện phản xạ diễn đạt ý tưởng qua các tình huống thực tế từ email, nhật ký đến bài luận. Hệ thống chấm câu thông minh giúp bạn hoàn thiện từng câu văn.
                    </p>
                    <div class="d-flex align-items-center flex-wrap gap-3">
                        <a asp-controller="Study"
                           asp-action="WritingExercises"
                           asp-route-level="@Model.SelectedLevelKey"
                           class="writing-continue-btn">
                            <i class="fas fa-play" aria-hidden="true"></i>
                            Bắt đầu ngay
                        </a>
                        <span class="text-secondary small">
                            <i class="fa-solid fa-layer-group me-1 text-primary" aria-hidden="true"></i> Cấp độ: <strong>@Model.SelectedLevelTitle</strong>
                        </span>
                    </div>
                </div>
                <div class="writing-continue-img-wrap" aria-hidden="true">
                    <img class="writing-continue-img"
                         src="~/images/writing/writing-banner-clay.svg"
                         alt="Bàn làm việc học viết tiếng Anh"
                         width="280"
                         height="175"
                         loading="lazy" />
                </div>
            </article>

            @* Highlights Column *@
            <div class="writing-stats-column">
                <div class="writing-stat-card">
                    <div class="writing-stat-icon writing-stat-icon--words">
                        <i class="fa-solid fa-shapes" aria-hidden="true"></i>
                    </div>
                    <div class="writing-stat-content">
                        <p class="writing-stat-label">Thể loại bài học</p>
                        <p class="writing-stat-value">@Model.ContentTypes.Count Dạng bài</p>
                        <span class="writing-stat-sub">Đa dạng tình huống học tập</span>
                    </div>
                </div>
                <div class="writing-stat-card">
                    <div class="writing-stat-icon writing-stat-icon--streak">
                        <i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i>
                    </div>
                    <div class="writing-stat-content">
                        <p class="writing-stat-label">Đánh giá câu viết</p>
                        <p class="writing-stat-value">Thời gian thực</p>
                        <span class="writing-stat-sub">Gợi ý chỉnh câu tự nhiên</span>
                    </div>
                </div>
            </div>
        </div>

        @* ── Level Selection ──────────────────────────────────── *@
        <section class="writing-section" aria-labelledby="writing-level-heading">
            <div class="writing-section-heading">
                <div class="d-flex align-items-center gap-3 mb-1">
                    <div class="writing-section-icon-clay" aria-hidden="true">
                        <i class="fa-solid fa-layer-group"></i>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <h2 id="writing-level-heading" class="writing-section-title mb-0">Chọn cấp độ của bạn</h2>
                            <span class="badge rounded-pill bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 small">
                                <i class="fa-solid fa-stairs me-1" aria-hidden="true"></i>@Model.Levels.Count cấp độ
                            </span>
                        </div>
                        <p class="writing-section-subtitle d-flex align-items-center gap-2 mb-0 mt-1">
                            <i class="fa-solid fa-circle-check text-success flex-shrink-0" aria-hidden="true"></i>
                            <span data-writing-selected-level-copy>Chế độ @Model.SelectedLevelTitle đã sẵn sàng. Hãy chọn dạng bài để bắt đầu luyện viết.</span>
                        </p>
                    </div>
                </div>
            </div>

            <div class="writing-level-grid" data-writing-level-grid>
                @foreach (var level in Model.Levels)
                {
                    <a class="writing-card-level @(level.IsSelected ? "is-selected" : string.Empty)"
                       asp-controller="Study"
                       asp-action="Writing"
                       asp-route-level="@level.Key"
                       data-writing-level-card
                       data-level-key="@level.Key"
                       data-level-title="@level.Title"
                       aria-current="@(level.IsSelected ? "true" : "false")"
                       style="--writing-accent: @level.AccentColor;">
                        <div class="writing-card-level-top">
                            <div class="writing-card-level-icon" aria-hidden="true">
                                <i class="@level.IconClass"></i>
                            </div>
                            <span class="writing-card-level-tag">@level.Key.ToUpper()</span>
                        </div>
                        <h3 class="writing-card-level-title">@level.Title</h3>
                        <p class="writing-card-level-desc">@level.Description</p>
                        <div class="writing-card-level-meta">
                            <span><i class="far fa-clock me-1"></i>@level.DurationText</span>
                            <span class="writing-card-level-arrow"><i class="fas fa-chevron-right" aria-hidden="true"></i></span>
                        </div>
                    </a>
                }
            </div>
        </section>

        @* ── Content Topics ───────────────────────────────────── *@
        <section class="writing-section" aria-labelledby="writing-content-heading">
            <div class="writing-section-heading">
                <div class="d-flex align-items-center gap-3 mb-1">
                    <div class="writing-section-icon-clay" aria-hidden="true">
                        <i class="fa-solid fa-shapes"></i>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <h2 id="writing-content-heading" class="writing-section-title mb-0">Chủ đề viết phổ biến</h2>
                            <span class="badge rounded-pill bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 small">
                                <i class="fa-solid fa-table-cells-large me-1" aria-hidden="true"></i>@Model.ContentTypes.Count thể loại
                            </span>
                        </div>
                        <p class="writing-section-subtitle d-flex align-items-center gap-2 mb-0 mt-1">
                            <i class="fa-solid fa-compass me-1 text-primary opacity-75" aria-hidden="true"></i>
                            <span>Lựa chọn thể loại bài viết phù hợp với mục tiêu học tập và công việc hàng ngày của bạn.</span>
                        </p>
                    </div>
                </div>
            </div>

            <div class="writing-content-grid">
                @foreach (var contentType in Model.ContentTypes)
                {
                    <a class="writing-card-content"
                       asp-controller="Study"
                       asp-action="WritingExercises"
                       asp-route-level="@Model.SelectedLevelKey"
                       asp-route-contentType="@contentType.Key"
                       data-writing-content-link
                       data-content-type-key="@contentType.Key"
                       style="--writing-accent: @contentType.AccentColor;">
                        <div class="writing-card-content-icon-wrap" aria-hidden="true">
                            <i class="@contentType.IconClass opacity-20" aria-hidden="true"></i>
                            <i class="@contentType.IconClass z-10" aria-hidden="true"></i>
                        </div>
                        <div class="writing-card-content-body">
                            <h3 class="writing-card-content-title">@contentType.Title</h3>
                            <p class="writing-card-content-desc">@contentType.Description</p>
                            <span class="writing-card-content-cta">
                                Xem bài tập <i class="fas fa-arrow-right ms-1" aria-hidden="true"></i>
                            </span>
                        </div>
                    </a>
                }
            </div>
        </section>

    </div>
</div>

@section Scripts {
    <script src="~/js/writing-index.js" asp-append-version="true"></script>
}