@model TCTEnglish.ViewModels.ListeningIndexViewModel
@using TCTEnglish.ViewModels
@*
    Photo hero of /Home/Listening (plan 2026-11-20-listening-catalog-b, 2.2, mockup B1). One card, four states chosen by the
    service (Model.HeroMode): continue, start, review (everything finished) and guest. The lesson thumbnail is a real <img>
    behind a dark scrim; the button is the only action, the card itself is not a link.
*@
@{
    var lesson = Model.HeroLesson;
    var mode = Model.HeroMode;

    // The tab of the first unfinished step that has content (mirrors listening-core.js nextStepHash).
    string NextHash(ListeningLessonCardViewModel c)
    {
        if (c.TranscriptLineCount > 0 && c.TranscriptCompleted != true) return "#transcript";
        if (c.QuizQuestionCount > 0 && c.QuizCompleted != true) return "#quiz";
        if (c.VocabItemCount > 0 && c.VocabReviewed != true) return "#vocab";
        return "#transcript";
    }

    var chip = mode switch { "continue" => "Nghe tiếp", "start" => "Bắt đầu", "review" => "Ôn lại", "guest" => "Nghe thử", _ => string.Empty };
    var practiceHref = lesson == null ? "/Home/Listening" : "/Home/Listening/Practice/" + lesson.Id + (mode == "continue" ? NextHash(lesson) : string.Empty);
    var buttonText = mode switch { "continue" => "Học tiếp", "start" => "Bắt đầu nghe", "guest" => "Nghe thử miễn phí", _ => string.Empty };
    var meta = lesson == null
        ? string.Empty
        : string.Join(" · ", new[] { lesson.Level, lesson.Topic, lesson.Duration }.Where(p => !string.IsNullOrWhiteSpace(p)));
}
@if (lesson != null && mode != "none")
{
    <section class="tl-hero" aria-labelledby="tlHeroTitle" data-hero="@mode">
        <div class="tl-hero__media" aria-hidden="true">
            @if (lesson.ThumbnailSrc != null)
            {
                <img class="tl-thumb" src="@lesson.ThumbnailSrc" alt="" width="640" height="360" decoding="async" />
            }
            else
            {
                <span class="tl-thumb--empty"><i class="fa-solid fa-headphones"></i></span>
            }
        </div>
        <span class="tl-hero__scrim" aria-hidden="true"></span>
        <span class="tl-hero__play" aria-hidden="true"><i class="fa-solid fa-play"></i></span>
        <div class="tl-hero__body">
            <span class="tl-hero__chip">@chip</span>
            @if (mode == "review")
            {
                <h2 id="tlHeroTitle" class="tl-hero__title tct-clamp-2 tct-break">@Model.HeroHint</h2>
                <p class="tl-hero__meta tct-clamp-2 tct-break">Bài gần nhất: @lesson.Title</p>
                <div class="tl-hero__actions">
                    <a class="btn btn-primary" href="/Home/Listening?status=done" data-tl-hero-done><i class="fa-solid fa-rotate-right" aria-hidden="true"></i> Ôn lại bài đã xong</a>
                </div>
            }
            else
            {
                <h2 id="tlHeroTitle" class="tl-hero__title tct-clamp-2 tct-break">@lesson.Title</h2>
                <p class="tl-hero__meta">@meta</p>
                <div class="tl-hero__actions">
                    <a class="btn btn-primary" href="@practiceHref"><i class="fa-solid fa-play" aria-hidden="true"></i> @buttonText</a>
                    @if (mode == "guest")
                    {
                        <a class="tl-hero__hint tl-hero__hint--link" href="/Account/Login?returnUrl=%2FHome%2FListening">@Model.HeroHint</a>
                    }
                    else if (!string.IsNullOrEmpty(Model.HeroHint))
                    {
                        <p class="tl-hero__hint">@Model.HeroHint</p>
                    }
                </div>
            }
        </div>
    </section>
}
