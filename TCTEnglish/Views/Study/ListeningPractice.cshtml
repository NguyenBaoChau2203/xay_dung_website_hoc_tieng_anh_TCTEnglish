@using System.Globalization
@using System.Text.Json
@using TCTEnglish.ViewModels
@model TCTEnglish.ViewModels.ListeningPracticeViewModel
@{
    ViewData["Title"] = "Luyện nghe — " + Model.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";

    // CEFR level: hue and label (text always accompanies the colour).
    var levelInfo = Model.Level switch
    {
        "A1" => (Label: "A1 · Sơ cấp", Hue: "success"),
        "A2" => (Label: "A2 · Cơ bản", Hue: "info"),
        "B1" => (Label: "B1 · Trung cấp", Hue: "primary"),
        "B2" => (Label: "B2 · Trung cao cấp", Hue: "warning"),
        "C1" => (Label: "C1 · Nâng cao", Hue: "danger"),
        "C2" => (Label: "C2 · Thành thạo", Hue: "accent"),
        _ => (Label: Model.Level, Hue: "primary")
    };

    var videoId = Model.SafeYoutubeId;
    var audioUrl = Model.SafeAudioUrl;
    bool hasVideo = videoId != null;
    bool hasAudio = !hasVideo && audioUrl != null;

    int transcriptCount = Model.TranscriptLines.Count;
    int quizCount = Model.QuizQuestions.Count;
    int vocabCount = Model.VocabItems.Count;
    bool hasTimedLines = Model.TranscriptLines.Any(l => l.StartTime.HasValue);
    bool anyTranslation = Model.TranscriptLines.Any(l => !string.IsNullOrWhiteSpace(l.VietnameseMeaning));
    bool allTranslated = transcriptCount > 0 && Model.TranscriptLines.All(l => !string.IsNullOrWhiteSpace(l.VietnameseMeaning));

    // Required steps, in page order (mirrors ListeningService.IsLessonComplete).
    var steps = new List<(string Key, string Label, string Tab, bool Done)>();
    if (transcriptCount > 0) { steps.Add(("transcript", "Nghe và đọc lời thoại", "transcript", Model.TranscriptCompleted)); }
    if (vocabCount > 0) { steps.Add(("vocab", "Học từ vựng", "vocab", Model.VocabReviewed)); }
    if (quizCount > 0) { steps.Add(("quiz", "Làm quiz", "quiz", Model.QuizCompleted)); }
    bool allDone = Model.IsCompleted;

    var header = new PageHeaderViewModel
    {
        Title = Model.Title,
        Breadcrumbs = new[] { new PageBreadcrumbItem("Luyện nghe", "/Home/Listening"), new PageBreadcrumbItem(Model.Title) }
    };

    string Clock(double? seconds)
    {
        var total = (int)Math.Max(0, Math.Floor(seconds ?? 0));
        var h = total / 3600; var m = total % 3600 / 60; var s = total % 60;
        return h > 0 ? $"{h}:{m:00}:{s:00}" : $"{m}:{s:00}";
    }

    string Num(double value) => value.ToString("0.##", CultureInfo.InvariantCulture);

    bool SafeImage(string? url) => !string.IsNullOrWhiteSpace(url)
        && (url.StartsWith("https://", StringComparison.OrdinalIgnoreCase) || (url.StartsWith("/", StringComparison.Ordinal) && !url.StartsWith("//", StringComparison.Ordinal)));

    // Second distinct speaker gets the info hue.
    var speakerOrder = Model.TranscriptLines.Select(l => l.Speaker).Distinct().ToList();

    var config = new
    {
        lessonId = Model.LessonId,
        youtubeId = videoId,
        audioUrl = hasAudio ? audioUrl : null,
        isAuthenticated = Model.IsAuthenticated,
        canUseSpeed = Model.CanUseSpeed,
        canTranslate = Model.CanTranslate,
        canUseAi = Model.CanUseAi,
        steps = new { transcript = transcriptCount, quiz = quizCount, vocab = vocabCount },
        progress = new
        {
            transcriptCompleted = Model.TranscriptCompleted,
            quizCompleted = Model.QuizCompleted,
            quizScore = Model.QuizScore,
            vocabReviewed = Model.VocabReviewed,
            isCompleted = Model.IsCompleted
        },
        lines = Model.TranscriptLines.Select((l, i) => new
        {
            id = l.Id,
            order = i,
            speaker = l.Speaker,
            text = l.Text,
            vi = l.VietnameseMeaning,
            start = l.StartTime,
            end = l.EndTime
        }),
        urls = new
        {
            evaluate = "/Home/Listening/EvaluateQuiz",
            save = $"/Home/Listening/SaveProgress/{Model.LessonId}",
            translate = $"/Home/Listening/Translate/{Model.LessonId}",
            generateQuiz = "/Home/Listening/My/GenerateQuiz",
            index = "/Home/Listening",
            premium = "/Account/Premium"
        }
    };
    var configJson = JsonSerializer.Serialize(config, new JsonSerializerOptions(JsonSerializerDefaults.Web));

    var noAudio = new StateMessageViewModel { Kind = StateMessageKind.Empty, Title = "Bài nghe chưa có âm thanh." };
    var noTranscript = new StateMessageViewModel { Kind = StateMessageKind.Empty, Title = "Bài nghe chưa có lời thoại." };
    var noQuiz = new StateMessageViewModel { Kind = StateMessageKind.Empty, Title = "Bài nghe chưa có quiz." };
}

@section Styles {
    <link rel="stylesheet" href="~/css/study-kit.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/listening.css" asp-append-version="true" />
}

<div class="tct-theme tct-page tl-page tl-page--practice tl-hue-@levelInfo.Hue">
    @Html.AntiForgeryToken()
    <partial name="~/Views/Shared/_PageHeader.cshtml" model="header" />

    <p class="tl-meta">
        <span class="tct-badge tct-badge--@levelInfo.Hue">@levelInfo.Label</span>
        <span><i class="fa-solid fa-tag" aria-hidden="true"></i> @Model.Topic</span>
        @if (!string.IsNullOrWhiteSpace(Model.Duration))
        {
            <span><i class="fa-regular fa-clock" aria-hidden="true"></i> @Model.Duration</span>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Speaker1Name))
        {
            <span><i class="fa-solid fa-user" aria-hidden="true"></i> @Model.Speaker1Name@(string.IsNullOrWhiteSpace(Model.Speaker1Country) ? "" : $" ({Model.Speaker1Country})")</span>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Speaker2Name))
        {
            <span><i class="fa-solid fa-user" aria-hidden="true"></i> @Model.Speaker2Name@(string.IsNullOrWhiteSpace(Model.Speaker2Country) ? "" : $" ({Model.Speaker2Country})")</span>
        }
    </p>

    @if (!Model.IsAuthenticated)
    {
        <div class="tl-guest k-panel k-panel--quiet" role="note">
            <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
            <p class="tl-guest__text">Bạn đang học ở chế độ khách. Đăng nhập để lưu tiến độ.</p>
            <a class="btn btn-primary btn-sm" href="/Account/Login">Đăng nhập</a>
        </div>
    }

    <div class="tl-practice">
        <aside class="tl-stage" aria-label="Trình phát và tiến độ">
            <div class="tl-player k-panel">
                @if (hasVideo)
                {
                    <div class="tl-video">
                        <iframe id="tlYoutube" title="@Model.Title"
                                src="https://www.youtube.com/embed/@videoId?enablejsapi=1&amp;rel=0&amp;modestbranding=1"
                                loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                    </div>
                    <p class="tl-player__notice" id="tlPlayerNotice" role="status" hidden>Không tải được trình phát YouTube. Bạn vẫn có thể đọc lời thoại và làm bài.</p>
                }
                else if (hasAudio)
                {
                    <div class="tl-audio">
                        <span class="tl-audio__art k-art-box" aria-hidden="true"><i class="fa-solid fa-headphones"></i></span>
                        <audio id="tlAudio" controls preload="metadata" src="@audioUrl"></audio>
                    </div>
                }
                else
                {
                    <partial name="~/Views/Shared/_StateMessage.cshtml" model="noAudio" />
                }

                <div class="tl-controls" role="toolbar" aria-label="Điều khiển phát">
                    <button type="button" class="btn k-btn--icon-surface tl-controls__btn" id="tlBack" aria-label="Lùi 5 giây"><i class="fa-solid fa-rotate-left" aria-hidden="true"></i></button>
                    <button type="button" class="btn btn-primary tl-controls__play" id="tlPlay" aria-label="Phát"><i class="fa-solid fa-play" aria-hidden="true"></i></button>
                    <button type="button" class="btn k-btn--icon-surface tl-controls__btn" id="tlForward" aria-label="Tới 5 giây"><i class="fa-solid fa-rotate-right" aria-hidden="true"></i></button>
                    <button type="button" class="btn btn-outline-primary btn-sm tl-toggle" id="tlLoop" aria-pressed="false"><i class="fa-solid fa-repeat" aria-hidden="true"></i> Lặp câu</button>
                </div>
                <div class="tl-speed">
                    @if (Model.CanUseSpeed)
                    {
                        <div class="k-seg" role="radiogroup" aria-label="Tốc độ phát">
                            @foreach (var rate in new[] { "0.5", "0.75", "1", "1.25", "1.5" })
                            {
                                <input type="radio" class="btn-check" name="tlSpeed" id="tlSpeed-@rate" value="@rate" checked="@(rate == "1" ? "checked" : null)" />
                                <label class="k-seg__item" for="tlSpeed-@rate">@(rate)×</label>
                            }
                        </div>
                    }
                    else
                    {
                        <span class="tl-speed__fixed">Tốc độ 1×</span>
                        <a class="tl-speed__unlock" href="/Account/Premium"><i class="fa-solid fa-lock" aria-hidden="true"></i> Mở khóa tốc độ với Premium</a>
                    }
                </div>
            </div>

            <div class="tl-steps k-panel" aria-label="Tiến độ bài nghe" role="group">
                <h2 class="tl-steps__title">Tiến độ bài nghe</h2>
                @if (steps.Count > 0)
                {
                    <ol class="tl-steps__list">
                        @foreach (var step in steps)
                        {
                            <li class="tl-step" data-step="@step.Key" data-done="@(step.Done ? "true" : "false")">
                                <button type="button" class="tl-step__btn" data-tl-goto="@step.Tab">
                                    <i class="@(step.Done ? "fa-solid fa-circle-check" : "fa-regular fa-circle") tl-step__icon" aria-hidden="true"></i>
                                    <span class="tl-step__label">@step.Label</span>
                                    <span class="visually-hidden tl-step__state">@(step.Done ? "đã xong" : "chưa xong")</span>
                                </button>
                            </li>
                        }
                    </ol>
                }
                <div class="tl-done k-soft tl-hue-success" id="tlDone" hidden="@(allDone ? null : "hidden")">
                    <i class="fa-solid fa-trophy" aria-hidden="true"></i>
                    <span>Bạn đã hoàn thành bài nghe này!</span>
                    <a href="/Home/Listening">Bài nghe khác</a>
                </div>
            </div>

            <p class="tl-keys" aria-hidden="true">
                <span><kbd class="k-kbd">Space</kbd> phát / dừng</span>
                <span><kbd class="k-kbd">←</kbd> <kbd class="k-kbd">→</kbd> câu trước / sau</span>
                <span><kbd class="k-kbd">R</kbd> nghe lại câu</span>
                <span><kbd class="k-kbd">L</kbd> lặp câu</span>
            </p>
        </aside>

        <section class="tl-work" aria-label="Nội dung bài nghe">
            <div class="tl-tabs k-seg" role="tablist" aria-label="Các phần của bài nghe">
                <button type="button" role="tab" class="k-seg__item" id="tlTab-transcript" aria-controls="tlPanel-transcript" aria-selected="true" data-tl-tab="transcript">
                    Lời thoại <span class="k-seg__count">@transcriptCount</span>
                    @if (Model.TranscriptCompleted) { <i class="fa-solid fa-circle-check tl-tab__done" aria-hidden="true"></i><span class="visually-hidden">đã xong</span> }
                </button>
                @if (vocabCount > 0)
                {
                    <button type="button" role="tab" class="k-seg__item" id="tlTab-vocab" aria-controls="tlPanel-vocab" aria-selected="false" tabindex="-1" data-tl-tab="vocab">
                        Từ vựng <span class="k-seg__count">@vocabCount</span>
                        @if (Model.VocabReviewed) { <i class="fa-solid fa-circle-check tl-tab__done" aria-hidden="true"></i><span class="visually-hidden">đã xong</span> }
                    </button>
                }
                <button type="button" role="tab" class="k-seg__item" id="tlTab-quiz" aria-controls="tlPanel-quiz" aria-selected="false" tabindex="-1" data-tl-tab="quiz">
                    Quiz <span class="k-seg__count">@quizCount</span>
                    @if (Model.QuizCompleted) { <i class="fa-solid fa-circle-check tl-tab__done" aria-hidden="true"></i><span class="visually-hidden">đã xong</span> }
                </button>
            </div>

            @* ───────────── Lời thoại ───────────── *@
            <div role="tabpanel" id="tlPanel-transcript" class="tl-panel" aria-labelledby="tlTab-transcript">
                @if (transcriptCount == 0)
                {
                    <partial name="~/Views/Shared/_StateMessage.cshtml" model="noTranscript" />
                }
                else
                {
                    <div class="k-seg tl-modes" role="radiogroup" aria-label="Chế độ luyện lời thoại">
                        <input type="radio" class="btn-check" name="tlMode" id="tlMode-normal" value="normal" checked />
                        <label class="k-seg__item" for="tlMode-normal"><i class="fa-solid fa-book-open" aria-hidden="true"></i> Nghe thường</label>
                        <input type="radio" class="btn-check" name="tlMode" id="tlMode-dictation" value="dictation" />
                        <label class="k-seg__item" for="tlMode-dictation"><i class="fa-solid fa-pen" aria-hidden="true"></i> Chính tả</label>
                        <input type="radio" class="btn-check" name="tlMode" id="tlMode-fill" value="fill" />
                        <label class="k-seg__item" for="tlMode-fill"><i class="fa-solid fa-spell-check" aria-hidden="true"></i> Điền từ</label>
                    </div>

                    <div id="tlModePanel-normal" class="tl-mode">
                        <div class="tl-toolbar-row">
                            <button type="button" class="btn btn-outline-primary btn-sm tl-toggle" id="tlToggleVi" aria-pressed="false" disabled="@(anyTranslation ? null : "disabled")">Hiện bản dịch</button>
                            <button type="button" class="btn btn-outline-primary btn-sm tl-toggle" id="tlToggleHide" aria-pressed="false">Ẩn lời thoại</button>
                            <button type="button" class="btn btn-outline-primary btn-sm tl-toggle" id="tlToggleScroll" aria-pressed="true">Tự cuộn theo âm thanh</button>
                            @if (Model.CanTranslate && !allTranslated)
                            {
                                <button type="button" class="btn btn-outline-primary btn-sm" id="tlTranslate"><i class="fa-solid fa-language" aria-hidden="true"></i> Dịch bằng AI</button>
                            }
                        </div>
                        @if (!anyTranslation)
                        {
                            <p class="tl-hint" id="tlViHint">Chưa có bản dịch cho bài này.</p>
                        }
                        <div class="tl-lines-wrap k-panel k-panel--quiet" id="tlLinesWrap" role="region" aria-label="Danh sách lời thoại" tabindex="0">
                            <ol class="tl-lines" id="tlLines">
                                @for (var i = 0; i < Model.TranscriptLines.Count; i++)
                                {
                                    var line = Model.TranscriptLines[i];
                                    var timed = line.StartTime.HasValue;
                                    var end = line.EndTime ?? (line.StartTime.GetValueOrDefault() + 5);
                                    var second = speakerOrder.IndexOf(line.Speaker) > 0;
                                    <li class="tl-line" data-i="@i" data-start="@(timed ? Num(line.StartTime!.Value) : null)" data-end="@(timed ? Num(end) : null)">
                                        <span class="tl-line__speaker tct-badge @(second ? "tct-badge--info" : "tct-badge--primary")">@line.Speaker</span>
                                        <div class="tl-line__text">
                                            @if (timed)
                                            {
                                                <button type="button" class="tl-line__seek" aria-label="Nghe từ câu @(i + 1)"><span class="tl-line__en" lang="en">@line.Text</span></button>
                                            }
                                            else
                                            {
                                                <span class="tl-line__en" lang="en">@line.Text</span>
                                            }
                                            <button type="button" class="tl-line__reveal btn btn-link btn-sm" hidden>Bấm để hiện</button>
                                            @if (!string.IsNullOrWhiteSpace(line.VietnameseMeaning))
                                            {
                                                <span class="tl-line__vi" hidden>@line.VietnameseMeaning</span>
                                            }
                                        </div>
                                        @if (timed)
                                        {
                                            <span class="tl-line__time">@Clock(line.StartTime)</span>
                                        }
                                    </li>
                                }
                            </ol>
                        </div>
                        <div class="tl-footer-row">
                            <button type="button" class="btn btn-primary" id="tlMarkDone" disabled="@(Model.TranscriptCompleted ? "disabled" : null)">
                                @if (Model.TranscriptCompleted)
                                {
                                    <i class="fa-solid fa-circle-check" aria-hidden="true"></i> <span>Đã nghe xong lời thoại</span>
                                }
                                else
                                {
                                    <i class="fa-solid fa-check" aria-hidden="true"></i> <span>Đánh dấu đã nghe xong</span>
                                }
                            </button>
                        </div>
                    </div>

                    <div id="tlModePanel-dictation" class="tl-mode" hidden></div>
                    <div id="tlModePanel-fill" class="tl-mode" hidden></div>
                }
            </div>

            @* ───────────── Từ vựng ───────────── *@
            @if (vocabCount > 0)
            {
                <div role="tabpanel" id="tlPanel-vocab" class="tl-panel" aria-labelledby="tlTab-vocab" hidden>
                    <ul class="tl-vocab">
                        @foreach (var item in Model.VocabItems)
                        {
                            <li class="tl-vocab__item k-card">
                                @if (SafeImage(item.ImageUrl))
                                {
                                    <div class="tl-vocab__image k-art-box"><img class="tl-thumb" src="@item.ImageUrl" alt="" width="320" height="180" loading="lazy" decoding="async" /></div>
                                }
                                <div class="tl-vocab__body">
                                    <div class="tl-vocab__head">
                                        <span class="tl-vocab__word" lang="en">@item.Word</span>
                                        <button type="button" class="btn tct-btn-icon tl-vocab__speak" data-tl-speak="@item.Word" aria-label="Phát âm @item.Word" hidden><i class="fa-solid fa-volume-high" aria-hidden="true"></i></button>
                                    </div>
                                    <p class="tl-vocab__def">@item.Definition</p>
                                    @if (!string.IsNullOrWhiteSpace(item.ExampleSentence))
                                    {
                                        <p class="tl-vocab__example" lang="en">@item.ExampleSentence</p>
                                    }
                                </div>
                            </li>
                        }
                    </ul>
                    <div class="tl-footer-row">
                        <button type="button" class="btn btn-primary" id="tlVocabDone" disabled="@(Model.VocabReviewed ? "disabled" : null)">
                            @if (Model.VocabReviewed)
                            {
                                <i class="fa-solid fa-circle-check" aria-hidden="true"></i> <span>Đã học xong từ vựng</span>
                            }
                            else
                            {
                                <i class="fa-solid fa-check" aria-hidden="true"></i> <span>Đã học xong từ vựng</span>
                            }
                        </button>
                    </div>
                </div>
            }

            @* ───────────── Quiz ───────────── *@
            <div role="tabpanel" id="tlPanel-quiz" class="tl-panel" aria-labelledby="tlTab-quiz" hidden>
                @if (quizCount == 0)
                {
                    <partial name="~/Views/Shared/_StateMessage.cshtml" model="noQuiz" />
                    @if (Model.CanUseAi && transcriptCount > 0)
                    {
                        <div class="tl-empty-actions"><button type="button" class="btn btn-primary" id="tlGenerateQuiz"><i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i> Tạo quiz bằng AI</button></div>
                    }
                }
                else
                {
                    <div class="tl-result k-panel" id="tlQuizResult" tabindex="-1" hidden></div>
                    <form id="tlQuizForm" novalidate>
                        <div class="tl-quiz">
                            @for (var qi = 0; qi < Model.QuizQuestions.Count; qi++)
                            {
                                var question = Model.QuizQuestions[qi];
                                var options = new[] { ("A", question.OptionA), ("B", question.OptionB), ("C", question.OptionC), ("D", question.OptionD) }
                                    .Where(o => !string.IsNullOrWhiteSpace(o.Item2)).ToList();
                                <fieldset class="tl-q k-panel" data-qid="@question.Id">
                                    <legend class="tl-q__legend">Câu @(qi + 1). @question.QuestionText</legend>
                                    <div class="tl-q__options">
                                        @foreach (var (key, text) in options)
                                        {
                                            <label class="tl-option" data-key="@key">
                                                <input type="radio" class="tl-option__input" name="q@(question.Id)" value="@key" />
                                                <span class="tl-option__key" aria-hidden="true">@key</span>
                                                <span class="tl-option__text" lang="en">@text</span>
                                                <span class="tl-option__mark" aria-hidden="true"></span>
                                            </label>
                                        }
                                    </div>
                                    <p class="tl-q__missing" hidden><i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i> Chưa chọn đáp án</p>
                                    <p class="tl-q__explain" hidden></p>
                                </fieldset>
                            }
                        </div>
                        @if (Model.IsAuthenticated)
                        {
                            <div class="tl-quiz__bar k-panel">
                                <span id="tlQuizCount" aria-live="polite">Đã chọn 0/@quizCount</span>
                                <button type="submit" class="btn btn-primary" id="tlQuizSubmit"><i class="fa-solid fa-paper-plane" aria-hidden="true"></i> Nộp bài</button>
                            </div>
                        }
                        else
                        {
                            <div class="tl-guest k-panel k-panel--quiet" role="note">
                                <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
                                <p class="tl-guest__text">Đăng nhập để làm quiz và lưu điểm.</p>
                                <a class="btn btn-primary btn-sm" href="/Account/Login">Đăng nhập</a>
                            </div>
                        }
                    </form>
                    <p class="visually-hidden" id="tlQuizLive" role="status" aria-live="polite"></p>
                }
            </div>
        </section>
    </div>

    <div id="tsToastHost" class="toast-container ts-toast-host" aria-live="polite"></div>
</div>

@section Scripts {
    <script src="~/js/time-tracker.js" data-feature="Listening" defer></script>
    <script type="application/json" id="tlConfig">@Html.Raw(configJson)</script>
    <script src="~/js/personal-sets-common.js" asp-append-version="true"></script>
    <script src="~/js/listening-core.js" asp-append-version="true"></script>
    <script src="~/js/listening-practice.js" asp-append-version="true"></script>
}
