@model TCTEnglish.ViewModels.ListeningLessonCardViewModel
@*
    One public lesson card on /Home/Listening (plan 5.1, mockup F1). The whole card is one stretched link; the play overlay,
    duration, status chip and progress bar are decorative extras inside it. ViewData["Auth"] = true shows status and progress.
    The data-* attributes on the <li> are read by listening-index.js and by the render tests.
*@
@{
    var signedIn = ViewData["Auth"] is true;
    var thumb = Model.ThumbnailSrc;
}
<li class="tl-grid__item" data-id="@Model.Id" data-title="@Model.Title" data-topic="@Model.Topic" data-level="@Model.Level" data-status="@Model.Status">
    <article class="tl-card k-card tct-card--interactive">
        <a class="tl-card__link stretched-link" href="/Home/Listening/Practice/@Model.Id" aria-label="Mở bài nghe @Model.Title"></a>
        <div class="tl-card__thumb k-art-box">
            @if (thumb != null)
            {
                <img class="tl-thumb" src="@thumb" alt="" width="320" height="180" loading="lazy" decoding="async" />
            }
            else
            {
                <span class="tl-thumb--empty" aria-hidden="true"><i class="fa-solid fa-headphones"></i></span>
            }
            <span class="tl-play" aria-hidden="true"><i class="fa-solid fa-play"></i></span>
            @if (!string.IsNullOrWhiteSpace(Model.Duration))
            {
                <span class="tl-card__duration"><i class="fa-regular fa-clock" aria-hidden="true"></i> @Model.Duration</span>
            }
        </div>
        <div class="tl-card__body">
            <h3 class="tl-card__title tct-clamp-2 tct-break">@Model.Title</h3>
            <p class="tl-card__meta">
                <span class="tct-badge tct-badge--primary">@Model.Level</span>
                <span class="tl-card__topic tct-break">@Model.Topic</span>
                @if (signedIn && Model.Status == "done")
                {
                    <span class="tct-badge tct-badge--success tl-card__status"><i class="fa-solid fa-check" aria-hidden="true"></i> Đã xong</span>
                }
                else if (signedIn && Model.Status == "progress")
                {
                    <span class="tct-badge tct-badge--warning tl-card__status">Đang học</span>
                }
            </p>
            @if (signedIn && Model.Status == "progress" && Model.StepsTotal > 0)
            {
                <progress class="tl-bar tl-card__bar" max="@Model.StepsTotal" value="@Model.StepsDone" aria-label="@Model.StepsDone/@Model.StepsTotal phần đã xong"></progress>
            }
        </div>
    </article>
</li>
