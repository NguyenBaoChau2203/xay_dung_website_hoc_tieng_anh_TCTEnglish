@model TCTEnglish.ViewModels.ReadingStudyViewModel
@{ ViewData["Title"] = Model.Title; }

<link rel="stylesheet" href="~/css/reading-study.css" asp-append-version="true" />

<div class="tct-theme reading-study-page">
<div class="reading-toolbar shadow-sm" data-passage-id="@Model.Id" data-attempt-id="@Model.AttemptId" data-mode="@Model.Mode" data-time-limit="@Model.TimeLimitSeconds">
    <div class="container-fluid d-flex align-items-center justify-content-between flex-wrap gap-2">
        <a asp-controller="Study" asp-action="Reading" class="btn btn-light border btn-sm hover-elevate">
            <i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Quay lại
        </a>
        <div class="d-flex align-items-center gap-3">
            <span id="readingTimer" class="reading-timer text-danger d-none">00:00</span>
            <div class="btn-group btn-group-sm" role="group" aria-label="Font size">
                <button type="button" class="btn btn-outline-secondary" id="fontSmaller" aria-label="Giảm cỡ chữ">A-</button>
                <button type="button" class="btn btn-outline-secondary" id="fontLarger" aria-label="Tăng cỡ chữ">A+</button>
            </div>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <button class="btn btn-primary btn-sm px-4 d-flex align-items-center gap-2" id="toggleTranslation">
                <i class="fa-solid fa-language" aria-hidden="true"></i>
                <span>Dịch toàn bài</span>
            </button>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <button class="btn btn-outline-success btn-sm px-4 d-flex align-items-center gap-2" id="btnMyTranslation">
                    <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
                    <span>Bản dịch của tôi</span>
                </button>
            }
        </div>
    </div>
</div>

<div class="container-fluid py-4">
    <div class="reading-mobile-tabs">
        <button type="button" class="btn btn-outline-primary flex-fill active" data-study-tab="passage">Passage</button>
        <button type="button" class="btn btn-outline-primary flex-fill" data-study-tab="questions">Questions</button>
    </div>
    <div class="reading-study-shell" id="readingStudyShell">
    <div class="reading-grid tab-passage" id="readingStudyGrid">
        
        <div class="passage-container">
            <div class="card border-0 shadow-sm p-4">
                <h2 class="passage-title mb-4" id="passageTitle">@Model.Title</h2>

                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <div class="text-center mb-4">
                        <img src="@Model.ImageUrl" class="img-fluid rounded shadow-sm reading-study-hero-image" alt="" />
                    </div>
                }

                <div class="passage-content" id="passageContent">
                    @{
                        var structured = Model.Paragraphs?.OrderBy(p => p.Order).ToList() ?? new List<TCTEnglish.ViewModels.ReadingParagraphViewModel>();
                        if (structured.Count == 0 && !string.IsNullOrWhiteSpace(Model.Content))
                        {
                            var parts = Model.Content.Replace("\r\n", "\n").Split("\n\n", StringSplitOptions.RemoveEmptyEntries);
                            for (var i = 0; i < parts.Length; i++)
                            {
                                structured.Add(new TCTEnglish.ViewModels.ReadingParagraphViewModel
                                {
                                    Order = i + 1,
                                    Content = parts[i].Trim()
                                });
                            }
                        }
                    }
                    @foreach (var p in structured)
                    {
                        <div class="paragraph-block mb-3" data-paragraph-no="@p.Order">
                            <div class="small text-secondary mb-1">Paragraph @p.Order</div>
                            <p class="passage-text mb-1">@p.Content</p>
                            <p class="translation d-none text-muted"></p>
                        </div>
                    }
                </div>

                @if (Model.Vocabulary != null && Model.Vocabulary.Count > 0)
                {
                    <div class="mt-4 pt-3 border-top" id="keyVocabularyPanel">
                        <h5 class="fw-bold mb-3">Từ vựng trọng điểm</h5>
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                <tr>
                                    <th>Word</th>
                                    <th>IPA</th>
                                    <th>Loại</th>
                                    <th>Nghĩa</th>
                                    <th>Ví dụ</th>
                                    <th>Đoạn</th>
                                </tr>
                                </thead>
                                <tbody>
                                @foreach (var v in Model.Vocabulary)
                                {
                                    <tr>
                                        <td class="fw-semibold">@v.Word</td>
                                        <td>@(string.IsNullOrWhiteSpace(v.Ipa) ? "—" : v.Ipa)</td>
                                        <td>@(string.IsNullOrWhiteSpace(v.PartOfSpeech) ? "—" : v.PartOfSpeech)</td>
                                        <td>@(string.IsNullOrWhiteSpace(v.VietnameseMeaning) ? "—" : v.VietnameseMeaning)</td>
                                        <td>@(string.IsNullOrWhiteSpace(v.Example) ? "—" : v.Example)</td>
                                        <td>@(v.ParagraphNo?.ToString() ?? "—")</td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>

            @* ─── Khu vực Bản dịch nổi bật ─── *@
            <div class="card border-0 shadow-sm p-4 mt-4" id="communityTranslationsCard">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h5 class="fw-bold mb-0">
                        <i class="fa-solid fa-star text-warning me-2" aria-hidden="true"></i>Những bản dịch nổi bật
                    </h5>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <button type="button" class="btn btn-sm btn-outline-primary reading-study-icon-btn"
                                id="btnAddTranslation" title="Thêm bản dịch" aria-label="Thêm bản dịch">
                            <i class="fa-solid fa-plus" aria-hidden="true"></i>
                        </button>
                    }
                </div>
                <div id="translationsList">
                    <div class="text-center text-muted py-3">
                        <span class="spinner-border spinner-border-sm"></span> Đang tải...
                    </div>
                </div>
            </div>
        </div>

        <div class="question-container">
            <div class="card border-0 shadow-sm sticky-card">
                <div class="card-header bg-white border-0 pt-4 px-4">
                    <h6 class="fw-bold text-uppercase text-secondary small">Danh sách câu hỏi</h6>
                    <div class="question-nav d-flex flex-wrap gap-2 mt-3" id="questionNav">
                        @for (int i = 0; i < Model.Questions.Count; i++)
                        {
                            <button type="button" class="btn btn-outline-secondary nav-btn"
                                    onclick="showQuestion(@i)" id="nav-btn-@i">
                                @(i + 1)
                            </button>
                        }
                    </div>
                </div>

                <div class="card-body p-4">
                    <div id="quizStatus" class="alert d-none mb-3"></div>

                    <form id="readingForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="passageId" value="@Model.Id" />
                        <input type="hidden" name="attemptId" value="@Model.AttemptId" />

                        <div class="question-display-area">
                            @for (int i = 0; i < Model.Questions.Count; i++)
                            {
                                var q = Model.Questions[i];
                                var qType = string.IsNullOrWhiteSpace(q.QuestionType)
                                    ? TCTEnglish.Models.Reading.ReadingQuestionTypes.MultipleChoice
                                    : q.QuestionType.Trim();
                                var isChoice = qType is TCTEnglish.Models.Reading.ReadingQuestionTypes.MultipleChoice
                                    or TCTEnglish.Models.Reading.ReadingQuestionTypes.TrueFalse;
                                var isText = qType is TCTEnglish.Models.Reading.ReadingQuestionTypes.GapFill
                                    or TCTEnglish.Models.Reading.ReadingQuestionTypes.ShortAnswer;
                                var isMatching = qType == TCTEnglish.Models.Reading.ReadingQuestionTypes.Matching;
                                <div class="question-panel @(i == 0 ? "" : "d-none")"
                                     id="q-panel-@i"
                                     data-q-id="@q.Id"
                                     data-q-type="@qType"
                                     data-q-index="@i"
                                     data-saved-matching="@(q.SavedMatchingJson ?? "")">
                                    <h6 class="mb-3 fw-bold">Câu @(i + 1): @q.QuestionText</h6>
                                    <div class="small text-secondary mb-2">@qType</div>

                                    @if (isChoice)
                                    {
                                        <div class="options-list">
                                            @foreach (var opt in q.Options)
                                            {
                                                var selected = q.SavedSelectedOptionId == opt.Id;
                                                <div class="option-item mb-2">
                                                    <input class="btn-check" type="radio"
                                                           name="answers[@q.Id]" value="@opt.Id"
                                                           id="opt_@opt.Id"
                                                           @(selected ? "checked" : null)
                                                           onchange="markNavDone(@i)">
                                                    <label class="btn btn-outline-light text-start w-100 py-2 px-3 option-label" for="opt_@opt.Id">
                                                        @opt.OptionText
                                                    </label>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else if (isText)
                                    {
                                        <div class="text-answer-wrap">
                                            @if (qType == TCTEnglish.Models.Reading.ReadingQuestionTypes.GapFill)
                                            {
                                                <label class="form-label visually-hidden" for="answer_text_@q.Id">Đáp án điền khuyết</label>
                                                <input type="text"
                                                       class="form-control reading-text-answer"
                                                       id="answer_text_@q.Id"
                                                       name="answerText[@q.Id]"
                                                       value="@(q.SavedAnswerText ?? "")"
                                                       autocomplete="off"
                                                       maxlength="1000"
                                                       data-q-index="@i" />
                                            }
                                            else
                                            {
                                                <label class="form-label visually-hidden" for="answer_text_@q.Id">Câu trả lời ngắn</label>
                                                <textarea class="form-control reading-text-answer"
                                                          id="answer_text_@q.Id"
                                                          name="answerText[@q.Id]"
                                                          rows="3"
                                                          maxlength="1000"
                                                          data-q-index="@i">@(q.SavedAnswerText ?? "")</textarea>
                                            }
                                        </div>
                                    }
                                    else if (isMatching)
                                    {
                                        var ordered = q.Options.ToList();
                                        var left = ordered.Where(o => string.Equals(o.MatchSide, "Left", StringComparison.OrdinalIgnoreCase)).ToList();
                                        var right = ordered.Where(o => string.Equals(o.MatchSide, "Right", StringComparison.OrdinalIgnoreCase)).ToList();
                                        if (left.Count == 0 && right.Count == 0 && ordered.Count > 0)
                                        {
                                            var mid = (ordered.Count + 1) / 2;
                                            left = ordered.Take(mid).ToList();
                                            right = ordered.Skip(mid).ToList();
                                        }
                                        <div class="matching-answer-wrap" data-matching-root="1">
                                            @if (left.Count == 0 || right.Count == 0)
                                            {
                                                <p class="text-muted small mb-0">
                                                    Câu Matching chưa có đủ cặp Left/Right. Admin cần gán MatchKey và MatchSide cho từng lựa chọn.
                                                </p>
                                            }
                                            else
                                            {
                                                <div class="d-flex flex-column gap-2">
                                                    @foreach (var leftOpt in left)
                                                    {
                                                        <div class="matching-row d-flex flex-column flex-sm-row align-items-sm-center gap-2"
                                                             data-left-id="@leftOpt.Id"
                                                             >
                                                            <div class="matching-left flex-fill fw-semibold">@leftOpt.OptionText</div>
                                                            <label class="visually-hidden" for="match_sel_@(q.Id)_@(leftOpt.Id)">Ghép với</label>
                                                            <select class="form-select matching-select"
                                                                    id="match_sel_@(q.Id)_@(leftOpt.Id)"
                                                                    data-q-index="@i">
                                                                <option value="">— Chọn —</option>
                                                                @foreach (var rightOpt in right)
                                                                {
                                                                    <option value="@rightOpt.Id"
                                                                            >
                                                                        @rightOpt.OptionText
                                                                    </option>
                                                                }
                                                            </select>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <p class="text-muted small mb-0">Loại câu hỏi không hỗ trợ trên màn học.</p>
                                    }
                                    <div class="result-feedback mt-3 d-none"></div>
                                </div>
                            }
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                            <div class="btn-group">
                                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="prevQuestion()" id="btnPrev">Trước</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="nextQuestion()" id="btnNext">Sau</button>
                            </div>
                            <button type="submit" id="btnSubmit" class="btn btn-sm btn-success px-4 fw-bold">Nộp bài</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

    </div>
    <partial name="~/Views/Study/_ReadingVocabPanel.cshtml" />
    </div>
</div>

<partial name="~/Views/Study/_ReadingHybridToolbar.cshtml" />

@* ─── Modal AI Feedback ─── *@
<div class="modal fade" id="aiFeedbackModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">
                    <i class="fa-solid fa-robot me-2" aria-hidden="true"></i>Kết quả chấm AI
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="aiScoreDisplay" class="text-center mb-3">
                    <div class="ai-score-circle mx-auto mb-2">
                        <span id="aiScoreValue">--</span>
                    </div>
                    <div id="aiApprovalBadge"></div>
                </div>
                <div id="aiFeedbackText" class="bg-light rounded p-3 mb-3"></div>
                <div id="aiActions" class="d-flex gap-2 justify-content-center"></div>
            </div>
        </div>
    </div>
</div>

<input type="hidden" id="passageId" value="@Model.Id" />
@Html.AntiForgeryToken()

</div>

@section Scripts {
    <script src="~/js/time-tracker.js" data-feature="Reading" defer></script>
    <script src="~/js/reading-study.js" asp-append-version="true"></script>
    <script src="~/js/reading-hybrid-toolbar.js" asp-append-version="true"></script>
    <script src="~/js/reading-translation.js" asp-append-version="true"></script>
}
