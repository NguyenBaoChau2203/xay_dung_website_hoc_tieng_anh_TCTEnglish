@model TCTEnglish.ViewModels.ListeningIndexViewModel
@*
    "Bài nghe từ YouTube" card of /Home/Listening (plan 2026-11-20-listening-catalog-b, 2.2, mockup B1). Premium and Admin get the
    import form (ids kept: tlImport, tlImportUrl, tlImportSubmit, tlImportHint, tlImportError, tlImportStatus), Standard gets an
    upsell, guests a login prompt. listening-index.js reads the form, the done panel and the "Xem tất cả" jump button.
*@
@{
    var signedIn = Model.IsAuthenticated;
}
<section class="tl-yt k-panel" aria-labelledby="tlYtTitle" data-yt="@(Model.CanImport ? "import" : signedIn ? "locked" : "guest")">
    <header class="tl-yt__head">
        <span class="tl-yt__logo" aria-hidden="true"><i class="fa-brands fa-youtube"></i></span>
        <div class="tl-yt__heading">
            <h2 id="tlYtTitle" class="tl-yt__title">Bài nghe từ YouTube</h2>
            <p class="tl-yt__sub">Biến video bạn thích thành bài luyện nghe</p>
        </div>
        <span class="tct-badge tct-badge--primary tl-yt__chip"><i class="fa-solid fa-crown" aria-hidden="true"></i> Premium</span>
    </header>

    @if (Model.CanImport)
    {
        <form id="tlImport" class="tl-yt__form" novalidate>
            <label class="visually-hidden" for="tlImportUrl">Link video YouTube</label>
            <input id="tlImportUrl" name="youtubeUrl" type="url" inputmode="url" class="form-control" required maxlength="300"
                   placeholder="https://youtube.com/watch?v=…" autocomplete="off" aria-describedby="tlImportHint tlImportError" />
            <p class="tl-yt__hint" id="tlImportHint">Chỉ hỗ trợ video tiếng Anh có phụ đề.</p>
            <button type="submit" class="btn btn-primary tl-yt__submit" id="tlImportSubmit"><i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i> Tạo bài nghe</button>
            <p class="tl-yt__error" id="tlImportError" role="alert" hidden></p>
            <div class="tl-yt__status" id="tlImportStatus" role="status" aria-live="polite"></div>
        </form>
        <div class="tl-yt__done" id="tlImportDone" hidden></div>
        <p class="tl-yt__mine">
            Bài của tôi: <strong id="tlMineCount">@Model.MyLessons.Count</strong>
            <span id="tlMineJumpWrap" hidden="@(Model.MyLessons.Count == 0 ? "hidden" : null)">
                <span aria-hidden="true">·</span>
                <button type="button" class="btn btn-link tl-yt__jump" id="tlMineJump">Xem tất cả</button>
            </span>
        </p>
    }
    else if (signedIn)
    {
        <div class="tl-yt__body">
            <p class="tl-yt__text">Dán link YouTube, TCT tạo lời thoại, chép chính tả và quiz cho bạn.</p>
            <a class="btn btn-primary tl-yt__submit" href="/Account/Premium"><i class="fa-solid fa-crown" aria-hidden="true"></i> Mở khóa với Premium</a>
        </div>
    }
    else
    {
        <div class="tl-yt__body">
            <p class="tl-yt__text">Đăng nhập để tạo bài nghe từ video YouTube.</p>
            <a class="btn btn-primary tl-yt__submit" href="/Account/Login?returnUrl=%2FHome%2FListening"><i class="fa-solid fa-right-to-bracket" aria-hidden="true"></i> Đăng nhập</a>
        </div>
    }
</section>
