@model TCTEnglish.Services.Sets.PracticeModes.ModeInfo
@{
    var big = ViewData["Big"] is true;
}
<label class="tct-card tp-mode-card tp-hue-@Model.Hue@(big ? " tp-mode-card--big" : "")" data-tp-card="@Model.Key">
    <input type="radio" name="mode" value="@Model.Key" class="visually-hidden" />
    <span class="tp-mode-card__icon" aria-hidden="true"><i class="@Model.Icon"></i></span>
    <span class="tp-mode-card__text">
        <span class="tp-mode-card__name">@Model.Label</span>
        <span class="tp-mode-card__hint">@Model.Hint</span>
        @if (big)
        {
            <span class="tp-mode-card__badges">
                <span class="tct-badge tp-stat" data-tp-stat="@Model.Key" hidden></span>
                <span class="tct-badge tct-badge--primary tp-suggest" data-tp-suggest="@Model.Key" hidden>Gợi ý cho bạn</span>
            </span>
        }
    </span>
    <span class="tp-mode-card__check" aria-hidden="true"><i class="fa-solid fa-circle-check"></i></span>
</label>
