@model TCTVocabulary.ViewModels.NotificationPageViewModel
@*
    /Notification (plan 5.1). Clay language, day groups, filters, side panel, real links and buttons only.
    - Layout, filters and states are server-rendered, so the page reads and navigates without JavaScript;
      the mark-read actions need notification-page.js and are the only parts that need it.
    - The antiforgery token comes from the shell's notification panel (rendered for every signed-in user);
      the page does not add a second one.
*@
@using TCTEnglish.Models
@using TCTEnglish.Services.Notifications
@{
    ViewData["Title"] = "Thông báo";

    var list = Model.List;
    var unread = list.UnreadCount;
    var isUnreadFilter = Model.Filter == "unread";
    var hasItems = list.Items.Count > 0;

    string FilterOf(bool unreadOnly) => unreadOnly ? "unread" : null!;
    string Href(string? filter, string? category, int? page = null)
        => Url.Action("Index", "Notification", new { page, filter, category })!;

    var categories = new[]
    {
        (Key: "learning", Label: "Học tập", Category: NotificationCategory.Learning),
        (Key: "badge", Label: "Huy hiệu", Category: NotificationCategory.Badge),
        (Key: "payment", Label: "Thanh toán", Category: NotificationCategory.Payment),
        (Key: "system", Label: "Hệ thống", Category: NotificationCategory.System)
    };

    var groups = new[]
    {
        (Key: "today", Label: "Hôm nay"),
        (Key: "yesterday", Label: "Hôm qua"),
        (Key: "earlier", Label: "Trước đó")
    };

    var summary = unread > 0 ? $"Bạn có {unread} thông báo chưa đọc." : "Bạn đã đọc hết thông báo.";
    var unreadBadge = unread > 99 ? "99+" : unread.ToString();
}

@section Styles {
    <link rel="stylesheet" href="~/css/study-kit.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/notification-page.css" asp-append-version="true" />
}

<div class="tct-theme tct-page tn-page" id="tnRoot"
     data-filter="@Model.Filter"
     data-category="@Model.Category"
     data-unread="@unread">

    <header class="tct-page-header">
        <div class="tct-page-header__row">
            <div class="tct-page-header__text">
                <h1 class="tct-page-title">Thông báo</h1>
                <p class="tct-page-desc" id="tnSummary">@summary</p>
            </div>
            <div class="tct-page-header__actions">
                <button type="button" class="btn btn-outline-primary tn-markall" id="tnMarkAll"
                        aria-label="Đánh dấu tất cả đã đọc" @(unread > 0 ? null : "hidden")>
                    <i class="fa-solid fa-check-double me-1" aria-hidden="true"></i><span class="tn-markall__text">Đánh dấu tất cả đã đọc</span>
                </button>
            </div>
        </div>
    </header>

    <nav class="tn-filters" aria-label="Lọc thông báo">
        <ul class="tn-filters__list">
            <li>
                <a class="tn-chip" href="@Href(null, null)"
                   aria-current="@(!isUnreadFilter && Model.Category == null ? "true" : null)">Tất cả</a>
            </li>
            <li>
                <a class="tn-chip" href="@Href("unread", Model.Category)"
                   aria-current="@(isUnreadFilter ? "true" : null)">
                    Chưa đọc
                    <span class="tn-chip__count" data-count="unread" @(Model.Counts.Unread > 0 ? null : "hidden")>@(Model.Counts.Unread > 99 ? "99+" : Model.Counts.Unread.ToString())<span class="visually-hidden"> chưa đọc</span></span>
                </a>
            </li>
            @foreach (var chip in categories)
            {
                var chipUnread = Model.Counts.ByCategory.TryGetValue(chip.Category, out var counted) ? counted.Unread : 0;
                <li>
                    <a class="tn-chip" href="@Href(FilterOf(isUnreadFilter), chip.Key)"
                       aria-current="@(Model.Category == chip.Key ? "true" : null)">
                        @chip.Label
                        <span class="tn-chip__count" data-count="@chip.Key" @(chipUnread > 0 ? null : "hidden")>@(chipUnread > 99 ? "99+" : chipUnread.ToString())<span class="visually-hidden"> chưa đọc</span></span>
                    </a>
                </li>
            }
        </ul>
    </nav>

    @if (TempData["Success"] is string successMsg)
    {
        <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
            <i class="fa-solid fa-circle-check me-2" aria-hidden="true"></i>@successMsg
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    <div class="tn-layout">
        <div class="tn-main">
            <div id="tnLists" @(hasItems ? null : "hidden")>
                @foreach (var group in groups)
                {
                    var inGroup = list.Items.Where(i => i.DayGroup == group.Key).ToList();
                    if (inGroup.Count == 0)
                    {
                        continue;
                    }

                    <section class="tn-group" aria-labelledby="tnGroup-@group.Key">
                        <h2 class="tn-group__title" id="tnGroup-@group.Key">@group.Label</h2>
                        <ul class="tn-list">
                            @foreach (var item in inGroup)
                            {
                                <partial name="_NotificationItem" model="item" />
                            }
                        </ul>
                    </section>
                }

                @if (list.TotalPages > 1)
                {
                    <nav class="tn-pager" aria-label="Phân trang thông báo">
                        <ul class="pagination">
                            <li class="page-item @(list.CurrentPage <= 1 ? "disabled" : "")">
                                @if (list.CurrentPage <= 1)
                                {
                                    <span class="page-link" aria-label="Trang trước" aria-disabled="true"><i class="fa-solid fa-chevron-left" aria-hidden="true"></i></span>
                                }
                                else
                                {
                                    <a class="page-link" aria-label="Trang trước" href="@Href(FilterOf(isUnreadFilter), Model.Category, list.CurrentPage - 1)"><i class="fa-solid fa-chevron-left" aria-hidden="true"></i></a>
                                }
                            </li>
                            @for (var p = Math.Max(1, list.CurrentPage - 2); p <= Math.Min(list.TotalPages, list.CurrentPage + 2); p++)
                            {
                                <li class="page-item @(p == list.CurrentPage ? "active" : "")">
                                    <a class="page-link" href="@Href(FilterOf(isUnreadFilter), Model.Category, p)"
                                       aria-label="Trang @p" aria-current="@(p == list.CurrentPage ? "page" : null)">@p</a>
                                </li>
                            }
                            <li class="page-item @(list.CurrentPage >= list.TotalPages ? "disabled" : "")">
                                @if (list.CurrentPage >= list.TotalPages)
                                {
                                    <span class="page-link" aria-label="Trang sau" aria-disabled="true"><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></span>
                                }
                                else
                                {
                                    <a class="page-link" aria-label="Trang sau" href="@Href(FilterOf(isUnreadFilter), Model.Category, list.CurrentPage + 1)"><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></a>
                                }
                            </li>
                        </ul>
                    </nav>
                }
            </div>

            @* Empty states (plan 5.1). The unread one also exists, hidden, on the "Chưa đọc" filter so that
               "Đánh dấu tất cả đã đọc" can swap the list for it without a reload. *@
            @if (!hasItems && !isUnreadFilter && Model.Category == null)
            {
                <section class="k-panel tn-empty" id="tnEmptyNone">
                    <span class="tn-empty__icon" aria-hidden="true"><i class="fa-solid fa-bell-slash"></i></span>
                    <h2 class="tn-empty__title">Chưa có thông báo nào</h2>
                    <p class="tn-empty__text">Khi bạn học, đạt mục tiêu hay nhận huy hiệu, thông báo sẽ hiện ở đây.</p>
                    <div class="tn-empty__actions">
                        <a class="btn btn-primary" href="@Url.Action("Index", "Home")">Bắt đầu học</a>
                    </div>
                </section>
            }

            @if (isUnreadFilter)
            {
                <section class="k-panel tn-empty" id="tnEmptyUnread" @(hasItems ? "hidden" : null)>
                    <span class="tn-empty__icon" aria-hidden="true"><i class="fa-solid fa-circle-check"></i></span>
                    <h2 class="tn-empty__title" tabindex="-1">Không còn thông báo chưa đọc</h2>
                    <p class="tn-empty__text">Mọi thông báo đều đã được đọc. Hãy học tiếp để giữ chuỗi ngày học.</p>
                    <div class="tn-empty__actions">
                        <a class="btn btn-primary" href="@Url.Action("Index", "Home")">Học tiếp</a>
                        <a class="tn-empty__link" href="@Href(null, null)">Xem tất cả thông báo</a>
                    </div>
                </section>
            }
            else if (!hasItems && Model.Category != null)
            {
                <section class="k-panel tn-empty" id="tnEmptyCategory">
                    <span class="tn-empty__icon" aria-hidden="true"><i class="fa-solid fa-inbox"></i></span>
                    <h2 class="tn-empty__title">Chưa có thông báo nào trong mục này.</h2>
                    <div class="tn-empty__actions">
                        <a class="tn-empty__link" href="@Href(null, null)">Xem tất cả thông báo</a>
                    </div>
                </section>
            }
        </div>

        <partial name="_NotificationSidePanel" model="Model.Side" />
    </div>

    <div class="tn-toast" id="tnToast" role="status" aria-live="polite" aria-atomic="true">
        <span class="tn-toast__icon" aria-hidden="true"><i class="fa-solid fa-circle-check" id="tnToastIcon"></i></span>
        <span id="tnToastText"></span>
    </div>
</div>

@section Scripts {
    <script src="~/js/notification-page.js" asp-append-version="true"></script>
}
