@model TCTVocabulary.ViewModels.SpeakingIndexViewModel
@{
    ViewData["Title"] = "Kỹ năng Nói — TCT English";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var groupByLevel = string.Equals(Context.Request.Query["group"], "level", StringComparison.Ordinal);
    int totalVideos = Model.PublicTotalCount > 0
        ? Model.PublicTotalCount
        : Model.VideosByLevel.Sum(kv => kv.Value.Count);
    var levelMeta = new Dictionary<string, (string Label, string Bg, string Fg, string Accent, string Icon)>
    {
        ["A1"] = ("Sơ cấp",     "#dcfce7", "#166534", "#22c55e", "🌱"),
        ["A2"] = ("Cơ bản",     "#d1fae5", "#065f46", "#10b981", "🌿"),
        ["B1"] = ("Trung cấp",  "#dbeafe", "#1e40af", "#3b82f6", "📘"),
        ["B2"] = ("Khá",        "#fff7ed", "#9a3412", "#f97316", "🔥"),
        ["C1"] = ("Cao cấp",    "#ede9fe", "#5b21b6", "#8b5cf6", "💎"),
        ["C2"] = ("Thành thạo", "#111c2d", "#ffffff", "#263143", "👑"),
    };

    var topicMeta = new Dictionary<string, (string Icon, string Color, string ClassModifier)>(StringComparer.OrdinalIgnoreCase)
    {
        ["all"]                   = ("auto_awesome",      "#4255ff", "all"),
        ["Tất cả chủ đề"]         = ("auto_awesome",      "#4255ff", "all"),
        ["Ăn uống"]               = ("restaurant",        "#ea580c", "dining"),
        ["General"]               = ("public",            "#475569", "general"),
        ["Nội dung chung"]        = ("public",            "#475569", "general"),
        ["Gia đình & đời sống"]   = ("home",              "#2563eb", "family"),
        ["Học tập & công việc"]   = ("work",              "#7c3aed", "work"),
        ["Khoa học & văn hóa"]   = ("science",           "#0891b2", "science"),
        ["Luyện thi tổng hợp"]    = ("assignment",        "#d97706", "exam"),
        ["Mua sắm & tài chính"]   = ("payments",          "#059669", "finance"),
        ["Sức khỏe"]              = ("health_and_safety", "#dc2626", "health"),
        ["Trò chuyện & tình cảm"] = ("forum",             "#db2777", "chat"),
        ["Vui chơi & giải trí"]   = ("sports_esports",    "#8b5cf6", "leisure"),
        ["Xã hội & di chuyển"]    = ("commute",           "#0284c7", "travel"),
    };

    (string Icon, string Color, string ClassModifier) GetTopicMeta(string? topicName)
    {
        if (string.IsNullOrWhiteSpace(topicName)) return ("auto_awesome", "#4255ff", "all");
        if (topicMeta.TryGetValue(topicName, out var meta)) return meta;
        return ("label", "#4255ff", "custom");
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/speaking.css" asp-append-version="true" />
}

@Html.AntiForgeryToken()

<div class="tct-theme tct-page spk-page-wrapper" aria-label="Learn English with Videos">

    @* ── HERO BANNER (Claymorphism Surface & Mascot Illustration) ── *@
    <div class="spk-hero-banner mb-5" aria-label="Giới thiệu Kỹ năng Nói">
        <div class="spk-hero-ambient-blob spk-hero-ambient-blob--1" aria-hidden="true"></div>
        <div class="spk-hero-ambient-blob spk-hero-ambient-blob--2" aria-hidden="true"></div>

        <div class="spk-hero-grid">
            @* Left: Title, Badges, Illustration Showcase & Stats *@
            <div class="spk-hero-content">
                <div class="spk-hero-eyebrow">
                    <span class="material-symbols-outlined" style="font-size:16px;font-variation-settings:'FILL' 1" aria-hidden="true">record_voice_over</span>
                    <span>Kỹ năng Nói &amp; Giao tiếp AI</span>
                    <span class="spk-eyebrow-dot" aria-hidden="true"></span>
                    <span class="spk-eyebrow-badge">Chuẩn CEFR</span>
                </div>

                <h1 class="spk-hero-title">
                    Luyện phát âm &amp;<br>
                    <span class="spk-hero-title-gradient">phản xạ nói chuẩn AI</span>
                </h1>

                <p class="spk-hero-subtitle">
                    Học qua video YouTube thực tế, AI phân tích âm tiết và hỗ trợ cải thiện ngữ điệu từng câu tức thì.
                </p>

                @* Visual Anchor: 3D Clay Illustration Showcase Card *@
                <div class="spk-hero-showcase" aria-hidden="true">
                    <img src="~/images/speaking/speaking-hero-clay.svg" alt="Minh họa Luyện nói AI" class="spk-hero-illus-img" width="440" height="250" />
                </div>

                @* Stats Bento Row *@
                <div class="spk-hero-stats-row">
                    <div class="spk-hero-stat">
                        <div class="spk-hero-stat-icon spk-hero-stat-icon--blue">
                            <span class="material-symbols-outlined" style="font-size:20px;font-variation-settings:'FILL' 1" aria-hidden="true">video_library</span>
                        </div>
                        <div class="spk-hero-stat-info">
                            <div class="spk-hero-stat-val" id="vi-video-count" data-total-count="@totalVideos">@totalVideos</div>
                            <div class="spk-hero-stat-lbl">Videos thực tế</div>
                        </div>
                    </div>
                    <div class="spk-hero-stat">
                        <div class="spk-hero-stat-icon spk-hero-stat-icon--amber">
                            <span class="material-symbols-outlined" style="font-size:20px;font-variation-settings:'FILL' 1" aria-hidden="true">topic</span>
                        </div>
                        <div class="spk-hero-stat-info">
                            <div class="spk-hero-stat-val">@Model.Topics.Count</div>
                            <div class="spk-hero-stat-lbl">Chủ đề bài học</div>
                        </div>
                    </div>
                    <div class="spk-hero-stat">
                        <div class="spk-hero-stat-icon spk-hero-stat-icon--green">
                            <span class="material-symbols-outlined" style="font-size:20px;font-variation-settings:'FILL' 1" aria-hidden="true">grade</span>
                        </div>
                        <div class="spk-hero-stat-info">
                            <div class="spk-hero-stat-val">A1–C2</div>
                            <div class="spk-hero-stat-lbl">Khung trình độ</div>
                        </div>
                    </div>
                </div>
            </div>

            @* Right: Hero Import Panel (Clay Surface) *@
            <section class="spk-hero-import" id="my-import-panel" aria-label="Thêm video YouTube">
                <div class="spk-hero-blob spk-hero-blob--1" aria-hidden="true"></div>
                <div class="spk-hero-blob spk-hero-blob--2" aria-hidden="true"></div>

                <div class="spk-hero-import-top">
                    <div class="spk-hero-yt-chip">
                        <i class="fab fa-youtube" style="color:#ff0000;font-size:18px;" aria-hidden="true"></i>
                        <span>YouTube Import</span>
                        <span class="spk-hero-yt-dot"></span>
                        <span style="color:var(--tct-text-muted, #5b6578);font-size:0.75rem;font-weight:600;">AI-powered</span>
                    </div>
                </div>

                <h2 class="spk-hero-import-title">
                    Dán link YouTube,<br>
                    AI lo phần còn lại ✨
                </h2>
                <p class="spk-hero-import-desc">
                    Hệ thống tự trích xuất transcript, tạo bài luyện phát âm<br>
                    và chấm điểm cho bạn — hoàn toàn tự động.
                </p>

                <div class="spk-hero-input-block">
                    <div class="spk-hero-url-wrap" id="spk-hero-url-wrap">
                        <i class="fab fa-youtube spk-hero-url-yt-icon" aria-hidden="true"></i>
                        <input type="url"
                               id="mip-url-input"
                               class="spk-hero-url-input"
                               placeholder="https://youtube.com/watch?v=..."
                               aria-label="Đường dẫn YouTube cần nhập"
                               autocomplete="off" />
                    </div>
                    <button type="button" id="mip-submit-btn" class="spk-hero-submit-btn">
                        <span class="material-symbols-outlined" id="mip-btn-icon" style="font-size:18px;" aria-hidden="true">add_circle</span>
                        <span id="mip-btn-label">Thêm video</span>
                    </button>
                </div>

                @* Custom Clay File Upload for Subtitle *@
                <div class="spk-hero-subtitle-block mt-3">
                    <label for="mip-subtitle-input" class="spk-custom-file-label">
                        <span class="d-inline-flex align-items-center gap-2">
                            <span class="material-symbols-outlined text-primary" style="font-size:16px;" aria-hidden="true">subtitles</span>
                            <span id="mip-subtitle-filename">Đính kèm phụ đề SRT/VTT (tùy chọn)</span>
                        </span>
                        <span class="spk-file-browse-btn">Chọn tệp</span>
                    </label>
                    <input id="mip-subtitle-input" name="subtitle" type="file" accept=".srt,.vtt,text/vtt" class="visually-hidden" />
                </div>

                <div id="mip-feedback" class="spk-hero-feedback" aria-live="polite" role="alert"></div>

                <div class="spk-hero-feature-row">
                    <span class="spk-hero-feature-pill">
                        <span class="material-symbols-outlined" style="font-size:14px;" aria-hidden="true">auto_awesome</span> AI phân tích
                    </span>
                    <span class="spk-hero-feature-pill">
                        <span class="material-symbols-outlined" style="font-size:14px;" aria-hidden="true">mic</span> Chấm điểm
                    </span>
                    <span class="spk-hero-feature-pill">
                        <span class="material-symbols-outlined" style="font-size:14px;" aria-hidden="true">headphones</span> Nghe chép
                    </span>
                </div>
            </section>
        </div>
    </div>

    <partial name="_RecentVideos" model="Model.RecentVideos" />

    @* ── WHY PRACTICE SPEAKING (Clay Feature Cards) ─────── *@
    <section class="spk-why-section mb-5" aria-label="Lợi ích luyện nói">
        <div class="spk-why-grid">
            <div class="spk-why-card">
                <div class="spk-why-icon spk-why-icon--blue">
                    <span class="material-symbols-outlined" style="font-size:22px;font-variation-settings:'FILL' 1" aria-hidden="true">mic</span>
                </div>
                <h3 class="spk-why-title">AI Chấm điểm</h3>
                <p class="spk-why-desc">Đối chiếu văn bản nhận diện chính xác từng từ, chỉ rõ từ khớp và từ thiếu.</p>
            </div>
            <div class="spk-why-card">
                <div class="spk-why-icon spk-why-icon--green">
                    <span class="material-symbols-outlined" style="font-size:22px;font-variation-settings:'FILL' 1" aria-hidden="true">trending_up</span>
                </div>
                <h3 class="spk-why-title">Tiến bộ rõ rệt</h3>
                <p class="spk-why-desc">Theo dõi tiến trình hoàn thành qua từng câu, từng video một cách trực quan.</p>
            </div>
            <div class="spk-why-card">
                <div class="spk-why-icon spk-why-icon--purple">
                    <span class="material-symbols-outlined" style="font-size:22px;font-variation-settings:'FILL' 1" aria-hidden="true">headphones</span>
                </div>
                <h3 class="spk-why-title">Nghe &amp; Chép</h3>
                <p class="spk-why-desc">Chế độ Dictation giúp rèn kỹ năng nghe hiểu và phản xạ từ vựng song song.</p>
            </div>
            <div class="spk-why-card">
                <div class="spk-why-icon spk-why-icon--amber">
                    <span class="material-symbols-outlined" style="font-size:22px;font-variation-settings:'FILL' 1" aria-hidden="true">school</span>
                </div>
                <h3 class="spk-why-title">Chuẩn CEFR</h3>
                <p class="spk-why-desc">Video được phân loại từ A1 đến C2 — lộ trình rõ ràng phù hợp mọi trình độ.</p>
            </div>
        </div>
    </section>

    @* ── MY VIDEOS ──────────────────────────────────────── *@
    <section class="spk-my-section mb-5" id="my-videos-section" aria-label="Video của tôi">
        <div class="spk-my-section-header">
            <div class="spk-my-section-title-row">
                <div class="spk-my-section-icon">
                    <span class="material-symbols-outlined" style="font-size:20px;font-variation-settings:'FILL' 1" aria-hidden="true">folder_special</span>
                </div>
                <h2 class="spk-section-title spk-headline-md">
                    Video của tôi
                    <span class="spk-count-badge" id="my-sec-count" data-total-count="@Model.MyVideosTotalCount">@Model.MyVideosTotalCount video</span>
                    @if (Model.IsMyVideosLocked)
                    {
                        <span class="spk-locked-badge"><i class="fas fa-lock me-1" aria-hidden="true"></i> Tính năng đã khóa</span>
                    }
                </h2>
            </div>
            <p class="spk-my-section-hint">Video bạn đã import từ YouTube để luyện tập riêng tư.</p>
        </div>

        <div class="spk-bento-grid spk-bento-grid--4" id="my-videos-grid">
            @foreach (var v in Model.MyVideos)
            {
                var thumb = string.IsNullOrEmpty(v.ThumbnailUrl)
                    ? $"https://img.youtube.com/vi/{v.YoutubeId}/hqdefault.jpg"
                    : v.ThumbnailUrl;

                <div class="my-video-card @(v.IsLocked ? "my-video-card--locked" : "")" data-id="@v.Id" data-title="@v.Title">
                    <div class="spk-my-card">
                        <div class="spk-video-thumb">
                            @if (v.ImportStatus == "processing")
                            {
                                <div class="spk-thumb-processing">
                                    <div class="spk-spinner"></div>
                                    <span class="spk-spinner-label">ĐANG XỬ LÝ</span>
                                </div>
                            }
                            else
                            {
                                <img src="@thumb" alt="@v.Title" class="spk-thumb-img" loading="lazy" />
                                <div class="spk-thumb-overlay"></div>
                            }
                            <div class="spk-thumb-badge-tl">
                                @if (v.IsLocked)
                                {
                                    <span class="spk-badge spk-badge--red"><i class="fas fa-lock me-1" aria-hidden="true"></i> ĐÃ KHÓA</span>
                                }
                                else if (v.ImportStatus == "processing")
                                {
                                    <span class="spk-badge spk-badge--amber">ĐANG TẢI</span>
                                }
                                else if (v.ImportStatus == "failed")
                                {
                                    <span class="spk-badge spk-badge--red">THẤT BẠI</span>
                                }
                                else
                                {
                                    <span class="spk-badge spk-badge--green">SẴN SÀNG</span>
                                }
                            </div>
                            @if (v.ImportStatus == "ready" && !v.IsLocked)
                            {
                                <div class="spk-thumb-play-overlay">
                                    <div class="spk-thumb-play-btn">
                                        <span class="material-symbols-outlined" style="font-size:28px;font-variation-settings:'FILL' 1" aria-hidden="true">play_arrow</span>
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="spk-my-card-body">
                            <h3 class="spk-my-card-title">@v.Title</h3>
                            <div class="spk-my-card-meta">
                                @if (!string.IsNullOrEmpty(v.Duration))
                                {
                                    <span class="spk-meta-item">
                                        <span class="material-symbols-outlined" style="font-size:13px;" aria-hidden="true">schedule</span>
                                        @v.Duration
                                    </span>
                                }
                                @if (v.SentenceCount > 0)
                                {
                                    <span class="spk-meta-item">
                                        <span class="material-symbols-outlined" style="font-size:13px;" aria-hidden="true">format_list_bulleted</span>
                                        @v.SentenceCount câu
                                    </span>
                                }
                            </div>
                            <div class="spk-my-card-actions">
                                @if (v.IsLocked)
                                {
                                    <a href="/Account/Premium" class="spk-btn spk-btn--warning spk-btn--full">
                                        <i class="fas fa-crown me-1" aria-hidden="true"></i> Nâng cấp Premium
                                    </a>
                                }
                                else if (v.ImportStatus == "ready")
                                {
                                    <a href="@Url.Action("Practice", "Speaking", new { id = v.Id })" class="spk-btn spk-btn--primary spk-btn--flex">
                                        <span class="material-symbols-outlined" style="font-size:16px;font-variation-settings:'FILL' 1" aria-hidden="true">mic</span>
                                        Luyện tập
                                    </a>
                                    <button type="button" class="spk-btn spk-btn--danger-outline spk-btn--icon my-btn-delete"
                                            data-id="@v.Id" data-title="@v.Title" title="Xóa video" aria-label="Xóa video @v.Title">
                                        <span class="material-symbols-outlined" style="font-size:16px;" aria-hidden="true">delete</span>
                                    </button>
                                }
                                else if (v.ImportStatus == "processing")
                                {
                                    <button type="button" class="spk-btn spk-btn--disabled spk-btn--full" disabled>
                                        <i class="fas fa-spinner fa-spin me-1" aria-hidden="true"></i> Đang xử lý...
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="spk-btn spk-btn--danger-outline spk-btn--full my-btn-delete"
                                            data-id="@v.Id" data-title="@v.Title">
                                        <span class="material-symbols-outlined" style="font-size:16px;" aria-hidden="true">delete</span> Xóa
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }

            @if (Model.MyVideosHasMore)
            {
                <div class="d-flex justify-content-center mt-3 mb-3 w-100">
                    <button type="button"
                            class="spk-btn spk-btn--primary spk-btn--sm spk-load-more-mine"
                            data-page="@(Model.MyCurrentPage + 1)"
                            data-page-size="@Model.PageSize"
                            data-search="@(Model.ActiveSearch ?? "")">
                        <span class="material-symbols-outlined" style="font-size:16px;" aria-hidden="true">expand_more</span>
                        Xem thêm video của tôi
                    </button>
                </div>
            }

            @* Empty state placeholder (Clay Bento Showcase) *@
            <div class="spk-my-empty @(Model.MyVideos.Any() ? "d-none" : "")" id="my-empty-state">
                <div class="spk-empty-left">
                    <div class="spk-hero-eyebrow mb-1">
                        <span class="material-symbols-outlined" style="font-size:16px;font-variation-settings:'FILL' 1;color:#ff9800" aria-hidden="true">auto_awesome</span>
                        <span>Không gian học cá nhân</span>
                        <span class="spk-eyebrow-dot" aria-hidden="true"></span>
                        <span class="spk-eyebrow-badge">Tự chọn nội dung</span>
                    </div>

                    <div class="spk-empty-illus-row">
                        <div class="spk-empty-illus-box">
                            <img src="~/images/speaking/speaking-empty-clay.svg" alt="Chưa có video" width="72" height="54" />
                        </div>
                        <div>
                            <h3 class="spk-my-empty-title">Luyện nói với bất kỳ video nào bạn thích</h3>
                            <p class="spk-empty-tagline text-muted small mb-0">Biến nội dung YouTube yêu thích thành bài tập tương tác</p>
                        </div>
                    </div>

                    <p class="spk-my-empty-desc">
                        Dán link YouTube (Podcast, Ted Talk, Tin tức, Phim ảnh...) vào thanh công cụ phía trên. AI sẽ tự động trích xuất câu thoại, phiên âm IPA và chấm điểm khẩu hình theo từng âm tiết.
                    </p>

                    <div class="spk-empty-actions-row">
                        <button type="button" class="spk-btn spk-btn--primary" onclick="focusImportInput()">
                            <span class="material-symbols-outlined" style="font-size:18px;font-variation-settings:'FILL' 1" aria-hidden="true">add_circle</span>
                            Dán link YouTube ngay
                        </button>
                        <span class="spk-empty-hint-text">
                            <span class="material-symbols-outlined text-success" style="font-size:16px;font-variation-settings:'FILL' 1" aria-hidden="true">check_circle</span>
                            Miễn phí &amp; hỗ trợ mọi video có phụ đề
                        </span>
                    </div>

                    @* Quick Sample Suggestions *@
                    <div class="spk-empty-samples mt-2">
                        <span class="spk-empty-samples-label">Gợi ý video mẫu:</span>
                        <div class="spk-sample-chips-wrap">
                            <button type="button" class="spk-sample-chip" data-url="https://www.youtube.com/watch?v=gT_qWk7B8tQ" onclick="setSampleVideo(this)">
                                <span class="material-symbols-outlined" style="font-size:14px;color:#ef4444" aria-hidden="true">play_circle</span>
                                TED-Ed: How memories form
                            </button>
                            <button type="button" class="spk-sample-chip" data-url="https://www.youtube.com/watch?v=UF8uR6Z6KLc" onclick="setSampleVideo(this)">
                                <span class="material-symbols-outlined" style="font-size:14px;color:#ef4444" aria-hidden="true">play_circle</span>
                                Steve Jobs Stanford Speech
                            </button>
                        </div>
                    </div>
                </div>

                <div class="spk-empty-right">
                    <div class="spk-empty-steps-heading">
                        <span class="material-symbols-outlined text-primary" style="font-size:18px;font-variation-settings:'FILL' 1" aria-hidden="true">tips_and_updates</span>
                        3 bước đơn giản để bắt đầu:
                    </div>

                    <div class="spk-empty-step-card">
                        <div class="spk-empty-step-num">1</div>
                        <div class="spk-empty-step-info">
                            <div class="spk-empty-step-title">Dán đường dẫn YouTube</div>
                            <div class="spk-empty-step-desc">Sao chép link video tiếng Anh bất kỳ và dán vào thanh nhập liệu phía trên.</div>
                        </div>
                    </div>

                    <div class="spk-empty-step-card">
                        <div class="spk-empty-step-num">2</div>
                        <div class="spk-empty-step-info">
                            <div class="spk-empty-step-title">AI bóc tách câu thoại</div>
                            <div class="spk-empty-step-desc">Tự động phân tích audio, căn chỉnh phụ đề và tạo bài tập shadowing từng câu.</div>
                        </div>
                    </div>

                    <div class="spk-empty-step-card">
                        <div class="spk-empty-step-num">3</div>
                        <div class="spk-empty-step-info">
                            <div class="spk-empty-step-title">Luyện nói &amp; Chấm phát âm</div>
                            <div class="spk-empty-step-desc">Ghi âm trực tiếp, đối chiếu sóng âm với người bản xứ và xem điểm số chi tiết.</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* Smart Clay Import Loading Card *@
        <div class="my-video-card my-video-card--skeleton spk-import-loading-card d-none" id="mip-loading-card" aria-live="polite">
            <div class="spk-my-card spk-my-card--importing">
                @* Ambient top glowing strip *@
                <div class="spk-import-shimmer-strip" aria-hidden="true"></div>

                @* Thumbnail preview with real image or AI clay orb *@
                <div class="spk-video-thumb spk-import-thumb">
                    <img src="" alt="Thumbnail video đang nạp" class="spk-thumb-img spk-import-thumb-img d-none" id="mip-loading-thumb" />
                    <div class="spk-import-thumb-placeholder" id="mip-loading-thumb-placeholder">
                        <div class="spk-import-ai-orb" aria-hidden="true">
                            <span class="material-symbols-outlined spk-import-ai-icon">auto_awesome</span>
                        </div>
                    </div>
                    <div class="spk-import-thumb-overlay" aria-hidden="true"></div>

                    @* Badge status with pulse dot *@
                    <div class="spk-thumb-badge-tl">
                        <span class="spk-badge spk-badge--importing">
                            <span class="spk-import-pulse-dot" aria-hidden="true"></span>
                            <span id="mip-loading-badge-text">AI ĐANG XỬ LÝ</span>
                        </span>
                    </div>

                    @* Estimated duration badge *@
                    <div class="spk-thumb-duration spk-import-duration" id="mip-loading-eta">
                        <span class="material-symbols-outlined" style="font-size:12px;vertical-align:middle;" aria-hidden="true">timer</span>
                        <span>~15-30s</span>
                    </div>
                </div>

                @* Card body with steps, title & progress bar *@
                <div class="spk-my-card-body spk-import-card-body">
                    <h3 class="spk-my-card-title spk-import-card-title" id="mip-loading-title">
                        Đang tạo bài học từ YouTube...
                    </h3>

                    @* Step ticker *@
                    <div class="spk-import-step-row" id="mip-loading-step-row">
                        <span class="material-symbols-outlined spk-import-step-icon" id="mip-loading-step-icon" aria-hidden="true">sync</span>
                        <span class="spk-import-step-text" id="mip-loading-step-text">Đang kết nối video YouTube...</span>
                    </div>

                    @* Clay Progress Bar *@
                    <div class="spk-import-progress-track" role="progressbar" id="mip-loading-progress-track" aria-valuenow="25" aria-valuemin="0" aria-valuemax="100" aria-label="Tiến độ tạo bài học">
                        <div class="spk-import-progress-fill" id="mip-loading-progress-fill" style="width: 25%;"></div>
                    </div>

                    @* Action button *@
                    <div class="spk-my-card-actions mt-3">
                        <button type="button" class="spk-btn spk-btn--processing spk-btn--full" disabled>
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            <span id="mip-loading-btn-text">Đang tạo bài...</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </section>

    @* ── UNIFIED PUBLIC LIBRARY TOOLBAR & FILTERS (Clay Card) ── *@
    <div class="spk-unified-toolbar spk-library-toolbar mb-4" aria-label="Thanh công cụ và bộ lọc thư viện">
        @* Row 1: Library Header on Left, Search Input on Right *@
        <div class="spk-toolbar-top-row">
            <div class="spk-library-toolbar-left spk-library-header-left">
                <div class="spk-library-toolbar-icon spk-library-header-icon">
                    <span class="material-symbols-outlined" style="font-size:22px;font-variation-settings:'FILL' 1" aria-hidden="true">auto_stories</span>
                </div>
                <div>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <h2 class="spk-section-title spk-headline-md mb-0">@(groupByLevel ? "Video luyện nói theo trình độ" : "Video luyện nói theo chủ đề")</h2>
                        <span class="spk-count-badge spk-library-count-badge">@totalVideos bài học</span>
                    </div>
                    <p class="spk-library-subtitle mb-0">Chọn nội dung bạn quan tâm, kết hợp trình độ A1–C2 để tìm bài phù hợp.</p>
                </div>
            </div>
            <div class="spk-library-toolbar-right spk-library-header-right">
                <div class="spk-search-wrap">
                    <span class="material-symbols-outlined spk-search-icon" aria-hidden="true">search</span>
                    <input type="search"
                           id="vi-search" value="@Model.ActiveSearch"
                           class="spk-search-input"
                           placeholder="Tìm kiếm video..."
                           aria-label="Tìm kiếm video luyện nói"
                           autocomplete="off" />
                    @if (!string.IsNullOrEmpty(Model.ActiveSearch))
                    {
                        <a href="@Url.Action("Index", "Speaking", new { level = Model.ActiveLevel, topic = Model.ActiveTopic, group = groupByLevel ? "level" : null })" class="spk-search-clear" title="Xóa tìm kiếm" aria-label="Xóa tìm kiếm">
                            <span class="material-symbols-outlined" style="font-size:16px;" aria-hidden="true">close</span>
                        </a>
                    }
                </div>
            </div>
        </div>

        @* Hairline Divider *@
        <div class="spk-toolbar-divider" aria-hidden="true"></div>

        @* Row 2: Display & Level Controls (Xem theo + Trình độ combined side-by-side) *@
        <div class="spk-toolbar-controls-row" role="region" aria-label="Tùy chọn hiển thị và trình độ">
            <nav class="spk-filter-group spk-filter-group--view-mode" aria-label="Sắp xếp thư viện">
                <span class="spk-filter-group-label">
                    <span class="material-symbols-outlined" style="font-size:16px;" aria-hidden="true">tune</span>
                    Xem theo
                </span>
                <div class="spk-filter-pills" role="tablist">
                    <a class="spk-pill-btn @(!groupByLevel ? "spk-pill-btn--active" : null)" aria-current="@(!groupByLevel ? "page" : null)"
                       href="@Url.Action("Index", "Speaking", new { level = Model.ActiveLevel, topic = Model.ActiveTopic, search = Model.ActiveSearch })">Chủ đề</a>
                    <a class="spk-pill-btn @(groupByLevel ? "spk-pill-btn--active" : null)" aria-current="@(groupByLevel ? "page" : null)"
                       href="@Url.Action("Index", "Speaking", new { group = "level", level = Model.ActiveLevel, topic = Model.ActiveTopic, search = Model.ActiveSearch })">Trình độ CEFR</a>
                </div>
            </nav>

            <span class="spk-filter-divider" aria-hidden="true"></span>

            <div class="spk-filter-group spk-filter-group--levels" role="region" aria-label="Bộ lọc trình độ">
                <span class="spk-filter-group-label">
                    <span class="material-symbols-outlined" style="font-size:16px;" aria-hidden="true">school</span>
                    Trình độ
                </span>
                <div class="spk-filter-pills" role="toolbar" aria-label="Lọc theo trình độ">
                    <a class="level-filter-btn spk-pill-btn @(string.IsNullOrEmpty(Model.ActiveLevel) ? "spk-pill-btn--active" : null)"
                       data-level="all"
                       href="@Url.Action("Index", "Speaking", new { topic = Model.ActiveTopic, search = Model.ActiveSearch, group = groupByLevel ? "level" : null })">Tất cả</a>
                    @foreach (var level in new[] { "A1", "A2", "B1", "B2", "C1", "C2" })
                    {
                        <a class="level-filter-btn spk-pill-btn @(Model.ActiveLevel == level ? "spk-pill-btn--active" : null)"
                           data-level="@level"
                           href="@Url.Action("Index", "Speaking", new { level, topic = Model.ActiveTopic, search = Model.ActiveSearch, group = groupByLevel ? "level" : null })">@level</a>
                    }
                </div>
            </div>
        </div>

        <p id="spk-catalog-status" class="small mb-0" role="status" aria-live="polite"></p>

        @* Row 3: Topic Chips Carousel (Dedicated compact single-line scroll row) *@
        @if (Model.Topics.Any())
        {
            <div class="spk-toolbar-topics-row" role="region" aria-label="Bộ lọc chủ đề">
                <div class="spk-filter-group spk-filter-group--topics">
                    <span class="spk-filter-group-label">
                        <span class="material-symbols-outlined" style="font-size:16px;" aria-hidden="true">label</span>
                        Chủ đề
                    </span>
                    <div class="spk-topic-chips-carousel" id="spk-topic-chips-carousel">
                        <button type="button" class="spk-topic-scroll-btn spk-topic-scroll-btn--prev d-none" id="spk-topic-scroll-prev" aria-label="Cuộn sang trái">
                            <span class="material-symbols-outlined" style="font-size:16px;" aria-hidden="true">chevron_left</span>
                        </button>
                        <div class="spk-topic-chips spk-scroll-x" id="spk-topic-chips-track" role="toolbar" aria-label="Lọc theo chủ đề">
                            @{
                                var allMeta = GetTopicMeta("all");
                            }
                            <a class="topic-filter-btn spk-chip @(string.IsNullOrEmpty(Model.ActiveTopic) ? "spk-chip--active" : null)"
                               data-topic="all"
                               href="@Url.Action("Index", "Speaking", new { level = Model.ActiveLevel, search = Model.ActiveSearch, group = groupByLevel ? "level" : null })">
                                <span class="spk-chip-icon spk-chip-icon--@allMeta.ClassModifier" style="--chip-icon-color:@allMeta.Color;" aria-hidden="true">
                                    <span class="material-symbols-outlined">@allMeta.Icon</span>
                                </span>
                                <span>Tất cả chủ đề</span>
                            </a>
                            @foreach (var topic in Model.Topics)
                            {
                                var meta = GetTopicMeta(topic);
                                <a class="topic-filter-btn spk-chip @(Model.ActiveTopic == topic ? "spk-chip--active" : null)"
                                   data-topic="@topic"
                                   href="@Url.Action("Index", "Speaking", new { level = Model.ActiveLevel, topic, search = Model.ActiveSearch, group = groupByLevel ? "level" : null })">
                                    <span class="spk-chip-icon spk-chip-icon--@meta.ClassModifier" style="--chip-icon-color:@meta.Color;" aria-hidden="true">
                                        <span class="material-symbols-outlined">@meta.Icon</span>
                                    </span>
                                    <span>@topic</span>
                                </a>
                            }
                        </div>
                        <button type="button" class="spk-topic-scroll-btn spk-topic-scroll-btn--next d-none" id="spk-topic-scroll-next" aria-label="Cuộn sang phải">
                            <span class="material-symbols-outlined" style="font-size:16px;" aria-hidden="true">chevron_right</span>
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>

    @* ── LEVEL SECTIONS ──────────────────────────────────── *@
    @if (!Model.VideosByLevel.Any())
    {
        <div class="spk-empty-full vi-empty text-center p-5">
            <img src="~/images/speaking/speaking-empty-clay.svg" alt="Chưa có video" class="spk-empty-svg mb-3" width="180" height="135" />
            <h3 class="spk-empty-title mt-2">Chưa có video công khai</h3>
            <p class="spk-empty-desc">Hệ thống đang cập nhật nội dung. Vui lòng quay lại sau!</p>
        </div>
    }
    else if (!groupByLevel)
    {
        var loadedVideos = Model.VideosByLevel.SelectMany(x => x.Value).ToList();
        var topicIndex = 0;
        foreach (var topicEntry in Model.PublicTotalByTopic.OrderBy(x => x.Key))
        {
            var topic = topicEntry.Key;
            var topicVideos = loadedVideos.Where(x => (string.IsNullOrEmpty(x.Topic) ? "General" : x.Topic) == topic).OrderBy(x => x.Level).ThenBy(x => x.Id).ToList();
            var trackKey = "topic-" + topicIndex++;
            var secMeta = GetTopicMeta(topic);
            <section class="vi-level-section spk-level-section mb-5" data-level="@trackKey" data-catalog-topic="@topic" aria-label="Chủ đề @topic">
                <div class="spk-level-section-header mb-3">
                    <div class="d-flex align-items-center gap-2">
                        <span class="spk-topic-section-icon" style="background:@(secMeta.Color)14; color:@secMeta.Color;" aria-hidden="true">
                            <span class="material-symbols-outlined" style="font-size:20px;font-variation-settings:'FILL' 1;">@secMeta.Icon</span>
                        </span>
                        <h3 class="spk-section-title mb-0">@(topic == "General" ? "Nội dung chung" : topic)</h3>
                    </div>
                    <span class="spk-count-badge">@topicEntry.Value video</span>
                </div>
                <div class="spk-bento-grid spk-bento-grid--4" id="track-@trackKey">
                    @foreach (var video in topicVideos)
                    {
                        <partial name="_CatalogVideoCard" model="video" />
                    }
                </div>
                <div class="numbered-pagination-container d-flex justify-content-center gap-2 flex-wrap" data-level="@trackKey"></div>
                @if (topicVideos.Count < topicEntry.Value)
                {
                    <a class="spk-pill-btn mt-3 spk-topic-more" href="@Url.Action("Index", "Speaking", new { topic, level = Model.ActiveLevel, search = Model.ActiveSearch, group = "level" })">Xem tất cả @topicEntry.Value video · @topic</a>
                }
            </section>
        }
    }
    else
    {
        foreach (var kvp in Model.VideosByLevel)
        {
            var level   = kvp.Key;
            var videos  = kvp.Value;
            var meta    = levelMeta.ContainsKey(level)
                          ? levelMeta[level]
                          : (Label: "Level " + level, Bg: "#e7eeff", Fg: "#111c2d", Accent: "#4255ff", Icon: "📚");
            var metaBg     = meta.Bg;
            var metaFg     = meta.Fg;
            var metaLabel  = meta.Label;
            var metaAccent = meta.Accent;
            var metaIcon   = meta.Icon;

            <section class="vi-level-section spk-level-section mb-5" data-level="@level" aria-label="Trình độ @level">
                <div class="spk-level-section-header mb-3">
                    <div class="spk-level-section-badge-wrap">
                        <span class="spk-level-section-badge" style="background:@metaBg; color:@metaFg; border: 2px solid @metaAccent;">
                            <span class="spk-level-badge-icon" aria-hidden="true">@metaIcon</span>
                            @level
                        </span>
                        <div>
                            <span class="spk-level-section-label" style="color:@metaFg;">@metaLabel</span>
                            <span class="spk-level-section-sub">Chuẩn CEFR</span>
                        </div>
                    </div>
                    @{
                        var levelTotal = Model.PublicTotalByLevel.GetValueOrDefault(level, videos.Count);
                    }
                    <span class="spk-count-badge">@levelTotal video</span>
                </div>

                <div class="spk-bento-grid spk-bento-grid--4" id="track-@level"
                     data-spk-level="@level"
                     data-spk-page="@Model.Page"
                     data-spk-has-more="@(Model.PublicHasMoreByLevel.GetValueOrDefault(level) ? "true" : "false")">
                    @foreach (var item in videos)
                    {
                        var thumb = string.IsNullOrEmpty(item.ThumbnailUrl)
                            ? $"https://img.youtube.com/vi/{item.YoutubeId}/hqdefault.jpg"
                            : item.ThumbnailUrl;

                        <div class="vi-video-col"
                             data-video-id="@item.Id" data-title="@item.Title.ToLower()" data-topic="@item.Topic" data-level="@item.Level">
                            <a href="@Url.Action("Practice", "Speaking", new { id = item.Id })" class="text-decoration-none d-block h-100">
                                <article class="spk-pub-card h-100">
                                    <div class="spk-video-thumb">
                                        <img src="@thumb" alt="@item.Title" class="spk-thumb-img" loading="lazy" />
                                        <div class="spk-thumb-overlay"></div>
                                        @if (!string.IsNullOrEmpty(item.Duration))
                                        {
                                            <div class="spk-thumb-duration">@item.Duration</div>
                                        }
                                        <div class="spk-thumb-badge-tl">
                                            <span class="spk-level-chip" style="background:@metaBg; color:@metaFg;">@level</span>
                                        </div>
                                        <div class="spk-pub-card-play-overlay">
                                            <div class="spk-pub-card-play">
                                                <span class="material-symbols-outlined" style="font-size:24px;font-variation-settings:'FILL' 1" aria-hidden="true">play_arrow</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="spk-pub-card-body">
                                        @if (!string.IsNullOrEmpty(item.Topic))
                                        {
                                            <span class="spk-pub-card-topic">@item.Topic</span>
                                        }
                                        <h4 class="spk-pub-card-title">@item.Title</h4>
                                        <div class="spk-pub-card-meta">
                                            @if (item.SentenceCount > 0)
                                            {
                                                <span class="spk-pub-card-meta-item">
                                                    <span class="material-symbols-outlined" style="font-size:13px;" aria-hidden="true">format_list_bulleted</span>
                                                    @item.SentenceCount câu
                                                </span>
                                            }
                                        </div>
                                        <div class="spk-pub-card-footer">
                                            <span class="spk-pub-practice-btn">
                                                <span class="material-symbols-outlined" style="font-size:14px;font-variation-settings:'FILL' 1" aria-hidden="true">mic</span>
                                                Luyện tập
                                            </span>
                                        </div>
                                    </div>
                                </article>
                            </a>
                        </div>
                    }
                </div>

                <div class="numbered-pagination-container d-flex justify-content-center gap-2 flex-wrap" data-level="@level"></div>
                @if (Model.PublicHasMoreByLevel.GetValueOrDefault(level))
                {
                    <div class="d-flex justify-content-center mt-3">
                        <button type="button"
                                class="spk-btn spk-btn--primary spk-btn--sm spk-load-more-public"
                                data-level="@level"
                                data-topic="@(Model.ActiveTopic ?? "")"
                                data-search="@(Model.ActiveSearch ?? "")"
                                data-page="@(Model.Page + 1)"
                                data-page-size="@Model.PageSize">
                            <span class="material-symbols-outlined" style="font-size:16px;" aria-hidden="true">expand_more</span>
                            Xem thêm video @level
                        </button>
                    </div>
                }
            </section>
        }
    }

    @* ── NO RESULTS ─────────────────────────────────────── *@
    <div id="vi-no-results" class="spk-no-results text-center py-5" style="display:none;">
        <img src="~/images/speaking/speaking-empty-clay.svg" alt="Không tìm thấy kết quả" class="spk-empty-svg mb-3" width="160" height="120" />
        <h3 class="spk-empty-title mt-2">Không tìm thấy video phù hợp</h3>
        <p class="spk-empty-desc">Hãy thử tìm kiếm với từ khóa khác hoặc điều chỉnh lại bộ lọc trình độ / chủ đề.</p>
    </div>

</div>

@* ── DELETE MODAL (Clay Dialog) ────────────────────────── *@
<div class="modal fade" id="deleteVideoModal" tabindex="-1" aria-labelledby="deleteVideoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="spk-modal-content">
            <div class="spk-modal-header">
                <div class="spk-modal-header-icon spk-modal-header-icon--danger">
                    <span class="material-symbols-outlined" aria-hidden="true">delete_forever</span>
                </div>
                <div class="flex-grow-1">
                    <h5 class="spk-modal-title" id="deleteVideoModalLabel">Xác nhận xóa video</h5>
                    <p class="spk-modal-subtitle">Hành động này không thể hoàn tác.</p>
                </div>
                <button type="button" class="spk-modal-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="spk-modal-body">
                <div class="spk-modal-warning-box">
                    <span class="material-symbols-outlined spk-modal-warning-icon" aria-hidden="true">warning</span>
                    <p class="mb-0">Bạn sắp xóa video <strong id="delete-modal-title" class="spk-modal-video-name"></strong>.<br>
                    Toàn bộ tiến trình luyện tập của video này cũng sẽ bị xóa vĩnh viễn.</p>
                </div>
            </div>
            <div class="spk-modal-footer">
                <button type="button" class="spk-btn spk-btn--ghost" data-bs-dismiss="modal">
                    <span class="material-symbols-outlined" style="font-size:16px;" aria-hidden="true">arrow_back</span>
                    Hủy
                </button>
                <button type="button" class="spk-btn spk-btn--danger" id="delete-modal-confirm">
                    <span class="material-symbols-outlined" style="font-size:16px;" aria-hidden="true">delete_forever</span>
                    Xóa vĩnh viễn
                </button>
            </div>
        </div>
    </div>
</div>

@* Import failures remain visible until dismissed; Bootstrap manages focus and Escape. *@
<div class="modal fade tct-theme" id="speakingImportErrorModal" tabindex="-1"
     aria-labelledby="speaking-import-error-title" aria-describedby="speaking-import-error-message speaking-import-error-help" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content spk-modal-content">
            <div class="spk-modal-header">
                <div class="spk-modal-header-icon spk-modal-header-icon--danger">
                    <span class="material-symbols-outlined" aria-hidden="true">error</span>
                </div>
                <h2 class="spk-modal-title flex-grow-1" id="speaking-import-error-title">Không thể tạo video cá nhân</h2>
                <button type="button" class="spk-modal-close" data-bs-dismiss="modal" aria-label="Đóng thông báo">
                    <span class="material-symbols-outlined" aria-hidden="true">close</span>
                </button>
            </div>
            <div class="spk-modal-body">
                <p id="speaking-import-error-message" class="text-break"></p>
                <p id="speaking-import-error-help" class="mb-0">Kiểm tra video có xem được và có phụ đề tiếng Anh. Bạn có thể chọn video khác hoặc đính kèm file phụ đề SRT/VTT tiếng Anh để thử lại.</p>
            </div>
            <div class="spk-modal-footer">
                <button type="button" class="spk-btn spk-btn--primary" data-bs-dismiss="modal">Đã hiểu</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/speaking-recent.js" asp-append-version="true"></script>
    <script src="~/js/speaking.js" asp-append-version="true"></script>
    <script>
        (function() {
            var subInput = document.getElementById('mip-subtitle-input');
            var subLabel = document.getElementById('mip-subtitle-filename');
            if (subInput && subLabel) {
                subInput.addEventListener('change', function() {
                    if (this.files && this.files.length > 0) {
                        subLabel.textContent = this.files[0].name;
                        subLabel.classList.add('fw-bold', 'text-primary');
                    } else {
                        subLabel.textContent = 'Đính kèm phụ đề SRT/VTT (tùy chọn)';
                        subLabel.classList.remove('fw-bold', 'text-primary');
                    }
                });
            }
        })();
    </script>
}
