@*
    _NotificationDropdown.cshtml (plan 5.2)
    Rendered by _Layout.cshtml inside .notif-wrapper for signed-in users.
    notifications.js mounts on the ids below; the list is built there with createElement.
    - Not modal: the panel is a labelled dialog that keeps Tab inside while open; Esc and an outside click close it.
    - The only antiforgery token the notification page and this panel need is the one below (the scripts read it).
*@

@* CSRF token, read by notifications.js and notification-page.js when they POST *@
@Html.AntiForgeryToken()

@* Pure helpers (badge text, safe link, state reducer) used by notifications.js and the notification page.
   Rendered here so it loads before notifications.js at the end of the layout. *@
<script src="~/js/notification-core.js" asp-append-version="true"></script>

<div class="notif-panel" id="notifPanel" role="dialog" aria-modal="false" aria-labelledby="notifTitle">

    @* ── Header: title, "n mới" chip, mark all ── *@
    <div class="notif-header">
        <h2 class="notif-header__title" id="notifTitle" tabindex="-1">Thông báo</h2>
        <span class="notif-new-chip" id="notifNewChip" hidden></span>
        <button class="notif-mark-all-btn" id="notifMarkAllBtn" type="button" hidden>Đánh dấu đã đọc</button>
    </div>

    @* ── Tabs ── *@
    <div class="notif-tabs" role="tablist" aria-label="Lọc thông báo">
        <button type="button" role="tab" class="notif-tab" id="notifTabAll"
                aria-selected="true" aria-controls="notifList">Tất cả</button>
        <button type="button" role="tab" class="notif-tab" id="notifTabUnread"
                aria-selected="false" aria-controls="notifList" tabindex="-1">Chưa đọc</button>
    </div>

    @* ── List: replaced by notifications.js (skeleton, items, empty and error states) ── *@
    <div class="notif-list" id="notifList" role="tabpanel" aria-labelledby="notifTabAll" aria-busy="true">
        <div class="notif-skeleton">
            <span class="tct-skeleton notif-skeleton__tile"></span>
            <div class="notif-skeleton__lines">
                <span class="tct-skeleton tct-skeleton--line"></span>
                <span class="tct-skeleton tct-skeleton--line tct-skeleton--short"></span>
            </div>
        </div>
        <div class="notif-skeleton">
            <span class="tct-skeleton notif-skeleton__tile"></span>
            <div class="notif-skeleton__lines">
                <span class="tct-skeleton tct-skeleton--line"></span>
                <span class="tct-skeleton tct-skeleton--line tct-skeleton--short"></span>
            </div>
        </div>
        <div class="notif-skeleton">
            <span class="tct-skeleton notif-skeleton__tile"></span>
            <div class="notif-skeleton__lines">
                <span class="tct-skeleton tct-skeleton--line"></span>
                <span class="tct-skeleton tct-skeleton--line tct-skeleton--short"></span>
            </div>
        </div>
    </div>

    @* Visible alternative to scrolling to the end of the list (keyboard users) *@
    <button class="notif-load-more" id="notifLoadMoreBtn" type="button" hidden>Tải thêm</button>

    <div class="notif-footer">
        <a class="notif-footer-link" href="@Url.Action("Index", "Notification")">Xem tất cả thông báo</a>
    </div>

    @* Announcements for screen readers (marked read, errors) *@
    <div class="visually-hidden" id="notifStatus" role="status" aria-live="polite"></div>
</div>
