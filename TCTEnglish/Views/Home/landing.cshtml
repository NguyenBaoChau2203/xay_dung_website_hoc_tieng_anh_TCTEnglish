@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="TCT English — nền tảng học tiếng Anh cho nhân viên TCT: từ vựng, nghe, nói, đọc, viết và trợ lý AI." />
    <title>TCT English — Nền tảng học tiếng Anh</title>
    <link rel="icon" href="~/brand/logo/favicon/favicon.ico" asp-append-version="true" />
    <link rel="icon" type="image/svg+xml" href="~/brand/logo/favicon/favicon.svg" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/brand/logo/favicon/favicon-32.png" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/brand/logo/favicon/favicon-16.png" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/brand/logo/favicon/apple-touch-icon.png" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ai-chat-launcher.css" asp-append-version="true" />
</head>
<body class="landing-page">
    <a class="landing-skip" href="#landing-main">Bỏ qua điều hướng</a>

    <header class="landing-header" id="landingHeader">
        <div class="landing-wrap landing-header__inner">
            <a class="landing-logo" asp-controller="Home" asp-action="Landing" aria-label="TCT English — trang chủ">
                <img src="~/brand/logo/tct-english-logo.svg"
                     asp-append-version="true"
                     alt="TCT English"
                     width="168"
                     height="40" />
            </a>

            <nav class="landing-nav" aria-label="Điều hướng chính">
                <a href="#features">Tính năng</a>
                <a href="#study-modes">Chế độ học</a>
                <a href="#ai-assistant">AI Chatbot</a>
                <a asp-controller="Home" asp-action="Contact">Liên hệ</a>
            </nav>

            <div class="landing-actions">
                <a class="landing-btn landing-btn--ghost" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                <a class="landing-btn landing-btn--primary" asp-controller="Account" asp-action="Register">Bắt đầu học miễn phí</a>
                <button type="button"
                        class="landing-menu-toggle"
                        id="landingMenuToggle"
                        aria-controls="landingDrawer"
                        aria-expanded="false"
                        aria-label="Mở menu">
                    <i class="fas fa-bars" aria-hidden="true"></i>
                </button>
            </div>
        </div>
    </header>

    <div class="landing-drawer"
         id="landingDrawer"
         aria-hidden="true">
        <div class="landing-drawer__panel" role="dialog" aria-modal="true" aria-label="Menu điều hướng">
            <a href="#features">Tính năng</a>
            <a href="#study-modes">Chế độ học</a>
            <a href="#ai-assistant">AI Chatbot</a>
            <a href="#progress">Tiến độ</a>
            <a href="#how-it-works">Cách sử dụng</a>
            <a href="#faq">Câu hỏi thường gặp</a>
            <a asp-controller="Home" asp-action="Contact">Liên hệ</a>
            <div class="landing-drawer__cta">
                <a class="landing-btn landing-btn--outline" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                <a class="landing-btn landing-btn--primary" asp-controller="Account" asp-action="Register">Bắt đầu học miễn phí</a>
            </div>
        </div>
    </div>

    <main id="landing-main">
        <section class="landing-hero" data-enter aria-labelledby="landing-hero-title">
            <div class="landing-hero__universe" aria-hidden="true">
                <div class="landing-hero__atmosphere"></div>
                <div class="landing-hero__softforms">
                    <span class="landing-hero__softform landing-hero__softform--a"></span>
                    <span class="landing-hero__softform landing-hero__softform--b"></span>
                    <span class="landing-hero__softform landing-hero__softform--c"></span>
                </div>
                <div class="landing-hero__props">
                    <img class="landing-hero__prop landing-hero__prop--book"
                         src="~/brand/landing/hero-props/prop-open-book.svg"
                         asp-append-version="true"
                         width="76"
                         height="60"
                         alt=""
                         decoding="async" />
                    <img class="landing-hero__prop landing-hero__prop--headphones"
                         src="~/brand/landing/hero-props/prop-headphones.svg"
                         asp-append-version="true"
                         width="68"
                         height="68"
                         alt=""
                         decoding="async" />
                    <img class="landing-hero__prop landing-hero__prop--card"
                         src="~/brand/landing/hero-props/prop-vocab-card.svg"
                         asp-append-version="true"
                         width="54"
                         height="66"
                         alt=""
                         decoding="async" />
                    <img class="landing-hero__prop landing-hero__prop--card-b"
                         src="~/brand/landing/hero-props/prop-vocab-card.svg"
                         asp-append-version="true"
                         width="48"
                         height="58"
                         alt=""
                         decoding="async" />
                </div>
                <div class="landing-hero__chips">
                    <span class="landing-hero__chip landing-hero__chip--learn">LEARN</span>
                    <span class="landing-hero__chip landing-hero__chip--speak">SPEAK</span>
                    <span class="landing-hero__chip landing-hero__chip--listen">LISTEN</span>
                </div>
            </div>

            <div class="landing-wrap landing-hero__inner">
                <div class="landing-hero__copy">
                    <p class="landing-kicker">
                        <i class="fas fa-bolt" aria-hidden="true"></i>
                        Trợ lý AI tiếng Anh
                    </p>
                    <h1 id="landing-hero-title">
                        Chinh phục tiếng Anh với
                        <span class="landing-brand-mark">TCT English</span>
                    </h1>
                    <p class="landing-hero__lead">
                        Nền tảng học tiếng Anh dành cho nhân viên công ty TCT —
                        từ vựng, nghe, nói, đọc, viết cùng trợ lý AI.
                    </p>
                    <div class="landing-hero__cta">
                        <a class="landing-btn landing-btn--primary landing-btn--lg"
                           asp-controller="Account"
                           asp-action="Register">
                            Học ngay miễn phí
                            <i class="fas fa-arrow-right" aria-hidden="true"></i>
                        </a>
                        <a class="landing-btn landing-btn--outline landing-btn--lg" href="#features">
                            Khám phá tính năng
                        </a>
                    </div>
                </div>

                <div class="landing-hero__stage" aria-label="Minh họa giao diện học trên TCT English">
                    <div class="landing-hero__ground" aria-hidden="true"></div>

                    <aside class="landing-side-card landing-side-card--left">
                        <div class="landing-side-card__label">
                            <i class="fas fa-layer-group" aria-hidden="true"></i>
                            Bộ thẻ từ vựng
                        </div>
                        <ul class="landing-side-card__list">
                            <li>
                                <strong>Accomplish</strong>
                                <span>Hoàn thành, đạt được</span>
                            </li>
                            <li>
                                <strong>Negotiate</strong>
                                <span>Đàm phán, thương lượng</span>
                            </li>
                            <li>
                                <strong>Collaborate</strong>
                                <span>Cộng tác, hợp tác</span>
                            </li>
                        </ul>
                        <p class="landing-side-card__note">Minh họa giao diện</p>
                    </aside>

                    <div class="landing-phone">
                        <div class="landing-phone__glow" aria-hidden="true"></div>
                        <div class="landing-phone__device">
                            <div class="landing-phone__notch" aria-hidden="true"></div>
                            <div class="landing-phone__screen">
                                <div class="landing-phone__status">
                                    <span>9:41</span>
                                    <span class="landing-phone__status-icons" aria-hidden="true">
                                        <i class="fas fa-signal"></i>
                                        <i class="fas fa-wifi"></i>
                                        <i class="fas fa-battery-full"></i>
                                    </span>
                                </div>
                                <div class="landing-phone__appbar">
                                    <span class="landing-phone__brand">TCT English</span>
                                    <span class="landing-phone__mode">Flashcard</span>
                                </div>
                                <div class="landing-phone__progress" aria-hidden="true">
                                    <span></span>
                                </div>
                                <article class="landing-phone__flashcard">
                                    <p class="landing-phone__eyebrow">Business English</p>
                                    <h3 class="landing-phone__term">Accomplish</h3>
                                    <p class="landing-phone__ipa">/əˈkɑːm.plɪʃ/</p>
                                    <p class="landing-phone__def">Hoàn thành, đạt được</p>
                                    <p class="landing-phone__example">We accomplished the quarterly goals ahead of schedule.</p>
                                </article>
                                <div class="landing-phone__actions" aria-hidden="true">
                                    <span class="landing-phone__chip landing-phone__chip--muted">Cần ôn lại</span>
                                    <span class="landing-phone__chip landing-phone__chip--ok">Đã thuộc</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <aside class="landing-side-card landing-side-card--right">
                        <div class="landing-side-card__label">
                            <img src="~/brand/mascot/stickers/tico-mascot-head-color.png"
                                 asp-append-version="true"
                                 width="28"
                                 height="28"
                                 alt=""
                                 decoding="async" />
                            TCT AI
                        </div>
                        <div class="landing-side-card__chat">
                            <p class="landing-side-card__bubble landing-side-card__bubble--user">
                                Khi nào dùng “deadline”?
                            </p>
                            <p class="landing-side-card__bubble landing-side-card__bubble--bot">
                                Dùng khi mốc nộp việc cứng — quá hạn thường có hậu quả.
                            </p>
                        </div>
                        <p class="landing-side-card__note">Minh họa trợ lý AI</p>
                    </aside>

                    <div class="landing-tico-host landing-tico--hero is-tico-poster"
                         data-tico-host>
                        <img class="landing-tico__poster"
                             src="~/brand/mascot/poses/tico-mascot-welcome-color.png"
                             asp-append-version="true"
                             width="280"
                             height="336"
                             alt="Tico, linh vật TCT English"
                             decoding="async" />
                        <canvas class="landing-tico__canvas"
                                hidden
                                aria-hidden="true"></canvas>
                        <p class="landing-tico__bubble" hidden role="status">
                            Xin chào! Chào mừng bạn đến với TCT English!
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <section class="landing-section landing-section--muted" id="features" aria-labelledby="features-title">
            <div class="landing-wrap">
                <div class="landing-reveal">
                    <p class="landing-eyebrow">Tính năng</p>
                    <h2 class="landing-section__title" id="features-title">Sáu kỹ năng trên một nền tảng</h2>
                    <p class="landing-section__desc">
                        Học từ vựng, luyện nghe – nói – đọc – viết và chat với trợ lý AI trong cùng một tài khoản.
                    </p>
                </div>

                <div class="landing-features">
                    <article class="landing-feature landing-reveal">
                        <div class="landing-feature__icon" aria-hidden="true"><i class="fas fa-layer-group"></i></div>
                        <h3>Vocabulary</h3>
                        <p>Flashcard kèm nghĩa, phiên âm và luyện tập theo bộ thẻ / thư mục của bạn.</p>
                    </article>
                    <article class="landing-feature landing-reveal">
                        <div class="landing-feature__icon" aria-hidden="true"><i class="fas fa-book-open"></i></div>
                        <h3>Reading</h3>
                        <p>Bài đọc hiểu theo trình độ, câu hỏi kiểm tra và theo dõi tiến độ đọc.</p>
                    </article>
                    <article class="landing-feature landing-reveal">
                        <div class="landing-feature__icon" aria-hidden="true"><i class="fas fa-headphones"></i></div>
                        <h3>Listening</h3>
                        <p>Luyện nghe theo bài / video có transcript và quiz kiểm tra.</p>
                        <span class="landing-feature__note">Một số công cụ Listening nâng cao thuộc Premium</span>
                    </article>
                    <article class="landing-feature landing-reveal">
                        <div class="landing-feature__icon" aria-hidden="true"><i class="fas fa-microphone"></i></div>
                        <h3>Speaking</h3>
                        <p>Luyện nói theo video, shadowing từng câu và theo dõi tiến độ luyện tập.</p>
                    </article>
                    <article class="landing-feature landing-reveal">
                        <div class="landing-feature__icon" aria-hidden="true"><i class="fas fa-pen"></i></div>
                        <h3>Writing</h3>
                        <p>Bài tập viết theo chủ đề và mức độ; AI hỗ trợ chấm và góp ý khi được bật.</p>
                        <span class="landing-feature__note">Tạo bài bằng AI có thể cần Premium</span>
                    </article>
                    <article class="landing-feature landing-reveal">
                        <div class="landing-feature__icon landing-feature__icon--accent" aria-hidden="true"><i class="fas fa-comments"></i></div>
                        <h3>AI Chatbot</h3>
                        <p>Trò chuyện tiếng Anh, hỏi từ vựng / ngữ pháp và luyện diễn đạt với trợ lý AI.</p>
                        <span class="landing-feature__note">Tài khoản miễn phí có hạn mức; Premium không giới hạn quota AI</span>
                    </article>
                </div>
            </div>
        </section>

        <section class="landing-section landing-section--dark" id="study-modes" aria-labelledby="modes-title">
            <div class="landing-wrap">
                <div class="landing-reveal">
                    <p class="landing-eyebrow">Chế độ học</p>
                    <h2 class="landing-section__title" id="modes-title">Bốn cách luyện từ vựng</h2>
                    <p class="landing-section__desc">
                        Chọn chế độ phù hợp từng buổi học — từ ôn nhanh đến kiểm tra ghi nhớ.
                    </p>
                </div>
                <div class="landing-modes">
                    <article class="landing-mode landing-reveal">
                        <i class="fas fa-clone" aria-hidden="true"></i>
                        <h3>Flashcard</h3>
                        <p>Lật thẻ, đánh dấu đã thuộc hoặc cần ôn lại.</p>
                    </article>
                    <article class="landing-mode landing-reveal">
                        <i class="fas fa-list-ul" aria-hidden="true"></i>
                        <h3>Trắc nghiệm</h3>
                        <p>Câu hỏi nhiều lựa chọn sinh từ bộ thẻ của bạn.</p>
                    </article>
                    <article class="landing-mode landing-reveal">
                        <i class="fas fa-keyboard" aria-hidden="true"></i>
                        <h3>Viết từ</h3>
                        <p>Gõ lại thuật ngữ để kiểm tra chính tả và ghi nhớ.</p>
                    </article>
                    <article class="landing-mode landing-reveal">
                        <i class="fas fa-puzzle-piece" aria-hidden="true"></i>
                        <h3>Ghép thẻ</h3>
                        <p>Ghép từ với nghĩa trong chế độ Matching.</p>
                    </article>
                </div>
            </div>
        </section>

        <section class="landing-section" id="ai-assistant" aria-labelledby="ai-title">
            <div class="landing-wrap landing-ai">
                <div class="landing-reveal">
                    <div class="landing-ai-mock" aria-label="Minh họa hội thoại với trợ lý AI">
                        <div class="landing-ai-mock__head">
                            <img class="landing-ai-mock__avatar"
                                 src="~/brand/mascot/stickers/tico-mascot-head-color.png"
                                 asp-append-version="true"
                                 width="36"
                                 height="36"
                                 alt=""
                                 loading="lazy"
                                 decoding="async" />
                            <span>TCT AI Assistant</span>
                        </div>
                        <div class="landing-ai-mock__body">
                            <div class="landing-bubble landing-bubble--user">
                                “Deadline” và “due date” khác nhau thế nào?
                            </div>
                            <div class="landing-bubble landing-bubble--bot">
                                <strong>Deadline</strong> nhấn mạnh mốc cứng; <strong>due date</strong> trung lập hơn — ngày cần hoàn thành.
                                Đây là ví dụ minh họa trên landing, không phải đoạn chat thật của bạn.
                            </div>
                        </div>
                    </div>
                </div>

                <div class="landing-reveal">
                    <p class="landing-eyebrow">Trợ lý AI</p>
                    <h2 class="landing-section__title" id="ai-title">Hỏi đáp và luyện hội thoại bằng tiếng Anh</h2>
                    <p class="landing-section__desc">
                        Trợ lý AI giúp giải thích từ vựng, ngữ pháp, gợi ý cách diễn đạt và luyện chat —
                        mở từ nút Tico ở góc màn hình sau khi đăng nhập.
                    </p>
                    <ul class="landing-ai-list">
                        <li>
                            <i class="fas fa-comments" aria-hidden="true"></i>
                            <div>
                                <strong>Giao tiếp bằng tiếng Anh</strong>
                                <span>Chat để luyện diễn đạt và nhận phản hồi ngay trong phiên.</span>
                            </div>
                        </li>
                        <li>
                            <i class="fas fa-spell-check" aria-hidden="true"></i>
                            <div>
                                <strong>Giải thích từ và ngữ pháp</strong>
                                <span>Hỏi nghĩa, cấu trúc câu và ví dụ dùng trong công việc.</span>
                            </div>
                        </li>
                        <li>
                            <i class="fas fa-lightbulb" aria-hidden="true"></i>
                            <div>
                                <strong>Gợi ý cách diễn đạt</strong>
                                <span>Xin cách viết email, câu lịch sự hoặc từ đồng nghĩa phù hợp ngữ cảnh.</span>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </section>

        <section class="landing-section landing-section--muted" id="progress" aria-labelledby="progress-title">
            <div class="landing-wrap landing-progress">
                <div class="landing-reveal">
                    <p class="landing-eyebrow">Theo dõi tiến độ</p>
                    <h2 class="landing-section__title" id="progress-title">Giữ nhịp học mỗi ngày</h2>
                    <p class="landing-section__desc">
                        Hệ thống mục tiêu, chuỗi ngày học và huy hiệu giúp bạn thấy rõ mình đang tiến bộ thế nào.
                    </p>
                    <div class="landing-progress-cards">
                        <article class="landing-progress-card">
                            <i class="fas fa-bullseye" aria-hidden="true"></i>
                            <h3>Mục tiêu học</h3>
                            <p>Đặt mục tiêu từ vựng / hoạt động và theo dõi trên trang Goals.</p>
                        </article>
                        <article class="landing-progress-card">
                            <i class="fas fa-fire" aria-hidden="true"></i>
                            <h3>Chuỗi ngày học</h3>
                            <p>Duy trì streak khi học liên tục; hệ thống ghi nhận chuỗi hiện tại và dài nhất.</p>
                        </article>
                        <article class="landing-progress-card">
                            <i class="fas fa-award" aria-hidden="true"></i>
                            <h3>Huy hiệu</h3>
                            <p>Nhận badge khi đạt các mốc học tập đã cấu hình trong hệ thống.</p>
                        </article>
                        <article class="landing-progress-card">
                            <i class="fas fa-users" aria-hidden="true"></i>
                            <h3>Lớp và chia sẻ</h3>
                            <p>Tạo / tham gia lớp, chia sẻ bộ thẻ và chat nhóm với đồng nghiệp.</p>
                        </article>
                    </div>
                </div>

                <div class="landing-progress__visual landing-reveal">
                    <img class="landing-tico--progress"
                         src="~/brand/mascot/poses/tico-mascot-success-color.png"
                         asp-append-version="true"
                         width="200"
                         height="240"
                         alt="Tico, linh vật TCT English"
                         loading="lazy"
                         decoding="async" />
                    <p class="landing-progress__caption">Tico đồng hành khi bạn hoàn thành mục tiêu học.</p>
                </div>
            </div>
        </section>

        <section class="landing-section" id="how-it-works" aria-labelledby="how-title">
            <div class="landing-wrap">
                <div class="landing-section__head--center landing-reveal">
                    <p class="landing-eyebrow">Cách sử dụng</p>
                    <h2 class="landing-section__title" id="how-title">Ba bước để bắt đầu</h2>
                    <p class="landing-section__desc">
                        Không cần cài phần mềm — mở trình duyệt, đăng ký và chọn nội dung học.
                    </p>
                </div>

                <div class="landing-steps">
                    <article class="landing-step landing-step--welcome landing-reveal">
                        <h3>Đăng ký tài khoản</h3>
                        <p>Tạo tài khoản miễn phí hoặc đăng nhập nếu đã có sẵn.</p>
                        <img class="landing-tico--welcome"
                             src="~/brand/mascot/poses/tico-mascot-welcome-color.png"
                             asp-append-version="true"
                             width="96"
                             height="115"
                             alt=""
                             loading="lazy"
                             decoding="async" />
                    </article>
                    <article class="landing-step landing-reveal">
                        <h3>Chọn nội dung học</h3>
                        <p>Chọn bộ thẻ, bài đọc / nghe / nói / viết phù hợp mục tiêu của bạn.</p>
                    </article>
                    <article class="landing-step landing-reveal">
                        <h3>Luyện tập và theo dõi</h3>
                        <p>Học theo chế độ flashcard hoặc quiz, rồi xem tiến độ và streak trên Goals.</p>
                    </article>
                </div>
            </div>
        </section>

        <section class="landing-section landing-section--muted" id="faq" aria-labelledby="faq-title">
            <div class="landing-wrap">
                <div class="landing-section__head--center landing-reveal">
                    <p class="landing-eyebrow">FAQ</p>
                    <h2 class="landing-section__title" id="faq-title">Câu hỏi thường gặp</h2>
                    <p class="landing-section__desc">
                        Những điểm cần biết trước khi đăng ký học trên TCT English.
                    </p>
                </div>

                <div class="landing-faq landing-reveal">
                    <details>
                        <summary>TCT English có miễn phí không?</summary>
                        <p>
                            Đăng ký và học các tính năng cơ bản là miễn phí. Một số công cụ nâng cao
                            (ví dụ tạo bài Writing bằng AI, một phần Listening / Speaking riêng tư, hoặc
                            quota AI không giới hạn) thuộc gói Premium.
                        </p>
                    </details>
                    <details>
                        <summary>Ai có thể sử dụng?</summary>
                        <p>
                            Nền tảng hướng tới nhân viên công ty TCT. Bạn cần tài khoản đăng ký để học
                            và lưu tiến độ.
                        </p>
                    </details>
                    <details>
                        <summary>Có cần cài đặt phần mềm không?</summary>
                        <p>
                            Không. TCT English chạy trên trình duyệt web — không cần cài app riêng.
                        </p>
                    </details>
                    <details>
                        <summary>Có thể học trên điện thoại không?</summary>
                        <p>
                            Có. Giao diện hỗ trợ trình duyệt trên điện thoại và máy tính bảng.
                            Một số màn hình học phức tạp vẫn thoải mái hơn trên màn hình lớn.
                        </p>
                    </details>
                    <details>
                        <summary>AI Chatbot hỗ trợ những gì?</summary>
                        <p>
                            Chat tiếng Anh, giải thích từ vựng / ngữ pháp, gợi ý diễn đạt và luyện hội thoại.
                            Tài khoản thường có hạn mức lượt dùng; Premium hoặc Admin không bị giới hạn quota AI.
                        </p>
                    </details>
                </div>
            </div>
        </section>

        <section class="landing-cta" aria-labelledby="cta-title">
            <div class="landing-wrap landing-cta__inner">
                <h2 id="cta-title">Bắt đầu học tiếng Anh trên TCT English</h2>
                <p>
                    Tạo tài khoản miễn phí để học từ vựng, luyện kỹ năng và dùng trợ lý AI theo hạn mức của gói.
                </p>
                <a class="landing-btn landing-btn--on-dark landing-btn--lg"
                   asp-controller="Account"
                   asp-action="Register">
                    Bắt đầu học miễn phí
                    <i class="fas fa-arrow-right" aria-hidden="true"></i>
                </a>
            </div>
        </section>
    </main>

