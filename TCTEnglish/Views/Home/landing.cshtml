@{
    Layout = null;

    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var pageTitle = "TCT English — Học tiếng Anh mỗi ngày 15 phút";
    var pageDescription = "Học từ vựng, nghe, nói, đọc và viết tiếng Anh theo bài ngắn. TCT English tự xếp lịch ôn để bạn nhớ lâu.";
    var pageUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Url.Content("~/")}";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle</title>
    <meta name="description" content="@pageDescription" />
    <meta name="theme-color" content="#0a0f2e" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:site_name" content="TCT English" />
    <meta property="og:title" content="@pageTitle" />
    <meta property="og:description" content="@pageDescription" />
    <meta property="og:url" content="@pageUrl" />
    <meta name="twitter:card" content="summary_large_image" />
    <script>document.documentElement.classList.add('lp-js');</script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/ai-chat-launcher.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
    <script src="~/js/landing-core.js" asp-append-version="true" defer></script>
    <script src="~/js/landing.js" asp-append-version="true" defer></script>
</head>
<body class="lp">
    <a class="lp-skip" href="#noi-dung">Bỏ qua điều hướng</a>

    <div class="lp-top">
        <header class="lp-header">
            <div class="lp-wrap">
                <nav class="lp-nav" aria-label="Điều hướng chính">
                    <a class="lp-logo" href="/">TCT English</a>
                    <div class="lp-nav-links" id="lp-nav-links">
                        <a href="#ky-nang">Kỹ năng</a>
                        <a href="#on-tap">Cách ôn tập</a>
                        <a href="#tro-ly-ai">Trợ lý AI</a>
                        <a href="/Home/Contact">Liên hệ</a>
                        @if (!isAuthenticated)
                        {
                            <a class="lp-nav-login" href="/Account/Login">Đăng nhập</a>
                        }
                    </div>
                    <div class="lp-nav-actions">
                        @if (isAuthenticated)
                        {
                            <a class="lp-btn lp-btn--sm" href="/Home/Index">Vào trang học</a>
                        }
                        else
                        {
                            <a class="lp-nav-login-link" href="/Account/Login">Đăng nhập</a>
                            <a class="lp-btn lp-btn--sm" href="/Account/Register">Bắt đầu miễn phí</a>
                        }
                    </div>
                    <button class="lp-nav-toggle" type="button" data-lp-nav-toggle aria-expanded="false" aria-controls="lp-nav-links" aria-label="Mở menu">
                        <i class="fa-solid fa-bars" aria-hidden="true"></i>
                    </button>
                </nav>
            </div>
        </header>

        <main id="noi-dung">
            <div class="lp-wrap">
                <section class="lp-hero" aria-labelledby="lp-hero-title">
                    <span class="lp-pill">
                        <img src="~/images/ai/tct-ai-mark.svg" asp-append-version="true" alt="" width="30" height="30" />
                        Có trợ lý AI trả lời mọi câu hỏi tiếng Anh
                    </span>
                    <h1 id="lp-hero-title">Tiếng Anh ngấm dần,<br />mỗi ngày 15 phút.</h1>
                    <p class="lp-sub">Học từ vựng, nghe, nói, đọc và viết theo bài ngắn. TCT English tự xếp lịch để bạn ôn lại đúng lúc sắp quên.</p>
                    <div class="lp-cta">
                        @if (isAuthenticated)
                        {
                            <a class="lp-btn" href="/Home/Index">Vào trang học</a>
                        }
                        else
                        {
                            <a class="lp-btn" href="/Account/Register">Bắt đầu miễn phí</a>
                        }
                        <a class="lp-btn lp-btn--glass" href="#hoc-thu"><i class="fa-solid fa-play" aria-hidden="true"></i>Xem cách học</a>
                    </div>

                    <div class="lp-shot">
                        <div class="lp-frame">
                            <div class="lp-frame-bar" aria-hidden="true"><i></i><i></i><i></i></div>
                            <img class="lp-frame-img"
                                 src="~/images/landing/hero-home-1120.webp"
                                 srcset="@Url.Content("~/images/landing/hero-home-1120.webp") 1110w, @Url.Content("~/images/landing/hero-home-2240.webp") 2220w"
                                 sizes="(min-width: 1100px) 1030px, calc(100vw - 36px)"
                                 width="1110" height="655" fetchpriority="high" decoding="async"
                                 alt="Trang Từ vựng của TCT English: mục tiêu hôm nay, từ cần ôn và lịch ôn 7 ngày" />
                        </div>
                        <div class="lp-chip lp-chip--1" aria-hidden="true">
                            <img src="~/images/goals/streak-flame-clay.svg" alt="" width="40" height="40" />
                            <div>Chuỗi ngày học<small>Đừng để đứt hôm nay</small></div>
                        </div>
                        <div class="lp-chip lp-chip--2" aria-hidden="true">
                            <i class="fa-regular fa-calendar-check lp-chip-icon"></i>
                            <div>negotiate<small>Ôn lại sau 7 ngày</small></div>
                        </div>
                        <div class="lp-chip lp-chip--3" aria-hidden="true">
                            <img src="~/images/goals/badge-trophy-clay.svg" alt="" width="40" height="40" />
                            <div>Huy hiệu mới<small>Nhịp từ vựng</small></div>
                        </div>
                        <div class="lp-chip lp-chip--4" aria-hidden="true">
                            <img class="lp-chip-avatar" src="~/images/ai/tct-ai-mark.svg" alt="" width="52" height="52" />
                            <div>“Deadline” khác “due date”…<small>Trợ lý AI đang trả lời</small></div>
                        </div>
                    </div>
                </section>
            </div>
        </main>
        <div class="lp-fade" aria-hidden="true"></div>
    </div>

    <div class="lp-wrap">
        <section class="lp-sec" id="hoc-thu" aria-labelledby="lp-try-title">
            <div class="lp-try">
                <div class="lp-try-copy">
                    <h2 id="lp-try-title">Thử một câu trước khi đăng ký.</h2>
                    <p class="lp-lead">Ba câu hỏi từ vựng, trả lời ngay trên trang này. Không cần tài khoản.</p>
                    <ul class="lp-tick">
                        <li><i class="fa-solid fa-circle-check" aria-hidden="true"></i>Hệ thống tự chấm, bạn chỉ cần chọn đáp án</li>
                        <li><i class="fa-solid fa-circle-check" aria-hidden="true"></i>Mỗi từ đúng được xếp ngày ôn lại</li>
                        <li><i class="fa-solid fa-circle-check" aria-hidden="true"></i>Dùng phím 1 đến 4 để trả lời nhanh</li>
                    </ul>
                </div>

                <div class="lp-quiz" data-lp-demo
                     data-lp-cta-href="@(isAuthenticated ? "/Home/Index" : "/Account/Register")"
                     data-lp-cta-label="@(isAuthenticated ? "Vào trang học" : "Tạo tài khoản miễn phí")"
                     data-lp-result-note="@(isAuthenticated ? "Vào trang học để lưu tiến độ và học tiếp." : "Tạo tài khoản để lưu tiến độ và học tiếp.")">
                    <div class="lp-quiz-play" data-lp-demo-play>
                        <div class="lp-quiz-head">
                            <span data-lp-demo-progress>Học thử · câu 1/3</span>
                            <b class="lp-quiz-tag">Từ mới</b>
                        </div>
                        <p class="lp-quiz-ask" data-lp-demo-prompt>Từ nào có nghĩa này?</p>
                        <p class="lp-quiz-word" data-lp-demo-word>đàm phán</p>
                        <ul class="lp-quiz-options" role="group" aria-label="Chọn đáp án đúng" data-lp-demo-options>
                            <li class="lp-option"><kbd>1</kbd><span class="lp-option-label">accomplish</span></li>
                            <li class="lp-option"><kbd>2</kbd><span class="lp-option-label">negotiate</span></li>
                            <li class="lp-option"><kbd>3</kbd><span class="lp-option-label">schedule</span></li>
                            <li class="lp-option"><kbd>4</kbd><span class="lp-option-label">confirm</span></li>
                        </ul>
                        <div class="lp-quiz-feedback" aria-live="polite" data-lp-demo-feedback></div>
                        <div class="lp-quiz-nojs">
                            <a class="lp-btn lp-btn--sm" href="@(isAuthenticated ? "/Home/Index" : "/Account/Register")">@(isAuthenticated ? "Vào trang học" : "Bắt đầu miễn phí")</a>
                        </div>
                    </div>
                    <div class="lp-quiz-result" data-lp-demo-result hidden></div>
                </div>
            </div>
        </section>

        <section class="lp-sec" id="ky-nang" aria-labelledby="lp-skills-title">
            <h2 id="lp-skills-title">Mọi thứ bạn cần để học đều nằm ở đây.</h2>
            <p class="lp-lead">Không phải lắp ghép nhiều ứng dụng. Một tài khoản, năm kỹ năng, một mục tiêu mỗi ngày.</p>

            <div class="lp-grid">
                <article class="lp-card lp-card--lesson">
                    <h3>Bài học từ vựng ba bước</h3>
                    <p>Làm quen, luyện tập, xem kết quả. Hệ thống tự chấm, bạn không phải tự đánh giá mình.</p>
                    <img class="lp-lesson-shot"
                         src="~/images/landing/lesson-card-780.webp"
                         srcset="@Url.Content("~/images/landing/lesson-card-780.webp") 816w, @Url.Content("~/images/landing/lesson-card-1560.webp") 1632w"
                         sizes="(min-width: 900px) 640px, calc(100vw - 80px)"
                         width="816" height="590" loading="lazy" decoding="async"
                         alt="Câu hỏi luyện tập trong một bài học từ vựng của TCT English" />
                </article>

                <article class="lp-card" id="on-tap">
                    <h3>Lịch ôn riêng cho từng từ</h3>
                    <p>Trả lời đúng, khoảng cách ôn dài dần cho đến khi thuộc hẳn. Quên thì quay về bậc đầu.</p>
                    <p class="lp-visually-hidden">Khoảng cách ôn: 1, 3, 7, 14, 30 rồi 60 ngày.</p>
                    <ol class="lp-ladder" aria-label="Các bậc khoảng cách ôn, tính bằng ngày">
                        <li style="--lp-h:30%"><b>1</b><small>ngày</small></li>
                        <li style="--lp-h:42%"><b>3</b><small>ngày</small></li>
                        <li style="--lp-h:55%"><b>7</b><small>ngày</small></li>
                        <li style="--lp-h:68%"><b>14</b><small>ngày</small></li>
                        <li style="--lp-h:84%"><b>30</b><small>ngày</small></li>
                        <li style="--lp-h:100%"><b>60</b><small>ngày</small></li>
                    </ol>
                </article>
            </div>

            <div class="lp-skills">
                <article class="lp-card lp-card--skill">
                    <span class="lp-skill-icon lp-skill-icon--cyan" aria-hidden="true"><i class="fa-solid fa-headphones"></i></span>
                    <h3>Nghe</h3>
                    <p>Video A1 đến C2, xem lời thoại, chép chính tả và làm quiz.</p>
                </article>
                <article class="lp-card lp-card--skill">
                    <span class="lp-skill-icon lp-skill-icon--violet" aria-hidden="true"><i class="fa-solid fa-microphone"></i></span>
                    <h3>Nói</h3>
                    <p>Nhại theo từng câu và xem điểm phát âm.</p>
                </article>
                <article class="lp-card lp-card--skill">
                    <span class="lp-skill-icon lp-skill-icon--amber" aria-hidden="true"><i class="fa-solid fa-pen-nib"></i></span>
                    <h3>Viết</h3>
                    <p>Viết câu tiếng Anh, nhận góp ý về nghĩa, ngữ pháp và cách dùng từ.</p>
                </article>
                <article class="lp-card lp-card--skill">
                    <span class="lp-skill-icon lp-skill-icon--green" aria-hidden="true"><i class="fa-solid fa-book-open"></i></span>
                    <h3>Đọc</h3>
                    <p>Bài đọc kèm câu hỏi kiểm tra.</p>
                </article>
            </div>

            <div class="lp-grid lp-grid--b">
                <article class="lp-card">
                    <h3>Mục tiêu, chuỗi ngày học, huy hiệu</h3>
                    <p>Đặt số từ mỗi ngày và giữ chuỗi. Học cùng bạn bè trong lớp học nhóm.</p>
                    <ul class="lp-tiles">
                        <li><img src="~/images/goals/streak-flame-clay.svg" alt="" width="40" height="40" />Chuỗi ngày học</li>
                        <li><img src="~/images/goals/goal-target-clay.svg" alt="" width="40" height="40" />Mục tiêu mỗi ngày</li>
                        <li><img src="~/images/goals/badge-trophy-clay.svg" alt="" width="40" height="40" />Huy hiệu</li>
                    </ul>
                </article>

                <article class="lp-card" id="tro-ly-ai">
                    <h3>Trợ lý AI trả lời bất cứ lúc nào</h3>
                    <p>Giải thích từ, ngữ pháp và đặt ví dụ theo tình huống của bạn.</p>
                    <div class="lp-chat" role="group" aria-label="Ví dụ hội thoại với trợ lý AI">
                        <p class="lp-bubble lp-bubble--user">“Deadline” và “due date” khác nhau thế nào?</p>
                        <div class="lp-bubble lp-bubble--bot">
                            <img src="~/images/ai/tct-ai-mark.svg" alt="" width="34" height="34" />
                            <span><b>Deadline</b> là hạn chót, trễ sẽ có hậu quả. <b>Due date</b> chỉ là ngày đến hạn.</span>
                        </div>
                    </div>
                </article>
            </div>
        </section>

        <section class="lp-sec" id="cau-hoi" aria-labelledby="lp-faq-title">
            <h2 id="lp-faq-title">Câu hỏi thường gặp</h2>
            <div class="lp-faq">
                <details class="lp-faq-item" open>
                    <summary>TCT English có miễn phí không?<span class="lp-faq-icon" aria-hidden="true"></span></summary>
                    <p>Có. Tài khoản miễn phí học được từ vựng, nghe, nói, đọc, viết và dùng trợ lý AI (có hạn mức mỗi ngày). Gói Premium mở thêm video riêng tư để luyện nói, tạo bài viết bằng AI, dịch lời thoại và quiz AI cho bài nghe.</p>
                </details>
                <details class="lp-faq-item">
                    <summary>Mỗi ngày cần học bao lâu?<span class="lp-faq-icon" aria-hidden="true"></span></summary>
                    <p>Khoảng 15 phút: ôn các từ đến hạn, học vài từ mới hoặc làm một bài nghe. Mục tiêu từ vựng mỗi ngày hiện là 10 từ.</p>
                </details>
                <details class="lp-faq-item">
                    <summary>Lịch ôn tập hoạt động thế nào?<span class="lp-faq-icon" aria-hidden="true"></span></summary>
                    <p>Mỗi từ có một bậc nhớ. Trả lời đúng, từ lên một bậc và khoảng cách ôn dài dần: 1, 3, 7, 14, 30 rồi 60 ngày. Quên thì từ quay về bậc đầu.</p>
                </details>
                <details class="lp-faq-item">
                    <summary>Tôi mới bắt đầu thì học được không?<span class="lp-faq-icon" aria-hidden="true"></span></summary>
                    <p>Được. Từ vựng và bài nghe có từ trình độ A1; bạn chọn bài theo trình độ của mình.</p>
                </details>
                <details class="lp-faq-item">
                    <summary>Có cần cài ứng dụng không?<span class="lp-faq-icon" aria-hidden="true"></span></summary>
                    <p>Không. TCT English chạy trên trình duyệt của máy tính và điện thoại.</p>
                </details>
            </div>
        </section>

        <section class="lp-end" aria-labelledby="lp-end-title">
            <h2 id="lp-end-title">Học những từ đầu tiên ngay tối nay.</h2>
            <p>Tài khoản miễn phí, học ngay trên trình duyệt.</p>
            @if (isAuthenticated)
            {
                <a class="lp-btn lp-btn--accent" href="/Home/Index">Vào trang học</a>
            }
            else
            {
                <a class="lp-btn lp-btn--accent" href="/Account/Register">Bắt đầu miễn phí</a>
            }
        </section>
    </div>

    <footer class="lp-foot">
        <div class="lp-wrap">
            <div class="lp-foot-grid">
                <div class="lp-foot-brand">
                    <a class="lp-logo" href="/">TCT English</a>
                    <p>Học từ vựng, nghe, nói, đọc và viết tiếng Anh theo bài ngắn, có lịch ôn tập tự động.</p>
                </div>
                <nav aria-labelledby="lp-foot-skills">
                    <h2 class="lp-foot-title" id="lp-foot-skills">Kỹ năng</h2>
                    <ul>
                        <li><a href="/Vocabulary">Từ vựng</a></li>
                        <li><a href="/Home/Listening">Nghe</a></li>
                        <li><a href="/Speaking">Nói</a></li>
                        <li><a href="/Home/Writing">Viết</a></li>
                        <li><a href="@(isAuthenticated ? "/Home/Reading" : "/Account/Login?returnUrl=%2FHome%2FReading")">Đọc</a></li>
                    </ul>
                </nav>
                <nav aria-labelledby="lp-foot-account">
                    <h2 class="lp-foot-title" id="lp-foot-account">Tài khoản</h2>
                    <ul>
                        @if (isAuthenticated)
                        {
                            <li><a href="/Home/Index">Vào trang học</a></li>
                        }
                        else
                        {
                            <li><a href="/Account/Login">Đăng nhập</a></li>
                            <li><a href="/Account/Register">Tạo tài khoản</a></li>
                        }
                        <li><a href="/Premium">Gói Premium</a></li>
                    </ul>
                </nav>
                <nav aria-labelledby="lp-foot-info">
                    <h2 class="lp-foot-title" id="lp-foot-info">Thông tin</h2>
                    <ul>
                        <li><a href="/Home/Introduction">Giới thiệu</a></li>
                        <li><a href="/Home/Contact">Liên hệ</a></li>
                        <li><a href="/Home/Privacypolicy">Quyền riêng tư</a></li>
                        <li><a href="/Home/Termsofuse">Điều khoản</a></li>
                    </ul>
                </nav>
            </div>
            <p class="lp-copy">© 2026 TCT English</p>
        </div>
    </footer>

    <script src="~/js/ai-chat-launcher.js" asp-append-version="true"></script>
    <partial name="~/Views/Shared/_AiChatLauncher.cshtml" />
</body>
</html>
