@{
    Layout = null;

    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var pageTitle = "TCT English — Học tiếng Anh mỗi ngày 15 phút";
    var pageDescription = "Học từ vựng, nghe, nói, đọc và viết tiếng Anh theo bài ngắn. TCT English tự xếp lịch ôn để bạn nhớ lâu.";
    var pageUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Url.Content("~/")}";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle</title>
    <meta name="description" content="@pageDescription" />
    <meta name="theme-color" content="#0a0f2e" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:site_name" content="TCT English" />
    <meta property="og:title" content="@pageTitle" />
    <meta property="og:description" content="@pageDescription" />
    <meta property="og:url" content="@pageUrl" />
    <meta name="twitter:card" content="summary_large_image" />
    <script>document.documentElement.classList.add('lp-js');</script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/ai-chat-launcher.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
    <script src="~/js/landing.js" asp-append-version="true" defer></script>
</head>
<body class="lp">
    <a class="lp-skip" href="#noi-dung">Bỏ qua điều hướng</a>

    <div class="lp-top">
        <header class="lp-header">
            <div class="lp-wrap">
                <nav class="lp-nav" aria-label="Điều hướng chính">
                    <a class="lp-logo" href="/">TCT English</a>
                    <div class="lp-nav-links" id="lp-nav-links">
                        <a href="#ky-nang">Kỹ năng</a>
                        <a href="#on-tap">Cách ôn tập</a>
                        <a href="#tro-ly-ai">Trợ lý AI</a>
                        <a href="/Home/Contact">Liên hệ</a>
                        @if (!isAuthenticated)
                        {
                            <a class="lp-nav-login" href="/Account/Login">Đăng nhập</a>
                        }
                    </div>
                    <div class="lp-nav-actions">
                        @if (isAuthenticated)
                        {
                            <a class="lp-btn lp-btn--sm" href="/Home/Index">Vào trang học</a>
                        }
                        else
                        {
                            <a class="lp-nav-login-link" href="/Account/Login">Đăng nhập</a>
                            <a class="lp-btn lp-btn--sm" href="/Account/Register">Bắt đầu miễn phí</a>
                        }
                    </div>
                    <button class="lp-nav-toggle" type="button" data-lp-nav-toggle aria-expanded="false" aria-controls="lp-nav-links" aria-label="Mở menu">
                        <i class="fa-solid fa-bars" aria-hidden="true"></i>
                    </button>
                </nav>
            </div>
        </header>

        <main id="noi-dung">
            <div class="lp-wrap">
                <section class="lp-hero" aria-labelledby="lp-hero-title">
                    <span class="lp-pill">
                        <img src="~/images/ai/tct-ai-mark.svg" asp-append-version="true" alt="" width="30" height="30" />
                        Có trợ lý AI trả lời mọi câu hỏi tiếng Anh
                    </span>
                    <h1 id="lp-hero-title">Tiếng Anh ngấm dần,<br />mỗi ngày 15 phút.</h1>
                    <p class="lp-sub">Học từ vựng, nghe, nói, đọc và viết theo bài ngắn. TCT English tự xếp lịch để bạn ôn lại đúng lúc sắp quên.</p>
                    <div class="lp-cta">
                        @if (isAuthenticated)
                        {
                            <a class="lp-btn" href="/Home/Index">Vào trang học</a>
                        }
                        else
                        {
                            <a class="lp-btn" href="/Account/Register">Bắt đầu miễn phí</a>
                        }
                        <a class="lp-btn lp-btn--glass" href="#hoc-thu"><i class="fa-solid fa-play" aria-hidden="true"></i>Xem cách học</a>
                    </div>
                </section>
            </div>
        </main>
    </div>

    <div class="lp-wrap">
        <section class="lp-sec" id="hoc-thu" aria-labelledby="lp-try-title">
            <h2 id="lp-try-title">Thử một câu trước khi đăng ký.</h2>
            <p class="lp-lead">Ba câu hỏi từ vựng, trả lời ngay trên trang này. Không cần tài khoản.</p>
        </section>

        <section class="lp-sec" id="ky-nang" aria-labelledby="lp-skills-title">
            <h2 id="lp-skills-title">Mọi thứ bạn cần để học đều nằm ở đây.</h2>
            <p class="lp-lead">Không phải lắp ghép nhiều ứng dụng. Một tài khoản, sáu kỹ năng, một mục tiêu mỗi ngày.</p>
            <div class="lp-grid">
                <article class="lp-card" id="on-tap">
                    <h3>Lịch ôn riêng cho từng từ</h3>
                    <p>Trả lời đúng, khoảng cách ôn dài dần cho đến khi thuộc hẳn. Quên thì quay về bậc đầu.</p>
                </article>
                <article class="lp-card" id="tro-ly-ai">
                    <h3>Trợ lý AI trả lời bất cứ lúc nào</h3>
                    <p>Giải thích từ, sửa ngữ pháp, đặt ví dụ theo đúng tình huống của bạn.</p>
                </article>
            </div>
        </section>
    </div>

    <footer class="lp-foot">
        <div class="lp-wrap">© 2026 TCT English</div>
    </footer>

    <script src="~/js/ai-chat-launcher.js" asp-append-version="true"></script>
    <partial name="~/Views/Shared/_AiChatLauncher.cshtml" />
</body>
</html>
