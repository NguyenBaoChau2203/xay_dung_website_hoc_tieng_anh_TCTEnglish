@model TCTVocabulary.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    // Simple display calculations (approved Q5)
    var userName    = Model.FullName ?? User.Identity?.Name ?? "Bạn";
    var nowHour     = DateTime.Now.Hour;
    var greetText   = nowHour < 12 ? "Chào buổi sáng" : nowHour < 18 ? "Chào buổi chiều" : "Chào buổi tối";
    // Streak week dots
    string[] dayNames   = { "T2","T3","T4","T5","T6","T7","CN" };
    int todayDow        = (int)DateTime.Now.DayOfWeek;
    int todayInWeek     = todayDow == 0 ? 6 : todayDow - 1;
    int litDays         = Math.Min(Model.Streak % 7 == 0 && Model.Streak > 0 ? 7 : Model.Streak % 7, 7);
    int streakStart     = Math.Max(0, todayInWeek - litDays + 1);
    // Memory bar
    var totalVocab  = Math.Max(Model.MasteredCount + Model.LearningCount + Model.NewCount, 1);
    var masteredPct = (int)Math.Round(Model.MasteredCount * 100d / totalVocab);
    var learningPct = (int)Math.Round(Model.LearningCount * 100d / totalVocab);
    var newPct      = Math.Max(0, 100 - masteredPct - learningPct);
    var hasVocab    = Model.CardCount > 0;
    // Weekly time chart
    var maxMin      = Model.FeatureTimeBreakdown.Any()
                        ? Math.Max(Model.FeatureTimeBreakdown.Max(d => d.TotalMinutes), 1)
                        : 1;
    // Continue reading
    var hasContinue = Model.RecentInProcessReading != null;
}

<link rel="stylesheet" href="~/css/Dashboard.css" />

@Html.AntiForgeryToken()

<div class="db-page tct-theme">

    @* GREETING *@
    <header class="db-greeting">
        <div>
            <p class="db-greeting__sub">@greetText</p>
            <h1 class="db-greeting__name">Xin chào, <span class="db-greeting__highlight">@userName</span>!</h1>
        </div>
        <div>
            @switch (Model.Role)
            {
                case "Admin":
                    <span class="tct-badge tct-badge--danger">Admin</span>
                    break;
                case "Premium":
                    <span class="tct-badge tct-badge--warning">Premium</span>
                    break;
                default:
                    <span class="tct-badge">Standard</span>
                    break;
            }
        </div>
    </header>

    @* ROW A: COMMAND STRIP + STREAK *@
    <div class="row g-3 mb-3">
        <div class="col-12 col-lg-8">
            <div class="db-card db-command h-100">
                @if (Model.TodayFolders.Any())
                {
                    var f = Model.TodayFolders.First();
                    <span class="db-label">@(f.IsOwnedByCurrentUser ? "Học tiếp" : "Khám phá cộng đồng")</span>
                    <p class="db-command__title">@f.FolderName</p>
                    <p class="db-command__meta">@f.SetCount bộ từ · @f.CreatorName</p>
                    @if (Model.Goal > 0)
                    {
                        <p class="db-command__goal">Hôm nay: <strong>@Model.CardsReviewedToday/@Model.Goal</strong> từ</p>
                    }
                    <a asp-controller="Folder" asp-action="FolderDetail" asp-route-id="@f.FolderId" class="db-cta-btn">
                        <i class="fa-solid fa-bolt" aria-hidden="true"></i> Học ngay
                    </a>
                }
                else
                {
                    <span class="db-label">Bắt đầu học</span>
                    <p class="db-command__title">Chưa có folder để học</p>
                    <p class="db-command__meta">Tạo folder của bạn hoặc khám phá folder từ cộng đồng</p>
                    @if (Model.Goal > 0)
                    {
                        <p class="db-command__goal">Hôm nay: <strong>@Model.CardsReviewedToday/@Model.Goal</strong> từ</p>
                    }
                    <a asp-controller="Folder" asp-action="Index" class="db-cta-btn db-cta-btn--secondary">
                        <i class="fa-solid fa-compass" aria-hidden="true"></i> Khám phá folders
                    </a>
                }
            </div>
        </div>
        <div class="col-12 col-lg-4">
            <div class="db-card h-100 d-flex flex-column align-items-center justify-content-center text-center gap-1 py-3">
                <span class="db-label">Streak</span>
                <p class="db-streak-num">@Model.Streak</p>
                <p class="db-streak-label">ngày liên tiếp</p>
                <div class="db-week-dots mt-2" aria-label="Tuần này: @litDays ngày học">
                    @for (int i = 0; i < 7; i++)
                    {
                        var on    = i >= streakStart && i <= todayInWeek ? "db-day-dot--on" : "";
                        var today = i == todayInWeek ? "db-day-dot--today" : "";
                        <span class="db-day-dot @on @today">@dayNames[i]</span>
                    }
                </div>
            </div>
        </div>
    </div>

    @* ROW B: STATS STRIP *@
    <div class="row g-3 mb-3">
        <div class="col-12">
            <div class="db-card db-stats-strip">
                <div class="db-stats-counts">
                    <div class="db-stat-item">
                        <span class="db-stat-val">@Model.CardCount</span>
                        <span class="db-stat-lbl">Thẻ từ</span>
                    </div>
                    <div class="db-stat-sep" aria-hidden="true"></div>
                    <div class="db-stat-item">
                        <span class="db-stat-val">@Model.SetCount</span>
                        <span class="db-stat-lbl">Bộ từ</span>
                    </div>
                    <div class="db-stat-sep" aria-hidden="true"></div>
                    <div class="db-stat-item">
                        <span class="db-stat-val">@Model.FolderCount</span>
                        <span class="db-stat-lbl">Folder</span>
                    </div>
                </div>
                <div class="db-memory">
                    <span class="db-label mb-2">Tiến độ từ vựng</span>
                    <div class="db-mem-bar"
                         role="img"
                         aria-label="Tiến độ: @Model.MasteredCount đã thuộc, @Model.LearningCount đang học, @Model.NewCount mới">
                        @if (hasVocab)
                        {
                            @if (masteredPct > 0)
                            {
                                <div class="db-mem-seg db-mem-seg--mastered" style="width:@masteredPct%" title="Đã thuộc: @Model.MasteredCount"></div>
                            }
                            @if (learningPct > 0)
                            {
                                <div class="db-mem-seg db-mem-seg--learning" style="width:@learningPct%" title="Đang học: @Model.LearningCount"></div>
                            }
                            @if (newPct > 0)
                            {
                                <div class="db-mem-seg db-mem-seg--new" style="width:@newPct%" title="Mới: @Model.NewCount"></div>
                            }
                        }
                        else
                        {
                            <div class="db-mem-seg db-mem-seg--empty" style="width:100%"></div>
                        }
                    </div>
                    <div class="db-mem-legend">
                        <span><span class="db-dot db-dot--green" aria-hidden="true"></span>Đã thuộc <strong>@Model.MasteredCount</strong></span>
                        <span><span class="db-dot db-dot--yellow" aria-hidden="true"></span>Đang học <strong>@Model.LearningCount</strong></span>
                        <span><span class="db-dot db-dot--blue" aria-hidden="true"></span>Mới <strong>@Model.NewCount</strong></span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* ROW C: WEEKLY TIME (pure CSS bars) *@
    <div class="row g-3 mb-3">
        <div class="col-12">
            <div class="db-card">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="db-label">Thời gian học trong tuần</span>
                    <span class="db-chart-unit">phút</span>
                </div>
                <div class="db-time-chart" role="img" aria-label="Biểu đồ thời gian học theo ngày trong tuần">
                    @if (Model.FeatureTimeBreakdown.Any())
                    {
                        @foreach (var day in Model.FeatureTimeBreakdown)
                        {
                            var barH = (int)Math.Round(day.TotalMinutes * 100.0 / maxMin);
                            <div class="db-time-col @(day.IsToday ? "db-time-col--today" : "")">
                                <div class="db-time-bar-outer">
                                    <div class="db-time-bar-wrap" style="height:@barH%">
                                        @if (day.FlashcardMinutes > 0)  { <div class="db-time-seg" style="flex:@day.FlashcardMinutes;background:var(--db-col-flash)"    title="Flashcard: @day.FlashcardMinutes p"></div> }
                                        @if (day.QuizMinutes > 0)       { <div class="db-time-seg" style="flex:@day.QuizMinutes;background:var(--db-col-quiz)"        title="Quiz: @day.QuizMinutes p"></div> }
                                        @if (day.SpeakingMinutes > 0)   { <div class="db-time-seg" style="flex:@day.SpeakingMinutes;background:var(--db-col-speaking)"  title="Speaking: @day.SpeakingMinutes p"></div> }
                                        @if (day.ReadingMinutes > 0)    { <div class="db-time-seg" style="flex:@day.ReadingMinutes;background:var(--db-col-reading)"    title="Reading: @day.ReadingMinutes p"></div> }
                                        @if (day.ListeningMinutes > 0)  { <div class="db-time-seg" style="flex:@day.ListeningMinutes;background:var(--db-col-listening)" title="Listening: @day.ListeningMinutes p"></div> }
                                        @if (day.WritingMinutes > 0)    { <div class="db-time-seg" style="flex:@day.WritingMinutes;background:var(--db-col-writing)"    title="Writing: @day.WritingMinutes p"></div> }
                                        @if (day.GrammarMinutes > 0)    { <div class="db-time-seg" style="flex:@day.GrammarMinutes;background:var(--db-col-grammar)"    title="Grammar: @day.GrammarMinutes p"></div> }
                                    </div>
                                </div>
                                <span class="db-time-label">@day.DayLabel</span>
                                @if (day.TotalMinutes > 0) { <span class="db-time-total">@day.TotalMinutes</span> }
                            </div>
                        }
                    }
                    else
                    {
                        <p class="db-chart-empty">Chưa có dữ liệu học tuần này</p>
                    }
                </div>
                <div class="db-time-legend" aria-hidden="true">
                    <span><span class="db-dot" style="background:var(--db-col-flash)"></span>Flashcard</span>
                    <span><span class="db-dot" style="background:var(--db-col-quiz)"></span>Quiz</span>
                    <span><span class="db-dot" style="background:var(--db-col-speaking)"></span>Speaking</span>
                    <span><span class="db-dot" style="background:var(--db-col-reading)"></span>Reading</span>
                    <span><span class="db-dot" style="background:var(--db-col-listening)"></span>Listening</span>
                    <span><span class="db-dot" style="background:var(--db-col-writing)"></span>Writing</span>
                    <span><span class="db-dot" style="background:var(--db-col-grammar)"></span>Grammar</span>
                </div>
            </div>
        </div>
    </div>

    @* ROW D: QUICK ACCESS + DAILY CHALLENGE *@
    <div class="row g-3 mb-3">
        <div class="col-12 col-md-6">
            <div class="db-card h-100">
                <span class="db-label d-block mb-3">Truy cập nhanh</span>
                <div class="row g-2">
                    <div class="col-4"><a asp-controller="Vocabulary" asp-action="Index"  class="db-quick-item db-quick-item--blue"><i class="fa-solid fa-clone" aria-hidden="true"></i><span>Flashcards</span></a></div>
                    <div class="col-4"><a asp-controller="Speaking"   asp-action="Index"  class="db-quick-item db-quick-item--yellow"><i class="fa-solid fa-microphone" aria-hidden="true"></i><span>Speaking</span></a></div>
                    <div class="col-4"><a asp-controller="Study"      asp-action="Reading" class="db-quick-item db-quick-item--purple"><i class="fa-solid fa-book-open" aria-hidden="true"></i><span>Reading</span></a></div>
                    <div class="col-4"><a asp-controller="Study"      asp-action="Listening" class="db-quick-item db-quick-item--blue"><i class="fa-solid fa-headphones" aria-hidden="true"></i><span>Listening</span></a></div>
                    <div class="col-4"><a asp-controller="Study"      asp-action="Writing" class="db-quick-item db-quick-item--yellow"><i class="fa-solid fa-pen-nib" aria-hidden="true"></i><span>Writing</span></a></div>
                    <div class="col-4"><a asp-controller="Vocabulary" asp-action="Index"  class="db-quick-item db-quick-item--purple"><i class="fa-solid fa-language" aria-hidden="true"></i><span>Vocabulary</span></a></div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6">
            <div class="db-card db-card--challenge h-100">
                <span class="db-label d-block mb-2">Daily Challenge</span>
                <div id="daily-challenge-content">
                    <partial name="_DailyChallenge" model="Model.DailyChallenge" />
                </div>
            </div>
        </div>
    </div>

    @* ROW E: CONTINUE READING + HEATMAP *@
    <div class="row g-3 mb-3">
        @if (hasContinue)
        {
            var r = Model.RecentInProcessReading!;
            <div class="col-12 col-md-6">
                <div class="db-card db-card--continue h-100">
                    <span class="db-label d-block mb-2">Đang đọc dở</span>
                    <p class="db-continue-title">@r.Title</p>
                    @{
                        var metaParts = new System.Collections.Generic.List<string>();
                        if (!string.IsNullOrWhiteSpace(r.Level)) metaParts.Add(r.Level);
                        if (!string.IsNullOrWhiteSpace(r.Topic)) metaParts.Add(r.Topic);
                    }
                    @if (metaParts.Count > 0)
                    {
                        <p class="db-continue-meta">@string.Join(" · ", metaParts)</p>
                    }
                    <a asp-controller="Reading" asp-action="Study" asp-route-id="@r.Id" class="db-continue-btn mt-auto">
                        <i class="fa-solid fa-arrow-right" aria-hidden="true"></i> Tiếp tục đọc
                    </a>
                </div>
            </div>
        }
        <div class="@(hasContinue ? "col-12 col-md-6" : "col-12")">
            <div class="db-card h-100">
                <span class="db-label d-block mb-3">Lịch sử ôn tập (28 ngày)</span>
                @if (Model.HeatmapCells.Any())
                {
                    <div class="db-heatmap" aria-label="Lịch sử học 28 ngày gần nhất">
                        @foreach (var cell in Model.HeatmapCells)
                        {
                            var heat = cell.ReviewedCards == 0 ? 0 : cell.ReviewedCards <= 5 ? 1 : cell.ReviewedCards <= 15 ? 2 : 3;
                            <div class="db-heat-cell db-heat--@heat"
                                 title="@cell.DayLabel @cell.WeekLabel: @cell.ReviewedCards thẻ"></div>
                        }
                    </div>
                    <div class="db-heat-legend mt-2" aria-hidden="true">
                        <span>Ít</span>
                        <span class="db-heat-swatch db-heat--0"></span>
                        <span class="db-heat-swatch db-heat--1"></span>
                        <span class="db-heat-swatch db-heat--2"></span>
                        <span class="db-heat-swatch db-heat--3"></span>
                        <span>Nhiều</span>
                    </div>
                }
                else
                {
                    <p class="text-muted" style="font-size:var(--tct-text-sm)">Chưa có dữ liệu ôn tập trong 28 ngày qua.</p>
                }
            </div>
        </div>
    </div>

</div>

<script>
document.addEventListener("DOMContentLoaded", function () {
    const container = document.getElementById("daily-challenge-content");
    if (!container) return;

    container.addEventListener("click", function (e) {
        const btn = e.target.closest(".answer-btn");
        if (!btn || btn.disabled) return;

        // Disable all buttons immediately (prevent double-submit)
        container.querySelectorAll(".answer-btn").forEach(b => { b.disabled = true; });

        const csrfToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        fetch("/Home/CheckAnswer", {
            method: "POST",
            headers: {
                "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8",
                "RequestVerificationToken": csrfToken ?? ""
            },
            body: new URLSearchParams({
                selectedCardId: btn.dataset.id,
                challengeToken: btn.dataset.token ?? ""
            }).toString()
        })
        .then(r => r.json())
        .then(data => {
            const correctId = String(data.correctCardId ?? "");
            btn.classList.add(data.correct === true ? "correct" : "wrong");
            if (data.correct !== true)
                container.querySelector(`.answer-btn[data-id="${correctId}"]`)?.classList.add("correct");
            // Wrong → new question (still incomplete). Correct → completed state. No endless XP loop.
            setTimeout(refreshChallenge, 1200);
        })
        .catch(err => {
            console.error("Lỗi:", err);
            container.querySelectorAll(".answer-btn").forEach(b => { b.disabled = false; });
        });
    });

    function refreshChallenge() {
        container.style.opacity = "0.5";
        fetch("/Home/RefreshDailyChallenge")
            .then(r => r.text())
            .then(html => { container.innerHTML = html; container.style.opacity = "1"; })
            .catch(() => { container.style.opacity = "1"; });
    }
});
</script>
