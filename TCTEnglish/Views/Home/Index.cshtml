@model TCTVocabulary.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var userName    = Model.FullName ?? User.Identity?.Name ?? "Bạn";
    var nowHour     = Model.BusinessHour;
    var greetText   = nowHour < 12 ? "Chào buổi sáng" : nowHour < 18 ? "Chào buổi chiều" : "Chào buổi tối";
    var totalVocab  = Math.Max(Model.MasteredCount + Model.LearningCount + Model.NewCount, 1);
    var masteredPct = (int)Math.Round(Model.MasteredCount * 100d / totalVocab);
    var learningPct = (int)Math.Round(Model.LearningCount * 100d / totalVocab);
    var newPct      = Math.Max(0, 100 - masteredPct - learningPct);
    var hasVocab    = Model.CardCount > 0;
    var maxMin      = Model.FeatureTimeBreakdown.Any()
                        ? Math.Max(Model.FeatureTimeBreakdown.Max(d => d.TotalMinutes), 1)
                        : 1;
    var weekHasMinutes = Model.FeatureTimeBreakdown.Any(d => d.TotalMinutes > 0);
    var hasContinue = Model.RecentInProcessReading != null;
    var commandGoalPct = Model.Goal > 0
        ? Math.Clamp((int)Math.Round(Model.CardsReviewedToday * 100d / Model.Goal), 0, 100)
        : 0;
    var goalLines = Model.ActiveGoalCount > 0 && !string.IsNullOrWhiteSpace(Model.DailyGoalSummary)
        ? Model.DailyGoalSummary.Split(';', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        : Array.Empty<string>();
    var primaryFolder = Model.TodayFolders.FirstOrDefault();
    var secondaryFolders = Model.TodayFolders.Skip(1).Take(2).ToList();
}

<link rel="stylesheet" href="~/css/Dashboard.css" asp-append-version="true" />

@Html.AntiForgeryToken()

<div class="db-page tct-theme">

    <header class="db-greeting">
        <div class="db-greeting__lead">
            <div class="db-tico db-tico--greeting" aria-hidden="true">
                <img src="~/brand/mascot/poses/tico-mascot-welcome-color.png"
                     alt=""
                     width="88"
                     height="88"
                     decoding="async" />
            </div>
            <div class="db-greeting__text">
                <p class="db-greeting__sub">@greetText</p>
                <h1 class="db-greeting__name">Xin chào, <span class="db-greeting__highlight">@userName</span>!</h1>
            </div>
        </div>
        <div class="db-greeting__aside">
            <div class="db-xp-chip" aria-label="Tổng @Model.TotalXp XP@(Model.TodayXp > 0 ? $", hôm nay +{Model.TodayXp}" : "")">
                <span class="db-xp-chip__val">@Model.TotalXp <span class="db-xp-chip__unit">XP</span></span>
                @if (Model.TodayXp > 0)
                {
                    <span class="db-xp-chip__today">Hôm nay +@Model.TodayXp</span>
                }
            </div>
            @switch (Model.Role)
            {
                case "Admin":
                    <span class="tct-badge tct-badge--danger">Admin</span>
                    break;
                case "Premium":
                    <span class="tct-badge tct-badge--warning">Premium</span>
                    break;
                default:
                    <span class="tct-badge">Standard</span>
                    break;
            }
        </div>
    </header>

    <div class="row g-3 mb-3 db-bento-row">
        <div class="col-12 col-lg-8">
            <div class="db-card db-command h-100">
                @if (primaryFolder != null)
                {
                    <span class="db-label">@(primaryFolder.IsOwnedByCurrentUser ? "Học tiếp" : "Khám phá cộng đồng")</span>
                    <p class="db-command__title">@primaryFolder.FolderName</p>
                    <p class="db-command__meta">@primaryFolder.SetCount bộ từ · @primaryFolder.CreatorName</p>
                    @if (Model.Goal > 0)
                    {
                        <div class="db-command__progress">
                            <div class="db-command__progress-head">
                                <span>Mục tiêu hôm nay:</span>
                                <strong>@Model.CardsReviewedToday/@Model.Goal thẻ</strong>
                            </div>
                            <div class="db-command__track"
                                 role="progressbar"
                                 aria-valuemin="0"
                                 aria-valuemax="100"
                                 aria-valuenow="@commandGoalPct"
                                 aria-label="Tiến độ thẻ hôm nay @commandGoalPct phần trăm">
                                <div class="db-command__fill" style="width:@commandGoalPct%"></div>
                            </div>
                        </div>
                    }
                    <a asp-controller="Folder" asp-action="FolderDetail" asp-route-id="@primaryFolder.FolderId" class="db-cta-btn">
                        <i class="fa-solid fa-bolt" aria-hidden="true"></i> Học ngay
                    </a>
                    @if (secondaryFolders.Count > 0)
                    {
                        <div class="db-command__more" aria-label="Folder khác">
                            @foreach (var f in secondaryFolders)
                            {
                                <a asp-controller="Folder"
                                   asp-action="FolderDetail"
                                   asp-route-id="@f.FolderId"
                                   class="db-folder-chip"
                                   title="@f.FolderName">
                                    <i class="fa-solid fa-folder" aria-hidden="true"></i>
                                    <span class="db-folder-chip__name">@f.FolderName</span>
                                    <span class="db-folder-chip__meta">@f.SetCount bộ</span>
                                </a>
                            }
                        </div>
                    }
                }
                else
                {
                    <span class="db-label">Bắt đầu học</span>
                    <p class="db-command__title">Chưa có folder để học</p>
                    <p class="db-command__meta">Tạo folder của bạn hoặc khám phá folder từ cộng đồng</p>
                    @if (Model.Goal > 0)
                    {
                        <div class="db-command__progress">
                            <div class="db-command__progress-head">
                                <span>Mục tiêu hôm nay:</span>
                                <strong>@Model.CardsReviewedToday/@Model.Goal thẻ</strong>
                            </div>
                            <div class="db-command__track"
                                 role="progressbar"
                                 aria-valuemin="0"
                                 aria-valuemax="100"
                                 aria-valuenow="@commandGoalPct"
                                 aria-label="Tiến độ thẻ hôm nay @commandGoalPct phần trăm">
                                <div class="db-command__fill" style="width:@commandGoalPct%"></div>
                            </div>
                        </div>
                    }
                    <a asp-controller="Folder" asp-action="Index" class="db-cta-btn db-cta-btn--secondary">
                        <i class="fa-solid fa-compass" aria-hidden="true"></i> Khám phá folders
                    </a>
                }
            </div>
        </div>
        <div class="col-12 col-lg-4">
            <div class="db-card db-streak h-100">
                <span class="db-label">Streak</span>
                <div class="db-streak-flame" aria-hidden="true">
                    <span class="db-streak-flame__glow"></span>
                    <svg class="db-streak-flame__svg" viewBox="0 0 64 80" width="60" height="75" focusable="false">
                        <defs>
                            <radialGradient id="db-streak-flame-ambient" cx="50%" cy="62%" r="55%">
                                <stop offset="0%" stop-color="#FFD54F" stop-opacity="0.65" />
                                <stop offset="45%" stop-color="#FFAA32" stop-opacity="0.32" />
                                <stop offset="100%" stop-color="#FF5722" stop-opacity="0" />
                            </radialGradient>
                            <linearGradient id="db-streak-flame-outer-grad" x1="32" y1="4" x2="32" y2="74" gradientUnits="userSpaceOnUse">
                                <stop offset="0%" stop-color="#FFAA32" />
                                <stop offset="40%" stop-color="#FF7628" />
                                <stop offset="100%" stop-color="#FF5722" />
                            </linearGradient>
                            <linearGradient id="db-streak-flame-mid-grad" x1="32" y1="20" x2="32" y2="70" gradientUnits="userSpaceOnUse">
                                <stop offset="0%" stop-color="#FFF3B0" />
                                <stop offset="45%" stop-color="#FFD54F" />
                                <stop offset="100%" stop-color="#FFAA32" />
                            </linearGradient>
                            <linearGradient id="db-streak-flame-inner-grad" x1="32" y1="34" x2="32" y2="68" gradientUnits="userSpaceOnUse">
                                <stop offset="0%" stop-color="#FFFFFF" stop-opacity="0.95" />
                                <stop offset="35%" stop-color="#FFF3B0" />
                                <stop offset="100%" stop-color="#FFD54F" />
                            </linearGradient>
                            <filter id="db-streak-flame-soft" x="-40%" y="-40%" width="180%" height="180%">
                                <feGaussianBlur in="SourceGraphic" stdDeviation="0.85" result="blur" />
                                <feMerge>
                                    <feMergeNode in="blur" />
                                    <feMergeNode in="SourceGraphic" />
                                </feMerge>
                            </filter>
                        </defs>

                        <ellipse class="db-streak-flame__ambient" cx="32" cy="54" rx="28" ry="30" fill="url(#db-streak-flame-ambient)" />

                        <g class="db-streak-flame__motion">
                            <path class="db-streak-flame__outer" fill="url(#db-streak-flame-outer-grad)" filter="url(#db-streak-flame-soft)"
                                  d="M32 4 C42 16 56 28 56 48 C56 66 44 76 32 76 C20 76 8 66 8 48 C8 28 20 14 28 8 C30 18 31 24 32 22 C34 12 30 6 32 4 Z">
                                <animate attributeName="d" dur="1.65s" repeatCount="indefinite" calcMode="spline"
                                         keyTimes="0;0.28;0.55;0.78;1"
                                         keySplines="0.42 0 0.58 1;0.42 0 0.58 1;0.42 0 0.58 1;0.42 0 0.58 1"
                                         values="
M32 4 C42 16 56 28 56 48 C56 66 44 76 32 76 C20 76 8 66 8 48 C8 28 20 14 28 8 C30 18 31 24 32 22 C34 12 30 6 32 4 Z;
M38 3 C48 14 58 26 54 48 C52 66 42 76 32 76 C22 76 10 64 12 44 C16 26 26 14 34 7 C35 17 36 22 37 20 C40 10 36 5 38 3 Z;
M26 3 C34 14 52 24 58 46 C60 66 46 76 32 76 C16 76 6 64 6 46 C6 26 16 14 22 7 C24 17 26 23 27 21 C28 11 24 5 26 3 Z;
M34 5 C46 15 57 30 55 50 C53 66 43 76 32 76 C21 76 9 65 10 47 C12 29 22 16 30 9 C31 19 33 24 34 22 C36 13 32 7 34 5 Z;
M32 4 C42 16 56 28 56 48 C56 66 44 76 32 76 C20 76 8 66 8 48 C8 28 20 14 28 8 C30 18 31 24 32 22 C34 12 30 6 32 4 Z" />
                            </path>
                            <path class="db-streak-flame__mid" fill="url(#db-streak-flame-mid-grad)"
                                  d="M32 22 C42 32 50 42 50 54 C50 68 41 72 32 72 C23 72 14 68 14 54 C14 42 22 34 28 28 C29 34 31 37 32 36 C34 30 30 24 32 22 Z">
                                <animate attributeName="d" dur="1.1s" repeatCount="indefinite" calcMode="spline"
                                         keyTimes="0;0.3;0.62;1"
                                         keySplines="0.4 0 0.6 1;0.4 0 0.6 1;0.4 0 0.6 1"
                                         values="
M32 22 C42 32 50 42 50 54 C50 68 41 72 32 72 C23 72 14 68 14 54 C14 42 22 34 28 28 C29 34 31 37 32 36 C34 30 30 24 32 22 Z;
M36 20 C46 30 52 40 48 54 C45 68 40 72 32 72 C24 72 15 66 17 51 C20 40 28 32 33 26 C34 32 36 35 37 34 C39 28 34 22 36 20 Z;
M28 21 C36 31 48 40 52 54 C54 68 42 72 32 72 C22 72 12 66 13 52 C14 40 20 33 25 27 C26 33 28 36 29 35 C30 29 26 23 28 21 Z;
M32 22 C42 32 50 42 50 54 C50 68 41 72 32 72 C23 72 14 68 14 54 C14 42 22 34 28 28 C29 34 31 37 32 36 C34 30 30 24 32 22 Z" />
                            </path>
                            <path class="db-streak-flame__inner" fill="url(#db-streak-flame-inner-grad)"
                                  d="M32 38 C39 45 44 52 44 58 C44 67 38 70 32 70 C26 70 20 67 20 58 C20 52 25 45 30 40 C30 45 31 48 32 47 C34 43 31 39 32 38 Z">
                                <animate attributeName="d" dur="0.72s" repeatCount="indefinite" calcMode="spline"
                                         keyTimes="0;0.35;0.7;1"
                                         keySplines="0.37 0 0.63 1;0.37 0 0.63 1;0.37 0 0.63 1"
                                         values="
M32 38 C39 45 44 52 44 58 C44 67 38 70 32 70 C26 70 20 67 20 58 C20 52 25 45 30 40 C30 45 31 48 32 47 C34 43 31 39 32 38 Z;
M35 35 C41 42 45 50 42 58 C40 67 37 70 32 70 C27 70 21 65 23 56 C25 50 29 43 33 38 C33 43 34 46 35 45 C37 40 34 36 35 35 Z;
M29 36 C35 43 43 51 45 58 C46 67 39 70 32 70 C25 70 19 65 19 58 C19 51 23 45 27 40 C27 45 28 48 29 47 C30 42 28 37 29 36 Z;
M32 38 C39 45 44 52 44 58 C44 67 38 70 32 70 C26 70 20 67 20 58 C20 52 25 45 30 40 C30 45 31 48 32 47 C34 43 31 39 32 38 Z" />
                            </path>
                            <ellipse class="db-streak-flame__core" cx="32" cy="61" rx="6" ry="8" fill="#FFF3B0" opacity="0.95" />
                        </g>

                        <g class="db-streak-flame__still">
                            <path fill="url(#db-streak-flame-outer-grad)" filter="url(#db-streak-flame-soft)"
                                  d="M32 4 C42 16 56 28 56 48 C56 66 44 76 32 76 C20 76 8 66 8 48 C8 28 20 14 28 8 C30 18 31 24 32 22 C34 12 30 6 32 4 Z" />
                            <path fill="url(#db-streak-flame-mid-grad)"
                                  d="M32 22 C42 32 50 42 50 54 C50 68 41 72 32 72 C23 72 14 68 14 54 C14 42 22 34 28 28 C29 34 31 37 32 36 C34 30 30 24 32 22 Z" />
                            <path fill="url(#db-streak-flame-inner-grad)"
                                  d="M32 38 C39 45 44 52 44 58 C44 67 38 70 32 70 C26 70 20 67 20 58 C20 52 25 45 30 40 C30 45 31 48 32 47 C34 43 31 39 32 38 Z" />
                            <ellipse cx="32" cy="61" rx="6" ry="8" fill="#FFF3B0" opacity="0.95" />
                        </g>

                        <g class="db-streak-flame__embers">
                            <circle class="db-streak-flame__ember db-streak-flame__ember--1" cx="46" cy="26" r="1.8" fill="#FFD54F" />
                            <circle class="db-streak-flame__ember db-streak-flame__ember--2" cx="20" cy="32" r="1.4" fill="#FFAA32" />
                            <circle class="db-streak-flame__ember db-streak-flame__ember--3" cx="40" cy="14" r="1.3" fill="#FFF3B0" />
                            <circle class="db-streak-flame__ember db-streak-flame__ember--4" cx="24" cy="18" r="1.1" fill="#FF7628" />
                        </g>
                    </svg>
                </div>
                <p class="db-streak-num">@Model.Streak</p>
                <p class="db-streak-label">ngày liên tiếp</p>
                <div class="db-week-dots mt-2" aria-label="7 ngày gần nhất: @Model.StudyDays.Count(d => d.HasConfirmedStudy) ngày học đã xác nhận">
                    @foreach (var day in Model.StudyDays)
                    {
                        var on = day.HasConfirmedStudy ? "db-day-dot--on" : "";
                        var today = day.IsToday ? "db-day-dot--today" : "";
                        <span class="db-day-dot @on @today" title="@day.FullLabel: @day.StudyLabel" aria-label="@day.FullLabel: @day.StudyLabel">@day.DayLabel</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <section class="db-card db-goals mb-3" aria-label="Mục tiêu học hôm nay">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
            <div class="db-goals__copy min-w-0 flex-grow-1">
                <span class="db-label">Mục tiêu hôm nay</span>
                @if (Model.ActiveGoalCount <= 0)
                {
                    <p class="db-goals__summary mb-0">Chọn kỹ năng và đặt mục tiêu để bắt đầu.</p>
                }
                else if (goalLines.Length > 0)
                {
                    <ul class="db-goals__list">
                        @foreach (var line in goalLines)
                        {
                            <li class="db-goals__item">
                                <i class="fa-solid fa-circle-check db-goals__icon" aria-hidden="true"></i>
                                <span>@line</span>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="db-goals__summary mb-0">@Model.DailyGoalSummary</p>
                }
            </div>
            <a asp-controller="Goals" asp-action="Index" class="btn btn-outline-primary btn-sm db-goals__link">Xem mục tiêu</a>
        </div>
        @if (Model.ActiveGoalCount > 0)
        {
            var goalPct = Math.Clamp(Model.DailyGoalPercent, 0, 100);
            var goalsDone = Model.MetGoalCount >= Model.ActiveGoalCount && Model.ActiveGoalCount > 0;
            <div class="db-goals__track mt-3"
                 role="progressbar"
                 aria-valuemin="0"
                 aria-valuemax="100"
                 aria-valuenow="@goalPct"
                 aria-label="Tiến độ mục tiêu hôm nay @goalPct phần trăm">
                <div class="db-goals__fill @(goalsDone ? "db-goals__fill--done" : "")" style="width:@goalPct%"></div>
            </div>
            <p class="db-goals__meta mb-0">Đã đạt <strong>@Model.MetGoalCount/@Model.ActiveGoalCount</strong> mục tiêu · <strong>@Model.DailyGoalPercent%</strong></p>
        }
    </section>

    <div class="row g-3 mb-3">
        <div class="col-12">
            <div class="db-card db-stats-strip">
                <div class="db-stats-counts">
                    <div class="db-stat-item">
                        <span class="db-stat-icon db-stat-icon--cards" aria-hidden="true"><i class="fa-solid fa-clone"></i></span>
                        <span class="db-stat-val">@Model.CardCount</span>
                        <span class="db-stat-lbl">Thẻ từ</span>
                    </div>
                    <div class="db-stat-item">
                        <span class="db-stat-icon db-stat-icon--sets" aria-hidden="true"><i class="fa-solid fa-layer-group"></i></span>
                        <span class="db-stat-val">@Model.SetCount</span>
                        <span class="db-stat-lbl">Bộ từ</span>
                    </div>
                    <div class="db-stat-item">
                        <span class="db-stat-icon db-stat-icon--folders" aria-hidden="true"><i class="fa-solid fa-folder"></i></span>
                        <span class="db-stat-val">@Model.FolderCount</span>
                        <span class="db-stat-lbl">Folder</span>
                    </div>
                </div>
                <div class="db-memory">
                    <span class="db-label mb-2">Tiến độ từ vựng</span>
                    <div class="db-mem-bar"
                         role="img"
                         aria-label="Tiến độ: @Model.MasteredCount đã thuộc, @Model.LearningCount đang học, @Model.NewCount mới"
                         data-db-float-root="vocab">
                        @if (hasVocab)
                        {
                            @if (masteredPct > 0)
                            {
                                <div class="db-mem-seg db-mem-seg--mastered"
                                     style="width:@masteredPct%"
                                     tabindex="0"
                                     role="button"
                                     data-db-float="vocab"
                                     data-label="Đã thuộc"
                                     data-count="@Model.MasteredCount"
                                     data-total="@Model.CardCount"
                                     data-pct="@masteredPct"
                                     data-accent="var(--tct-success)"
                                     aria-label="Đã thuộc: @Model.MasteredCount thẻ"></div>
                            }
                            @if (learningPct > 0)
                            {
                                <div class="db-mem-seg db-mem-seg--learning"
                                     style="width:@learningPct%"
                                     tabindex="0"
                                     role="button"
                                     data-db-float="vocab"
                                     data-label="Đang học"
                                     data-count="@Model.LearningCount"
                                     data-total="@Model.CardCount"
                                     data-pct="@learningPct"
                                     data-accent="var(--tct-warning)"
                                     aria-label="Đang học: @Model.LearningCount thẻ"></div>
                            }
                            @if (newPct > 0)
                            {
                                <div class="db-mem-seg db-mem-seg--new"
                                     style="width:@newPct%"
                                     tabindex="0"
                                     role="button"
                                     data-db-float="vocab"
                                     data-label="Mới"
                                     data-count="@Model.NewCount"
                                     data-total="@Model.CardCount"
                                     data-pct="@newPct"
                                     data-accent="var(--tct-primary)"
                                     aria-label="Mới: @Model.NewCount thẻ"></div>
                            }
                        }
                        else
                        {
                            <div class="db-mem-seg db-mem-seg--empty" style="width:100%"></div>
                        }
                    </div>
                    <div class="db-mem-legend">
                        <span><span class="db-dot db-dot--green" aria-hidden="true"></span>Đã thuộc <strong>@Model.MasteredCount</strong></span>
                        <span><span class="db-dot db-dot--yellow" aria-hidden="true"></span>Đang học <strong>@Model.LearningCount</strong></span>
                        <span><span class="db-dot db-dot--blue" aria-hidden="true"></span>Mới <strong>@Model.NewCount</strong></span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-3 db-bento-row">
        <div class="col-12 col-lg-7">
            <div class="db-card db-time-block h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="db-label">Thời gian học trong tuần</span>
                    <span class="db-chart-unit">phút</span>
                </div>
                <div class="db-time-chart-shell" data-db-float-root="weekly">
                    @if (Model.FeatureTimeBreakdown.Any())
                    {
                        <div class="db-time-yscale" aria-hidden="true">
                            <span>@maxMin</span>
                            @if (maxMin >= 2)
                            {
                                <span>@(maxMin / 2)</span>
                            }
                            <span>0</span>
                        </div>
                        <div class="db-time-chart @(weekHasMinutes ? "" : "db-time-chart--empty")" role="img" aria-label="Biểu đồ thời gian học theo ngày trong tuần">
                            @foreach (var day in Model.FeatureTimeBreakdown)
                            {
                                var barH = (int)Math.Round(day.TotalMinutes * 100.0 / maxMin);
                                var dayTotal = day.TotalMinutes;
                                <div class="db-time-col @(day.IsToday ? "db-time-col--today" : "")">
                                    @if (day.IsToday)
                                    {
                                        <span class="db-time-today-badge">Hôm nay</span>
                                    }
                                    <div class="db-time-bar-outer">
                                        <div class="db-time-bar-wrap" style="height:@(Math.Max(barH, dayTotal > 0 ? 4 : 0))%">
                                            @if (day.FlashcardMinutes > 0)
                                            {
                                                <div class="db-time-seg"
                                                     style="flex:@day.FlashcardMinutes;background:var(--db-col-flash)"
                                                     tabindex="0"
                                                     role="button"
                                                     data-db-float="weekly"
                                                     data-day="@day.DayLabel"
                                                     data-date="@day.FullDate"
                                                     data-skill="Flashcard"
                                                     data-minutes="@day.FlashcardMinutes"
                                                     data-total="@dayTotal"
                                                     data-accent="var(--db-col-flash)"
                                                     aria-label="@day.FullDate Flashcard @day.FlashcardMinutes phút"></div>
                                            }
                                            @if (day.QuizMinutes > 0)
                                            {
                                                <div class="db-time-seg"
                                                     style="flex:@day.QuizMinutes;background:var(--db-col-quiz)"
                                                     tabindex="0"
                                                     role="button"
                                                     data-db-float="weekly"
                                                     data-day="@day.DayLabel"
                                                     data-date="@day.FullDate"
                                                     data-skill="Quiz"
                                                     data-minutes="@day.QuizMinutes"
                                                     data-total="@dayTotal"
                                                     data-accent="var(--db-col-quiz)"
                                                     aria-label="@day.FullDate Quiz @day.QuizMinutes phút"></div>
                                            }
                                            @if (day.SpeakingMinutes > 0)
                                            {
                                                <div class="db-time-seg"
                                                     style="flex:@day.SpeakingMinutes;background:var(--db-col-speaking)"
                                                     tabindex="0"
                                                     role="button"
                                                     data-db-float="weekly"
                                                     data-day="@day.DayLabel"
                                                     data-date="@day.FullDate"
                                                     data-skill="Speaking"
                                                     data-minutes="@day.SpeakingMinutes"
                                                     data-total="@dayTotal"
                                                     data-accent="var(--db-col-speaking)"
                                                     aria-label="@day.FullDate Speaking @day.SpeakingMinutes phút"></div>
                                            }
                                            @if (day.ReadingMinutes > 0)
                                            {
                                                <div class="db-time-seg"
                                                     style="flex:@day.ReadingMinutes;background:var(--db-col-reading)"
                                                     tabindex="0"
                                                     role="button"
                                                     data-db-float="weekly"
                                                     data-day="@day.DayLabel"
                                                     data-date="@day.FullDate"
                                                     data-skill="Reading"
                                                     data-minutes="@day.ReadingMinutes"
                                                     data-total="@dayTotal"
                                                     data-accent="var(--db-col-reading)"
                                                     aria-label="@day.FullDate Reading @day.ReadingMinutes phút"></div>
                                            }
                                            @if (day.ListeningMinutes > 0)
                                            {
                                                <div class="db-time-seg"
                                                     style="flex:@day.ListeningMinutes;background:var(--db-col-listening)"
                                                     tabindex="0"
                                                     role="button"
                                                     data-db-float="weekly"
                                                     data-day="@day.DayLabel"
                                                     data-date="@day.FullDate"
                                                     data-skill="Listening"
                                                     data-minutes="@day.ListeningMinutes"
                                                     data-total="@dayTotal"
                                                     data-accent="var(--db-col-listening)"
                                                     aria-label="@day.FullDate Listening @day.ListeningMinutes phút"></div>
                                            }
                                            @if (day.WritingMinutes > 0)
                                            {
                                                <div class="db-time-seg"
                                                     style="flex:@day.WritingMinutes;background:var(--db-col-writing)"
                                                     tabindex="0"
                                                     role="button"
                                                     data-db-float="weekly"
                                                     data-day="@day.DayLabel"
                                                     data-date="@day.FullDate"
                                                     data-skill="Writing"
                                                     data-minutes="@day.WritingMinutes"
                                                     data-total="@dayTotal"
                                                     data-accent="var(--db-col-writing)"
                                                     aria-label="@day.FullDate Writing @day.WritingMinutes phút"></div>
                                            }
                                            @if (day.GrammarMinutes > 0)
                                            {
                                                <div class="db-time-seg"
                                                     style="flex:@day.GrammarMinutes;background:var(--db-col-grammar)"
                                                     tabindex="0"
                                                     role="button"
                                                     data-db-float="weekly"
                                                     data-day="@day.DayLabel"
                                                     data-date="@day.FullDate"
                                                     data-skill="Grammar"
                                                     data-minutes="@day.GrammarMinutes"
                                                     data-total="@dayTotal"
                                                     data-accent="var(--db-col-grammar)"
                                                     aria-label="@day.FullDate Grammar @day.GrammarMinutes phút"></div>
                                            }
                                        </div>
                                    </div>
                                    <span class="db-time-label">@day.DayLabel</span>
                                    @if (day.TotalMinutes > 0) { <span class="db-time-total">@day.TotalMinutes</span> }
                                </div>
                            }
                        </div>
                        @if (!weekHasMinutes)
                        {
                            <p class="db-chart-empty db-chart-empty--overlay">Chưa có dữ liệu học tuần này</p>
                        }
                    }
                    else
                    {
                        <p class="db-chart-empty">Chưa có dữ liệu học tuần này</p>
                    }
                </div>
                <div class="db-time-legend" aria-hidden="true">
                    <span class="db-legend-pill"><span class="db-dot" style="background:var(--db-col-flash)"></span>Flashcard</span>
                    <span class="db-legend-pill"><span class="db-dot" style="background:var(--db-col-quiz)"></span>Quiz</span>
                    <span class="db-legend-pill"><span class="db-dot" style="background:var(--db-col-speaking)"></span>Speaking</span>
                    <span class="db-legend-pill"><span class="db-dot" style="background:var(--db-col-reading)"></span>Reading</span>
                    <span class="db-legend-pill"><span class="db-dot" style="background:var(--db-col-listening)"></span>Listening</span>
                    <span class="db-legend-pill"><span class="db-dot" style="background:var(--db-col-writing)"></span>Writing</span>
                    <span class="db-legend-pill"><span class="db-dot" style="background:var(--db-col-grammar)"></span>Grammar</span>
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-5">
            <div class="db-card db-heat-card h-100">
                <span class="db-label d-block mb-3">Lịch sử ôn tập (28 ngày)</span>
                @if (Model.HeatmapCells.Any())
                {
                    <div class="db-heatmap" aria-label="Lịch sử học 28 ngày gần nhất" data-db-float-root="heatmap">
                        @foreach (var cell in Model.HeatmapCells)
                        {
                            var heat = cell.ReviewedCards == 0 ? 0 : cell.ReviewedCards <= 5 ? 1 : cell.ReviewedCards <= 15 ? 2 : 3;
                            var heatLabel = heat == 0 ? "Không hoạt động" : heat == 1 ? "Ít" : heat == 2 ? "Trung bình" : "Nhiều";
                            <div class="db-heat-cell db-heat--@heat"
                                 tabindex="0"
                                 role="button"
                                 data-db-float="heatmap"
                                 data-day="@cell.DayLabel"
                                 data-date="@cell.FullDate"
                                 data-week="@cell.WeekLabel"
                                 data-reviewed="@cell.ReviewedCards"
                                 data-intensity="@heat"
                                 data-intensity-label="@heatLabel"
                                 data-accent="var(--tct-primary)"
                                 aria-label="@(string.IsNullOrEmpty(cell.FullDate) ? $"{cell.DayLabel} {cell.WeekLabel}" : cell.FullDate): @cell.ReviewedCards thẻ"></div>
                        }
                    </div>
                    <div class="db-heat-legend mt-2" aria-hidden="true">
                        <span>Ít</span>
                        <span class="db-heat-swatch db-heat--0"></span>
                        <span class="db-heat-swatch db-heat--1"></span>
                        <span class="db-heat-swatch db-heat--2"></span>
                        <span class="db-heat-swatch db-heat--3"></span>
                        <span>Nhiều</span>
                    </div>
                }
                else
                {
                    <p class="db-heat-empty">Chưa có dữ liệu ôn tập trong 28 ngày qua.</p>
                }
            </div>
        </div>
    </div>

    <div class="row g-3 mb-3 db-bento-row">
        <div class="col-12 col-md-6">
            <div class="db-card h-100">
                <span class="db-label d-block mb-3">Truy cập nhanh</span>
                <div class="row g-2">
                    <div class="col-4"><a asp-controller="Vocabulary" asp-action="Index"  class="db-quick-item db-quick-item--blue"><span class="db-quick-icon" aria-hidden="true"><i class="fa-solid fa-clone"></i></span><span>Flashcards</span></a></div>
                    <div class="col-4"><a asp-controller="Speaking"   asp-action="Index"  class="db-quick-item db-quick-item--yellow"><span class="db-quick-icon" aria-hidden="true"><i class="fa-solid fa-microphone"></i></span><span>Speaking</span></a></div>
                    <div class="col-4"><a asp-controller="Study"      asp-action="Reading" class="db-quick-item db-quick-item--teal"><span class="db-quick-icon" aria-hidden="true"><i class="fa-solid fa-book-open"></i></span><span>Reading</span></a></div>
                    <div class="col-4"><a asp-controller="Study"      asp-action="Listening" class="db-quick-item db-quick-item--blue"><span class="db-quick-icon" aria-hidden="true"><i class="fa-solid fa-headphones"></i></span><span>Listening</span></a></div>
                    <div class="col-4"><a asp-controller="Study"      asp-action="Writing" class="db-quick-item db-quick-item--yellow"><span class="db-quick-icon" aria-hidden="true"><i class="fa-solid fa-pen-nib"></i></span><span>Writing</span></a></div>
                    <div class="col-4"><a asp-controller="Goals"      asp-action="Index"  class="db-quick-item db-quick-item--teal"><span class="db-quick-icon" aria-hidden="true"><i class="fa-solid fa-bullseye"></i></span><span>Goals</span></a></div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6">
            <div class="db-card db-card--challenge h-100">
                <span class="db-label d-block mb-2">Thử thách hôm nay</span>
                <div id="daily-challenge-content">
                    <partial name="_DailyChallenge" model="Model.DailyChallenge" />
                </div>
            </div>
        </div>
    </div>

    @if (hasContinue)
    {
        var r = Model.RecentInProcessReading!;
        var continueTopic = string.IsNullOrWhiteSpace(r.Topic) ? null : r.Topic.Trim();
        <div class="row g-3 mb-3">
            <div class="col-12">
                <article class="db-card db-card--continue db-continue">
                    <div class="db-continue__media" aria-hidden="true">
                        @if (!string.IsNullOrWhiteSpace(r.ImageUrl))
                        {
                            <img class="db-continue__img"
                                 src="@r.ImageUrl"
                                 alt=""
                                 width="480"
                                 height="300"
                                 loading="lazy"
                                 decoding="async" />
                        }
                        else
                        {
                            <div class="db-continue__placeholder">
                                <i class="fa-solid fa-book-open"></i>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(r.Level))
                        {
                            <span class="db-continue__level">@r.Level</span>
                        }
                    </div>
                    <div class="db-continue__body">
                        <span class="db-label">Đang đọc dở</span>
                        <p class="db-continue-title">@r.Title</p>
                        @if (!string.IsNullOrWhiteSpace(continueTopic))
                        {
                            <p class="db-continue-meta">@continueTopic</p>
                        }
                        <a asp-controller="Reading" asp-action="Study" asp-route-id="@r.Id" class="db-continue-btn">
                            <i class="fa-solid fa-arrow-right" aria-hidden="true"></i> Tiếp tục đọc
                        </a>
                    </div>
                </article>
            </div>
        </div>
    }

    <partial name="_OnboardingHost" />
</div>

<div id="dbFloatTooltip" class="db-float-tip" hidden role="tooltip" aria-hidden="true"></div>
<div id="dbFloatDetail" class="db-float-detail" hidden role="dialog" aria-modal="false" aria-hidden="true" aria-label="Chi tiết dữ liệu học">
    <button type="button" class="db-float-detail__close" data-db-float-close aria-label="Đóng">
        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
    </button>
    <div class="db-float-detail__content" data-db-float-detail-body></div>
</div>

@section Scripts {
<script src="~/js/dashboard-float-card.js" asp-append-version="true"></script>
<script>
document.addEventListener("DOMContentLoaded", function () {
    const container = document.getElementById("daily-challenge-content");
    if (!container) return;

    container.addEventListener("click", function (e) {
        const btn = e.target.closest(".answer-btn");
        if (!btn || btn.disabled) return;

        container.querySelectorAll(".answer-btn").forEach(b => { b.disabled = true; });

        const csrfToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        fetch("/Home/CheckAnswer", {
            method: "POST",
            headers: {
                "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8",
                "RequestVerificationToken": csrfToken ?? ""
            },
            body: new URLSearchParams({
                selectedCardId: btn.dataset.id,
                challengeToken: btn.dataset.token ?? ""
            }).toString()
        })
        .then(r => r.json())
        .then(data => {
            const correctId = String(data.correctCardId ?? "");
            btn.classList.add(data.correct === true ? "correct" : "wrong");
            if (data.correct !== true)
                container.querySelector(`.answer-btn[data-id="${correctId}"]`)?.classList.add("correct");
            setTimeout(refreshChallenge, 1200);
        })
        .catch(err => {
            console.error("Lỗi:", err);
            container.querySelectorAll(".answer-btn").forEach(b => { b.disabled = false; });
        });
    });

    function refreshChallenge() {
        container.style.opacity = "0.5";
        fetch("/Home/RefreshDailyChallenge")
            .then(r => r.text())
            .then(html => { container.innerHTML = html; container.style.opacity = "1"; })
            .catch(() => { container.style.opacity = "1"; });
    }
});
</script>
}
