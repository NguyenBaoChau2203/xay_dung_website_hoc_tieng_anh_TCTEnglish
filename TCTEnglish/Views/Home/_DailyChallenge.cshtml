@model TCTVocabulary.ViewModels.DailyChallengeViewModel

@if (Model.IsCompletedToday)
{
    <div class="db-challenge-state db-challenge-state--done">
        <div class="db-tico db-tico--challenge" aria-hidden="true">
            <img src="~/brand/mascot/poses/tico-mascot-success-color.png"
                 alt=""
                 width="72"
                 height="72"
                 decoding="async" />
        </div>
        <p class="db-challenge-done">
            <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
            Bạn đã hoàn thành thử thách hôm nay.
        </p>
    </div>
}
else if (!string.IsNullOrWhiteSpace(Model.Term) && Model.Options.Any())
{
    <div class="db-challenge-state db-challenge-state--pending">
        <div class="db-tico db-tico--challenge" aria-hidden="true">
            <img src="~/brand/mascot/poses/tico-mascot-thinking-color.png"
                 alt=""
                 width="72"
                 height="72"
                 decoding="async" />
        </div>
        <h2 id="challenge-term">
            @Model.Term
        </h2>
    </div>

    <div class="answers">
        @foreach (var opt in Model.Options)
        {
            <button type="button"
                    class="answer-btn"
                    data-id="@opt.CardId"
                    data-token="@Model.ChallengeToken">
                <i class="fa-solid fa-circle-dot" aria-hidden="true"></i>
                @opt.Definition
            </button>
        }
    </div>
}
else
{
    <p class="empty-text">
        <i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i>
        Thử thách hôm nay hiện chưa khả dụng
    </p>
}
