@using TCTEnglish.Services.AI.Rag
@using TCTEnglish.ViewModels.AI
@model ChatGroundingDto
@{
    var notice = Model.Status == "unverified" && string.IsNullOrWhiteSpace(Model.Notice)
        ? "Mình chưa kiểm tra lại được thông tin của câu trả lời này. Bạn hỏi lại mình nhé."
        : Model.Notice;
    var showNotice = Model.Status is "unverified" or "changed" or "snapshot"
        && !string.IsNullOrWhiteSpace(notice);
    var allowActions = (Model.Outcome is "answered" or "needs_clarification")
        && (Model.Status is "current" or "changed" or "snapshot");
    var actions = Model.Sources.Where(source => allowActions && source.Freshness == "current"
            && LearnerSourceLink.IsNavigationAllowed(source.Route))
        .DistinctBy(source => source.Route, StringComparer.OrdinalIgnoreCase).Take(3).ToList();
}
@if (showNotice || actions.Count > 0)
{
    <section class="ai-chat-sources" aria-label="Gợi ý học tập">
        @if (showNotice)
        {
            <p class="ai-chat-source-notice">@notice</p>
        }
        @if (actions.Count > 0)
        {
            <nav class="ai-chat-actions" aria-label="Mở trang được gợi ý">
                @foreach (var action in actions)
                {
                    <a class="ai-chat-action" href="@action.Route" target="_top" data-source-key="@action.SourceKey">
                        <span class="ai-chat-action-icon @LearnerSourceLink.ActionIcon(action.Route)" aria-hidden="true"></span>
                        <span class="ai-chat-action-label">@LearnerSourceLink.NavigationLabel(action.Route!, action.Title)</span>
                    </a>
                }
            </nav>
        }
    </section>
}
