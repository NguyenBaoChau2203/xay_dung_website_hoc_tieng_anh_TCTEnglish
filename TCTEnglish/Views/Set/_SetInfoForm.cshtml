@model TCTEnglish.ViewModels.Sets.SetInfoFormViewModel
@{
    var isEdit = Model.SetId.HasValue;
    var preview = string.IsNullOrWhiteSpace(Model.SetName) ? "?" : Model.SetName.Trim()[..1].ToUpperInvariant();
}
<div class="ts-form-layout">
    <form method="post" class="ts-form" novalidate
          asp-controller="Set" asp-action="@(isEdit ? "SaveSettings" : "CreateDeck")" asp-route-id="@(isEdit ? Model.SetId : null)">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="mb-3">
            <label class="form-label" asp-for="SetName">Tên bộ thẻ</label>
            <input class="form-control @(ViewData.ModelState["SetName"]?.Errors.Count > 0 ? "is-invalid" : "")" asp-for="SetName"
                   maxlength="255" required autocomplete="off"
                   placeholder="Ví dụ: Tiếng Anh giao tiếp văn phòng"
                   autofocus="@(isEdit ? null : "autofocus")" data-ts-preview-source />
            <span class="invalid-feedback" asp-validation-for="SetName"></span>
        </div>

        <div class="mb-3">
            <label class="form-label" asp-for="Description">Mô tả (không bắt buộc)</label>
            <textarea class="form-control @(ViewData.ModelState["Description"]?.Errors.Count > 0 ? "is-invalid" : "")" asp-for="Description" rows="2" maxlength="500"></textarea>
            <span class="invalid-feedback" asp-validation-for="Description"></span>
        </div>

        <fieldset class="mb-3 ts-choices">
            <legend class="form-label ts-legend">Ai được xem</legend>
            <div class="ts-choice-list">
                <div>
                    <input type="radio" class="btn-check" name="Visibility" id="ts-vis-private" value="Private" checked="@(Model.Visibility != "Public")" />
                    <label class="ts-choice" for="ts-vis-private">
                        <i class="fa-solid fa-lock" aria-hidden="true"></i>
                        <span><span class="ts-choice-title">Riêng tư</span>
                            <span class="ts-choice-text">Chỉ mình bạn. Bạn vẫn có thể bật link chia sẻ sau.</span></span>
                    </label>
                </div>
                <div>
                    <input type="radio" class="btn-check" name="Visibility" id="ts-vis-public" value="Public" checked="@(Model.Visibility == "Public")" />
                    <label class="ts-choice" for="ts-vis-public">
                        <i class="fa-solid fa-globe" aria-hidden="true"></i>
                        <span><span class="ts-choice-title">Công khai</span>
                            <span class="ts-choice-text">Ai có đường dẫn trong hệ thống đều xem và học được.</span></span>
                    </label>
                </div>
            </div>
        </fieldset>

        <div class="mb-4">
            <label class="form-label" asp-for="FolderId">Thư mục (không bắt buộc)</label>
            <select class="form-select" asp-for="FolderId">
                <option value="">Không xếp vào thư mục</option>
                @foreach (var folder in Model.AvailableFolders)
                {
                    <option value="@folder.FolderId" selected="@(Model.FolderId == folder.FolderId)">@folder.FolderName</option>
                }
            </select>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <button type="submit" class="btn btn-primary" data-ts-pending="Đang lưu…">@(isEdit ? "Lưu bộ thẻ" : "Tạo bộ thẻ")</button>
            <a class="btn btn-outline-primary" href="@(isEdit ? Url.Action("Detail", "Set", new { id = Model.SetId }) : Url.Action("Index", "Set"))">Hủy</a>
        </div>

        @if (!isEdit)
        {
            <p class="form-text mt-3">Muốn nhập nhiều từ từ file? Tạo bộ thẻ trước, sau đó chọn Nhập hàng loạt.</p>
        }
    </form>

    <aside class="ts-form-preview ts-hue-@Model.CoverHue" aria-hidden="true">
        <span class="ts-form-preview-letter" data-ts-preview-target>@preview</span>
    </aside>
</div>
