@model TCTEnglish.ViewModels.Sets.SetInfoFormViewModel
@using TCTEnglish.ViewModels
@{
    ViewData["Title"] = "Tạo bộ thẻ";
    var breadcrumbs = new List<PageBreadcrumbItem> { new("Bộ thẻ", Url.Action("Index", "Set")) };
    // Coming from a folder page: show that folder in the trail (only a folder the form lists, i.e. one of the owner's).
    var folderCrumb = Model.FolderId.HasValue ? Model.AvailableFolders.FirstOrDefault(f => f.FolderId == Model.FolderId.Value) : null;
    if (folderCrumb != null)
    {
        breadcrumbs.Add(new PageBreadcrumbItem(folderCrumb.FolderName, Url.Action("FolderPage", "Set", new { id = folderCrumb.FolderId })));
    }
    breadcrumbs.Add(new PageBreadcrumbItem("Tạo bộ thẻ"));
    var header = new PageHeaderViewModel { Title = "Tạo bộ thẻ", Breadcrumbs = breadcrumbs };
}
@section Styles {
    <link rel="stylesheet" href="~/css/study-kit.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/personal-sets.css" asp-append-version="true" />
}

<div class="tct-theme tct-page tct-page--narrow ts-page ts-page--form">
    <partial name="_PageHeader" model="header" />
    <partial name="_SetInfoForm" model="Model" />
</div>

@section Scripts {
    <script src="~/js/personal-sets-common.js" asp-append-version="true"></script>
}
