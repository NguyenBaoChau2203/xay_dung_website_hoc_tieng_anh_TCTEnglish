@* Flash messages written by SetController (TempData SetMessage / SetError). *@
@if (TempData["SetMessage"] is string setMessage && !string.IsNullOrWhiteSpace(setMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="status">
        <i class="fa-solid fa-circle-check me-2" aria-hidden="true"></i>@setMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng thông báo"></button>
    </div>
}
@if (TempData["SetError"] is string setError && !string.IsNullOrWhiteSpace(setError))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fa-solid fa-circle-exclamation me-2" aria-hidden="true"></i>@setError
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng thông báo"></button>
    </div>
}
