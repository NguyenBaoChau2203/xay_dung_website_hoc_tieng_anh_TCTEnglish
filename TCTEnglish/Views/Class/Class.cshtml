@model TCTVocabulary.ViewModels.ClassPageViewModel
@using TCTEnglish.ViewModels
@{
    ViewData["Title"] = Model.PageTitle;
    var header = new PageHeaderViewModel
    {
        Title = Model.PageTitle,
        Description = Model.PageDescription
    };
    var emptyTitle = Model.IsCreatorRole
        ? "Bạn chưa tạo lớp nào"
        : "Chưa có lớp học của bạn";
    var emptyMessage = Model.IsCreatorRole
        ? "Tạo lớp mới hoặc tham gia lớp Public / bằng mã lớp."
        : "Khám phá lớp Public, hoặc tham gia bằng mã lớp do giảng viên gửi.";
    var empty = new StateMessageViewModel
    {
        Kind = StateMessageKind.Empty,
        Title = emptyTitle,
        Message = emptyMessage
    };
    var managedHeading = Model.IsCreatorRole ? "Lớp tôi tạo" : "Lớp bạn quản lý";
}

<link rel="stylesheet" href="~/css/class.css" asp-append-version="true" />

@Html.AntiForgeryToken()
<div class="tct-theme class-page">
    <partial name="_PageHeader" model="header" />

    <div class="class-page__actions">
        <a href="@Url.Action("BrowseClasses", "Class")" class="btn btn-outline-primary class-page__browse">
            <i class="fas fa-compass" aria-hidden="true"></i>
            Khám phá lớp
        </a>
        <button type="button" class="btn btn-outline-primary class-page__code-btn" id="openJoinByCodeBtn"
                data-bs-toggle="modal" data-bs-target="#joinByCodeModal">
            <i class="fas fa-key" aria-hidden="true"></i>
            Tham gia bằng mã
        </button>
        @if (Model.CanCreateClass)
        {
            <a href="@Url.Action("CreateClass", "Class")" class="btn btn-primary class-page__create">
                <i class="fas fa-plus" aria-hidden="true"></i>
                Tạo lớp
            </a>
        }
    </div>
    <p class="class-page__hint">
        @(Model.IsCreatorRole
            ? "Quản lý lớp bạn tạo tại đây. Tìm lớp Public ở Khám phá lớp; lớp Private chỉ vào bằng mã."
            : "Tìm lớp Public ở Khám phá lớp. Lớp Private chỉ vào bằng mã lớp.")
    </p>

    <div id="myClassesContent">
        @if (Model.ManagedClasses.Count == 0 && Model.JoinedClasses.Count == 0)
        {
            <partial name="_StateMessage" model="empty" />
        }
        else
        {
            @if (Model.ManagedClasses.Count > 0)
            {
                <section class="class-section" aria-labelledby="managed-classes-heading">
                    <h2 class="class-section__title" id="managed-classes-heading">@managedHeading</h2>
                    <div class="class-cover-grid">
                        @foreach (var c in Model.ManagedClasses)
                        {
                            @await Html.PartialAsync("_ClassCoverCard", c)
                        }
                    </div>
                </section>
            }

            @if (Model.JoinedClasses.Count > 0)
            {
                <section class="class-section" aria-labelledby="joined-classes-heading">
                    <h2 class="class-section__title" id="joined-classes-heading">Lớp đang tham gia</h2>
                    <div class="class-cover-grid">
                        @foreach (var c in Model.JoinedClasses)
                        {
                            @await Html.PartialAsync("_ClassCoverCard", c)
                        }
                    </div>
                </section>
            }
        }
    </div>

    <partial name="_JoinClassByCode" />
</div>

@section Scripts {
    <script src="~/js/class-join-code.js" asp-append-version="true"></script>
}
