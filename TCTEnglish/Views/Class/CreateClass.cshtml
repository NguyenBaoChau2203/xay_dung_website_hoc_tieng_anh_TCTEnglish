@model TCTVocabulary.ViewModels.CreateClassViewModel
@using TCTEnglish.ViewModels
@{
    ViewData["Title"] = "Tạo lớp học mới";
    var header = new PageHeaderViewModel
    {
        Title = "Tạo lớp học",
        Description = "Đặt ảnh bìa, quyền lớp và mã tham gia trước khi mời học viên"
    };
    var form = Model ?? new CreateClassViewModel { IsPublic = true, JoinCode = TCTVocabulary.Services.ClassJoinCode.Generate() };
}

<link rel="stylesheet" href="~/css/class.css" asp-append-version="true" />

<div class="tct-theme create-class-page">
    <partial name="_PageHeader" model="header" />

    <form class="create-class-form" method="post" enctype="multipart/form-data" asp-antiforgery="true">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-group">
            <label for="className">Tên lớp <span class="text-danger">*</span></label>
            <input id="className" type="text" name="ClassName" placeholder="Ví dụ: TOEIC 600+" required value="@form.ClassName" />
        </div>

        <div class="form-group cover-upload">
            <label for="avatarInput">Ảnh bìa lớp</label>
            <div class="cover-preview">
                <img id="avatarPreview" src="/images/ClassDefault/class-default.png" alt="Xem trước ảnh bìa" />
            </div>
            <input type="file" id="avatarInput" name="Avatar" accept="image/*" hidden />
            <div>
                <button type="button" class="btn btn-outline-primary" id="pickCoverBtn">Chọn ảnh bìa</button>
                <span class="text-muted small ms-2">JPG, PNG, WebP • tối đa 5MB • tỉ lệ ngang</span>
            </div>
        </div>

        <div class="form-group">
            <span class="d-block fw-semibold mb-2">Hiển thị lớp</span>
            <div class="visibility-toggle" role="radiogroup" aria-label="Hiển thị lớp">
                <label class="visibility-option">
                    <input type="radio" name="IsPublic" value="true" @(form.IsPublic ? "checked" : null) />
                    <span>
                        <span class="setting-title">Công khai (Public)</span>
                        <span class="setting-desc">Hiện trong gợi ý và tìm lớp trên trang Lớp học</span>
                    </span>
                </label>
                <label class="visibility-option">
                    <input type="radio" name="IsPublic" value="false" @(!form.IsPublic ? "checked" : null) />
                    <span>
                        <span class="setting-title">Riêng tư (Private)</span>
                        <span class="setting-desc">Không hiện khi tìm; học viên vào bằng mã lớp</span>
                    </span>
                </label>
            </div>
        </div>

        <div class="form-group">
            <label for="joinCodeInput">Mã lớp</label>
            <div class="join-code-field">
                <input id="joinCodeInput"
                       type="text"
                       name="JoinCode"
                       maxlength="16"
                       value="@form.JoinCode"
                       autocomplete="off"
                       spellcheck="false"
                       class="join-code-input" />
                <button type="button" class="btn btn-outline-secondary" id="regenJoinCodeBtn">Tạo lại</button>
            </div>
            <p class="text-muted small mb-0 mt-1">Hệ thống đã tạo mã bảo mật. Bạn có thể đổi trước khi lưu.</p>
        </div>

        <div class="form-group">
            <label class="d-flex align-items-center gap-2 fw-normal">
                <input type="checkbox" id="enablePassword" />
                Đặt mật khẩu cho lớp
            </label>
            <input type="password" id="classPassword" name="Password" placeholder="Nhập mật khẩu lớp" disabled class="mt-2" />
        </div>

        <div class="form-group">
            <label>Quyền lớp</label>
            <div class="settings-grid">
                <label class="setting-item">
                    <input type="checkbox" name="RequiresApproval" value="true" />
                    <div>
                        <span class="setting-title">Phải duyệt mới vào lớp</span>
                        <span class="setting-desc">Học viên gửi yêu cầu; bạn hoặc phó nhóm chấp nhận</span>
                    </div>
                </label>
                <label class="setting-item">
                    <input type="checkbox" name="IsChatLocked" value="true" />
                    <div>
                        <span class="setting-title">Chỉ quản lý được nhắn tin</span>
                        <span class="setting-desc">Khóa chat cho thành viên thường</span>
                    </div>
                </label>
                <label class="setting-item">
                    <input type="checkbox" name="AllowMemberToPost" value="true" />
                    <div>
                        <span class="setting-title">Thành viên được thêm folder</span>
                        <span class="setting-desc">Tắt thì chỉ trưởng/phó thêm folder vào lớp</span>
                    </div>
                </label>
            </div>
        </div>

        <div class="form-group">
            <label for="classDescription">Mô tả lớp</label>
            <textarea id="classDescription" name="Description" rows="4" placeholder="Mục tiêu và nội dung lớp...">@form.Description</textarea>
        </div>

        <div class="form-actions">
            <a href="@Url.Action("Class", "Class")" class="btn btn-outline-secondary">Hủy</a>
            <button type="submit" class="btn btn-primary">Tạo lớp</button>
        </div>
    </form>
</div>

@section Scripts {
<script>
(function () {
    const alphabet = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
    function generateCode() {
        const bytes = new Uint8Array(8);
        crypto.getRandomValues(bytes);
        let out = '';
        for (let i = 0; i < 8; i++) out += alphabet[bytes[i] % alphabet.length];
        return out;
    }

    const input = document.getElementById('avatarInput');
    const preview = document.getElementById('avatarPreview');
    const password = document.getElementById('classPassword');
    const joinCode = document.getElementById('joinCodeInput');
    document.getElementById('pickCoverBtn')?.addEventListener('click', function () { input?.click(); });
    input?.addEventListener('change', function () {
        const file = this.files && this.files[0];
        if (!file || !preview) return;
        preview.src = URL.createObjectURL(file);
    });
    document.getElementById('enablePassword')?.addEventListener('change', function () {
        if (!password) return;
        password.disabled = !this.checked;
        if (!this.checked) password.value = '';
    });
    document.getElementById('regenJoinCodeBtn')?.addEventListener('click', function () {
        if (joinCode) joinCode.value = generateCode();
    });
})();
</script>
}
