@model TCTEnglish.ViewModels.GoalsViewModel
@using TCTEnglish.ViewModels
@using TCTVocabulary.Models
@{
    ViewData["Title"] = "Mục tiêu & Tiến độ";
    var vocabCard = Model.GoalCards.FirstOrDefault(g => g.GoalArea == GoalArea.Vocabulary);
    var speakingCard = Model.GoalCards.FirstOrDefault(g => g.GoalArea == GoalArea.Speaking);
    var writingCard = Model.GoalCards.FirstOrDefault(g => g.GoalArea == GoalArea.Writing);
    var readingCard = Model.GoalCards.FirstOrDefault(g => g.GoalArea == GoalArea.Reading);
    var listeningCard = Model.GoalCards.FirstOrDefault(g => g.GoalArea == GoalArea.Listening);
}

@section Styles {
    <link rel="stylesheet" href="~/css/goals.css" asp-append-version="true" />
}

<div class="tct-theme tct-page goals-ui goals-page">
    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="goals-toast-region" aria-live="polite" aria-atomic="true">
            <div class="goals-feedback-toast" id="goalUpdateToast" role="status">
                <div class="goals-feedback-toast__icon" aria-hidden="true">
                    <i class="fa-solid fa-circle-check"></i>
                </div>
                <div class="goals-feedback-toast__content">
                    <p class="goals-feedback-toast__title mb-1" data-testid="goal-toast-title">Đã lưu mục tiêu ngày</p>
                    <p class="goals-feedback-toast__message mb-0" data-testid="goal-toast-message">@successMessage</p>
                </div>
                <button type="button" class="btn-close goals-feedback-toast__close" data-goals-dismiss="goalUpdateToast" aria-label="Đóng"></button>
            </div>
        </div>
    }

    <!-- Header Section (Single H1) -->
    <header class="tct-page-header goals-header">
        <div class="tct-page-header__row">
            <div class="tct-page-header__text">
                <h1 class="tct-page-title mb-1">Mục tiêu &amp; Tiến độ</h1>
                <p class="tct-page-desc mb-0">Chào mừng bạn trở lại! Hãy cùng duy trì thói quen học tập hôm nay.</p>
            </div>
            <div class="tct-page-header__actions">
                <button type="button"
                        class="btn btn-primary goals-header-btn d-flex align-items-center justify-content-center gap-2 btn-edit-goals"
                        data-testid="goal-header-cta"
                        data-goal-mode="@(Model.IsCreatingGoal ? "create" : "edit")"
                        data-bs-toggle="modal"
                        data-bs-target="#goalEditorModal">
                    <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
                    <span>@Model.GoalHeaderActionText</span>
                </button>
            </div>
        </div>
    </header>

    <!-- Row 1: Hero Bento Grid (Streak + Daily Target + Spotlight) -->
    <div class="goals-bento-grid">
        <!-- 1. Streak Card -->
        <div class="goals-card goals-streak-card">
            <div class="d-flex align-items-center justify-content-between">
                <span class="goals-streak-tag">
                    <i class="fa-solid fa-fire" aria-hidden="true"></i>
                    Chuỗi học tập
                </span>
                <span class="text-muted small">Mỗi ngày</span>
            </div>

            <div class="goals-streak-main">
                <div class="goals-streak-value">@Model.CurrentStreak ngày</div>
                <p class="goals-streak-msg">@Model.StreakMessage</p>
                <p class="goals-streak-record">Kỷ lục tốt nhất: <strong>@Model.LongestStreak ngày</strong></p>
            </div>

            @if (Model.HasWeeklyActivity)
            {
                <div class="goals-mini-streak" aria-label="Chuỗi học 7 ngày qua">
                    @foreach (var day in Model.WeeklyActivity)
                    {
                        var isActive = day.ActivityCount > 0;
                        var dayBarClass = day.IsToday ? "goals-mini-bar--today" : (isActive ? "goals-mini-bar--active" : "");
                        var dayTextClass = day.IsToday ? "text-primary fw-bold" : "";
                        <div class="goals-mini-bar-col" title="@day.FullLabel: @day.ActivityCount thẻ">
                            <span class="goals-mini-label @dayTextClass">@day.DayLabel</span>
                            <div class="goals-mini-bar @dayBarClass"></div>
                        </div>
                    }
                </div>
            }

            <img src="~/images/goals/streak-flame-clay.svg" class="goals-streak-art" alt="" aria-hidden="true" width="110" height="110" />
        </div>

        <!-- 2. Daily Goal Card -->
        <div class="goals-card goals-daily-card">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <h2 class="goals-section-title">
                        Mục tiêu hôm nay
                    </h2>
                    @if (Model.HasDeferredGoalAreas)
                    {
                        <div class="alert alert-warning py-2 px-3 small mb-0 mt-2" role="status">
                            @(string.Join(", ", Model.DeferredGoalAreaLabels)) hiện đang tạm hoãn vì chưa có tín hiệu hoàn thành đáng tin cậy trên server.
                        </div>
                    }
                </div>
                <div class="goals-icon-pill goals-icon-pill--primary" aria-hidden="true">
                    <i class="fa-solid fa-bullseye"></i>
                </div>
            </div>

            @if (Model.HasGoalCards)
            {
                <p class="goals-section-subtitle mt-2 mb-3">
                    Bạn đã hoàn thành <strong>@Model.ProgressPercent%</strong> mục tiêu ngày hôm nay. Cố gắng lên!
                </p>

                <div class="goals-daily-content">
                    <div class="goals-daily-list">
                        @foreach (var goal in Model.GoalCards)
                        {
                            var isComplete = goal.ProgressPercent >= 100;
                            <div class="goals-item-row">
                                <div class="goals-item-header">
                                    <span class="goals-item-name">@goal.AreaLabel</span>
                                    <span class="goals-item-score">@goal.TodayProgressValue/@goal.TargetValue @goal.UnitLabel</span>
                                </div>
                                <div class="goals-progress-track" role="progressbar" aria-valuenow="@goal.ProgressPercent" aria-valuemin="0" aria-valuemax="100" aria-label="Tiến độ @goal.AreaLabel: @goal.ProgressPercent%">
                                    <div class="goals-progress-fill @(isComplete ? "goals-progress-fill--complete" : "")" style="width: @Math.Min(goal.ProgressPercent, 100)%"></div>
                                </div>
                                <p class="mb-0 mt-1 small text-muted">@goal.ProgressLabel</p>
                            </div>
                        }
                    </div>

                    <!-- Circular Radial Progress -->
                    <div class="goals-circle-progress-wrap">
                        <div class="goals-circle-box">
                            <svg class="goals-circle-svg" viewBox="0 0 100 100">
                                <circle class="goals-circle-bg" cx="50" cy="50" r="40" fill="none" stroke-width="8"></circle>
                                <circle class="goals-circle-bar" cx="50" cy="50" r="40" fill="none" stroke-width="8"
                                        stroke-linecap="round"
                                        stroke-dasharray="251.2"
                                        stroke-dashoffset="@(251.2 - (251.2 * Math.Min(Model.ProgressPercent, 100) / 100.0))"></circle>
                            </svg>
                            <span class="goals-circle-percent">@Model.ProgressPercent%</span>
                        </div>
                        <span class="d-block fw-bold small text-dark mt-2">Tổng tiến độ</span>
                        <span class="d-block text-muted" style="font-size: 11px;">Trung bình các kỹ năng</span>
                    </div>
                </div>

                @if (Model.HasWeeklyActivity)
                {
                    <div class="goals-day-dots" aria-label="Trạng thái hoàn thành 7 ngày qua">
                        @foreach (var day in Model.WeeklyActivity)
                        {
                            var isActive = day.ActivityCount > 0;
                            if (day.IsToday)
                            {
                                <div class="goals-day-dot goals-day-dot--today" title="Hôm nay">
                                    <span class="goals-day-dot__label text-primary fw-bold">@day.DayLabel</span>
                                    <span class="goals-day-dot__status text-primary"><i class="fa-solid fa-circle" style="font-size: 8px;"></i></span>
                                </div>
                            }
                            else if (isActive)
                            {
                                <div class="goals-day-dot" title="@day.FullLabel: Đã hoàn thành">
                                    <span class="goals-day-dot__label">@day.DayLabel</span>
                                    <span class="goals-day-dot__status text-success"><i class="fa-solid fa-circle-check"></i></span>
                                </div>
                            }
                            else
                            {
                                <div class="goals-day-dot" title="@day.FullLabel: Chưa có hoạt động">
                                    <span class="goals-day-dot__label text-muted">@day.DayLabel</span>
                                    <span class="goals-day-dot__status text-muted opacity-50"><i class="fa-regular fa-circle" style="font-size: 8px;"></i></span>
                                </div>
                            }
                        }
                    </div>
                }
            }
            else
            {
                <div class="text-center py-4 my-auto">
                    <img src="~/images/goals/goal-target-clay.svg" class="goals-empty-art" alt="" aria-hidden="true" width="80" height="80" />
                    <p class="fw-semibold text-dark mb-1">Bạn chưa có mục tiêu nào theo kỹ năng.</p>
                    <p class="small text-muted mb-3">Thiết lập mục tiêu giúp bạn duy trì đều đặn thói quen mỗi ngày.</p>
                    <button type="button"
                            class="btn btn-outline-primary progress-empty-action"
                            data-testid="goal-empty-state-cta"
                            data-goal-mode="create"
                            data-bs-toggle="modal"
                            data-bs-target="#goalEditorModal">
                        @Model.GoalEmptyStateActionText
                    </button>
                </div>
            }
        </div>

        <!-- 3. Achievement Spotlight Card -->
        <div class="goals-card goals-spotlight-card">
            <div class="d-flex align-items-center justify-content-between">
                <span class="goals-section-title">
                    Thành tích
                </span>
                <span class="goals-badge-pill">
                    @Model.UnlockedBadgeCount / @Model.Badges.Count
                </span>
            </div>

            <div class="goals-spotlight-body">
                <div class="goals-spotlight-metric">@Model.UnlockedBadgeCount <span class="fs-6 fw-normal text-muted">huy hiệu mở khóa</span></div>

                @if (Model.HasRecentlyUnlockedBadges)
                {
                    <div class="goals-new-badge-banner" role="status">
                        <div class="goals-new-badge-icon" aria-hidden="true">
                            <i class="fa-solid fa-trophy"></i>
                        </div>
                        <div>
                            <p class="fw-bold mb-0 small">Mở khóa mới hôm nay!</p>
                            <p class="text-muted mb-0" style="font-size: 11px;">@Model.RecentlyUnlockedBadgeCount huy hiệu vừa được mở.</p>
                        </div>
                    </div>
                }

                @if (Model.Badges.Any(b => !b.IsUnlocked))
                {
                    var nextBadge = Model.Badges.First(b => !b.IsUnlocked);
                    <div class="goals-next-badge-box">
                        <div class="goals-next-badge-title">Nhiệm vụ tiếp theo</div>
                        <p class="goals-next-badge-desc mb-2">@nextBadge.Name — @nextBadge.Description</p>
                        <div class="goals-progress-track" role="progressbar" aria-valuenow="@nextBadge.ProgressPercent" aria-valuemin="0" aria-valuemax="100" aria-label="Tiến độ huy hiệu: @nextBadge.ProgressPercent%">
                            <div class="goals-progress-fill" style="width: @nextBadge.ProgressPercent%"></div>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-1">
                            <span class="small text-muted" style="font-size: 11px;">@nextBadge.MetricLabel</span>
                            <span class="small fw-bold text-primary" style="font-size: 11px;">@nextBadge.ProgressLabel</span>
                        </div>
                    </div>
                }
            </div>

            <div class="d-flex align-items-center justify-content-between small text-muted pt-2 border-top">
                <span>Khám phá thêm</span>
                <a href="#goalsBadgeSection" class="text-primary text-decoration-none fw-semibold">Xem tất cả <i class="fa-solid fa-chevron-down ms-1" style="font-size: 10px;"></i></a>
            </div>

            <img src="~/images/goals/badge-trophy-clay.svg" class="goals-spotlight-art" alt="" aria-hidden="true" width="100" height="100" />
        </div>
    </div>

    <!-- Row 2: Skill Goals & Practice Hub (All 5 Skills Supported) -->
    <section class="goals-skills-section" aria-labelledby="skillsSectionTitle">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <div>
                <h2 class="goals-section-title" id="skillsSectionTitle">
                    Tiến độ kỹ năng
                </h2>
                <p class="goals-section-subtitle">Chỉ tiêu rèn luyện 5 kỹ năng chính và đường dẫn luyện tập nhanh.</p>
            </div>
        </div>

        <div class="goals-skills-grid">
            <!-- 1. Vocabulary -->
            @{
                var hasVocab = vocabCard != null && vocabCard.TargetValue > 0;
                var vocabPercent = vocabCard?.ProgressPercent ?? 0;
                var isVocabDone = hasVocab && vocabPercent >= 100;
            }
            <a asp-controller="Vocabulary" asp-action="Index" class="goals-skill-card" aria-label="Từ vựng: @(hasVocab ? $"{vocabCard!.TodayProgressValue}/{vocabCard.TargetValue} {vocabCard.UnitLabel}" : "Chưa đặt chỉ tiêu")">
                <div>
                    <div class="goals-skill-top">
                        <div class="goals-skill-icon-pill goals-skill-icon-pill--vocab" aria-hidden="true">
                            <i class="fa-solid fa-language"></i>
                        </div>
                        @if (hasVocab)
                        {
                            <span class="goals-skill-status-tag @(isVocabDone ? "goals-skill-status-tag--done" : "")">
                                @(isVocabDone ? "Đã đạt" : $"{vocabPercent}%")
                            </span>
                        }
                        else
                        {
                            <span class="goals-skill-status-tag">Luyện tập</span>
                        }
                    </div>

                    <h3 class="goals-skill-name">Từ vựng</h3>
                    <p class="text-muted small mb-2">Flashcard</p>

                    @if (hasVocab)
                    {
                        <div class="goals-skill-stat">@vocabCard!.TodayProgressValue / @vocabCard.TargetValue @vocabCard.UnitLabel</div>
                        <div class="goals-progress-track" role="progressbar" aria-valuenow="@vocabPercent" aria-valuemin="0" aria-valuemax="100" aria-label="Tiến độ Từ vựng: @vocabPercent%">
                            <div class="goals-progress-fill @(isVocabDone ? "goals-progress-fill--complete" : "")" style="width: @Math.Min(vocabPercent, 100)%"></div>
                        </div>
                    }
                    else
                    {
                        <div class="small text-muted mb-2">Chưa đặt chỉ tiêu ngày</div>
                        <div class="goals-progress-track">
                            <div class="goals-progress-fill" style="width: 0%"></div>
                        </div>
                    }
                </div>

                <div class="goals-skill-bottom">
                    <span class="goals-skill-cta-text">Vào học ngay</span>
                    <i class="fa-solid fa-arrow-right goals-skill-arrow" aria-hidden="true"></i>
                </div>
            </a>

            <!-- 2. Speaking -->
            @{
                var hasSpeaking = speakingCard != null && speakingCard.TargetValue > 0;
                var speakingPercent = speakingCard?.ProgressPercent ?? 0;
                var isSpeakingDone = hasSpeaking && speakingPercent >= 100;
            }
            <a asp-controller="Speaking" asp-action="Index" class="goals-skill-card" aria-label="Luyện nói: @(hasSpeaking ? $"{speakingCard!.TodayProgressValue}/{speakingCard.TargetValue} {speakingCard.UnitLabel}" : "Chưa đặt chỉ tiêu")">
                <div>
                    <div class="goals-skill-top">
                        <div class="goals-skill-icon-pill goals-skill-icon-pill--speaking" aria-hidden="true">
                            <i class="fa-solid fa-microphone"></i>
                        </div>
                        @if (hasSpeaking)
                        {
                            <span class="goals-skill-status-tag @(isSpeakingDone ? "goals-skill-status-tag--done" : "")">
                                @(isSpeakingDone ? "Đã đạt" : $"{speakingPercent}%")
                            </span>
                        }
                        else
                        {
                            <span class="goals-skill-status-tag">Luyện tập</span>
                        }
                    </div>

                    <h3 class="goals-skill-name">Luyện nói</h3>
                    <p class="text-muted small mb-2">Speaking</p>

                    @if (hasSpeaking)
                    {
                        <div class="goals-skill-stat">@speakingCard!.TodayProgressValue / @speakingCard.TargetValue @speakingCard.UnitLabel</div>
                        <div class="goals-progress-track" role="progressbar" aria-valuenow="@speakingPercent" aria-valuemin="0" aria-valuemax="100" aria-label="Tiến độ Luyện nói: @speakingPercent%">
                            <div class="goals-progress-fill @(isSpeakingDone ? "goals-progress-fill--complete" : "")" style="width: @Math.Min(speakingPercent, 100)%"></div>
                        </div>
                    }
                    else
                    {
                        <div class="small text-muted mb-2">Chưa đặt chỉ tiêu ngày</div>
                        <div class="goals-progress-track">
                            <div class="goals-progress-fill" style="width: 0%"></div>
                        </div>
                    }
                </div>

                <div class="goals-skill-bottom">
                    <span class="goals-skill-cta-text">Vào học ngay</span>
                    <i class="fa-solid fa-arrow-right goals-skill-arrow" aria-hidden="true"></i>
                </div>
            </a>

            <!-- 3. Writing -->
            @{
                var hasWriting = writingCard != null && writingCard.TargetValue > 0;
                var writingPercent = writingCard?.ProgressPercent ?? 0;
                var isWritingDone = hasWriting && writingPercent >= 100;
            }
            <a asp-controller="Study" asp-action="Writing" class="goals-skill-card" aria-label="Kỹ năng viết: @(hasWriting ? $"{writingCard!.TodayProgressValue}/{writingCard.TargetValue} {writingCard.UnitLabel}" : "Chưa đặt chỉ tiêu")">
                <div>
                    <div class="goals-skill-top">
                        <div class="goals-skill-icon-pill goals-skill-icon-pill--writing" aria-hidden="true">
                            <i class="fa-solid fa-pen-nib"></i>
                        </div>
                        @if (hasWriting)
                        {
                            <span class="goals-skill-status-tag @(isWritingDone ? "goals-skill-status-tag--done" : "")">
                                @(isWritingDone ? "Đã đạt" : $"{writingPercent}%")
                            </span>
                        }
                        else
                        {
                            <span class="goals-skill-status-tag">Luyện tập</span>
                        }
                    </div>

                    <h3 class="goals-skill-name">Kỹ năng viết</h3>
                    <p class="text-muted small mb-2">Writing</p>

                    @if (hasWriting)
                    {
                        <div class="goals-skill-stat">@writingCard!.TodayProgressValue / @writingCard.TargetValue @writingCard.UnitLabel</div>
                        <div class="goals-progress-track" role="progressbar" aria-valuenow="@writingPercent" aria-valuemin="0" aria-valuemax="100" aria-label="Tiến độ Kỹ năng viết: @writingPercent%">
                            <div class="goals-progress-fill @(isWritingDone ? "goals-progress-fill--complete" : "")" style="width: @Math.Min(writingPercent, 100)%"></div>
                        </div>
                    }
                    else
                    {
                        <div class="small text-muted mb-2">Chưa đặt chỉ tiêu ngày</div>
                        <div class="goals-progress-track">
                            <div class="goals-progress-fill" style="width: 0%"></div>
                        </div>
                    }
                </div>

                <div class="goals-skill-bottom">
                    <span class="goals-skill-cta-text">Vào học ngay</span>
                    <i class="fa-solid fa-arrow-right goals-skill-arrow" aria-hidden="true"></i>
                </div>
            </a>

            <!-- 4. Reading -->
            @{
                var hasReading = readingCard != null && readingCard.TargetValue > 0;
                var readingPercent = readingCard?.ProgressPercent ?? 0;
                var isReadingDone = hasReading && readingPercent >= 100;
            }
            <a asp-controller="Study" asp-action="Reading" class="goals-skill-card" aria-label="Kỹ năng đọc: @(hasReading ? $"{readingCard!.TodayProgressValue}/{readingCard.TargetValue} {readingCard.UnitLabel}" : "Chưa đặt chỉ tiêu")">
                <div>
                    <div class="goals-skill-top">
                        <div class="goals-skill-icon-pill goals-skill-icon-pill--reading" aria-hidden="true">
                            <i class="fa-solid fa-book-reader"></i>
                        </div>
                        @if (hasReading)
                        {
                            <span class="goals-skill-status-tag @(isReadingDone ? "goals-skill-status-tag--done" : "")">
                                @(isReadingDone ? "Đã đạt" : $"{readingPercent}%")
                            </span>
                        }
                        else
                        {
                            <span class="goals-skill-status-tag">Luyện tập</span>
                        }
                    </div>

                    <h3 class="goals-skill-name">Kỹ năng đọc</h3>
                    <p class="text-muted small mb-2">Reading</p>

                    @if (hasReading)
                    {
                        <div class="goals-skill-stat">@readingCard!.TodayProgressValue / @readingCard.TargetValue @readingCard.UnitLabel</div>
                        <div class="goals-progress-track" role="progressbar" aria-valuenow="@readingPercent" aria-valuemin="0" aria-valuemax="100" aria-label="Tiến độ Kỹ năng đọc: @readingPercent%">
                            <div class="goals-progress-fill @(isReadingDone ? "goals-progress-fill--complete" : "")" style="width: @Math.Min(readingPercent, 100)%"></div>
                        </div>
                    }
                    else
                    {
                        <div class="small text-muted mb-2">Chưa đặt chỉ tiêu ngày</div>
                        <div class="goals-progress-track">
                            <div class="goals-progress-fill" style="width: 0%"></div>
                        </div>
                    }
                </div>

                <div class="goals-skill-bottom">
                    <span class="goals-skill-cta-text">Vào học ngay</span>
                    <i class="fa-solid fa-arrow-right goals-skill-arrow" aria-hidden="true"></i>
                </div>
            </a>

            <!-- 5. Listening -->
            @{
                var hasListening = listeningCard != null && listeningCard.TargetValue > 0;
                var listeningPercent = listeningCard?.ProgressPercent ?? 0;
                var isListeningDone = hasListening && listeningPercent >= 100;
            }
            <a asp-controller="Study" asp-action="Listening" class="goals-skill-card" aria-label="Kỹ năng nghe: @(hasListening ? $"{listeningCard!.TodayProgressValue}/{listeningCard.TargetValue} {listeningCard.UnitLabel}" : "Chưa đặt chỉ tiêu")">
                <div>
                    <div class="goals-skill-top">
                        <div class="goals-skill-icon-pill goals-skill-icon-pill--listening" aria-hidden="true">
                            <i class="fa-solid fa-headphones"></i>
                        </div>
                        @if (hasListening)
                        {
                            <span class="goals-skill-status-tag @(isListeningDone ? "goals-skill-status-tag--done" : "")">
                                @(isListeningDone ? "Đã đạt" : $"{listeningPercent}%")
                            </span>
                        }
                        else
                        {
                            <span class="goals-skill-status-tag">Luyện tập</span>
                        }
                    </div>

                    <h3 class="goals-skill-name">Kỹ năng nghe</h3>
                    <p class="text-muted small mb-2">Listening</p>

                    @if (hasListening)
                    {
                        <div class="goals-skill-stat">@listeningCard!.TodayProgressValue / @listeningCard.TargetValue @listeningCard.UnitLabel</div>
                        <div class="goals-progress-track" role="progressbar" aria-valuenow="@listeningPercent" aria-valuemin="0" aria-valuemax="100" aria-label="Tiến độ Kỹ năng nghe: @listeningPercent%">
                            <div class="goals-progress-fill @(isListeningDone ? "goals-progress-fill--complete" : "")" style="width: @Math.Min(listeningPercent, 100)%"></div>
                        </div>
                    }
                    else
                    {
                        <div class="small text-muted mb-2">Chưa đặt chỉ tiêu ngày</div>
                        <div class="goals-progress-track">
                            <div class="goals-progress-fill" style="width: 0%"></div>
                        </div>
                    }
                </div>

                <div class="goals-skill-bottom">
                    <span class="goals-skill-cta-text">Vào học ngay</span>
                    <i class="fa-solid fa-arrow-right goals-skill-arrow" aria-hidden="true"></i>
                </div>
            </a>
        </div>
    </section>

    <!-- Row 3: Weekly Activity Chart + Badges Grid -->
    <div class="goals-lower-grid">
        <!-- 1. Weekly Activity Chart (Vocabulary focus) -->
        <div class="goals-card goals-chart-card">
            <div class="goals-chart-header">
                <div>
                    <h3 class="goals-section-title">
                        Ôn từ vựng hàng tuần
                    </h3>
                    <p class="goals-section-subtitle mb-0">@Model.WeeklyActivityMessage</p>
                </div>
                <span class="badge bg-primary-subtle text-primary fw-semibold px-2 py-1">7 ngày</span>
            </div>

            @if (Model.HasWeeklyActivity)
            {
                <div class="goals-chart-area" role="list" aria-label="Biểu đồ hoạt động ôn từ vựng 7 ngày">
                    @for (var dayIndex = 0; dayIndex < Model.WeeklyActivity.Count; dayIndex++)
                    {
                        var day = Model.WeeklyActivity[dayIndex];
                        var chartBarClass = day.IsToday ? "goals-chart-bar--today" : (day.ActivityCount > 0 ? "goals-chart-bar--active" : "");
                        var textClass = day.IsToday ? "goals-chart-label--today" : "";
                        var tooltipText = $"{day.FullLabel}: {day.ActivityCount} thẻ đã ôn";
                        var tooltipId = $"goals-chart-tooltip-{dayIndex}";

                        <div class="goals-chart-col chart-column"
                             tabindex="0"
                             role="listitem"
                             aria-label="@tooltipText"
                             aria-describedby="@tooltipId">
                            <span id="@tooltipId" class="visually-hidden">@tooltipText</span>

                            @if (day.ActivityCount > 0)
                            {
                                <span class="goals-chart-num">@day.ActivityCount</span>
                            }

                            <div class="goals-chart-bar @chartBarClass chart-bar-anim"
                                 style="height: @day.HeightPercent%; min-height: @(day.ActivityCount > 0 ? "16%" : "6%");"
                                 data-tooltip="@tooltipText">
                                @if (day.IsToday)
                                {
                                    <div class="goals-chart-bar-overlay"></div>
                                }
                            </div>
                            <span class="goals-chart-label @textClass">@day.DayLabel</span>
                        </div>
                    }
                </div>
                <div class="d-flex justify-content-between align-items-center mt-3 text-muted small">
                    <span><i class="fa-regular fa-clock me-1"></i> Cập nhật theo thời gian thực</span>
                    <span>Đơn vị: <strong>Số thẻ ôn</strong></span>
                </div>
            }
            else
            {
                <div class="chart-empty-state">
                    <img src="~/images/goals/goal-target-clay.svg" class="goals-empty-art" alt="" aria-hidden="true" width="80" height="80" />
                    <p class="fw-bold text-dark mb-1">Biểu đồ sẽ sáng dần khi bạn bắt đầu ôn thẻ</p>
                    <p class="goals-section-subtitle mb-4">@Model.WeeklyActivityMessage</p>
                    <a asp-controller="Vocabulary" asp-action="Index" class="btn btn-primary px-4">
                        <i class="fa-solid fa-play me-2"></i>Bắt đầu ôn thẻ
                    </a>
                </div>
            }
        </div>

        <!-- 2. Badges Showcase -->
        <div class="goals-card goals-badge-card" id="goalsBadgeSection">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3 class="goals-section-title">
                    Huy hiệu
                </h3>
                <span class="goals-badge-pill">@Model.UnlockedBadgeCount / @Model.Badges.Count</span>
            </div>

            @if (Model.HasRecentlyUnlockedBadges)
            {
                <div class="goals-new-badge-banner" role="status">
                    <div class="goals-new-badge-icon" aria-hidden="true">
                        <i class="fa-solid fa-award"></i>
                    </div>
                    <div>
                        <p class="fw-bold mb-0 small">Mở khóa mới hôm nay!</p>
                        <p class="text-muted mb-0" style="font-size: 11px;">@Model.RecentlyUnlockedBadgeCount huy hiệu vừa được mở khóa.</p>
                    </div>
                </div>
            }

            @if (Model.HasBadges)
            {
                <div class="goals-badge-grid flex-grow-1">
                    @foreach (var badge in Model.Badges)
                    {
                        if (badge.IsUnlocked)
                        {
                            <div class="goals-badge-tile goals-badge-tile--unlocked"
                                 data-badge-code="@badge.Code"
                                 title="@badge.Name — @badge.Description (Đã mở khóa)">
                                <div class="goals-badge-icon-wrap goals-badge-icon-wrap--unlocked" aria-hidden="true">
                                    <i class="@badge.IconClass" style="font-size: 16px;"></i>
                                </div>
                                <span class="goals-badge-name">@badge.Name</span>
                                @if (badge.IsRecentlyUnlocked)
                                {
                                    <span class="goals-badge-recent-dot" title="Mở khóa hôm nay"></span>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="goals-badge-tile goals-badge-tile--locked"
                                 data-badge-code="@badge.Code"
                                 title="@badge.Name — @badge.Description (@badge.ProgressLabel)">
                                <div class="goals-badge-icon-wrap goals-badge-icon-wrap--locked" aria-hidden="true">
                                    <i class="fa-solid fa-lock" style="font-size: 14px;"></i>
                                </div>
                                <span class="goals-badge-name goals-badge-name--locked">@badge.Name</span>
                            </div>
                        }
                    }
                </div>

                @if (Model.Badges.Any(b => !b.IsUnlocked))
                {
                    var nextBadge = Model.Badges.First(b => !b.IsUnlocked);
                    <div class="goals-next-badge-box mt-auto">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="goals-next-badge-title mb-0">Mục tiêu tiếp theo</span>
                            <span class="badge bg-primary-subtle text-primary" style="font-size: 10px;">@nextBadge.ProgressPercent%</span>
                        </div>
                        <p class="goals-next-badge-desc mb-2">@nextBadge.Description</p>
                        <div class="goals-progress-track" role="progressbar" aria-valuenow="@nextBadge.ProgressPercent" aria-valuemin="0" aria-valuemax="100" aria-label="Tiến độ @nextBadge.Name: @nextBadge.ProgressPercent%">
                            <div class="goals-progress-fill" style="width: @nextBadge.ProgressPercent%;"></div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-4 my-auto">
                    <div class="goals-icon-pill goals-icon-pill--warning mx-auto mb-3" aria-hidden="true">
                        <i class="fa-solid fa-award fs-4"></i>
                    </div>
                    <p class="fw-bold mb-1">Chưa có dữ liệu huy hiệu</p>
                    <p class="text-muted small mb-0">Khi dữ liệu huy hiệu sẵn sàng, tiến độ sẽ xuất hiện tại đây.</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Goal Editor Modal -->
<div class="modal fade goal-editor-modal tct-theme"
     id="goalEditorModal"
     data-open-on-load="@(Model.ShowGoalEditor ? "true" : "false")"
     tabindex="-1"
     aria-labelledby="goalEditorModalLabel"
     aria-describedby="goalEditorModalHelp"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered goal-modal-dialog">
        <div class="modal-content goal-modal-content">
            <div class="modal-header goal-modal-header">
                <div class="d-flex align-items-center gap-3">
                    <div class="goal-modal-icon-badge" aria-hidden="true">
                        <i class="fa-solid fa-bullseye"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold text-dark mb-0" id="goalEditorModalLabel" data-testid="goal-modal-title" data-goal-mode="@(Model.IsCreatingGoal ? "create" : "edit")">@Model.GoalEditorTitle</h5>
                        <p class="goal-modal-subtitle text-muted mb-0">@(Model.IsCreatingGoal ? "Thiết lập chỉ tiêu rèn luyện hàng ngày" : "Điều chỉnh chỉ tiêu rèn luyện phù hợp với bạn")</p>
                    </div>
                </div>
                <button type="button" class="goal-modal-close-btn" data-bs-dismiss="modal" aria-label="Đóng">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <form asp-controller="Goals" asp-action="UpdateGoal" method="post" id="goalEditorForm">
                <div class="modal-body pt-3 pb-2">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3"></div>

                    <div class="goal-field-group mb-3">
                        <label asp-for="GoalEditor.GoalArea" class="form-label goal-form-label">
                            <i class="fa-solid fa-layer-group text-primary me-1"></i>
                            <span>Kỹ năng rèn luyện</span>
                        </label>
                        <div class="goal-select-wrapper">
                            <select asp-for="GoalEditor.GoalArea"
                                    asp-items="Model.GoalAreaOptions"
                                    class="form-select form-select-lg goal-input goal-select-input"
                                    id="goalAreaSelect">
                            </select>
                            <i class="fa-solid fa-chevron-down goal-select-arrow" aria-hidden="true"></i>
                        </div>
                        <span asp-validation-for="GoalEditor.GoalArea" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="goal-field-group mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label asp-for="GoalEditor.TargetValue" class="form-label goal-form-label mb-0">
                                <i class="fa-solid fa-crosshairs text-primary me-1"></i>
                                <span>Mục tiêu mỗi ngày</span>
                            </label>
                            <span class="goal-unit-badge" id="goalUnitBadge">từ / ngày</span>
                        </div>

                        <div class="goal-stepper-box">
                            <button type="button" class="goal-stepper-btn goal-stepper-btn--dec" id="goalTargetDecBtn" aria-label="Giảm 5 đơn vị">
                                <i class="fa-solid fa-minus"></i>
                            </button>
                            <input asp-for="GoalEditor.TargetValue"
                                   class="form-control form-control-lg goal-input"
                                   id="goalTargetInput"
                                   min="@UpdateGoalInputViewModel.MinTargetValue"
                                   max="@UpdateGoalInputViewModel.MaxTargetValue"
                                   required />
                            <button type="button" class="goal-stepper-btn goal-stepper-btn--inc" id="goalTargetIncBtn" aria-label="Tăng 5 đơn vị">
                                <i class="fa-solid fa-plus"></i>
                            </button>
                        </div>
                        <span asp-validation-for="GoalEditor.TargetValue" class="text-danger small mt-1 d-block"></span>

                        <!-- Quick target presets -->
                        <div class="goal-presets-row mt-2" aria-label="Gợi ý mức chỉ tiêu nhanh">
                            <span class="goal-presets-label">Gợi ý:</span>
                            <button type="button" class="goal-preset-btn" data-preset="5">5</button>
                            <button type="button" class="goal-preset-btn" data-preset="10">10</button>
                            <button type="button" class="goal-preset-btn" data-preset="20">20</button>
                            <button type="button" class="goal-preset-btn" data-preset="30">30</button>
                            <button type="button" class="goal-preset-btn" data-preset="50">50</button>
                        </div>
                    </div>

                    <div class="goal-tip-box mb-3">
                        <div class="goal-tip-icon" aria-hidden="true">
                            <i class="fa-solid fa-lightbulb"></i>
                        </div>
                        <div class="goal-tip-text" id="goalEditorModalHelp">
                            Chọn kỹ năng và đặt chỉ tiêu mỗi ngày từ <strong>@UpdateGoalInputViewModel.MinTargetValue</strong> đến <strong>@UpdateGoalInputViewModel.MaxTargetValue</strong>. Đặt về <strong>0</strong> để tạm dừng theo dõi kỹ năng đó mà không xóa lịch sử học.
                        </div>
                    </div>
                </div>
                <div class="modal-footer goal-modal-footer gap-2 flex-nowrap">
                    <button type="button" class="btn goal-btn-clay-cancel flex-grow-1" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary goal-btn-clay-submit flex-grow-1" id="goalSubmitBtn" data-testid="goal-modal-submit" data-goal-mode="@(Model.IsCreatingGoal ? "create" : "edit")">
                        <i class="fa-solid fa-floppy-disk me-1"></i>
                        <span>@Model.GoalEditorSubmitText</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/goals.js" asp-append-version="true"></script>
}
