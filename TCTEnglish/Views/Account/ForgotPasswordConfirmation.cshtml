@{
    Layout = null;
    ViewData["Title"] = "Kiểm tra email";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TCT English</title>
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --brand-primary: #4255ff;
            --brand-primary-hover: #3142d6;
            --text-main: #1e293b;
            --text-sub: #64748b;
            --white: #ffffff;
            --radius-input: 10px;
            --radius-card: 18px;
            --font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            --card-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.03);
            --success-green: #10b981;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: var(--font-family);
            background-color: #f6f7fb;
            color: var(--text-main);
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            padding: 20px;
            line-height: 1.5;
        }

        .auth-card-container {
            background-color: var(--white);
            width: 100%;
            max-width: 520px;
            padding: 44px 36px;
            border-radius: var(--radius-card);
            box-shadow: var(--card-shadow);
            border: 1px solid #edf0f7;
            text-align: center;
        }

        .icon-check-wrap {
            width: 72px;
            height: 72px;
            border-radius: 50%;
            background: rgba(16, 185, 129, 0.1);
            color: var(--success-green);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 32px;
            margin: 0 auto 24px;
        }

        h2 {
            font-weight: 700;
            font-size: 24px;
            color: var(--text-main);
            margin-bottom: 12px;
            letter-spacing: -0.01em;
        }

        .description {
            color: var(--text-sub);
            font-size: 15px;
            line-height: 1.6;
            margin-bottom: 32px;
            padding: 0 10px;
        }

        .btn-submit {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            padding: 14px;
            background-color: var(--brand-primary);
            color: var(--white);
            border: none;
            border-radius: var(--radius-input);
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            transition: all 0.2s ease;
            font-family: var(--font-family);
            box-shadow: 0 4px 12px rgba(66, 85, 255, 0.25);
            gap: 8px;
        }

        .btn-submit:hover {
            background-color: var(--brand-primary-hover);
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(66, 85, 255, 0.35);
            color: var(--white);
        }

        .btn-submit:focus-visible {
            outline: none;
            box-shadow: 0 0 0 3px rgba(66, 85, 255, 0.35), 0 0 0 1px var(--white);
        }

        @@media (max-width: 576px) {
            .auth-card-container {
                padding: 32px 20px;
                border-radius: 16px;
            }
            h2 {
                font-size: 21px;
            }
            .description {
                font-size: 14px;
                margin-bottom: 24px;
            }
        }
    </style>
</head>
<body>

    <div class="auth-card-container">
        <div class="icon-check-wrap">
            <i class="fa-regular fa-envelope"></i>
        </div>
        <h2>Hãy kiểm tra email của bạn</h2>
        <p class="description">
            @(string.IsNullOrWhiteSpace(ViewBag.Message as string)
                ? "Chúng tôi đã gửi hướng dẫn khôi phục mật khẩu vào hòm thư của bạn. Vui lòng kiểm tra và nhấp vào liên kết để tiếp tục."
                : ViewBag.Message)
        </p>

        <a href="@Url.Action("Login", "Account")" class="btn-submit">
            <i class="fa-solid fa-right-to-bracket"></i>
            <span>Quay lại Đăng nhập</span>
        </a>
    </div>

</body>
</html>
