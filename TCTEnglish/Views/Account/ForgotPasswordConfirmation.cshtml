@{
    Layout = null;
    ViewData["Title"] = "Kiểm tra email";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Hướng dẫn kiểm tra email khôi phục mật khẩu TCT English." />
    <title>@ViewData["Title"] - TCT English</title>

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Bootstrap 5.3.3 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />

    <!-- Shared Design System Tokens & Scoped Auth Styles -->
    <link href="~/css/tct-learning-ui.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/account-auth-ui.css" rel="stylesheet" asp-append-version="true" />
</head>
<body class="tct-theme account-auth-ui">

    <div class="auth-surface">
        <main class="tct-card recovery-card text-center" id="main-content">
            <div class="recovery-brand-wrap">
                <div class="brand">
                    <span class="brand-icon">
                        <i class="fa-solid fa-graduation-cap" aria-hidden="true"></i>
                    </span>
                    <span>TCT English</span>
                </div>
            </div>

            <div class="recovery-icon" aria-hidden="true">
                <i class="fa-regular fa-envelope"></i>
            </div>

            <header class="tct-page-header">
                <h1 class="tct-page-title">Hãy kiểm tra email của bạn</h1>
            </header>

            <div class="alert alert-success text-start" role="status">
                <i class="fa-solid fa-circle-check me-2" aria-hidden="true"></i>
                <span>
                    @(string.IsNullOrWhiteSpace(ViewBag.Message as string)
                        ? "Nếu email này tồn tại trong hệ thống, chúng tôi đã gửi hướng dẫn đặt lại mật khẩu."
                        : ViewBag.Message)
                </span>
            </div>

            <p class="recovery-hint">
                Kiểm tra cả thư mục thư rác. Liên kết khôi phục có thời hạn.
            </p>

            <a href="@Url.Action("Login", "Account")" class="btn btn-primary w-100">
                <i class="fa-solid fa-right-to-bracket me-2" aria-hidden="true"></i>
                <span>Quay lại đăng nhập</span>
            </a>

            <a href="@Url.Action("ForgotPassword", "Account")" class="back-link">
                <i class="fa-solid fa-arrow-left me-2" aria-hidden="true"></i>
                <span>Nhập lại email</span>
            </a>
        </main>
    </div>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>

    <!-- Owned Account Auth Script -->
    <script src="~/js/account-auth-ui.js" asp-append-version="true"></script>
</body>
</html>
