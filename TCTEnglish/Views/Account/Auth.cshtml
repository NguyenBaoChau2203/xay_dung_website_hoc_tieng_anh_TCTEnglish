@model dynamic

@{
    ViewData["Title"] = "Đăng nhập / Đăng ký | TCT English";
    Layout = null;
    var activeTab = (ViewData["ActiveTab"] as string) ?? "login";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Đăng nhập hoặc đăng ký tài khoản TCT English – nền tảng học tiếng Anh thông minh." />
    <title>@ViewData["Title"]</title>

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Bootstrap 5.3.3 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />

    <!-- Shared Design System Tokens (Claymorphism) & Scoped Auth Styles -->
    <link href="~/css/tct-learning-ui.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/account-auth-ui.css" rel="stylesheet" asp-append-version="true" />
</head>
<body class="tct-theme account-auth-ui auth-page">

    <div class="auth-split-container">

        <!-- ============================================================
             LEFT COLUMN: Hero with Brand, Illustration & Feature Cards (Claymorphism)
             ============================================================ -->
        <aside class="auth-col-left" aria-label="Giới thiệu TCT English">
            <!-- Dot-grid pattern overlay -->
            <div class="auth-decoration" aria-hidden="true"></div>

            <!-- Floating soft clay shapes -->
            <div class="auth-floating-shapes" aria-hidden="true">
                <div class="auth-shape auth-shape--1"></div>
                <div class="auth-shape auth-shape--2"></div>
                <div class="auth-shape auth-shape--3"></div>
                <div class="auth-shape auth-shape--4"></div>
            </div>

            <!-- Brand content -->
            <div class="auth-brand-content">
                <div class="auth-brand-logo">
                    <i class="fa-solid fa-graduation-cap" aria-hidden="true"></i>
                </div>
                <div class="auth-brand-title">TCT ENGLISH</div>
                <p class="auth-brand-subtitle">
                    Học tiếng Anh thông minh — dành cho mọi người.<br />
                    Nâng tầm ngoại ngữ, mở rộng tương lai.
                </p>
            </div>

            <!-- Custom Vector Illustration for Website -->
            <div class="auth-hero-illustration">
                <img src="~/images/auth/auth-illustration.svg" asp-append-version="true" alt="Học tiếng Anh cùng TCT English" class="auth-hero-img" />
            </div>

            <!-- Feature Clay Cards -->
            <div class="auth-features">
                <div class="auth-feature-card">
                    <div class="auth-feature-icon auth-feature-icon--vocab">
                        <i class="fa-solid fa-book-open" aria-hidden="true"></i>
                    </div>
                    <span class="auth-feature-label">500+ Từ vựng</span>
                </div>
                <div class="auth-feature-card">
                    <div class="auth-feature-icon auth-feature-icon--speaking">
                        <i class="fa-solid fa-microphone" aria-hidden="true"></i>
                    </div>
                    <span class="auth-feature-label">AI Speaking</span>
                </div>
                <div class="auth-feature-card">
                    <div class="auth-feature-icon auth-feature-icon--quiz">
                        <i class="fa-solid fa-bolt" aria-hidden="true"></i>
                    </div>
                    <span class="auth-feature-label">Smart Quiz</span>
                </div>
            </div>
        </aside>

        <!-- ============================================================
             RIGHT COLUMN: Form Card Area (Main Landmark)
             ============================================================ -->
        <main class="auth-col-right" id="main-content">
            <button class="btn auth-close-btn tct-btn-icon" onclick="window.history.back()" aria-label="Quay lại" id="btn-close-auth" type="button">
                <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
            </button>

            <div class="tct-card auth-card">
                <header class="auth-header">
                    <h1 class="tct-page-title" id="auth-heading">Đăng nhập</h1>
                    <p class="auth-subheading" id="auth-description">Tiếp tục học với TCT English.</p>
                </header>

                <!-- TABS: Login / Register -->
                <div class="auth-tabs" role="tablist" aria-label="Chọn hình thức xác thực">
                    <div class="auth-tab-slider" aria-hidden="true"></div>
                    <button class="auth-tab-btn" type="button" role="tab" id="tab-login" aria-selected="true" aria-controls="form-login" tabindex="0" onclick="switchTab('login')">
                        Đăng nhập
                    </button>
                    <button class="auth-tab-btn" type="button" role="tab" id="tab-register" aria-selected="false" aria-controls="form-register" tabindex="-1" onclick="switchTab('register')">
                        Đăng ký
                    </button>
                </div>

                <!-- Server Error Message -->
                @if (ViewBag.ErrorMessage != null)
                {
                    <div class="alert alert-danger" role="alert" id="server-error-alert">
                        <i class="fa-solid fa-circle-exclamation me-2" aria-hidden="true"></i>
                        <span>@ViewBag.ErrorMessage</span>
                    </div>
                }

                @if (TempData["SuccessMessage"] != null)
                {
                    <script>
                        document.addEventListener("DOMContentLoaded", function() {
                            if (typeof Swal !== 'undefined') {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Thành công!',
                                    text: @Html.Raw(Json.Serialize(TempData["SuccessMessage"])),
                                    confirmButtonColor: '#4255ff',
                                    confirmButtonText: 'Đăng nhập ngay'
                                });
                            }
                        });
                    </script>
                }

                <!-- Social Login Buttons -->
                <div class="auth-social-btns">
                    <button class="btn auth-btn-social" type="button" id="btn-google" onclick="handleExternalLogin('@Url.Action("ExternalLogin", "Account", new { provider = "Google" })')">
                        <i class="fa-brands fa-google text-danger" aria-hidden="true"></i>
                        Google
                    </button>
                    <button class="btn auth-btn-social" type="button" id="btn-facebook" onclick="handleExternalLogin('@Url.Action("ExternalLogin", "Account", new { provider = "Facebook" })')">
                        <i class="fa-brands fa-facebook text-primary" aria-hidden="true"></i>
                        Facebook
                    </button>
                </div>

                <div class="auth-separator">hoặc bằng email</div>

                <!-- ==================== LOGIN FORM ==================== -->
                <form id="form-login" action="@Url.Action("Login", "Account")" method="post" onsubmit="handleLogin(event)" role="tabpanel" aria-labelledby="tab-login">
                    @Html.AntiForgeryToken()

                    <div class="auth-form-group">
                        <label class="auth-form-label" for="login-email">Email</label>
                        <input type="email" name="email" class="form-control auth-form-input" placeholder="nhapemail@example.com" required id="login-email" autocomplete="email">
                    </div>

                    <div class="auth-form-group">
                        <label class="auth-form-label" for="login-password">Mật khẩu</label>
                        <div class="auth-password-wrap">
                            <input type="password" name="password" class="form-control auth-form-input" placeholder="••••••••" required id="login-password" autocomplete="current-password">
                            <button type="button" class="auth-toggle-password" onclick="togglePassword('login-password', this)" aria-label="Hiện mật khẩu" aria-pressed="false" aria-controls="login-password">
                                <i class="fa-solid fa-eye" aria-hidden="true"></i>
                            </button>
                        </div>
                        <div class="d-flex justify-content-end mt-1">
                            <a href="@Url.Action("ForgotPassword", "Account")" class="auth-forgot-pass">Quên mật khẩu?</a>
                        </div>
                    </div>

                    <!-- Client Error Alert Box -->
                    <div id="login-error-msg" class="alert alert-danger" role="alert" tabindex="-1" hidden style="display:none;"></div>

                    <!-- Blocked Account Alert -->
                    <div id="blocked-alert" class="alert alert-warning auth-blocked-alert" role="alert" style="display:none;">
                        <div class="fw-bold mb-1">
                            <i class="fa-solid fa-lock me-1" aria-hidden="true"></i> Tài khoản đã bị khóa
                        </div>
                        <p class="mb-1 small">Lý do: <span id="blocked-reason"></span></p>
                        <p class="mb-2 small">Mở khóa: <span id="blocked-expiry"></span></p>
                        <a href="@Url.Action("Contact", "Home", new { subject = "khieu-nai-khoa-tai-khoan" })" class="btn btn-outline-primary btn-sm">
                            <i class="fa-solid fa-paper-plane me-1" aria-hidden="true"></i> Gửi khiếu nại
                        </a>
                    </div>

                    <button type="submit" class="btn btn-primary auth-btn-submit" id="btn-login-submit">
                        <i class="fa-solid fa-right-to-bracket me-2" aria-hidden="true"></i> Đăng nhập
                    </button>

                    <div class="auth-form-footer">
                        Mới sử dụng TCT English? <button type="button" class="btn btn-link auth-link p-0 align-baseline" onclick="switchTab('register')">Tạo tài khoản</button>
                    </div>
                </form>

                <!-- ==================== REGISTER FORM ==================== -->
                <form id="form-register" action="@Url.Action("Register", "Account")" method="post" onsubmit="handleRegister(event)" role="tabpanel" aria-labelledby="tab-register" style="display:none;">
                    @Html.AntiForgeryToken()

                    <div class="auth-form-group">
                        <label class="auth-form-label" for="register-email">Email</label>
                        <input type="email" name="email" class="form-control auth-form-input" placeholder="nhapemail@example.com" required id="register-email" autocomplete="email">
                    </div>

                    <div class="auth-form-group">
                        <label class="auth-form-label" for="register-name">Tên hiển thị</label>
                        <input type="text" name="fullName" class="form-control auth-form-input" placeholder="Nhập tên của bạn" required id="register-name" autocomplete="name">
                    </div>

                    <div class="auth-form-group">
                        <label class="auth-form-label" for="register-password">Mật khẩu</label>
                        <div class="auth-password-wrap">
                            <input type="password" name="password" class="form-control auth-form-input" placeholder="Tối thiểu 6 ký tự" required minlength="6" id="register-password" autocomplete="new-password">
                            <button type="button" class="auth-toggle-password" onclick="togglePassword('register-password', this)" aria-label="Hiện mật khẩu" aria-pressed="false" aria-controls="register-password">
                                <i class="fa-solid fa-eye" aria-hidden="true"></i>
                            </button>
                        </div>
                    </div>

                    <div class="auth-checkbox-wrap">
                        <input type="checkbox" id="terms" class="form-check-input" required>
                        <label for="terms" class="form-check-label ms-1">
                            Tôi chấp nhận <strong>Điều khoản dịch vụ</strong> và <strong>Chính sách quyền riêng tư</strong> của TCT English.
                        </label>
                    </div>

                    <button type="submit" class="btn btn-primary auth-btn-submit" id="btn-register-submit">
                        <i class="fa-solid fa-user-plus me-2" aria-hidden="true"></i> Đăng ký
                    </button>

                    <div class="auth-form-footer">
                        Bạn đã có tài khoản? <button type="button" class="btn btn-link auth-link p-0 align-baseline" onclick="switchTab('login')">Đăng nhập</button>
                    </div>
                </form>

            </div>
        </main>
    </div>

    <!-- LOADER OVERLAY -->
    <div id="loader-overlay" class="loader-overlay" role="status" aria-label="Đang chuyển trang" hidden>
        <div class="loader-box tct-card">
            <div class="spinner-border text-primary mb-3" role="status" aria-hidden="true"></div>
            <p class="mb-0 fw-semibold text-secondary" id="loading-fill">Đang xử lý đăng nhập…</p>
        </div>
    </div>

    @if (TempData["IsBlocked"] is true)
    {
        <!-- ===== BLOCKED ACCOUNT MODAL (Bootstrap 5) ===== -->
        <div class="modal fade" id="blockedAccountModal" tabindex="-1" aria-labelledby="blockedAccountModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow" style="border-radius: var(--tct-radius-xl);">
                    <div class="modal-header border-bottom-0 pb-0">
                        <h2 class="modal-title h5 fw-semibold text-danger" id="blockedAccountModalLabel">
                            <i class="fa-solid fa-lock me-2" aria-hidden="true"></i>Tài khoản đã bị khóa
                        </h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                    </div>
                    <div class="modal-body">
                        <p class="mb-2"><strong>Lý do:</strong> @TempData["LockReason"]</p>
                        <p class="mb-3"><strong>Mở khóa:</strong> @TempData["LockExpiry"]</p>
                        <a href="@Url.Action("Contact", "Home", new { subject = "khieu-nai-khoa-tai-khoan" })" class="btn btn-outline-primary btn-sm">
                            <i class="fa-solid fa-paper-plane me-1" aria-hidden="true"></i> Gửi khiếu nại
                        </a>
                    </div>
                    <div class="modal-footer border-top-0 pt-0">
                        <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Đóng</button>
                    </div>
                </div>
            </div>
        </div>

        <script>
            document.addEventListener('DOMContentLoaded', function () {
                var modalEl = document.getElementById('blockedAccountModal');
                if (modalEl && typeof bootstrap !== 'undefined' && bootstrap.Modal) {
                    var blockedModal = new bootstrap.Modal(modalEl);
                    blockedModal.show();
                }
            });
        </script>
    }

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>

    <!-- Owned Account Auth Script -->
    <script src="~/js/account-auth-ui.js" asp-append-version="true"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var activeTab = '@activeTab';
            if (window.switchTab) {
                window.switchTab(activeTab);
            }

            // Keyboard navigation for tabs
            var tabLog = document.getElementById('tab-login');
            var tabReg = document.getElementById('tab-register');
            var tabs = [tabLog, tabReg];
            tabs.forEach(function (tab, index) {
                if (!tab) return;
                tab.addEventListener('keydown', function (e) {
                    if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
                        e.preventDefault();
                        var nextIndex = (e.key === 'ArrowRight') ? (index + 1) % tabs.length : (index - 1 + tabs.length) % tabs.length;
                        var nextTab = tabs[nextIndex];
                        if (nextTab) {
                            nextTab.click();
                            nextTab.focus();
                        }
                    }
                });
            });

            @if (TempData["BlockedReason"] != null)
            {
                <text>
                if (window.switchTab) window.switchTab('login');
                var bReason = document.getElementById('blocked-reason');
                var bExpiry = document.getElementById('blocked-expiry');
                if (bReason) bReason.textContent = @Html.Raw(Json.Serialize(TempData["BlockedReason"]));
                if (bExpiry) bExpiry.textContent = @Html.Raw(Json.Serialize(TempData["BlockedExpiry"]));
                var bAlert = document.getElementById('blocked-alert');
                if (bAlert) bAlert.style.display = 'block';
                </text>
            }
        });
    </script>
</body>
</html>