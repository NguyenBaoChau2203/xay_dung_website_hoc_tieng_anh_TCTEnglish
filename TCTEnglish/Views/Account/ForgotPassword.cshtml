@model TCTVocabulary.ViewModels.ForgotPasswordViewModel

@{
    Layout = null;
    ViewData["Title"] = "Quên mật khẩu";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Khôi phục quyền truy cập tài khoản TCT English." />
    <title>@ViewData["Title"] - TCT English</title>

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Bootstrap 5.3.3 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />

    <!-- Shared Design System Tokens & Scoped Auth Styles -->
    <link href="~/css/tct-learning-ui.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/account-auth-ui.css" rel="stylesheet" asp-append-version="true" />
</head>
<body class="tct-theme account-auth-ui">

    <div class="auth-surface">
        <main class="tct-card recovery-card" id="main-content">
            <div class="brand">
                <span class="brand-icon">
                    <i class="fa-solid fa-graduation-cap" aria-hidden="true"></i>
                </span>
                <span>TCT English</span>
            </div>

            <header class="tct-page-header">
                <h1 class="tct-page-title">Quên mật khẩu</h1>
                <p class="tct-page-desc">
                    Nhập email đã dùng để đăng ký. Nếu email có trong hệ thống, bạn sẽ nhận được hướng dẫn đặt lại mật khẩu.
                </p>
            </header>

            @using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post, new { id = "form-forgot-password" }))
            {
                @Html.AntiForgeryToken()

                <div class="field">
                    <label class="form-label" for="Email">Địa chỉ email</label>
                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "ban@example.com", type = "email", autocomplete = "email", required = "required", id = "Email" })
                    @Html.ValidationMessageFor(m => m.Email, null, new { @class = "text-danger small mt-1 d-block" })
                </div>

                <button type="submit" class="btn btn-primary w-100" id="btn-forgot-submit">
                    <i class="fa-solid fa-paper-plane me-2" aria-hidden="true"></i>
                    <span>Gửi liên kết khôi phục</span>
                </button>
            }

            <a href="@Url.Action("Login", "Account")" class="back-link">
                <i class="fa-solid fa-arrow-left me-2" aria-hidden="true"></i>
                <span>Quay lại đăng nhập</span>
            </a>
        </main>
    </div>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>

    <!-- Owned Account Auth Script -->
    <script src="~/js/account-auth-ui.js" asp-append-version="true"></script>
</body>
</html>
