@model TCTVocabulary.ViewModels.ForgotPasswordViewModel

@{
    Layout = null;
    ViewData["Title"] = "Quên mật khẩu";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TCT English</title>
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --brand-primary: #4255ff;
            --brand-primary-hover: #3142d6;
            --text-main: #1e293b;
            --text-sub: #64748b;
            --input-bg: #f8fafc;
            --input-border: #e2e8f0;
            --input-focus: #4255ff;
            --white: #ffffff;
            --radius-input: 10px;
            --radius-card: 18px;
            --font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            --card-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.03);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: var(--font-family);
            background-color: #f6f7fb;
            color: var(--text-main);
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            padding: 20px;
            line-height: 1.5;
        }

        .auth-card-container {
            background-color: var(--white);
            width: 100%;
            max-width: 520px;
            padding: 40px;
            border-radius: var(--radius-card);
            box-shadow: var(--card-shadow);
            border: 1px solid #edf0f7;
            text-align: left;
        }

        .brand-header {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 24px;
        }

        .brand-icon {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            background: linear-gradient(135deg, #4255ff 0%, #6366f1 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--white);
            font-size: 20px;
        }

        .brand-text h1 {
            font-size: 18px;
            font-weight: 800;
            color: var(--text-main);
            letter-spacing: -0.02em;
        }

        .brand-text p {
            font-size: 13px;
            color: var(--text-sub);
        }

        h2 {
            font-weight: 700;
            font-size: 24px;
            color: var(--text-main);
            margin-bottom: 8px;
            letter-spacing: -0.01em;
        }

        .description {
            color: var(--text-sub);
            font-size: 15px;
            line-height: 1.6;
            margin-bottom: 28px;
        }

        .form-group {
            margin-bottom: 22px;
        }

        .form-label {
            display: block;
            font-weight: 600;
            font-size: 14px;
            color: var(--text-main);
            margin-bottom: 8px;
        }

        .form-input {
            width: 100%;
            padding: 13px 16px;
            background-color: var(--input-bg);
            border: 1.5px solid var(--input-border);
            border-radius: var(--radius-input);
            font-size: 15px;
            color: var(--text-main);
            font-family: var(--font-family);
            transition: all 0.2s ease;
        }

        .form-input:focus,
        .form-input:focus-visible {
            background-color: var(--white);
            border-color: var(--input-focus);
            outline: none;
            box-shadow: 0 0 0 3px rgba(66, 85, 255, 0.18);
        }

        .btn-submit {
            width: 100%;
            padding: 14px;
            background-color: var(--brand-primary);
            color: var(--white);
            border: none;
            border-radius: var(--radius-input);
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
            font-family: var(--font-family);
            box-shadow: 0 4px 12px rgba(66, 85, 255, 0.25);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .btn-submit:hover {
            background-color: var(--brand-primary-hover);
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(66, 85, 255, 0.35);
        }

        .btn-submit:focus-visible {
            outline: none;
            box-shadow: 0 0 0 3px rgba(66, 85, 255, 0.35), 0 0 0 1px var(--white);
        }

        .back-link {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            text-align: center;
            margin-top: 24px;
            color: var(--text-sub);
            text-decoration: none;
            font-weight: 600;
            font-size: 14px;
            transition: color 0.2s ease;
            padding: 8px;
            border-radius: 8px;
        }

        .back-link:hover {
            color: var(--brand-primary);
        }

        .back-link:focus-visible {
            outline: 2px solid var(--brand-primary);
            outline-offset: 2px;
        }

        .back-link i {
            margin-right: 8px;
            font-size: 13px;
        }

        .field-validation-error {
            color: #ef4444;
            font-size: 13px;
            margin-top: 6px;
            display: block;
            font-weight: 500;
        }

        @@media (max-width: 576px) {
            .auth-card-container {
                padding: 28px 20px;
                border-radius: 16px;
            }
            h2 {
                font-size: 21px;
            }
            .description {
                font-size: 14px;
                margin-bottom: 22px;
            }
        }
    </style>
</head>
<body>

    <div class="auth-card-container">
        <div class="brand-header">
            <div class="brand-icon">
                <i class="fa-solid fa-graduation-cap"></i>
            </div>
            <div class="brand-text">
                <h1>TCT ENGLISH</h1>
                <p>Nền tảng học tập nội bộ</p>
            </div>
        </div>

        <h2>Cài đặt lại mật khẩu</h2>
        <p class="description">
            Hãy nhập email bạn đã dùng để đăng ký tài khoản. Hệ thống sẽ gửi cho bạn một liên kết bảo mật để đặt lại mật khẩu.
        </p>

        @using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label class="form-label" for="Email">Địa chỉ Email</label>
                @Html.TextBoxFor(m => m.Email, new { @class = "form-input", placeholder = "name@email.com", type = "email", autocomplete = "email", required = "required" })
                @Html.ValidationMessageFor(m => m.Email)
            </div>

            <button type="submit" class="btn-submit">
                <i class="fa-solid fa-paper-plane"></i>
                <span>Gửi liên kết khôi phục</span>
            </button>
        }

        <a href="@Url.Action("Login", "Account")" class="back-link">
            <i class="fa-solid fa-arrow-left"></i> Quay lại Đăng nhập
        </a>
    </div>

</body>
</html>
