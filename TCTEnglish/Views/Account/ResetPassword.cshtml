@model TCTVocabulary.ViewModels.ResetPasswordViewModel

@{
    Layout = null;
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Đặt mật khẩu mới cho tài khoản TCT English." />
    <title>@ViewData["Title"] - TCT English</title>

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Bootstrap 5.3.3 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />

    <!-- Shared Design System Tokens & Scoped Auth Styles -->
    <link href="~/css/tct-learning-ui.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/account-auth-ui.css" rel="stylesheet" asp-append-version="true" />
</head>
<body class="tct-theme account-auth-ui">

    <div class="auth-surface">
        <main class="tct-card recovery-card" id="main-content">
            <div class="brand">
                <span class="brand-icon">
                    <i class="fa-solid fa-graduation-cap" aria-hidden="true"></i>
                </span>
                <span>TCT English</span>
            </div>

            <header class="tct-page-header">
                <h1 class="tct-page-title">Đặt lại mật khẩu</h1>
                <p class="tct-page-desc">
                    Nhập mật khẩu mới cho tài khoản của bạn. Mật khẩu phải có ít nhất 6 ký tự.
                </p>
            </header>

            @using (Html.BeginForm("ResetPassword", "Account", FormMethod.Post, new { id = "form-reset-password" }))
            {
                @Html.AntiForgeryToken()

                @Html.HiddenFor(m => m.Token, new { id = "Token" })
                @Html.HiddenFor(m => m.Email, new { id = "Email" })

                @if (ViewData.ModelState["Token"]?.Errors.Count > 0)
                {
                    <div class="alert alert-warning mb-3" role="alert" tabindex="-1" id="token-error-alert">
                        <p class="mb-2 fw-semibold">
                            <i class="fa-solid fa-triangle-exclamation me-2" aria-hidden="true"></i>
                            Liên kết đặt lại mật khẩu không hợp lệ hoặc đã hết hạn.
                        </p>
                        <p class="mb-0 small">
                            Vui lòng <a href="@Url.Action("ForgotPassword", "Account")" class="alert-link fw-bold">yêu cầu một liên kết đặt lại mật khẩu mới</a> để tiếp tục.
                        </p>
                    </div>
                }

                @Html.ValidationSummary(excludePropertyErrors: false, message: null, htmlAttributes: new { @class = "alert alert-danger", role = "alert" })

                <div class="field">
                    <label class="form-label" for="NewPassword">Mật khẩu mới</label>
                    <div class="input-group">
                        @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control", placeholder = "Tối thiểu 6 ký tự", autocomplete = "new-password", minlength = "6", required = "required", id = "NewPassword" })
                        <button type="button" class="btn password-toggle tct-btn-icon" id="toggle-reset-new-password" aria-label="Hiện mật khẩu mới" aria-controls="NewPassword" aria-pressed="false" data-password="NewPassword">
                            <i class="fa-solid fa-eye" aria-hidden="true"></i>
                        </button>
                    </div>
                    @Html.ValidationMessageFor(m => m.NewPassword, null, new { @class = "text-danger small mt-1 d-block" })
                </div>

                <div class="field">
                    <label class="form-label" for="ConfirmPassword">Xác nhận mật khẩu mới</label>
                    <div class="input-group">
                        @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", placeholder = "Nhập lại mật khẩu mới", autocomplete = "new-password", required = "required", id = "ConfirmPassword", aria_describedby = "reset-mismatch" })
                        <button type="button" class="btn password-toggle tct-btn-icon" id="toggle-reset-confirm-password" aria-label="Hiện xác nhận mật khẩu mới" aria-controls="ConfirmPassword" aria-pressed="false" data-password="ConfirmPassword">
                            <i class="fa-solid fa-eye" aria-hidden="true"></i>
                        </button>
                    </div>
                    <p class="text-danger small mt-1 mb-0" id="reset-mismatch" style="display: none;">Mật khẩu xác nhận không khớp.</p>
                    @Html.ValidationMessageFor(m => m.ConfirmPassword, null, new { @class = "text-danger small mt-1 d-block" })
                </div>

                <button type="submit" class="btn btn-primary w-100" id="btn-reset-submit">
                    <i class="fa-solid fa-check me-2" aria-hidden="true"></i>
                    <span>Xác nhận đặt lại mật khẩu</span>
                </button>
            }

            <a href="@Url.Action("Login", "Account")" class="back-link">
                <i class="fa-solid fa-arrow-left me-2" aria-hidden="true"></i>
                <span>Quay lại đăng nhập</span>
            </a>
        </main>
    </div>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>

    <!-- Owned Account Auth Script -->
    <script src="~/js/account-auth-ui.js" asp-append-version="true"></script>
</body>
</html>
