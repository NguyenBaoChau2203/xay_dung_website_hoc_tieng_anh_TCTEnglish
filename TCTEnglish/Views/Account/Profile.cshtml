@model TCTVocabulary.ViewModels.UpdateProfileViewModel
@using TCTEnglish.ViewModels

@{
    ViewData["Title"] = "Hồ sơ của tôi";
    ViewData["HideSidebar"] = true;
    var hasAvatar = !string.IsNullOrEmpty(Model.CurrentAvatarUrl);
    var userInitial = string.IsNullOrWhiteSpace(Model.FullName) ? "U" : Model.FullName.Substring(0, 1).ToUpper();
}

@section Styles {
    <link rel="stylesheet" href="~/css/account-ui.css" asp-append-version="true" />
}

<div class="tct-theme tct-page account-ui">
    <div class="account-surface">

        <!-- ====== ACCOUNT SIDEBAR ====== -->
        <aside class="account-sidebar preview-account-nav" id="accountSidebar" aria-label="Menu tài khoản">
            <div class="nav-heading">
                <strong>Tài khoản</strong>
                <button class="btn btn-outline-primary tct-btn-icon" id="accountSidebarToggle" type="button" aria-controls="accountSidebar" aria-expanded="true" aria-label="Thu gọn hoặc đóng menu tài khoản">
                    <i class="fa-solid fa-chevron-left" id="accountSidebarToggleIcon" aria-hidden="true"></i>
                </button>
            </div>

            <nav aria-label="Tài khoản">
                <button class="sidebar-nav-item preview-nav-item active" type="button" data-tab="profile" aria-current="page">
                    <i class="fa-regular fa-user" aria-hidden="true"></i>
                    <span class="nav-label">Hồ sơ</span>
                </button>
                <button class="sidebar-nav-item preview-nav-item" type="button" data-tab="security">
                    <i class="fa-solid fa-sliders" aria-hidden="true"></i>
                    <span class="nav-label">Cài đặt</span>
                </button>
                <button class="sidebar-nav-item preview-nav-item" type="button" data-tab="subscription">
                    <i class="fa-solid fa-gem" aria-hidden="true"></i>
                    <span class="nav-label">Gói dịch vụ</span>
                </button>
            </nav>

            <div class="nav-logout">
                <a asp-action="Logout" class="btn btn-outline-danger w-100">
                    <i class="fa-solid fa-right-from-bracket me-2" aria-hidden="true"></i>Đăng xuất
                </a>
            </div>
        </aside>

        <!-- ====== MAIN CONTENT ====== -->
        <div class="account-content">

            <!-- Mobile Drawer Opener -->
            <button class="btn btn-outline-primary mobile-account-toggle sidebar-mobile-toggle" id="sidebarMobileToggle" type="button" aria-controls="accountSidebar" aria-expanded="false">
                <i class="fa-solid fa-bars me-2" aria-hidden="true"></i>Menu tài khoản
            </button>

            <!-- Page Header (Single H1) -->
            @await Html.PartialAsync("_PageHeader", new PageHeaderViewModel
            {
                Title = "Hồ sơ của tôi",
                Description = "Cập nhật thông tin cá nhân và xem thành tích học tập."
            })

            <!-- Alert Notifications -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success d-flex align-items-center justify-content-between" role="status">
                    <div>
                        <i class="fa-solid fa-circle-check me-2" aria-hidden="true"></i>
                        <span>@TempData["SuccessMessage"]</span>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger d-flex align-items-center justify-content-between" role="alert">
                    <div>
                        <i class="fa-solid fa-circle-exclamation me-2" aria-hidden="true"></i>
                        <span>@TempData["ErrorMessage"]</span>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
                </div>
            }

            <!-- ═══════════════ TAB: MY PROFILE ═══════════════ -->
            <div class="account-tab-pane active" id="tab-profile">

                <!-- Identity Row -->
                <div class="identity">
                    <div class="avatar-wrap">
                        <div class="avatar" id="avatarFallback" style="@(hasAvatar ? "display:none;" : "")">@userInitial</div>
                        <img id="avatarPreview" src="@(hasAvatar ? Model.CurrentAvatarUrl : "")" alt="Avatar của @Model.FullName" class="avatar" style="@(hasAvatar ? "" : "display:none;")" onerror="this.style.display='none'; var fb = document.getElementById('avatarFallback'); if (fb) fb.style.display='flex';" />
                        <button type="button" class="btn btn-primary tct-btn-icon avatar-edit" id="avatarClickTarget" aria-label="Thay đổi ảnh đại diện">
                            <i class="fa-solid fa-pen" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="identity-text">
                        <h2>@Model.FullName</h2>
                        <p class="text-secondary mb-2">@Model.Email</p>
                        <span class="tct-badge @(Model.Role == "Premium" ? "tct-badge--warning" : Model.Role == "Admin" ? "tct-badge--success" : "tct-badge--primary")">@Model.Role</span>
                    </div>
                </div>

                <!-- Streak & Badges Stats -->
                <dl class="profile-stats">
                    <div>
                        <dt>Chuỗi học</dt>
                        <dd>@Model.StreakDays Ngày</dd>
                    </div>
                    <div>
                        <dt>Danh hiệu</dt>
                        <dd>@Model.EarnedBadges.Count</dd>
                    </div>
                </dl>

                <!-- Profile Columns (Form + Info) -->
                <div class="profile-columns">

                    <!-- Form Personal Info -->
                    <section class="tct-card panel">
                        <h2>Thông tin cá nhân</h2>

                        <form asp-controller="Account" asp-action="UpdateProfile" method="post" enctype="multipart/form-data">
                            @Html.AntiForgeryToken()
                            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                            <input asp-for="Avatar" type="file" id="Avatar" class="visually-hidden" accept=".jpg,.jpeg,.png" tabindex="-1" />
                            <span asp-validation-for="Avatar" class="text-danger small d-block"></span>
                            <p class="form-text mb-2">JPG hoặc PNG, tối đa 2 MB. Ảnh chỉ được lưu khi bạn chọn Lưu thay đổi.</p>
                            <p class="small" id="avatar-status" role="status" hidden></p>

                            <div class="field">
                                <label asp-for="FullName" class="form-label">Họ và tên</label>
                                <input asp-for="FullName" class="form-control" placeholder="Ví dụ: Nguyễn Văn A" id="FullName" required />
                                <span asp-validation-for="FullName" class="text-danger small d-block mt-1"></span>
                            </div>

                            <div class="field">
                                <label class="form-label" for="profile-display-email">Địa chỉ email</label>
                                <input type="email" id="profile-display-email" class="form-control" value="@Model.Email" readonly aria-describedby="profile-email-hint" />
                                <p class="form-text mt-1" id="profile-email-hint">
                                    Đổi email tại <a href="#tab-security" data-tab="security">Cài đặt tài khoản</a>.
                                </p>
                            </div>

                            <div class="form-actions">
                                <button type="button" class="btn btn-outline-primary" id="profile-cancel">Hủy</button>
                                <button type="submit" class="btn btn-primary" id="profile-save">
                                    <i class="fa-solid fa-floppy-disk me-2" aria-hidden="true"></i>Lưu thay đổi
                                </button>
                            </div>
                        </form>
                    </section>

                    <!-- Side Info Stack -->
                    <aside class="info-stack">
                        <section class="tct-card panel">
                            <h2>Gói thành viên</h2>
                            <p class="fw-semibold mb-1">
                                @(Model.Role == "Premium" ? "TCT English Premium" : Model.Role == "Admin" ? "Vai trò Admin" : "TCT English Standard")
                            </p>
                            <p class="text-secondary small mb-3">Chưa có thông tin thời hạn tại đây.</p>
                            @if (Model.Role != "Premium" && Model.Role != "Admin")
                            {
                                <a href="/Premium" class="btn btn-outline-primary btn-sm">Nâng cấp Premium</a>
                            }
                        </section>

                        <section class="tct-card panel">
                            <h2>Mục tiêu học tập</h2>
                            <p class="text-secondary small mb-3">Theo dõi tiến độ học tập và thiết lập chỉ tiêu cá nhân tại trang Mục tiêu.</p>
                            <a asp-controller="Goals" asp-action="Index" class="btn btn-outline-primary btn-sm">
                                Xem &amp; điều chỉnh mục tiêu
                            </a>
                        </section>

                        <section class="tct-card panel">
                            <h2>Thông tin khác</h2>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-secondary small">Ngôn ngữ giao diện</span>
                                <span class="small fw-semibold">Tiếng Việt</span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="text-secondary small">Múi giờ</span>
                                <span class="small fw-semibold">GMT +7</span>
                            </div>
                        </section>
                    </aside>
                </div>

                <!-- Earned Badges -->
                <section class="tct-card panel">
                    <h2>Danh hiệu đã đạt</h2>
                    @if (Model.EarnedBadges == null || Model.EarnedBadges.Count == 0)
                    {
                        @await Html.PartialAsync("_StateMessage", new StateMessageViewModel
                        {
                            Kind = StateMessageKind.Empty,
                            Title = "Chưa có danh hiệu",
                            Message = "Danh hiệu sẽ xuất hiện khi bạn hoàn thành các mốc học tập.",
                            ActionLabel = "Xem mục tiêu học tập",
                            ActionUrl = "/Goals"
                        })
                    }
                    else
                    {
                        <ul class="badge-list">
                            @foreach (var badge in Model.EarnedBadges.Where(b => b.IsUnlocked))
                            {
                                <li>
                                    <i class="@(string.IsNullOrEmpty(badge.IconClass) ? "fa-solid fa-award" : badge.IconClass)" aria-hidden="true"></i>
                                    <div>
                                        <strong>@badge.Name</strong>
                                        <p class="text-secondary small">@badge.Description</p>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                </section>
            </div>

            <!-- ═══════════════ TAB: SECURITY & PASSWORD ═══════════════ -->
            <div class="account-tab-pane" id="tab-security" hidden>
                <h2 tabindex="-1" id="profile-security-heading">Cài đặt tài khoản</h2>
                <p class="text-secondary">
                    Quản lý các thiết lập bảo mật, mật khẩu và tùy chỉnh tài khoản của bạn.
                </p>

                <div class="tct-card panel mb-4">
                    <!-- Update Email -->
                    <form asp-controller="Account" asp-action="UpdateEmail" method="post" class="security-form">
                        @Html.AntiForgeryToken()
                        <h3><i class="fa-solid fa-envelope text-primary me-2" aria-hidden="true"></i>Địa chỉ email</h3>
                        <p class="text-secondary small">Email này dùng để thông báo và khôi phục mật khẩu nếu bạn quên.</p>
                        <div class="email-row">
                            <div class="field">
                                <label class="form-label visually-hidden" for="profileEmailInput">Địa chỉ email</label>
                                <input id="profileEmailInput" name="Email" value="@Model.Email" class="form-control" autocomplete="email" required />
                            </div>
                            <button type="submit" class="btn btn-primary" id="profile-email-submit">Cập nhật email</button>
                        </div>
                    </form>

                    <!-- Change Password -->
                    <form asp-controller="Account" asp-action="ChangePassword" method="post" class="security-form">
                        @Html.AntiForgeryToken()
                        <h3><i class="fa-solid fa-key text-primary me-2" aria-hidden="true"></i>Thay đổi mật khẩu</h3>
                        <p class="form-text mb-3">Ít nhất 6 ký tự theo yêu cầu hiện tại.</p>

                        <div class="password-fields">
                            <div class="field">
                                <label class="form-label" for="profileCurrentPassword">Mật khẩu hiện tại</label>
                                <div class="input-group">
                                    <input id="profileCurrentPassword" name="CurrentPassword" type="password" class="form-control" autocomplete="current-password" required />
                                    <button class="btn password-toggle tct-btn-icon toggle-pwd" type="button" aria-label="Hiện mật khẩu hiện tại" aria-controls="profileCurrentPassword" aria-pressed="false" data-password="profileCurrentPassword">
                                        <i class="fa-solid fa-eye" aria-hidden="true"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="field">
                                <label class="form-label" for="profileNewPassword">Mật khẩu mới</label>
                                <div class="input-group">
                                    <input id="profileNewPassword" name="NewPassword" type="password" class="form-control" autocomplete="new-password" minlength="6" required />
                                    <button class="btn password-toggle tct-btn-icon toggle-pwd" type="button" aria-label="Hiện mật khẩu mới" aria-controls="profileNewPassword" aria-pressed="false" data-password="profileNewPassword">
                                        <i class="fa-solid fa-eye" aria-hidden="true"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="field">
                                <label class="form-label" for="profileConfirmPassword">Xác nhận mật khẩu</label>
                                <div class="input-group">
                                    <input id="profileConfirmPassword" name="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" required />
                                    <button class="btn password-toggle tct-btn-icon toggle-pwd" type="button" aria-label="Hiện xác nhận mật khẩu" aria-controls="profileConfirmPassword" aria-pressed="false" data-password="profileConfirmPassword">
                                        <i class="fa-solid fa-eye" aria-hidden="true"></i>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div class="form-actions">
                            <button type="submit" class="btn btn-primary">Đổi mật khẩu</button>
                        </div>
                    </form>
                </div>

                <!-- Notifications -->
                <section class="tct-card panel mb-4" id="section-notifications" aria-labelledby="heading-notifications">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h2 id="heading-notifications" class="mb-0">
                            <i class="fa-solid fa-bell text-primary me-2" aria-hidden="true"></i>Thông báo
                        </h2>
                        <span class="badge bg-secondary-subtle text-secondary border">Chưa hỗ trợ</span>
                    </div>
                    <p class="text-secondary small mb-3">Tùy chọn nhận thông báo đẩy và email định kỳ. Tính năng này hiện đang được nâng cấp.</p>

                    <fieldset disabled>
                        <div class="preference-row">
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input notification-checkbox" id="prefPush" />
                                <label class="form-check-label" for="prefPush">
                                    <strong>Thông báo đẩy (Push)</strong>
                                    <p class="text-secondary small mb-0">Nhận thông báo về lịch học và nhắc nhở ôn tập trên thiết bị.</p>
                                </label>
                            </div>
                        </div>
                        <div class="preference-row mt-3">
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input notification-checkbox" id="prefEmail" />
                                <label class="form-check-label" for="prefEmail">
                                    <strong>Email định kỳ</strong>
                                    <p class="text-secondary small mb-0">Bản tin học tập hàng tuần và báo cáo tiến độ qua email.</p>
                                </label>
                            </div>
                        </div>
                    </fieldset>
                </section>

                <!-- Linked Accounts -->
                <section class="tct-card panel mb-4" id="section-linked" aria-labelledby="heading-linked">
                    <h2 id="heading-linked">
                        <i class="fa-solid fa-link text-primary me-2" aria-hidden="true"></i>Tài khoản liên kết
                    </h2>
                    <p class="text-secondary small mb-3">Liên kết tài khoản bên thứ ba để đăng nhập nhanh chóng và an toàn hơn.</p>

                    <div class="linked-row">
                        <div class="provider">
                            <div class="social-icon text-danger fs-3">
                                <i class="fa-brands fa-google" aria-hidden="true"></i>
                            </div>
                            <div>
                                <strong>Google</strong>
                                <p class="text-secondary small mb-0">Chưa liên kết</p>
                            </div>
                        </div>
                        <div>
                            <span class="badge bg-secondary-subtle text-secondary border">Chưa liên kết</span>
                        </div>
                    </div>

                    <div class="linked-row">
                        <div class="provider">
                            <div class="social-icon text-primary fs-3">
                                <i class="fa-brands fa-facebook" aria-hidden="true"></i>
                            </div>
                            <div>
                                <strong>Facebook</strong>
                                <p class="text-secondary small mb-0">Chưa liên kết</p>
                            </div>
                        </div>
                        <div>
                            <span class="badge bg-secondary-subtle text-secondary border">Chưa liên kết</span>
                        </div>
                    </div>
                </section>

                <!-- Danger Zone -->
                <section class="tct-card panel danger-panel" id="section-danger">
                    <h2 class="text-danger">
                        <i class="fa-solid fa-triangle-exclamation text-danger me-2" aria-hidden="true"></i>Vùng nguy hiểm
                    </h2>
                    <p class="text-secondary small">Tất cả dữ liệu học tập, bộ từ vựng và tiến trình sẽ không thể khôi phục sau khi xóa.</p>
                    <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteAccountModal">
                        Xóa tài khoản
                    </button>
                </section>
            </div>

            <!-- ═══════════════ TAB: SUBSCRIPTION ═══════════════ -->
            <div class="account-tab-pane" id="tab-subscription" hidden>
                <h2 tabindex="-1" id="profile-subscription-heading">Gói dịch vụ</h2>
                <section class="tct-card panel">
                    <h3>@(Model.Role == "Premium" ? "TCT English Premium" : Model.Role == "Admin" ? "Vai trò Admin" : "TCT English Standard")</h3>
                    <p class="text-secondary mb-3">Chưa có thông tin thời hạn tại đây.</p>
                    @if (Model.Role != "Premium" && Model.Role != "Admin")
                    {
                        <a href="/Premium" class="btn btn-primary">Nâng cấp Premium</a>
                    }
                </section>
            </div>

        </div>

        <!-- Sidebar Backdrop for Mobile -->
        <div id="sidebarOverlay" class="offcanvas-backdrop fade" hidden></div>

        <!-- Delete Account Confirmation Modal -->
        <div class="modal fade confirm-modal" id="deleteAccountModal" tabindex="-1" aria-labelledby="deleteAccountModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header border-bottom-0 pb-0">
                        <h2 class="modal-title h5 fw-bold text-danger" id="deleteAccountModalLabel">
                            <i class="fa-solid fa-triangle-exclamation me-2" aria-hidden="true"></i>Xác nhận xóa tài khoản
                        </h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                    </div>
                    <div class="modal-body">
                        <p class="text-secondary mb-1">
                            Bạn có chắc chắn muốn xóa tài khoản? Tất cả dữ liệu học tập, bộ từ vựng và tiến trình sẽ bị <strong class="text-danger">xóa vĩnh viễn</strong>.
                        </p>
                        <p class="text-secondary small mb-3">Hành động này không thể hoàn tác.</p>

                        <div class="field mb-0">
                            <label class="form-label" for="deleteConfirmInput">Gõ <strong>CONFIRM</strong> để tiếp tục:</label>
                            <input type="text" id="deleteConfirmInput" class="form-control" placeholder="CONFIRM" autocomplete="off" />
                        </div>
                    </div>
                    <div class="modal-footer border-top-0 pt-0">
                        <button type="button" class="btn btn-outline-primary" data-bs-dismiss="modal">Hủy</button>
                        <form asp-controller="Account" asp-action="DeleteAccount" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" id="deleteAccountBtn" class="btn btn-danger" disabled>
                                <i class="fa-solid fa-trash-can me-1" aria-hidden="true"></i> Xóa vĩnh viễn
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/account-ui.js" asp-append-version="true"></script>
}
