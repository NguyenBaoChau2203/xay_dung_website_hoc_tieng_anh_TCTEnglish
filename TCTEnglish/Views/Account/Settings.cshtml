@model TCTVocabulary.ViewModels.SecuritySettingsViewModel
@using TCTEnglish.ViewModels

@{
    ViewData["Title"] = "Cài đặt tài khoản";
    ViewData["HideSidebar"] = true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/account-ui.css" asp-append-version="true" />
}

<div class="tct-theme tct-page account-ui">
    <div class="account-surface">

        <!-- ====== ACCOUNT SIDEBAR ====== -->
        <aside class="account-sidebar preview-account-nav" id="accountSidebar" aria-label="Menu tài khoản">
            <div class="nav-heading">
                <strong>Tài khoản</strong>
                <button class="btn btn-outline-primary tct-btn-icon" id="accountSidebarToggle" type="button" aria-controls="accountSidebar" aria-expanded="true" aria-label="Thu gọn hoặc đóng menu tài khoản">
                    <i class="fa-solid fa-chevron-left" id="accountSidebarToggleIcon" aria-hidden="true"></i>
                </button>
            </div>

            <nav aria-label="Tài khoản">
                <a class="sidebar-nav-item preview-nav-item" href="@Url.Action("Profile", "Account")">
                    <span class="nav-icon-box nav-icon-box--profile" aria-hidden="true">
                        <i class="fa-solid fa-user"></i>
                    </span>
                    <span class="nav-label">Hồ sơ</span>
                </a>
                <a class="sidebar-nav-item preview-nav-item active" href="@Url.Action("Settings", "Account")" aria-current="page">
                    <span class="nav-icon-box nav-icon-box--security" aria-hidden="true">
                        <i class="fa-solid fa-sliders"></i>
                    </span>
                    <span class="nav-label">Cài đặt</span>
                </a>
                <a class="sidebar-nav-item preview-nav-item" href="/Account/Profile?tab=subscription">
                    <span class="nav-icon-box nav-icon-box--subscription" aria-hidden="true">
                        <i class="fa-solid fa-gem"></i>
                    </span>
                    <span class="nav-label">Gói dịch vụ</span>
                </a>
            </nav>

            <div class="nav-logout">
                <a asp-action="Logout" class="btn btn-outline-danger w-100 btn-logout" title="Đăng xuất" aria-label="Đăng xuất">
                    <span class="nav-icon-box nav-icon-box--logout" aria-hidden="true">
                        <i class="fa-solid fa-right-from-bracket"></i>
                    </span>
                    <span class="nav-label">Đăng xuất</span>
                </a>
            </div>
        </aside>

        <!-- ====== MAIN CONTENT ====== -->
        <div class="account-content">

            <!-- Mobile Drawer Opener -->
            <button class="btn btn-outline-primary mobile-account-toggle sidebar-mobile-toggle" id="sidebarMobileToggle" type="button" aria-controls="accountSidebar" aria-expanded="false">
                <i class="fa-solid fa-bars me-2" aria-hidden="true"></i>Menu tài khoản
            </button>

            <!-- Dynamic Account Header Hero (Single H1, Claymorphism) -->
            <header class="account-header-hero tct-card" aria-label="Tiêu đề trang cài đặt">
                <div class="account-header-hero__content">
                    <nav class="account-breadcrumb-nav" aria-label="Đường dẫn">
                        <span class="account-breadcrumb-pill">
                            <i class="fa-solid fa-sliders text-primary me-1" aria-hidden="true"></i>
                            <span>Tài khoản</span>
                            <span class="breadcrumb-sep text-secondary mx-1">/</span>
                            <span class="breadcrumb-active fw-semibold text-primary">Cài đặt</span>
                        </span>
                    </nav>
                    <div class="account-header-hero__titles">
                        <h1 class="tct-page-title account-hero-title mb-1">Cài đặt tài khoản</h1>
                        <p class="tct-page-desc account-hero-desc text-secondary mb-0">
                            Quản lý các thiết lập bảo mật và tùy chỉnh trải nghiệm học tập của bạn.
                        </p>
                    </div>
                </div>

                <div class="account-header-hero__meta" aria-label="Thông tin nhanh tài khoản">
                    <div class="account-meta-chip meta-chip--status">
                        <span class="meta-chip__icon bg-success-subtle text-success">
                            <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
                        </span>
                        <div class="meta-chip__text">
                            <span class="meta-chip__label">Trạng thái</span>
                            <strong class="meta-chip__val text-success">Hoạt động</strong>
                        </div>
                    </div>

                    <div class="account-meta-chip meta-chip--security">
                        <span class="meta-chip__icon bg-purple-subtle text-purple">
                            <i class="fa-solid fa-shield-alt" aria-hidden="true"></i>
                        </span>
                        <div class="meta-chip__text">
                            <span class="meta-chip__label">Bảo mật</span>
                            <strong class="meta-chip__val text-primary">Đã kích hoạt</strong>
                        </div>
                    </div>

                    <div class="account-meta-chip meta-chip--zone">
                        <span class="meta-chip__icon bg-info-subtle text-info">
                            <i class="fa-solid fa-globe" aria-hidden="true"></i>
                        </span>
                        <div class="meta-chip__text">
                            <span class="meta-chip__label">Múi giờ</span>
                            <strong class="meta-chip__val">GMT +7</strong>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Alert Notifications -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success d-flex align-items-center justify-content-between" role="status">
                    <div>
                        <i class="fa-solid fa-circle-check me-2" aria-hidden="true"></i>
                        <span>@TempData["SuccessMessage"]</span>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger d-flex align-items-center justify-content-between" role="alert">
                    <div>
                        <i class="fa-solid fa-circle-exclamation me-2" aria-hidden="true"></i>
                        <span>@TempData["ErrorMessage"]</span>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
                </div>
            }

            <!-- Settings Section Quick Navigation -->
            <nav class="section-nav" aria-label="Điều hướng các mục cài đặt">
                <button type="button" class="btn btn-outline-primary active" data-section="security">
                    <i class="fa-solid fa-shield-alt me-2" aria-hidden="true"></i>Bảo mật
                </button>
                <button type="button" class="btn btn-outline-primary" data-section="notifications">
                    <i class="fa-solid fa-bell me-2" aria-hidden="true"></i>Thông báo
                </button>
                <button type="button" class="btn btn-outline-primary" data-section="linked">
                    <i class="fa-solid fa-link me-2" aria-hidden="true"></i>Tài khoản liên kết
                </button>
                <button type="button" class="btn btn-outline-danger" data-section="danger">
                    <i class="fa-solid fa-triangle-exclamation me-2" aria-hidden="true"></i>Vùng nguy hiểm
                </button>
            </nav>

            <!-- ── Security & Password ── -->
            <section class="tct-card panel mb-4" id="section-security" aria-labelledby="heading-security">
                <div class="panel-header d-flex align-items-center gap-2 mb-3">
                    <span class="panel-icon-box panel-icon-box--purple" aria-hidden="true">
                        <i class="fa-solid fa-shield-alt"></i>
                    </span>
                    <h2 id="heading-security" class="mb-0">Bảo mật &amp; Mật khẩu</h2>
                </div>

                <!-- Email Update -->
                <form asp-controller="Account" asp-action="UpdateEmail" method="post" class="security-form mb-4">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ReturnSurface" value="settings" />
                    <div class="mb-3">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="panel-icon-box panel-icon-box--blue" aria-hidden="true">
                                <i class="fa-solid fa-envelope"></i>
                            </span>
                            <h3 class="h6 fw-bold mb-0">Địa chỉ email</h3>
                        </div>
                        <p class="text-secondary small">Email này dùng để thông báo và khôi phục mật khẩu nếu bạn quên.</p>
                        <div class="email-row">
                            <div class="field">
                                <label for="settingsEmailInput" class="form-label visually-hidden">Địa chỉ email</label>
                                <input id="settingsEmailInput" name="Email" type="email" value="@(ViewData["EmailChangeInput"] as string ?? Model?.Email)" class="form-control" placeholder="name@example.com" autocomplete="email" />
                                <input name="CurrentPassword" type="password" class="form-control mt-2" autocomplete="current-password" placeholder="Mật khẩu hiện tại" />
                                <input name="ProofCode" class="form-control mt-2" placeholder="Mã email nếu không có mật khẩu cục bộ" autocomplete="one-time-code" />
                            </div>
                            <button type="submit" class="btn btn-primary">Gửi xác nhận</button>
                        </div>
                    </div>
                </form>

                <!-- Change Password -->
                <form asp-controller="Account" asp-action="ChangePassword" method="post" class="security-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ReturnSurface" value="settings" />
                    <div class="mb-3">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="panel-icon-box panel-icon-box--purple" aria-hidden="true">
                                <i class="fa-solid fa-key"></i>
                            </span>
                            <h3 class="h6 fw-bold mb-0">Thay đổi mật khẩu</h3>
                        </div>
                        <p class="text-secondary small">Mật khẩu nên dài ít nhất 6 ký tự. Chỉ nhập nếu bạn muốn thay đổi mật khẩu hiện tại.</p>
                    </div>

                    <div class="password-fields mb-3">
                        <div>
                            <label asp-for="CurrentPassword" class="form-label">Mật khẩu hiện tại</label>
                            <div class="input-group">
                                <input asp-for="CurrentPassword" type="password" class="form-control" placeholder="Mật khẩu hiện nay" autocomplete="current-password" />
                                <button class="btn btn-outline-secondary toggle-pwd" type="button" aria-label="Hiện mật khẩu" aria-pressed="false">
                                    <i class="fa-solid fa-eye" aria-hidden="true"></i>
                                </button>
                            </div>
                            <span asp-validation-for="CurrentPassword" class="text-danger small mt-1 d-block"></span>
                        </div>
                        <div>
                            <label asp-for="NewPassword" class="form-label">Mật khẩu mới</label>
                            <div class="input-group">
                                <input asp-for="NewPassword" type="password" class="form-control" placeholder="Tối thiểu 6 ký tự" autocomplete="new-password" />
                                <button class="btn btn-outline-secondary toggle-pwd" type="button" aria-label="Hiện mật khẩu" aria-pressed="false">
                                    <i class="fa-solid fa-eye" aria-hidden="true"></i>
                                </button>
                            </div>
                            <span asp-validation-for="NewPassword" class="text-danger small mt-1 d-block"></span>
                        </div>
                        <div>
                            <label asp-for="ConfirmPassword" class="form-label">Xác nhận mật khẩu</label>
                            <div class="input-group">
                                <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Nhập lại mật khẩu" autocomplete="new-password" />
                                <button class="btn btn-outline-secondary toggle-pwd" type="button" aria-label="Hiện mật khẩu" aria-pressed="false">
                                    <i class="fa-solid fa-eye" aria-hidden="true"></i>
                                </button>
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="settings-first-password-proof">Mã email để đặt mật khẩu đầu tiên</label>
                        <input id="settings-first-password-proof" name="ProofCode" class="form-control" autocomplete="one-time-code" maxlength="128" />
                    </div>
                    <div class="d-flex justify-content-end">
                        <button type="submit" class="btn btn-primary">Đổi mật khẩu</button>
                    </div>
                </form>
            </section>

            <!-- ── Notifications ── -->
            <section class="tct-card panel mb-4" id="section-notifications" aria-labelledby="heading-notifications">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="d-flex align-items-center gap-2">
                        <span class="panel-icon-box panel-icon-box--amber" aria-hidden="true">
                            <i class="fa-solid fa-bell"></i>
                        </span>
                        <h2 id="heading-notifications" class="mb-0">Thông báo</h2>
                    </div>
                    <span class="badge bg-light text-dark border">Đã nối máy chủ</span>
                </div>
                <p class="text-secondary small mb-3">@Model.EmailVerificationText @Model.PushState</p>
                @await Html.PartialAsync("_NotificationPreferences", new TCTEnglish.Services.Notifications.NotificationPreferenceForm
                {
                    DailyReminderEnabled = Model.DailyReminderEnabled,
                    ReminderHour = Model.ReminderHour,
                    ReminderMinute = Model.ReminderMinute,
                    TimeZoneId = Model.TimeZoneId,
                    PushOptIn = Model.PushOptIn,
                    WeeklyEmailOptIn = Model.WeeklyEmailOptIn,
                    PushState = Model.PushState,
                    EmailState = Model.EmailState,
                    PushConfigured = Model.PushConfigured,
                    ReturnSurface = "settings"
                })
                @await Html.PartialAsync("_AccountProofRequests", "settings")
            </section>

            <!-- ── Linked Accounts ── -->
            <section class="tct-card panel mb-4" id="section-linked" aria-labelledby="heading-linked">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="panel-icon-box panel-icon-box--indigo" aria-hidden="true">
                        <i class="fa-solid fa-link"></i>
                    </span>
                    <h2 id="heading-linked" class="mb-0">Tài khoản liên kết</h2>
                </div>
                <p class="text-secondary small mb-3">Liên kết tài khoản bên thứ ba để đăng nhập nhanh chóng và an toàn hơn.</p>

                <!-- Google -->
                <div class="linked-row">
                    <div class="provider">
                        <div class="social-icon-box social-icon-box--google" aria-hidden="true">
                            <i class="fa-brands fa-google"></i>
                        </div>
                        <div>
                            <strong>Google</strong>
                            @if (Model.IsGoogleLinked)
                            {
                                <p class="text-success small mb-0">Đã kết nối</p>
                            }
                            else if (Model.HasUnconfirmedSocialLoginMarker)
                            {
                                <p class="text-unconfirmed-warning small mb-0">Có thể đã đăng nhập Google — chưa xác nhận trong hệ thống liên kết</p>
                            }
                            else
                            {
                                <p class="text-secondary small mb-0">Chưa kết nối</p>
                            }
                        </div>
                    </div>
                    <div>
                        @if (Model.IsGoogleLinked)
                        {
                            <span class="tct-badge tct-badge--success px-3 py-2">Đã kết nối</span>
                        }
                        else if (Model.HasUnconfirmedSocialLoginMarker)
                        {
                            <span class="tct-badge tct-badge--warning px-3 py-2">Chưa xác nhận</span>
                        }
                        else
                        {
                            <a href="/Account/LinkGoogle" class="btn btn-outline-primary btn-sm">Kết nối Google</a>
                        }
                    </div>
                </div>

                <!-- Facebook -->
                <div class="linked-row">
                    <div class="provider">
                        <div class="social-icon-box social-icon-box--facebook" aria-hidden="true">
                            <i class="fa-brands fa-facebook"></i>
                        </div>
                        <div>
                            <strong>Facebook</strong>
                            @if (Model.IsFacebookLinked)
                            {
                                <p class="text-success small mb-0">Đã kết nối</p>
                            }
                            else
                            {
                                <p class="text-secondary small mb-0">Chưa kết nối</p>
                            }
                        </div>
                    </div>
                    <div>
                        @if (Model.IsFacebookLinked)
                        {
                            <span class="tct-badge tct-badge--success px-3 py-2">Đã kết nối</span>
                        }
                        else
                        {
                            <a href="/Account/LinkFacebook" class="btn btn-outline-primary btn-sm">Kết nối Facebook</a>
                        }
                    </div>
                </div>
            </section>

            <!-- ── Danger Zone ── -->
            <section class="tct-card panel danger-zone danger-panel mb-4" id="section-danger" aria-labelledby="heading-danger">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="panel-icon-box panel-icon-box--red" aria-hidden="true">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                    </span>
                    <h2 id="heading-danger" class="text-danger mb-0">Vùng nguy hiểm</h2>
                </div>
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div>
                        <strong class="d-block mb-1">Xóa tài khoản vĩnh viễn</strong>
                        <p class="text-secondary small mb-0">Một khi đã xóa, tất cả dữ liệu học tập của bạn sẽ không thể khôi phục.</p>
                    </div>
                    <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteAccountModal">
                        <i class="fa-solid fa-trash-can me-2" aria-hidden="true"></i>Xóa tài khoản
                    </button>
                </div>
            </section>

        </div>

        <!-- Backdrop for mobile offcanvas drawer -->
        <div id="sidebarOverlay" class="offcanvas-backdrop fade" hidden></div>
    </div>

    <!-- Delete Account Confirmation Modal -->
    <div class="modal fade confirm-modal" id="deleteAccountModal" tabindex="-1" aria-labelledby="deleteAccountModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-danger bg-opacity-10">
                    <h3 class="modal-title h5 fw-bold text-danger mb-0" id="deleteAccountModalLabel">
                        <i class="fa-solid fa-triangle-exclamation me-2" aria-hidden="true"></i>Xác nhận xóa tài khoản
                    </h3>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body">
                    <p class="text-secondary mb-2">Bạn có chắc chắn muốn xóa tài khoản? Tất cả dữ liệu học tập, bộ từ vựng, và tiến trình sẽ bị <strong class="text-danger">xóa vĩnh viễn</strong>.</p>
                    <p class="text-danger small mb-3">Hành động này không thể hoàn tác.</p>

                    <form asp-controller="Account" asp-action="DeleteAccount" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnSurface" value="settings" />
                        <div class="confirm-input-wrap">
                            <label for="deleteConfirmInput" class="form-label">Gõ <strong>CONFIRM</strong> để tiếp tục:</label>
                            <input type="text" id="deleteConfirmInput" name="confirmText" class="form-control" placeholder="CONFIRM" autocomplete="off" />
                        </div>
                        <label class="form-label mt-2" for="deleteCurrentPassword">Mật khẩu hiện tại hoặc mã xác nhận</label>
                        <input type="password" id="deleteCurrentPassword" name="currentPassword" class="form-control" autocomplete="current-password" />
                        <input type="text" name="proofCode" class="form-control mt-2" placeholder="Mã email nếu không có mật khẩu cục bộ" autocomplete="one-time-code" />
                        <div class="modal-footer px-0">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                            <button type="submit" id="deleteAccountBtn" class="btn btn-danger fw-medium" disabled>
                                <i class="fa-solid fa-trash-can me-1" aria-hidden="true"></i>Xóa vĩnh viễn
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/account-ui.js" asp-append-version="true"></script>
    <script src="~/js/account-push.js" asp-append-version="true"></script>
}
