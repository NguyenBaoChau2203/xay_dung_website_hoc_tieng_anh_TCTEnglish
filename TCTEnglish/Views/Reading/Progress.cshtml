@model TCTEnglish.Services.Reading.ReadingProgressViewModel
@using TCTEnglish.ViewModels
@{
    ViewData["Title"] = "Tiến độ Reading";
    Layout = "_Layout";
    var header = new PageHeaderViewModel
    {
        Title = "Tiến độ Reading",
        Description = "Số bài hoàn thành, điểm và lịch sử làm bài của bạn.",
        Breadcrumbs = new[]
        {
            new PageBreadcrumbItem("Reading", Url.Action("Reading", "Study")),
            new PageBreadcrumbItem("Tiến độ")
        }
    };
}

<div class="container py-4 tct-theme reading-progress-page">
    <partial name="_PageHeader" model="header" />

    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="tct-card p-3 h-100">
                <div class="text-muted small">Bài hoàn thành</div>
                <div class="fs-3">@Model.CompletedCount</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="tct-card p-3 h-100">
                <div class="text-muted small">Điểm TB %</div>
                <div class="fs-3">@Model.AverageScorePercent.ToString("0.0")</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="tct-card p-3 h-100">
                <div class="text-muted small">Độ chính xác %</div>
                <div class="fs-3">@Model.AccuracyPercent.ToString("0.0")</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="tct-card p-3 h-100">
                <div class="text-muted small">Thời gian học (phút)</div>
                <div class="fs-3">@((Model.TotalStudySeconds / 60.0).ToString("0"))</div>
            </div>
        </div>
    </div>

    <h2 class="h5">Theo dạng câu hỏi</h2>
    @if (Model.AccuracyByQuestionType.Count == 0)
    {
        <p class="text-muted">Chưa có dữ liệu theo dạng câu hỏi.</p>
    }
    else
    {
        <ul>
            @foreach (var pair in Model.AccuracyByQuestionType)
            {
                <li>@pair.Key: @pair.Value.ToString("0.0")%</li>
            }
        </ul>
    }

    <h2 class="h5 mt-4">Điểm theo thời gian</h2>
    @if (Model.ScoreOverTime.Count == 0)
    {
        <p class="text-muted">Chưa có điểm theo thời gian.</p>
    }
    else
    {
        <canvas id="readingScoreChart" height="120" aria-label="Biểu đồ điểm Reading"></canvas>
        <script>
            (() => {
                const points = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ScoreOverTime.Select(p => new { t = p.Date.ToString("o"), y = p.Percent })));
                const canvas = document.getElementById('readingScoreChart');
                if (!canvas || !points.length) return;
                const ctx = canvas.getContext('2d');
                const w = canvas.width = canvas.clientWidth;
                const h = canvas.height = 160;
                const stroke = getComputedStyle(document.documentElement).getPropertyValue('--tct-primary').trim() || '#4255ff';
                ctx.clearRect(0, 0, w, h);
                ctx.strokeStyle = stroke;
                ctx.lineWidth = 2;
                ctx.beginPath();
                points.forEach((p, i) => {
                    const x = (i / Math.max(points.length - 1, 1)) * (w - 20) + 10;
                    const y = h - 10 - (p.y / 100) * (h - 20);
                    if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
                });
                ctx.stroke();
            })();
        </script>
    }

    <h2 class="h5 mt-4">Lịch sử làm bài</h2>
    @if (Model.History.Count == 0)
    {
        <p class="text-muted">Chưa có lần nộp bài nào.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm">
                <thead><tr><th>Bài</th><th>Level</th><th>Điểm</th><th>Thời gian</th></tr></thead>
                <tbody>
                @foreach (var item in Model.History)
                {
                    <tr>
                        <td><a href="/Reading/Study/@item.PassageId">@item.Title</a></td>
                        <td>@item.Level</td>
                        <td>@(item.Score)/@(item.MaxScore)</td>
                        <td>@(item.SubmittedAt?.ToLocalTime().ToString("g"))</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
