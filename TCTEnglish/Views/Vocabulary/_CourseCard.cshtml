@model TCTVocabulary.ViewModels.VocabularyCourseCardViewModel
@*
    One system course on the Vocabulary home: cover with icon, level and status, name, real counts, progress.
    The whole card is one stretched link; data-* attributes feed the client-side filters (vocabulary-home.js).
*@
@{
    var icon = Model.IconKey switch
    {
        "food" => "fa-utensils",
        "travel" => "fa-plane",
        "jobs" => "fa-briefcase",
        "colors" => "fa-palette",
        "talk" => "fa-comments",
        "star" => "fa-star",
        _ => "fa-book-open"
    };
    var (statusClass, statusIcon, statusText) = Model.Status switch
    {
        "done" => ("tct-badge--success", "fa-check", "Đã xong"),
        "progress" => ("tct-badge--warning", "fa-clock", "Đang học"),
        _ => ("tct-badge--primary", (string?)null, "Chưa học")
    };
}
<article class="tct-card tct-card--interactive k-card tv-course tv-hue-@Model.Hue"
         data-tv-course data-level="@Model.Level" data-status="@Model.Status" data-name="@Model.SetName">
    <a class="tv-course__link" href="@Url.Action("Detail", "Vocabulary", new { setId = Model.SetId })" aria-label="Mở khóa @Model.SetName"></a>
    <div class="k-art-box tv-course__cover" aria-hidden="true">
        @if (!string.IsNullOrEmpty(Model.Level))
        {
            <span class="tct-badge tv-course__level">@Model.Level</span>
        }
        <span class="tct-badge @statusClass tv-course__status">
            @if (statusIcon != null)
            {
                <i class="fa-solid @statusIcon" aria-hidden="true"></i>
            }
            @statusText
        </span>
        <i class="fa-solid @icon tv-course__icon"></i>
    </div>
    <h3 class="tv-course__name tct-clamp-2 tct-break">@Model.SetName</h3>
    <p class="tv-meta tv-course__meta">
        <span><i class="fa-solid fa-book" aria-hidden="true"></i>@Model.WordCount từ</span>
        <span><i class="fa-solid fa-layer-group" aria-hidden="true"></i>@Model.LessonCount bài</span>
    </p>
    <div class="tv-course__progress">
        <div class="k-progress k-progress--thin" aria-hidden="true"><span class="k-progress__fill" style="--p:@(Model.ProgressPercent)%"></span></div>
        <span class="tv-course__count">@Model.LearnedCount/@Model.WordCount từ<span class="visually-hidden"> đã học</span></span>
    </div>
</article>
