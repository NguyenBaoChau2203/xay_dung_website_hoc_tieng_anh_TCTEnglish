@model TCTVocabulary.ViewModels.VocabularyLessonViewModel
@{
    var heading = string.IsNullOrEmpty(Model.LessonTitle) ? Model.SetName : Model.LessonTitle + " · " + Model.SetName;
    ViewData["Title"] = heading;
}
@section Styles {
    <link rel="stylesheet" href="~/css/study-kit.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/practice.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/vocabulary.css" asp-append-version="true" />
}

<div class="tct-theme tct-page tv-page tv-page--lesson tp-page tp-page--session tp-hue-primary" data-tv-kind="@Model.Kind">
    <h1 class="visually-hidden">@heading</h1>

    @if (Model.EmptyReason != null)
    {
        <p data-tv="empty" data-reason="@Model.EmptyReason">@Model.EmptyReason</p>
    }
    else
    {
        <ul data-tv="words">
            @foreach (var word in Model.Words)
            {
                <li>@word.Term · @word.Definition</li>
            }
        </ul>
    }

    <script id="tvLesson" type="application/json">@Html.Raw(Model.ToConfigJson())</script>
    @Html.AntiForgeryToken()
</div>

@section Scripts {
    <script src="~/js/time-tracker.js" data-feature="Flashcard" defer></script>
}
