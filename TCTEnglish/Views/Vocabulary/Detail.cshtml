@model TCTVocabulary.ViewModels.VocabularyCourseViewModel
@{
    ViewData["Title"] = Model.Course.SetName + " · Từ vựng";
}
@section Styles {
    <link rel="stylesheet" href="~/css/study-kit.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/vocabulary.css" asp-append-version="true" />
}

<div class="tct-theme tct-page tv-page tv-page--course" data-active-tab="@Model.ActiveTab" data-topic-filter="@Model.TopicFilter">
    <h1>@Model.Course.SetName</h1>
    <p>@Model.Course.WordCount từ · @Model.Course.LessonCount bài · @Model.Course.LearnedCount/@Model.Course.WordCount đã học</p>

    @if (Model.NextLesson != null)
    {
        <p><a data-tv="next-lesson" href="@Model.NextLesson.Url">Học tiếp bài @Model.NextLesson.Number</a></p>
    }

    <ol data-tv="lessons">
        @foreach (var lesson in Model.Lessons)
        {
            <li data-state="@lesson.State"><a href="@lesson.Url">@lesson.Title</a> · @lesson.WordCount từ</li>
        }
    </ol>

    <ul data-tv="words">
        @foreach (var word in Model.Words)
        {
            <li data-state="@word.State">@word.Term · @word.Definition</li>
        }
    </ul>
</div>
