@model TCTVocabulary.ViewModels.VocabularyCourseViewModel
@using TCTEnglish.ViewModels
@using Microsoft.AspNetCore.Mvc.ViewFeatures
@{
    var course = Model.Course;
    ViewData["Title"] = course.SetName + " · Từ vựng";

    var crumbs = new List<PageBreadcrumbItem> { new("Từ vựng", Url.Action("Index", "Vocabulary")) };
    if (Model.FolderId.HasValue && !string.IsNullOrWhiteSpace(Model.FolderName))
    {
        crumbs.Add(new PageBreadcrumbItem(Model.FolderName!, Url.Action("FolderDetail", "Vocabulary", new { folderId = Model.FolderId.Value })));
    }
    crumbs.Add(new PageBreadcrumbItem(course.SetName));
    var header = new PageHeaderViewModel { Title = course.SetName, Breadcrumbs = crumbs };

    var wordsActive = Model.ActiveTab == "words";
    var empty = new StateMessageViewModel { Kind = StateMessageKind.Empty, Title = "Khóa này chưa có từ nào." };
    var noWordMatch = new StateMessageViewModel
    {
        Kind = StateMessageKind.Empty,
        Title = "Không có từ nào ở mục này.",
        Message = "Thử tìm bằng từ khác hoặc bỏ bớt bộ lọc."
    };
    var stateFilters = new[] { ("", "Tất cả"), ("due", "Cần ôn"), ("new", "Chưa học"), ("learned", "Đã học") };
    var memoryData = new ViewDataDictionary(ViewData)
    {
        ["Compact"] = true,
        ["PanelTitle"] = "Trí nhớ khóa này",
        ["PanelTitleId"] = "tvCourseMemoryTitle"
    };
    var emptyUpcoming = Model.Upcoming.Count == 0;
}
@section Styles {
    <link rel="stylesheet" href="~/css/study-kit.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/vocabulary.css" asp-append-version="true" />
}

<div class="tct-theme tct-page tv-page tv-page--course" data-active-tab="@Model.ActiveTab" data-topic-filter="@Model.TopicFilter">
    <section class="tv-hero tv-hue-@course.Hue">
        <div class="tv-hero__art k-art-box tv-cover tv-cover--@course.ArtKey" aria-hidden="true"><partial name="_CourseArt" model="course.ArtKey" /></div>
        <div class="tv-hero__main">
            <partial name="~/Views/Shared/_PageHeader.cshtml" model="header" />
            <p class="tv-meta tv-hero__meta">
                @if (!string.IsNullOrEmpty(course.Level))
                {
                    <span class="tct-badge tct-badge--primary">@course.Level</span>
                }
                <span><i class="fa-solid fa-book" aria-hidden="true"></i>@course.WordCount từ</span>
                <span><i class="fa-solid fa-layer-group" aria-hidden="true"></i>@course.LessonCount bài</span>
                @if (course.DueCount > 0)
                {
                    <span class="tv-chipdue"><i class="fa-solid fa-rotate" aria-hidden="true"></i>@course.DueCount từ cần ôn</span>
                }
            </p>
            <div class="k-progress" role="progressbar" aria-label="Tiến độ khóa học" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@course.ProgressPercent">
                <span class="k-progress__fill" style="--p:@(course.ProgressPercent)%"></span>
            </div>
            <p class="tv-hero__progress-text">Đã học @course.LearnedCount/@course.WordCount từ · Đã thuộc @course.KnownCount</p>
            @if (course.WordCount > 0)
            {
                <div class="tv-hero__actions">
                    @if (Model.DueUrl != null)
                    {
                        <a class="btn btn-primary btn-lg" href="@Model.DueUrl"><i class="fa-solid fa-rotate me-2" aria-hidden="true"></i>Ôn @course.DueCount từ đến hạn</a>
                        @if (Model.NextLesson != null)
                        {
                            <a class="btn btn-outline-primary btn-lg" href="@Model.NextLesson.Url"><i class="fa-solid fa-play me-2" aria-hidden="true"></i>Học bài tiếp theo</a>
                        }
                    }
                    else if (Model.NextLesson != null)
                    {
                        <a class="btn btn-primary btn-lg" href="@Model.NextLesson.Url"><i class="fa-solid fa-play me-2" aria-hidden="true"></i>Học bài tiếp theo</a>
                    }
                    else if (Model.CourseComplete && Model.Lessons.Count > 0)
                    {
                        <a class="btn k-btn--soft btn-lg" href="@Model.Lessons[0].Url"><i class="fa-solid fa-rotate me-2" aria-hidden="true"></i>Học lại từ đầu</a>
                    }
                    <a class="btn btn-outline-primary btn-lg" href="@Model.PracticeUrl"><i class="fa-solid fa-gamepad me-2" aria-hidden="true"></i>Luyện bằng trò chơi</a>
                </div>
            }
        </div>
    </section>

    <div class="tv-cols">
        <aside class="tv-cols__aside" aria-label="Trí nhớ và lịch ôn của khóa học">
            <partial name="_MemoryPanel" model="Model.Memory" view-data="memoryData" />
            <section class="tv-panel k-panel" aria-labelledby="tvUpcomingTitle">
                <div class="tv-panel__head">
                    <h2 class="tv-panel__title" id="tvUpcomingTitle"><i class="fa-solid fa-calendar-check" aria-hidden="true"></i>Sắp ôn lại</h2>
                </div>
                @if (emptyUpcoming)
                {
                    <p class="tv-panel__empty">Chưa có từ nào trong lịch ôn.</p>
                }
                else
                {
                    <ul class="tv-upcoming">
                        @foreach (var item in Model.Upcoming)
                        {
                            <li class="tv-upcoming__row">
                                <span class="tv-emoji" aria-hidden="true">@(item.Emoji ?? item.Term.Substring(0, 1).ToUpperInvariant())</span>
                                <span class="tv-upcoming__word">
                                    <span class="tv-upcoming__term" lang="en">@item.Term</span>
                                    <span class="tv-upcoming__def tct-clamp-2">@item.Definition</span>
                                </span>
                                <partial name="_LevelDots" model="item.Level" />
                                <span class="tv-upcoming__label">@item.Label</span>
                            </li>
                        }
                    </ul>
                }
            </section>
        </aside>

        <div class="tv-cols__main">
    <div class="k-seg" role="tablist" aria-label="Nội dung khóa học" id="tvTabs">
        <button type="button" class="k-seg__item" role="tab" id="tvTabLessons" aria-controls="tvPanelLessons"
                aria-selected="@(wordsActive ? "false" : "true")" tabindex="@(wordsActive ? "-1" : "0")" data-tv-tab="lessons" data-hash="bai-hoc">
            <i class="fa-solid fa-layer-group" aria-hidden="true"></i>Bài học <span class="k-seg__count">@course.LessonCount</span>
        </button>
        <button type="button" class="k-seg__item" role="tab" id="tvTabWords" aria-controls="tvPanelWords"
                aria-selected="@(wordsActive ? "true" : "false")" tabindex="@(wordsActive ? "0" : "-1")" data-tv-tab="words" data-hash="tat-ca-tu">
            <i class="fa-solid fa-list" aria-hidden="true"></i>Tất cả từ <span class="k-seg__count">@course.WordCount</span>
        </button>
    </div>

    <div id="tvPanelLessons" role="tabpanel" aria-labelledby="tvTabLessons" @(wordsActive ? "hidden" : null)>
        @if (Model.Lessons.Count == 0)
        {
            <partial name="~/Views/Shared/_StateMessage.cshtml" model="empty" />
        }
        else
        {
            <ol class="tv-lessons tv-list">
                @foreach (var lesson in Model.Lessons)
                {
                    <li><partial name="_LessonRow" model="lesson" /></li>
                }
            </ol>
        }
    </div>

    <div id="tvPanelWords" role="tabpanel" aria-labelledby="tvTabWords" @(wordsActive ? null : "hidden")>
        @if (Model.Words.Count == 0)
        {
            <partial name="~/Views/Shared/_StateMessage.cshtml" model="empty" />
        }
        else
        {
            <div class="tv-toolbar" role="search">
                <div class="tv-toolbar__search">
                    <label class="visually-hidden" for="tvWordSearch">Tìm từ hoặc nghĩa</label>
                    <div class="input-group">
                        <span class="input-group-text" aria-hidden="true"><i class="fa-solid fa-magnifying-glass"></i></span>
                        <input id="tvWordSearch" type="search" class="form-control" placeholder="Tìm từ hoặc nghĩa…" maxlength="80" autocomplete="off" />
                    </div>
                </div>
                <div class="k-seg" role="group" aria-label="Lọc theo trạng thái" data-tv-filter="state">
                    @foreach (var (value, label) in stateFilters)
                    {
                        <button type="button" class="k-seg__item" data-value="@value" aria-pressed="@(value == "" ? "true" : "false")">@label</button>
                    }
                </div>
                @if (!string.IsNullOrEmpty(Model.TopicFilter))
                {
                    <span class="tv-topic-chip" id="tvTopicChip">
                        <span>Chủ đề: <span class="tct-break">@Model.TopicFilter</span></span>
                        <button type="button" class="btn btn-sm tv-topic-chip__remove" id="tvTopicRemove" aria-label="Bỏ lọc chủ đề @Model.TopicFilter"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
                    </span>
                }
            </div>

            <p class="visually-hidden" id="tvWordStatus" role="status" aria-live="polite"></p>

            <div id="tvWordNoMatch" hidden>
                <partial name="~/Views/Shared/_StateMessage.cshtml" model="noWordMatch" />
            </div>

            <div class="tct-table-wrap k-panel k-panel--quiet tv-words" id="tvWordTable">
                <table class="tct-table tv-table">
                    <caption class="visually-hidden">Tất cả từ trong khóa @course.SetName</caption>
                    <thead>
                        <tr>
                            <th scope="col">Từ</th>
                            <th scope="col">Phiên âm</th>
                            <th scope="col">Nghĩa</th>
                            <th scope="col">Bài</th>
                            <th scope="col">Trí nhớ</th>
                            <th scope="col">Ôn lại</th>
                            <th scope="col"><span class="visually-hidden">Thao tác</span></th>
                        </tr>
                    </thead>
                    @foreach (var word in Model.Words)
                    {
                        <partial name="_WordRow" model="word" />
                    }
                </table>
            </div>
        }
    </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/personal-sets-common.js" asp-append-version="true"></script>
    <script src="~/js/practice-core.js" asp-append-version="true"></script>
    <script src="~/js/vocabulary-core.js" asp-append-version="true"></script>
    <script src="~/js/vocabulary-course.js" asp-append-version="true"></script>
}
