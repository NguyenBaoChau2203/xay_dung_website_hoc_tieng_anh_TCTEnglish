@model TCTVocabulary.ViewModels.VocabularyHomeViewModel
@{
    ViewData["Title"] = Model.FilterFolderName != null ? Model.FilterFolderName + " · Từ vựng" : "Từ vựng";
}
@section Styles {
    <link rel="stylesheet" href="~/css/study-kit.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/vocabulary.css" asp-append-version="true" />
}

<div class="tct-theme tct-page tv-page tv-page--home">
    <h1>@(Model.FilterFolderName ?? "Từ vựng")</h1>

    <p data-tv="stats">
        <span data-tv="learned">@Model.Stats.LearnedCards</span> từ đã học ·
        <span data-tv="known">@Model.Stats.KnownCards</span> từ đã thuộc ·
        <span data-tv="due">@Model.Stats.DueCards</span> từ cần ôn
    </p>

    @if (Model.Next != null)
    {
        <p data-tv="next"><a href="@Model.Next.Url">@Model.Next.LessonTitle · @Model.Next.SetName</a> (@Model.Next.NewWordCount từ mới)</p>
    }

    @if (Model.DueUrl != null)
    {
        <p><a data-tv="due-link" href="@Model.DueUrl">Ôn @Model.Stats.DueCards từ đến hạn</a></p>
    }

    @foreach (var collection in Model.Collections)
    {
        <section>
            <h2>@collection.FolderName</h2>
            <ul>
                @foreach (var course in collection.Courses)
                {
                    <li>
                        <a href="@Url.Action("Detail", "Vocabulary", new { setId = course.SetId })">@course.SetName</a>
                        · @course.WordCount từ · @course.LessonCount bài · @course.LearnedCount/@course.WordCount
                    </li>
                }
            </ul>
        </section>
    }
</div>
