<rect class="fP" x="42" y="62" width="62" height="42" rx="9"/><path class="sP" d="M60 62v-8a6 6 0 0 1 6-6h14a6 6 0 0 1 6 6v8" stroke-width="5"/>
<path class="sSf" d="M58 72v22M88 72v22" stroke-width="4" stroke-linecap="round"/>
<path class="fI" d="M96 34l26-9-7 12 12 6-5 4-13-3-8 10-3-1 2-12-10-4z"/></svg>
        break;
    case "jobs":
<svg class="tv-art" viewBox="0 0 200 120" aria-hidden="true" focusable="false">
<circle class="fSf o5" cx="172" cy="20" r="32"/><circle class="fSf o3" cx="24" cy="102" r="24"/>
<rect class="fT" x="46" y="46" width="92" height="56" rx="11"/><path class="sT" d="M74 46v-8a7 7 0 0 1 7-7h22a7 7 0 0 1 7 7v8" stroke-width="6"/>
<rect class="fA" x="46" y="66" width="92" height="8"/><rect class="fW" x="84" y="60" width="16" height="20" rx="4"/>
