<circle class="fP" cx="148" cy="42" r="8"/><path class="sP" d="M138 62h20" stroke-width="4" stroke-linecap="round" transform="rotate(10 147 49)"/></svg>
        break;
    case "colors":
<svg class="tv-art" viewBox="0 0 200 120" aria-hidden="true" focusable="false">
<circle class="fSf o5" cx="30" cy="22" r="30"/><circle class="fSf o3" cx="176" cy="100" r="26"/>
<path class="fSf" d="M96 22c34 0 60 20 60 46 0 16-12 22-24 22h-10c-7 0-9 7-5 12 3 4-1 10-9 10-36 0-62-22-62-48 0-24 22-42 50-42z"/>
<circle class="fD" cx="76" cy="50" r="9"/><circle class="fW" cx="102" cy="40" r="9"/><circle class="fS" cx="128" cy="52" r="9"/><circle class="fP" cx="70" cy="76" r="9"/><circle class="fI" cx="94" cy="92" r="8"/>
<path class="fWk" d="M150 96l30-56 8 4-30 56z"/><path class="fP" d="M150 96l8 4-4 10c-2 4-10 2-9-3z"/></svg>
        break;
    default:
<svg class="tv-art" viewBox="0 0 200 120" aria-hidden="true" focusable="false">
<circle class="fSf o5" cx="168" cy="18" r="34"/><circle class="fSf o3" cx="22" cy="108" r="26"/>
<rect class="fSf" x="38" y="34" width="74" height="54" rx="12" transform="rotate(-8 75 61)"/>
<rect class="fP" x="62" y="26" width="84" height="62" rx="14"/>
@* "<text>" is a Razor transition tag inside a code block, so this one element is written through Html.Raw. *@
@Html.Raw("<text class=\"tx fSf\" x=\"78\" y=\"68\">Aa</text>")
<path class="fA" d="M150 62l6.5 13.5 14.8 2-10.8 10.3 2.7 14.7L150 95.4l-13.2 7.1 2.7-14.7-10.8-10.3 14.8-2z"/>
<circle class="fS" cx="48" cy="28" r="7"/><circle class="fW" cx="170" cy="50" r="5"/></svg>
        break;
}
