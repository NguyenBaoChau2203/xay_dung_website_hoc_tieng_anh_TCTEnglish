@model string?
@*
    Course cover illustration (plan 5.2). The model is an art key: star, talk, book, food, travel, jobs or colors
    (anything else draws "star"). The SVGs carry classes only; vocabulary.css maps them to tokens under .tv-art.
    Decorative: aria-hidden, the course name is always text next to it.
*@
@switch ((Model ?? string.Empty).Trim().ToLowerInvariant())
{
    case "talk":
<svg class="tv-art" viewBox="0 0 200 120" aria-hidden="true" focusable="false">
<circle class="fSf o5" cx="170" cy="20" r="32"/><circle class="fSf o3" cx="24" cy="104" r="24"/>
<path class="fI" d="M44 28h72a14 14 0 0 1 14 14v26a14 14 0 0 1-14 14H74L56 96V82H44a14 14 0 0 1-14-14V42a14 14 0 0 1 14-14z"/>
<circle class="fSf" cx="62" cy="55" r="5"/><circle class="fSf" cx="80" cy="55" r="5"/><circle class="fSf" cx="98" cy="55" r="5"/>
<path class="fP" d="M112 54h50a12 12 0 0 1 12 12v18a12 12 0 0 1-12 12h-6v12l-15-12h-29a12 12 0 0 1-12-12V66a12 12 0 0 1 12-12z"/>
<path class="sSf" d="M120 70h34M120 82h22" stroke-width="5" stroke-linecap="round"/></svg>
        break;
    case "book":
<svg class="tv-art" viewBox="0 0 200 120" aria-hidden="true" focusable="false">
<circle class="fSf o5" cx="30" cy="20" r="30"/><circle class="fSf o3" cx="176" cy="104" r="26"/>
<path class="fS" d="M100 34c-14-10-36-12-54-8v62c18-4 40-2 54 8z"/><path class="fSk" d="M100 34c14-10 36-12 54-8v62c-18-4-40-2-54 8z"/>
<path class="sSf" d="M58 44c10-1 22 1 32 6M58 58c10-1 22 1 32 6M58 72c10-1 22 1 32 6" stroke-width="4" stroke-linecap="round"/>
<path class="sSf o5" d="M110 50c10-5 22-7 32-6M110 64c10-5 22-7 32-6" stroke-width="4" stroke-linecap="round"/>
<path class="fA" d="M130 22h16v30l-8-7-8 7z"/>
<path class="fW" d="M168 30l3 7 7 3-7 3-3 7-3-7-7-3 7-3z"/></svg>
        break;
    case "food":
<svg class="tv-art" viewBox="0 0 200 120" aria-hidden="true" focusable="false">
<circle class="fSf o5" cx="172" cy="22" r="32"/><circle class="fSf o3" cx="22" cy="100" r="24"/>
<path class="sWk" d="M76 26c-6 6 6 10 0 16M98 22c-6 6 6 10 0 16M120 26c-6 6 6 10 0 16" stroke-width="4" stroke-linecap="round"/>
<path class="fW" d="M40 54h116c0 26-22 44-58 44S40 80 40 54z"/><rect class="fWk" x="34" y="48" width="128" height="10" rx="5"/>
<path class="fA" d="M62 58h72c-4 6-18 10-36 10s-32-4-36-10z"/>
<path class="sT" d="M128 30l34 22M136 24l34 22" stroke-width="4" stroke-linecap="round"/>
<rect class="fWk" x="78" y="98" width="40" height="8" rx="4"/></svg>
        break;
    case "travel":
<svg class="tv-art" viewBox="0 0 200 120" aria-hidden="true" focusable="false">
<circle class="fSf o5" cx="28" cy="22" r="30"/><circle class="fSf o3" cx="178" cy="102" r="26"/>
<path class="sM" d="M36 92c30-34 70-10 96-44" stroke-width="4" stroke-dasharray="2 10" stroke-linecap="round"/>
