@model TCTVocabulary.ViewModels.VocabularyWordRowViewModel
@*
    One word of a course, as its own <tbody> so an optional example row can sit under it.
    data-* feed the client-side filters (vocabulary-course.js). The speak button stays hidden until the browser can speak.
*@
@{
    var (stateClass, stateIcon, stateText) = Model.State switch
    {
        "known" => ("tct-badge--success", "fa-check", "Đã thuộc"),
        "learning" => ("tct-badge--warning", "fa-clock", "Đang học"),
        _ => ("tct-badge--primary", (string?)null, "Chưa học")
    };
    var hasExample = !string.IsNullOrWhiteSpace(Model.Example);
}
<tbody class="tv-word" data-tv-word data-term="@Model.Term" data-definition="@Model.Definition"
       data-state="@Model.State" data-lesson="@Model.LessonNumber" data-topic="@Model.Topic">
    <tr class="tv-word__row">
        <td class="tv-word__term" lang="en">@Model.Term</td>
        <td class="tv-word__ipa">
            @if (!string.IsNullOrWhiteSpace(Model.Phonetic))
            {
                <span class="tct-phonetic">@Model.Phonetic</span>
            }
        </td>
        <td class="tv-word__def tct-break">@Model.Definition</td>
        <td class="tv-word__lesson">Bài @Model.LessonNumber</td>
        <td class="tv-word__state">
            <span class="tct-badge @stateClass">
                @if (stateIcon != null)
                {
                    <i class="fa-solid @stateIcon" aria-hidden="true"></i>
                }
                @stateText
            </span>
            @if (Model.IsDue)
            {
                <span class="tct-badge tct-badge--danger"><i class="fa-solid fa-rotate" aria-hidden="true"></i>Cần ôn</span>
            }
        </td>
        <td class="tv-word__actions">
            <button type="button" class="btn k-btn--icon-surface tct-btn-icon tv-speak" data-tv-speak="@Model.Term" aria-label="Phát âm @Model.Term" hidden><i class="fa-solid fa-volume-high" aria-hidden="true"></i></button>
            @if (hasExample)
            {
                <button type="button" class="btn btn-sm btn-outline-primary tv-example-toggle" data-tv-example aria-expanded="false" aria-controls="tvEx@(Model.CardId)">Xem ví dụ</button>
            }
        </td>
    </tr>
    @if (hasExample)
    {
        <tr class="tv-word__example" id="tvEx@(Model.CardId)" hidden>
            <td colspan="6">
                <div class="tv-example">
                    <p class="tv-example__en" lang="en">@Model.Example</p>
                    @if (!string.IsNullOrWhiteSpace(Model.ExampleTranslation))
                    {
                        <p class="tv-example__vi">@Model.ExampleTranslation</p>
                    }
                </div>
            </td>
        </tr>
    }
</tbody>
