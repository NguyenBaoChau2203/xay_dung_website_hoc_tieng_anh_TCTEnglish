@model TCTEnglish.ViewModels.Billing.PricingViewModel
@using TCTEnglish.Services.Billing
@using TCTEnglish.ViewModels
@using TCTEnglish.ViewModels.Billing
@{
    ViewData["Title"] = "Nâng cấp Premium";
    var header = new PageHeaderViewModel
    {
        Title = "Nâng cấp Premium",
        Description = "Thanh toán một lần cho mỗi gói. Không tự động gia hạn."
    };
    var selectedPlan = Model.SelectedPlan;
    var selectedProvider = Model.SelectedProvider;
    var noPlans = Model.Plans.Count == 0;
    var noGateway = !Model.HasAnyReadyProvider;
    var canCheckout = Model.CanBuy && !noPlans && !noGateway && selectedPlan != null;
    var summary = new OrderSummaryViewModel
    {
        Heading = "Tóm tắt",
        Live = true,
        Rows = selectedPlan == null
            ? Array.Empty<BillingRow>()
            : new[]
            {
                new BillingRow("Gói", selectedPlan.Name, Emphasis: true, Key: "plan"),
                new BillingRow("Hiệu lực", PricingPageBuilder.ValidityText(Model, selectedPlan), Emphasis: true, Key: "validity")
            },
        TotalText = selectedPlan?.PriceText ?? string.Empty
    };
    var noteProvider = selectedProvider == null ? string.Empty : (selectedProvider.Code == "momo" ? "MoMo" : "VNPay");
    var emptyPlans = new StateMessageViewModel
    {
        Kind = StateMessageKind.Empty,
        Title = "Hiện chưa có gói nào.",
        Message = "Vui lòng quay lại sau."
    };
    var errorState = new StateMessageViewModel
    {
        Kind = StateMessageKind.Error,
        Title = "Chưa thể bắt đầu thanh toán",
        Message = Model.ErrorMessage ?? string.Empty
    };
}
@section Styles {
    <link rel="stylesheet" href="~/css/study-kit.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/billing.css" asp-append-version="true" />
}

<div class="tct-theme tct-page tb-page tb-page--pricing">
    <partial name="_PageHeader" model="header" />

    <partial name="_PremiumStatus" model="Model.Status" />

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="tb-error" tabindex="-1" data-tb-error>
            <partial name="_StateMessage" model="errorState" />
        </div>
    }

    @if (noPlans)
    {
        <partial name="_StateMessage" model="emptyPlans" />
    }
    else if (!Model.CanBuy)
    {
        <div class="tb-grid tb-grid--benefits">
            <div class="tb-main">
                <partial name="_BenefitsTable" />
            </div>
            <aside class="tb-grid__side">
                <section class="k-panel tb-card tb-note-card" aria-label="Quyền Premium không thời hạn">
                    <p class="tb-section-title">Bạn không cần mua gói</p>
                    <p class="tb-note">Tài khoản của bạn có quyền Premium không thời hạn.</p>
                </section>
            </aside>
        </div>
    }
    else
    {
        <form method="post" asp-controller="Billing" asp-action="Checkout" class="tb-checkout"
              data-tb-pricing data-now-ms="@Model.NowMs" data-current-end-ms="@Model.CurrentEndMs">
            <div class="tb-grid">
                <div class="tb-main">
                    <fieldset class="tb-fieldset">
                        <legend class="tb-section-title">1. Chọn gói</legend>
                        <div class="tb-plans">
                            @foreach (var plan in Model.Plans)
                            {
                                <label class="tb-plan k-card" data-tb-plan data-name="@plan.Name" data-price="@((long)plan.PriceVnd)" data-days="@plan.DurationDays">
                                    <input class="tb-radio" type="radio" name="PlanCode" value="@plan.Code" checked="@plan.IsPreselected" required />
                                    <span class="tb-plan__head">
                                        <span class="tb-plan__name">@plan.Name</span>
                                        @if (plan.SavingPercent > 0)
                                        {
                                            <span class="tb-chip tb-chip--success">Tiết kiệm @plan.SavingPercent%</span>
                                        }
                                    </span>
                                    <span class="tb-plan__price tb-num">@plan.PriceText</span>
                                    <span class="tb-plan__meta">
                                        Dùng trong @plan.DurationDays ngày@(string.IsNullOrEmpty(plan.PerMonthText) ? string.Empty : " · " + plan.PerMonthText)
                                    </span>
                                    <span class="tb-mark" aria-hidden="true"><i class="fa-solid fa-check"></i></span>
                                </label>
                            }
                        </div>
                    </fieldset>

                    <partial name="_BenefitsTable" />
                </div>

                <aside class="tb-grid__side">
                    <section class="k-panel tb-card tb-pay" aria-label="Thanh toán">
                        @if (noGateway)
                        {
                            <p class="tb-section-title">2. Thanh toán</p>
                            <div class="tb-notice tb-notice--warning" role="status">
                                <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
                                <span>Cổng thanh toán đang tạm ngưng. Vui lòng quay lại sau.</span>
                            </div>
                        }
                        else
                        {
                            <fieldset class="tb-fieldset">
                                <legend class="tb-section-title">2. Thanh toán</legend>
                                <div class="tb-methods">
                                    @foreach (var provider in Model.Providers)
                                    {
                                        <label class="tb-method@(provider.Available ? string.Empty : " is-disabled")" data-tb-method
                                               data-name="@(provider.Code == "momo" ? "MoMo" : "VNPay")">
                                            <input class="tb-radio" type="radio" name="Provider" value="@provider.Code"
                                                   checked="@(provider.IsPreselected)" disabled="@(!provider.Available)" required />
                                            <span class="tb-method__badge tb-method__badge--@provider.Code" aria-hidden="true">@provider.Badge</span>
                                            <span class="tb-method__body">
                                                <span class="tb-method__name">
                                                    @provider.Name
                                                    @if (provider.IsTest)
                                                    {
                                                        <span class="tb-chip tb-chip--info">Thử nghiệm</span>
                                                    }
                                                </span>
                                                <span class="tb-method__desc">@(provider.Available ? provider.Description : "Tạm thời chưa dùng được")</span>
                                            </span>
                                            <span class="tb-mark" aria-hidden="true"><i class="fa-solid fa-check"></i></span>
                                        </label>
                                    }
                                </div>
                            </fieldset>

                            <partial name="_OrderSummary" model="summary" />

                            @if (canCheckout)
                            {
                                <button type="submit" class="btn btn-primary btn-lg w-100 tb-submit" data-tb-submit>
                                    <i class="fa-solid fa-lock me-2" aria-hidden="true" data-tb-icon></i>
                                    <span data-tb-field="button">Thanh toán</span>
                                </button>
                            }

                            <p class="tb-note" data-tb-field="note">
                                Bạn sẽ được chuyển sang trang của @noteProvider để hoàn tất. TCT English không lưu thông tin thẻ của bạn.
                            </p>
                            <p class="tb-note tb-note--info">
                                <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
                                Sau khi thanh toán xong, bạn có thể được yêu cầu đăng nhập lại để tài khoản nhận quyền Premium.
                            </p>
                        }
                    </section>
                </aside>
            </div>
        </form>
    }
</div>

@section Scripts {
    <script src="~/js/billing-core.js" asp-append-version="true"></script>
    <script src="~/js/billing-pricing.js" asp-append-version="true"></script>
}
